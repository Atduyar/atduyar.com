---
---

<!-- Field Notes / Technical Writing -->
<section id="writings" class="px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14] relative overflow-hidden">
	<!-- Diagonal grid pattern -->
	<div class="absolute inset-0 opacity-[0.04]" style="background-image: repeating-linear-gradient(45deg, transparent, transparent 35px, rgba(96,165,250,0.3) 35px, rgba(96,165,250,0.3) 36px);"></div>

	<div class="relative z-10">
		<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-4 flex items-center gap-4">
			<span class="font-oldturcic text-2xl md:text-3xl text-emerald-400/30 leading-none">𐰖𐰔</span>
			Field Notes
			<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
		</h2>
		<p class="text-gray-500 mb-12 max-w-2xl font-mono text-sm">TECHNICAL DOCUMENTATION // THOUGHTS & DISCOVERIES</p>

		<!-- Writing entries as field journal entries -->
		<div class="grid md:grid-cols-2 gap-6">
			<!-- Entry 1 -->
			<article class="group relative border border-emerald-400/20 hover:border-emerald-400/40 transition-all p-6 bg-[#0a0b0d]/50">
				<div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-emerald-400/50 to-transparent"></div>
				<div class="flex items-start justify-between mb-4">
					<div class="font-mono text-xs text-emerald-400/60 border border-emerald-400/30 px-2 py-1">ENTRY #001</div>
					<span class="font-mono text-xs text-gray-500">2024.01.15</span>
				</div>
				<h3 class="font-sinistre text-xl text-emerald-200 mb-3 group-hover:text-emerald-100 transition-colors">
					Building Zero-Copy Key-Value Stores in Rust
				</h3>
				<p class="text-gray-400 text-sm leading-relaxed mb-4">
					Exploring memory-mapped I/O and serialization strategies for high-performance storage systems. Lessons learned from implementing REKV.
				</p>
				<div class="flex items-center justify-between">
					<div class="flex gap-2">
						<span class="font-mono text-xs text-emerald-400/60 border border-emerald-400/20 px-2 py-1">Rust</span>
						<span class="font-mono text-xs text-emerald-400/60 border border-emerald-400/20 px-2 py-1">Systems</span>
					</div>
					<a href="#" class="font-mono text-xs text-emerald-400 hover:text-emerald-300 flex items-center gap-1 transition-colors">
						READ MORE →
					</a>
				</div>
			</article>

			<!-- Entry 2 -->
			<article class="group relative border border-emerald-400/20 hover:border-emerald-400/40 transition-all p-6 bg-[#0a0b0d]/50">
				<div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-emerald-400/50 to-transparent"></div>
				<div class="flex items-start justify-between mb-4">
					<div class="font-mono text-xs text-emerald-400/60 border border-emerald-400/30 px-2 py-1">ENTRY #002</div>
					<span class="font-mono text-xs text-gray-500">2023.11.08</span>
				</div>
				<h3 class="font-sinistre text-xl text-emerald-200 mb-3 group-hover:text-emerald-100 transition-colors">
					Clean Architecture in .NET: A Field Guide
				</h3>
				<p class="text-gray-400 text-sm leading-relaxed mb-4">
					Practical implementation patterns for maintaining separation of concerns in enterprise applications. Real-world trade-offs and decisions.
				</p>
				<div class="flex items-center justify-between">
					<div class="flex gap-2">
						<span class="font-mono text-xs text-emerald-400/60 border border-emerald-400/20 px-2 py-1">C#</span>
						<span class="font-mono text-xs text-emerald-400/60 border border-emerald-400/20 px-2 py-1">Architecture</span>
					</div>
					<a href="#" class="font-mono text-xs text-emerald-400 hover:text-emerald-300 flex items-center gap-1 transition-colors">
						READ MORE →
					</a>
				</div>
			</article>

			<!-- Entry 3 -->
			<article class="group relative border border-emerald-400/20 hover:border-emerald-400/40 transition-all p-6 bg-[#0a0b0d]/50">
				<div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-emerald-400/50 to-transparent"></div>
				<div class="flex items-start justify-between mb-4">
					<div class="font-mono text-xs text-emerald-400/60 border border-emerald-400/30 px-2 py-1">ENTRY #003</div>
					<span class="font-mono text-xs text-gray-500">2023.08.22</span>
				</div>
				<h3 class="font-sinistre text-xl text-emerald-200 mb-3 group-hover:text-emerald-100 transition-colors">
					Optimizing WebGL Performance in 2D Engines
				</h3>
				<p class="text-gray-400 text-sm leading-relaxed mb-4">
					Batching strategies, texture atlases, and shader optimization techniques discovered while building Make2Game engine.
				</p>
				<div class="flex items-center justify-between">
					<div class="flex gap-2">
						<span class="font-mono text-xs text-emerald-400/60 border border-emerald-400/20 px-2 py-1">OpenGL</span>
						<span class="font-mono text-xs text-emerald-400/60 border border-emerald-400/20 px-2 py-1">C++</span>
					</div>
					<a href="#" class="font-mono text-xs text-emerald-400 hover:text-emerald-300 flex items-center gap-1 transition-colors">
						READ MORE →
					</a>
				</div>
			</article>

			<!-- Entry 4 -->
			<article class="group relative border border-emerald-400/20 hover:border-emerald-400/40 transition-all p-6 bg-[#0a0b0d]/50">
				<div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-emerald-400/50 to-transparent"></div>
				<div class="flex items-start justify-between mb-4">
					<div class="font-mono text-xs text-emerald-400/60 border border-emerald-400/30 px-2 py-1">ENTRY #004</div>
					<span class="font-mono text-xs text-gray-500">2023.05.14</span>
				</div>
				<h3 class="font-sinistre text-xl text-emerald-200 mb-3 group-hover:text-emerald-100 transition-colors">
					Streaming Architecture at Scale
				</h3>
				<p class="text-gray-400 text-sm leading-relaxed mb-4">
					Designing adaptive bitrate streaming infrastructure. CDN integration, edge caching, and multi-platform delivery strategies.
				</p>
				<div class="flex items-center justify-between">
					<div class="flex gap-2">
						<span class="font-mono text-xs text-emerald-400/60 border border-emerald-400/20 px-2 py-1">Streaming</span>
						<span class="font-mono text-xs text-emerald-400/60 border border-emerald-400/20 px-2 py-1">Infrastructure</span>
					</div>
					<a href="#" class="font-mono text-xs text-emerald-400 hover:text-emerald-300 flex items-center gap-1 transition-colors">
						READ MORE →
					</a>
				</div>
			</article>
		</div>

		<!-- Archive link -->
		<div class="mt-8 text-center">
			<a href="#" class="inline-flex items-center gap-2 font-mono text-sm text-gray-400 hover:text-emerald-400 transition-colors border-b border-transparent hover:border-emerald-400/50 pb-1">
				<span>VIEW ALL ENTRIES</span>
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
				</svg>
			</a>
		</div>
	</div>
</section>
