---
---

<!-- Public Contributions / Open Source -->
<section id="opensource" class="px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14] relative overflow-hidden">
	<!-- Git graph pattern -->
	<div class="absolute inset-0 opacity-[0.06]" style="background-image: linear-gradient(to right, rgba(251,146,60,0.4) 1px, transparent 1px), linear-gradient(to bottom, rgba(251,146,60,0.4) 1px, transparent 1px); background-size: 50px 50px;"></div>

	<div class="relative z-10">
		<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-4 flex items-center gap-4">
			<span class="font-oldturcic text-2xl md:text-3xl text-orange-400/30 leading-none">𐰆𐰞</span>
			Public Contributions
			<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
		</h2>
		<p class="text-gray-500 mb-12 max-w-2xl font-mono text-sm">OPEN SOURCE // COMMUNITY ENGAGEMENT</p>

		<!-- Contribution stats -->
		<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
			<div class="border border-orange-400/20 p-4 text-center bg-[#0a0b0d]/50">
				<div class="font-sinistre text-3xl text-orange-300 mb-1">1.2K+</div>
				<div class="font-mono text-xs text-gray-500">COMMITS</div>
			</div>
			<div class="border border-orange-400/20 p-4 text-center bg-[#0a0b0d]/50">
				<div class="font-sinistre text-3xl text-orange-300 mb-1">15+</div>
				<div class="font-mono text-xs text-gray-500">REPOSITORIES</div>
			</div>
			<div class="border border-orange-400/20 p-4 text-center bg-[#0a0b0d]/50">
				<div class="font-sinistre text-3xl text-orange-300 mb-1">45+</div>
				<div class="font-mono text-xs text-gray-500">PRs MERGED</div>
			</div>
			<div class="border border-orange-400/20 p-4 text-center bg-[#0a0b0d]/50">
				<div class="font-sinistre text-3xl text-orange-300 mb-1">8</div>
				<div class="font-mono text-xs text-gray-500">STARS EARNED</div>
			</div>
		</div>

		<!-- Featured repositories -->
		<div class="space-y-4">
			<h4 class="font-sinistre text-lg text-orange-300 mb-6">Featured Repositories</h4>

			<!-- Repo 1 -->
			<div class="group relative border border-orange-400/20 hover:border-orange-400/40 transition-all p-5 bg-[#0a0b0d]/50">
				<div class="flex flex-col md:flex-row md:items-center gap-4">
					<div class="flex-1">
						<div class="flex items-center gap-3 mb-2">
							<svg class="w-5 h-5 text-gray-500" fill="currentColor" viewBox="0 0 24 24">
								<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
							</svg>
							<h3 class="font-sinistre text-lg text-orange-200 group-hover:text-orange-100 transition-colors">atduyar/rekv</h3>
							<span class="font-mono text-xs text-gray-500 border border-gray-700 px-2 py-0.5">PUBLIC</span>
						</div>
						<p class="text-gray-400 text-sm mb-3">Zero-copy key-value store library in Rust with memory-mapped storage and async I/O</p>
						<div class="flex flex-wrap gap-2">
							<span class="font-mono text-xs text-orange-400/80 flex items-center gap-1">
								<span class="w-2 h-2 bg-orange-500 rounded-full"></span>
								Rust
							</span>
							<span class="font-mono text-xs text-gray-500 flex items-center gap-1">
								<svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
								3
							</span>
						</div>
					</div>
					<a href="https://github.com/atduyar/rekv" target="_blank" rel="noopener noreferrer" class="px-4 py-2 border border-orange-400/30 hover:border-orange-400 hover:bg-orange-400/10 transition-all font-mono text-xs text-orange-300 whitespace-nowrap">
						VIEW →
					</a>
				</div>
			</div>

			<!-- Repo 2 -->
			<div class="group relative border border-orange-400/20 hover:border-orange-400/40 transition-all p-5 bg-[#0a0b0d]/50">
				<div class="flex flex-col md:flex-row md:items-center gap-4">
					<div class="flex-1">
						<div class="flex items-center gap-3 mb-2">
							<svg class="w-5 h-5 text-gray-500" fill="currentColor" viewBox="0 0 24 24">
								<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
							</svg>
							<h3 class="font-sinistre text-lg text-orange-200 group-hover:text-orange-100 transition-colors">atduyar/make2game</h3>
							<span class="font-mono text-xs text-gray-500 border border-gray-700 px-2 py-0.5">PUBLIC</span>
						</div>
						<p class="text-gray-400 text-sm mb-3">Experimental 2D game engine with Lua scripting and ImGui editor interface</p>
						<div class="flex flex-wrap gap-2">
							<span class="font-mono text-xs text-orange-400/80 flex items-center gap-1">
								<span class="w-2 h-2 bg-blue-400 rounded-full"></span>
								C++
							</span>
							<span class="font-mono text-xs text-gray-500 flex items-center gap-1">
								<svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
								5
							</span>
						</div>
					</div>
					<a href="https://github.com/atduyar/make2game" target="_blank" rel="noopener noreferrer" class="px-4 py-2 border border-orange-400/30 hover:border-orange-400 hover:bg-orange-400/10 transition-all font-mono text-xs text-orange-300 whitespace-nowrap">
						VIEW →
					</a>
				</div>
			</div>

			<!-- Repo 3 -->
			<div class="group relative border border-orange-400/20 hover:border-orange-400/40 transition-all p-5 bg-[#0a0b0d]/50">
				<div class="flex flex-col md:flex-row md:items-center gap-4">
					<div class="flex-1">
						<div class="flex items-center gap-3 mb-2">
							<svg class="w-5 h-5 text-gray-500" fill="currentColor" viewBox="0 0 24 24">
								<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
							</svg>
							<h3 class="font-sinistre text-lg text-orange-200 group-hover:text-orange-100 transition-colors">atduyar/dotfiles</h3>
							<span class="font-mono text-xs text-gray-500 border border-gray-700 px-2 py-0.5">PUBLIC</span>
						</div>
						<p class="text-gray-400 text-sm mb-3">Personal Linux development environment configuration files and automation scripts</p>
						<div class="flex flex-wrap gap-2">
							<span class="font-mono text-xs text-orange-400/80 flex items-center gap-1">
								<span class="w-2 h-2 bg-yellow-400 rounded-full"></span>
								Shell
							</span>
							<span class="font-mono text-xs text-gray-500 flex items-center gap-1">
								<svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
								12
							</span>
						</div>
					</div>
					<a href="https://github.com/atduyar/dotfiles" target="_blank" rel="noopener noreferrer" class="px-4 py-2 border border-orange-400/30 hover:border-orange-400 hover:bg-orange-400/10 transition-all font-mono text-xs text-orange-300 whitespace-nowrap">
						VIEW →
					</a>
				</div>
			</div>
		</div>

		<!-- GitHub profile link -->
		<div class="mt-8 flex justify-center">
			<a href="https://github.com/atduyar" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3 px-6 py-3 border border-orange-400/30 hover:border-orange-400 hover:bg-orange-400/10 transition-all">
				<svg class="w-5 h-5 text-orange-400" fill="currentColor" viewBox="0 0 24 24">
					<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
				</svg>
				<span class="font-mono text-sm text-orange-300">github.com/atduyar</span>
				<svg class="w-4 h-4 text-orange-400/60 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
				</svg>
			</a>
		</div>
	</div>
</section>
