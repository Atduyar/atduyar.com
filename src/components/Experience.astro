---
---

<!-- Career Trajectory / Experience Timeline -->
<section id="experience" class="px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14] relative overflow-hidden">
	<!-- Timeline grid background -->
	<div class="absolute inset-0 opacity-[0.05]" style="background-image: linear-gradient(rgba(251,191,36,0.4) 1px, transparent 1px), linear-gradient(90deg, rgba(251,191,36,0.4) 1px, transparent 1px); background-size: 40px 40px;"></div>

	<div class="relative z-10">
		<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-4 flex items-center gap-4">
			<span class="font-oldturcic text-2xl md:text-3xl text-amber-400/30 leading-none">𐰖𐰍</span>
			Career Trajectory
			<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
		</h2>
		<p class="text-gray-500 mb-12 max-w-2xl font-mono text-sm">PROFESSIONAL HISTORY // DEPLOYMENT TIMELINE</p>

		<!-- Timeline container -->
		<div class="relative">
			<!-- Central timeline line -->
			<div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-amber-400/50 via-amber-400/30 to-transparent md:-translate-x-1/2"></div>

			<!-- Experience 1 -->
			<div class="relative mb-12 md:mb-0">
				<div class="md:grid md:grid-cols-2 md:gap-8 items-center">
					<!-- Content left -->
					<div class="pl-12 md:pl-0 md:pr-12 md:text-right">
						<div class="group relative border border-amber-400/20 hover:border-amber-400/40 transition-all p-5 bg-[#0a0b0d]/50">
							<div class="absolute -top-3 right-4 md:left-auto md:right-4 font-mono text-xs text-amber-400 border border-amber-400/30 bg-[#0a0b0d] px-2 py-1">PRESENT</div>
							<div class="font-mono text-xs text-amber-400/60 mb-2">2022 — CURRENT</div>
							<h3 class="font-sinistre text-xl text-amber-200 mb-2">Full-Stack Engineer</h3>
							<div class="text-sm text-amber-400/80 mb-3">Deniz Egece Co. Ltd.</div>
							<p class="text-gray-400 text-sm leading-relaxed mb-3">
								Led development of EgeceTV streaming platform and Distance Education Platform. Architected systems serving 17K+ users across 5 platforms.
							</p>
							<div class="flex flex-wrap gap-2 md:justify-end">
								<span class="font-mono text-xs text-gray-500 border border-gray-700 px-2 py-1">Next.js</span>
								<span class="font-mono text-xs text-gray-500 border border-gray-700 px-2 py-1">.NET</span>
								<span class="font-mono text-xs text-gray-500 border border-gray-700 px-2 py-1">AWS</span>
							</div>
						</div>
					</div>
					<!-- Timeline marker -->
					<div class="absolute left-4 md:left-1/2 top-6 md:top-1/2 w-3 h-3 bg-amber-400 rounded-full border-2 border-[#0d0e12] md:-translate-x-1/2 md:-translate-y-1/2 z-10 shadow-[0_0_10px_rgba(251,191,36,0.5)]"></div>
					<!-- Content right (empty for first) -->
					<div class="hidden md:block md:pl-12"></div>
				</div>
			</div>

			<!-- Experience 2 -->
			<div class="relative mb-12 md:mb-0 md:mt-12">
				<div class="md:grid md:grid-cols-2 md:gap-8 items-center">
					<!-- Content left (empty) -->
					<div class="hidden md:block md:pr-12"></div>
					<!-- Timeline marker -->
					<div class="absolute left-4 md:left-1/2 top-6 md:top-1/2 w-3 h-3 bg-amber-400/60 rounded-full border-2 border-[#0d0e12] md:-translate-x-1/2 md:-translate-y-1/2 z-10"></div>
					<!-- Content right -->
					<div class="pl-12 md:pl-12">
						<div class="group relative border border-amber-400/20 hover:border-amber-400/40 transition-all p-5 bg-[#0a0b0d]/50">
							<div class="font-mono text-xs text-amber-400/60 mb-2">2021 — 2022</div>
							<h3 class="font-sinistre text-xl text-amber-200 mb-2">Software Developer</h3>
							<div class="text-sm text-amber-400/80 mb-3">Freelance & Personal Projects</div>
							<p class="text-gray-400 text-sm leading-relaxed mb-3">
								Developed Evrenomi blogging platform with 95+ Lighthouse score. Built foundational skills in full-stack development and Linux server administration.
							</p>
							<div class="flex flex-wrap gap-2">
								<span class="font-mono text-xs text-gray-500 border border-gray-700 px-2 py-1">C#</span>
								<span class="font-mono text-xs text-gray-500 border border-gray-700 px-2 py-1">REST API</span>
								<span class="font-mono text-xs text-gray-500 border border-gray-700 px-2 py-1">Linux</span>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Experience 3 -->
			<div class="relative md:mt-12">
				<div class="md:grid md:grid-cols-2 md:gap-8 items-center">
					<!-- Content left -->
					<div class="pl-12 md:pl-0 md:pr-12 md:text-right">
						<div class="group relative border border-amber-400/20 hover:border-amber-400/40 transition-all p-5 bg-[#0a0b0d]/50">
							<div class="font-mono text-xs text-amber-400/60 mb-2">2019 — 2021</div>
							<h3 class="font-sinistre text-xl text-amber-200 mb-2">Computer Science Student</h3>
							<div class="text-sm text-amber-400/80 mb-3">University Education</div>
							<p class="text-gray-400 text-sm leading-relaxed mb-3">
								Formal education in computer science fundamentals. Began experimenting with game development in C++ and OpenGL during this period.
							</p>
							<div class="flex flex-wrap gap-2 md:justify-end">
								<span class="font-mono text-xs text-gray-500 border border-gray-700 px-2 py-1">C++</span>
								<span class="font-mono text-xs text-gray-500 border border-gray-700 px-2 py-1">OpenGL</span>
								<span class="font-mono text-xs text-gray-500 border border-gray-700 px-2 py-1">Algorithms</span>
							</div>
						</div>
					</div>
					<!-- Timeline marker -->
					<div class="absolute left-4 md:left-1/2 top-6 md:top-1/2 w-3 h-3 bg-amber-400/40 rounded-full border-2 border-[#0d0e12] md:-translate-x-1/2 md:-translate-y-1/2 z-10"></div>
					<!-- Content right (empty) -->
					<div class="hidden md:block md:pl-12"></div>
				</div>
			</div>
		</div>

		<!-- Download CV -->
		<div class="mt-16 text-center">
			<a href="#" class="inline-flex items-center gap-3 px-6 py-3 border border-amber-400/30 hover:border-amber-400 hover:bg-amber-400/10 transition-all font-mono text-sm text-amber-300">
				<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
				</svg>
				<span>DOWNLOAD CV</span>
			</a>
		</div>
	</div>
</section>
