<!-- SECTION 10: THE CREDITS - Footer as Movie Credits -->
<section id="credits" class="relative overflow-hidden">
	<div class="px-4 md:px-8 lg:px-16 py-20 text-center">
		<div class="max-w-2xl mx-auto">
			<!-- Film grain overlay -->
			<div class="absolute inset-0 opacity-[0.02] pointer-events-none" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 256 256%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noise%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%224%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noise)%22/%3E%3C/svg%3E');"></div>

			<!-- Studio logo -->
			<div class="mb-12">
				<img src="/favicon.svg" alt="Logo" class="w-16 h-16 mx-auto opacity-60" />
			</div>

			<!-- Title card -->
			<div class="mb-16">
				<h3 class="font-sinistre text-4xl text-blue-200 mb-2">AHMET TARIK DUYAR</h3>
				<p class="text-gray-500 italic">A Full-Stack Production</p>
			</div>

			<!-- Credits roll -->
			<div class="space-y-8 text-sm">
				<div>
					<div class="text-gray-500 mb-1">WRITTEN AND DIRECTED BY</div>
					<div class="font-sinistre text-lg">Ahmet Tarik Duyar</div>
				</div>

				<div>
					<div class="text-gray-500 mb-1">PRODUCED BY</div>
					<div class="font-sinistre text-lg">Coffee and Late Nights</div>
				</div>

				<div>
					<div class="text-gray-500 mb-1">TECHNOLOGIES</div>
					<div class="font-sinistre">Node.js / Rust / PostgreSQL / React</div>
				</div>

				<div>
					<div class="text-gray-500 mb-1">SPECIAL THANKS</div>
					<div class="font-sinistre">The Open Source Community</div>
				</div>

				<div>
					<div class="text-gray-500 mb-1">FILMED ON LOCATION</div>
					<div class="font-sinistre">Sarajevo, Bosnia and Herzegovina</div>
				</div>
			</div>

			<!-- Copyright -->
			<div class="mt-16 pt-8 border-t border-[#90c5ff14]">
				<p class="text-gray-600 text-xs">&copy; 2026 ATDUYAR PRODUCTIONS</p>
				<p class="text-gray-700 text-xs mt-2">No code was harmed in the making of this portfolio.</p>
			</div>

			<!-- Social links as "distribution" -->
			<div class="mt-8 flex justify-center gap-8 text-gray-500 text-sm">
				<a href="https://github.com/atduyar" target="_blank" rel="noopener" class="hover:text-white transition-colors">GitHub</a>
				<a href="https://linkedin.com/in/atduyar" target="_blank" rel="noopener" class="hover:text-white transition-colors">LinkedIn</a>
				<a href="mailto:contact@atduyar.com" class="hover:text-white transition-colors">Email</a>
			</div>
		</div>
	</div>
</section>

