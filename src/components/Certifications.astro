---
---

<!-- Validated Credentials / Certifications -->
<section id="certifications" class="px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14] relative overflow-hidden">
	<!-- Hexagonal pattern -->
	<div class="absolute inset-0 opacity-[0.05]" style="background-image: url('data:image/svg+xml,%3Csvg width=&quot;60&quot; height=&quot;60&quot; viewBox=&quot;0 0 60 60&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot;%3E%3Cpath d=&quot;M30 0l25.98 15v30L30 60 4.02 45V15z&quot; fill=&quot;none&quot; stroke=&quot;%23fb7185&quot; stroke-width=&quot;1&quot;/%3E%3C/svg%3E');"></div>

	<div class="relative z-10">
		<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-4 flex items-center gap-4">
			<span class="font-oldturcic text-2xl md:text-3xl text-rose-400/30 leading-none">𐰋𐰼</span>
			Validated Credentials
			<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
		</h2>
		<p class="text-gray-500 mb-12 max-w-2xl font-mono text-sm">CERTIFICATIONS // VERIFIED COMPETENCIES</p>

		<!-- Certifications grid -->
		<div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
			<!-- AWS Certification -->
			<div class="group relative">
				<div class="relative border border-rose-400/20 hover:border-rose-400/40 transition-all p-5 bg-[#0a0b0d]/50 h-full">
					<!-- Badge icon -->
					<div class="absolute -top-3 -right-3 w-8 h-8 bg-rose-500/20 border border-rose-400/40 rounded-full flex items-center justify-center">
						<svg class="w-4 h-4 text-rose-400" fill="currentColor" viewBox="0 0 24 24">
							<path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/>
						</svg>
					</div>
					
					<div class="font-mono text-xs text-rose-400/60 mb-3">AWS-CLF-C02</div>
					<h3 class="font-sinistre text-lg text-rose-200 mb-2">AWS Certified</h3>
					<div class="text-sm text-rose-400/80 mb-3">Cloud Practitioner</div>
					<p class="text-gray-400 text-xs leading-relaxed mb-4">
						Foundational cloud concepts, AWS services, security, and architectural best practices.
					</p>
					<div class="flex items-center justify-between pt-3 border-t border-rose-400/10">
						<span class="font-mono text-xs text-gray-500">2023</span>
						<span class="font-mono text-xs text-emerald-400">VERIFIED</span>
					</div>
				</div>
			</div>

			<!-- Azure Certification -->
			<div class="group relative">
				<div class="relative border border-rose-400/20 hover:border-rose-400/40 transition-all p-5 bg-[#0a0b0d]/50 h-full">
					<div class="absolute -top-3 -right-3 w-8 h-8 bg-rose-500/20 border border-rose-400/40 rounded-full flex items-center justify-center">
						<svg class="w-4 h-4 text-rose-400" fill="currentColor" viewBox="0 0 24 24">
							<path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/>
						</svg>
					</div>
					
					<div class="font-mono text-xs text-rose-400/60 mb-3">AZ-900</div>
					<h3 class="font-sinistre text-lg text-rose-200 mb-2">Azure Fundamentals</h3>
					<div class="text-sm text-rose-400/80 mb-3">Microsoft Certified</div>
					<p class="text-gray-400 text-xs leading-relaxed mb-4">
						Cloud concepts, Azure services, workloads, security, privacy, pricing, and support.
					</p>
					<div class="flex items-center justify-between pt-3 border-t border-rose-400/10">
						<span class="font-mono text-xs text-gray-500">2023</span>
						<span class="font-mono text-xs text-emerald-400">VERIFIED</span>
					</div>
				</div>
			</div>

			<!-- Docker Certification -->
			<div class="group relative">
				<div class="relative border border-rose-400/20 hover:border-rose-400/40 transition-all p-5 bg-[#0a0b0d]/50 h-full">
					<div class="absolute -top-3 -right-3 w-8 h-8 bg-rose-500/20 border border-rose-400/40 rounded-full flex items-center justify-center">
						<svg class="w-4 h-4 text-rose-400" fill="currentColor" viewBox="0 0 24 24">
							<path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/>
						</svg>
					</div>
					
					<div class="font-mono text-xs text-rose-400/60 mb-3">DCA</div>
					<h3 class="font-sinistre text-lg text-rose-200 mb-2">Docker Certified</h3>
					<div class="text-sm text-rose-400/80 mb-3">Associate</div>
					<p class="text-gray-400 text-xs leading-relaxed mb-4">
						Containerization, image creation, orchestration, networking, and security best practices.
					</p>
					<div class="flex items-center justify-between pt-3 border-t border-rose-400/10">
						<span class="font-mono text-xs text-gray-500">2022</span>
						<span class="font-mono text-xs text-emerald-400">VERIFIED</span>
					</div>
				</div>
			</div>

			<!-- Linux Certification -->
			<div class="group relative">
				<div class="relative border border-rose-400/20 hover:border-rose-400/40 transition-all p-5 bg-[#0a0b0d]/50 h-full">
					<div class="absolute -top-3 -right-3 w-8 h-8 bg-rose-500/20 border border-rose-400/40 rounded-full flex items-center justify-center">
						<svg class="w-4 h-4 text-rose-400" fill="currentColor" viewBox="0 0 24 24">
							<path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/>
						</svg>
					</div>
					
					<div class="font-mono text-xs text-rose-400/60 mb-3">LPI-1</div>
					<h3 class="font-sinistre text-lg text-rose-200 mb-2">Linux Professional</h3>
					<div class="text-sm text-rose-400/80 mb-3">LPIC-1</div>
					<p class="text-gray-400 text-xs leading-relaxed mb-4">
						System architecture, installation, GNU commands, devices, filesystems, and networking.
					</p>
					<div class="flex items-center justify-between pt-3 border-t border-rose-400/10">
						<span class="font-mono text-xs text-gray-500">2022</span>
						<span class="font-mono text-xs text-emerald-400">VERIFIED</span>
					</div>
				</div>
			</div>
		</div>

		<!-- Additional skills badges -->
		<div class="mt-12 border-t border-rose-400/20 pt-8">
			<h4 class="font-sinistre text-lg text-rose-300 mb-4">Additional Competencies</h4>
			<div class="flex flex-wrap gap-3">
				<span class="font-mono text-xs text-gray-400 border border-gray-700 px-3 py-1.5 flex items-center gap-2">
					<span class="w-1.5 h-1.5 bg-rose-400 rounded-full"></span>
					GraphQL Certified
				</span>
				<span class="font-mono text-xs text-gray-400 border border-gray-700 px-3 py-1.5 flex items-center gap-2">
					<span class="w-1.5 h-1.5 bg-rose-400 rounded-full"></span>
					MongoDB University
				</span>
				<span class="font-mono text-xs text-gray-400 border border-gray-700 px-3 py-1.5 flex items-center gap-2">
					<span class="w-1.5 h-1.5 bg-rose-400 rounded-full"></span>
					Redis Certified
				</span>
				<span class="font-mono text-xs text-gray-400 border border-gray-700 px-3 py-1.5 flex items-center gap-2">
					<span class="w-1.5 h-1.5 bg-rose-400 rounded-full"></span>
					PostgreSQL Advanced
				</span>
				<span class="font-mono text-xs text-gray-400 border border-gray-700 px-3 py-1.5 flex items-center gap-2">
					<span class="w-1.5 h-1.5 bg-rose-400 rounded-full"></span>
					GitHub Actions
				</span>
			</div>
		</div>
	</div>
</section>
