---
---

<!-- Origin/About Section -->
<section id="origin" class="px-4 md:px-8 lg:px-16 py-24 border-b border-[#90c5ff14]">
	<div class="flex flex-col items-center lg:flex-row gap-12">
		<div class="flex-1">
			<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-8 flex items-center gap-4">
				<span class="font-oldturcic text-2xl md:text-3xl text-blue-400/30 leading-none">𐰋𐰃𐰠</span>
				Origin
				<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
			</h2>
			<div class="space-y-6 text-gray-300 text-lg leading-relaxed">
				<p>
					Full-Stack Software Engineer from the lands where ancient scripts once carved wisdom into stone. I carry the same precision into modern architecture.
				</p>
				<p>
					At <span class="text-blue-300">Deniz Egece Co. Ltd.</span>, I architected a streaming platform serving <span class="text-blue-300">17,000+ paid users</span> — from backend architecture and database design to payment systems and CI/CD automation.
				</p>
				<p>
					Currently an <span class="text-white">Honor Student</span> at the International University of Sarajevo, exploring the foundations of computing: C, Rust, JavaScript, and Linux.
				</p>
			</div>
		</div>
		<div class="flex-shrink-0 w-1/5">

			<!-- Summoning circle container -->
			<div class="aspect-square max-w-2xl mx-auto relative group">
				<!-- Outer circle decorations (base always spins, boost adds speed on hover) -->
				<div class="absolute inset-0 flex items-center justify-center pointer-events-none circle-boost">
					<div class="aspect-square w-full h-full scale-110 border border-blue-500/10 rounded-full circle-base"></div>
				</div>
				<div class="absolute inset-0 flex items-center justify-center pointer-events-none circle-boost-reverse">
					<div class="aspect-square w-full h-full scale-125 border border-indigo-500/10 rounded-full circle-base-reverse"></div>
				</div>

				<div class="absolute left-0 top-0 h-full w-full to-50% opacity-30 from-blue-600 to-transparent mix-blend-hard-light bg-radial-[circle_at_50%_50%,var(--tw-gradient-from)] group-hover:scale-150 duration-600 transition-all ease-out"></div>

				<!-- Central form (the ritual itself) -->
				<div class="relative p-8 rounded-full aspect-square flex flex-col items-center justify-center h-full w-full mx-auto backdrop-blur-xs">
					<img src="/favicon.svg" alt="Emblem" class="opacity-60 h-2/3 w-2/3" />
				</div>

				<!-- Turkic runes orbiting on a true circle -->
				<!-- orbit-base: always spins slowly | orbit-boost: adds speed on hover -->
				<!-- Each rune wrapped in a breathe div (absolute inset-0) that scales independently -->
				<div class="absolute inset-0 pointer-events-none orbit-base">
					<div class="absolute inset-0 orbit-boost *:absolute *:inset-0">
						<!-- Cardinal runes (0/90/180/270) -->
						<div class="breathe" style="--b:1.08; animation-duration:3.5s; animation-delay:0s"><span class="absolute left-[50%] top-[5%] -translate-x-1/2 -translate-y-1/2"><span class="counter-base"><span class="counter-boost rune text-2xl text-blue-400/20 group-hover:text-blue-400/35">𐰚</span></span></span></div>
						<div class="breathe" style="--b:1.04; animation-duration:4.2s; animation-delay:-1.7s"><span class="absolute left-[95%] top-[50%] -translate-x-1/2 -translate-y-1/2"><span class="counter-base"><span class="counter-boost rune text-2xl text-blue-400/20 group-hover:text-blue-400/35">𐰏</span></span></span></div>
						<div class="breathe" style="--b:1.07; animation-duration:3.8s; animation-delay:-0.9s"><span class="absolute left-[50%] top-[95%] -translate-x-1/2 -translate-y-1/2"><span class="counter-base"><span class="counter-boost rune text-2xl text-blue-400/20 group-hover:text-blue-400/35">𐰠</span></span></span></div>
						<div class="breathe" style="--b:1.05; animation-duration:4.5s; animation-delay:-2.3s"><span class="absolute left-[5%] top-[50%] -translate-x-1/2 -translate-y-1/2"><span class="counter-base"><span class="counter-boost rune text-2xl text-blue-400/20 group-hover:text-blue-400/35">𐱅</span></span></span></div>
						<!-- Diagonal runes (45/135/225/315) -->
						<div class="breathe" style="--b:1.06; animation-duration:5s; animation-delay:-0.4s"><span class="absolute left-[81.82%] top-[18.18%] -translate-x-1/2 -translate-y-1/2"><span class="counter-base"><span class="counter-boost rune text-xl text-indigo-400/15 group-hover:text-indigo-400/25">𐰃</span></span></span></div>
						<div class="breathe" style="--b:1.09; animation-duration:3.2s; animation-delay:-1.1s"><span class="absolute left-[81.82%] top-[81.82%] -translate-x-1/2 -translate-y-1/2"><span class="counter-base"><span class="counter-boost rune text-xl text-indigo-400/15 group-hover:text-indigo-400/25">𐰋</span></span></span></div>
						<div class="breathe" style="--b:1.05; animation-duration:4.8s; animation-delay:-2.8s"><span class="absolute left-[18.18%] top-[81.82%] -translate-x-1/2 -translate-y-1/2"><span class="counter-base"><span class="counter-boost rune text-xl text-indigo-400/15 group-hover:text-indigo-400/25">𐰼</span></span></span></div>
						<div class="breathe" style="--b:1.07; animation-duration:3.6s; animation-delay:-1.5s"><span class="absolute left-[18.18%] top-[18.18%] -translate-x-1/2 -translate-y-1/2"><span class="counter-base"><span class="counter-boost rune text-xl text-indigo-400/15 group-hover:text-indigo-400/25">𐰇</span></span></span></div>
					</div>
				</div>
			</div>

		</div>
	</div>
</section>

<style>
	@keyframes spin {
		from { transform: rotate(0deg); }
		to { transform: rotate(360deg); }
	}

	@keyframes counter-spin {
		from { transform: rotate(0deg); }
		to { transform: rotate(-360deg); }
	}

	@keyframes breathe {
		0%, 100% { scale: 1; }
		50% { scale: var(--b, 1.06); }
	}

	/* ── Base layer: always spinning slowly ── */
	.orbit-base          { animation: spin 120s linear infinite; }
	.circle-base         { animation: spin 120s linear infinite; }
	.circle-base-reverse { animation: spin 120s linear infinite reverse; }
	.counter-base        { animation: counter-spin 120s linear infinite; display: inline-block; }

	/* ── Boost layer: paused by default, resumes on hover (no jump) ── */
	.orbit-boost          { animation: spin 20s ease-in-out infinite; animation-play-state: paused; }
	.circle-boost         { animation: spin 20s ease-in-out infinite; animation-play-state: paused; }
	.circle-boost-reverse { animation: spin 20s ease-in-out infinite reverse; animation-play-state: paused; }
	.counter-boost        { animation: counter-spin 20s ease-in-out infinite; animation-play-state: paused; }

	.group:hover .orbit-boost,
	.group:hover .circle-boost,
	.group:hover .circle-boost-reverse,
	.group:hover .counter-boost {
		animation-play-state: running;
	}

	/* ── Rune shared visual styles ── */
	.breathe {
		animation: breathe ease-in-out infinite;
	}

	.rune {
		display: inline-block;
		font-family: var(--font-oldturcic);
		transition: color 0.4s, text-shadow 0.4s;
	}

	.group:hover .rune {
		text-shadow: 0 0 12px rgba(96, 165, 250, 0.3);
	}
</style>
