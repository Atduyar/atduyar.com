<!-- TODO: correct the writing -->
<!-- Origin/About Section -->
<section id="origin" class="px-4 md:px-8 lg:px-16 py-24 border-b border-[#90c5ff14]">
	<div class="flex flex-col items-center lg:flex-row gap-12">
		<div class="flex-1">
			<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-8 flex items-center gap-4">
				<span class="font-oldturcic text-2xl md:text-3xl text-blue-400/30 leading-none">𐰋𐰃𐰠</span>
				Origin
				<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
			</h2>
			<div class="space-y-6 text-gray-300 text-lg leading-relaxed">
				<p>
					A Full-Stack Software Engineer from the lands where ancient scripts once carved wisdom into stone. I carry the same precision into modern architecture.
				</p>
				<p>
					At <span class="text-blue-300">Deniz Egece Co. Ltd.</span>, I architected a streaming platform serving <span class="text-blue-300">17,000+ subscribers</span>, managing video transcoding pipelines, payment systems, and real-time analytics.
				</p>
				<p>
					Currently an <span class="text-white">Honor Student</span> at the International University of Sarajevo, diving deep into the roots of computing: C, Rust, and Linux systems.
				</p>
			</div>
		</div>
		<div class=" flex-shrink-0 w-1/5">

			<!-- Summoning circle container -->
			<div class="aspect-square max-w-2xl mx-auto relative group">
				<!-- Outer circle decorations -->
				<div class="absolute inset-0 flex items-center justify-center pointer-events-none">
					<div class="aspect-square w-full h-full scale-110 border border-blue-500/10 rounded-full animate-spin-very-slow"></div>
				</div>
				<div class="absolute inset-0 flex items-center justify-center pointer-events-none">
					<div class="aspect-square w-full h-full scale-125  border border-indigo-500/10 rounded-full animate-spin-very-slow" style="animation-direction: reverse;"></div>
				</div>

				<div class="absolute left-0 top-0 h-full w-full to-50% opacity-30 from-blue-600 to-transparent mix-blend-hard-light bg-radial-[circle_at_50%_50%,var(--tw-gradient-from)] group-hover:scale-150 transition-all ease-in-out"></div>

				<!-- Central form (the ritual itself) -->
				<div class="relative p-8 rounded-full aspect-square flex flex-col items-center justify-center h-full w-full mx-auto backdrop-blur-xs">
					<img src="/favicon.svg" alt="Emblem" class="opacity-60 h-2/3 w-2/3" />
				</div>

				<!-- TODO: More cirular -->
				<!-- TODO: Make them spin on group-hover -->
				<!-- Turkic runes around circle -->
				<div class="absolute inset-0 flex items-center justify-center pointer-events-none">
					<div class="relative w-full h-full">
						<span class="absolute font-oldturcic text-2xl text-blue-400/20 top-0 left-1/2 -translate-x-1/2">𐰚</span>
						<span class="absolute font-oldturcic text-2xl text-blue-400/20 bottom-0 left-1/2 -translate-x-1/2">𐰠</span>
						<span class="absolute font-oldturcic text-2xl text-blue-400/20 left-0 top-1/2 -translate-y-1/2">𐱅</span>
						<span class="absolute font-oldturcic text-2xl text-blue-400/20 right-0 top-1/2 -translate-y-1/2">𐰏</span>
						<span class="absolute font-oldturcic text-xl text-indigo-400/15 top-[15%] left-[15%]">𐰇</span>
						<span class="absolute font-oldturcic text-xl text-indigo-400/15 top-[15%] right-[15%]">𐰃</span>
						<span class="absolute font-oldturcic text-xl text-indigo-400/15 bottom-[15%] left-[15%]">𐰼</span>
						<span class="absolute font-oldturcic text-xl text-indigo-400/15 bottom-[15%] right-[15%]">𐰋</span>
					</div>
				</div>
			</div>

			{/*
			<!-- Decorative card with emblem and corner decorations -->
			<div class="aspect-square border border-[#90c5ff14] bg-gradient-to-br from-[#90c5ff05] to-transparent p-6 flex items-center justify-center relative">
				<img src="/favicon.svg" alt="Emblem" class="w-3/4 opacity-60" />
				<!-- Corner decorations -->
				<div class="absolute top-0 left-0 w-6 h-6 border-t border-l border-blue-400/40"></div>
				<div class="absolute top-0 right-0 w-6 h-6 border-t border-r border-blue-400/40"></div>
				<div class="absolute bottom-0 left-0 w-6 h-6 border-b border-l border-blue-400/40"></div>
				<div class="absolute bottom-0 right-0 w-6 h-6 border-b border-r border-blue-400/40"></div>
			</div>
			*/}

		</div>
	</div>
</section>
