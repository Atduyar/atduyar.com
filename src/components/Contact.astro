---
import BackgroundMarquee from "./BackgroundMarquee.astro";

interface Props {
	minimal?: boolean;
}

let { minimal = false } = Astro.props;
---

{ !minimal ?
<!-- Contact Section -->
<section id="contact" class="px-4 md:px-8 lg:px-16 py-24 relative group">
	<BackgroundMarquee class="group-has-[button:hover]:text-blue-300/30 duration-700 transition-all">
		𐰚𐰇𐰠𐱅𐰃𐰏𐰤: 𐰖𐰸: 𐰼𐰾𐰼: 𐰸𐰆𐰯: 𐰇𐰠𐱅𐰲𐰃: 𐰼𐱅𐰏𐰕: 𐰃𐰤𐰢: 𐰚𐰇𐰠𐱅𐰃𐰏𐰤: 𐰚𐰼𐰏𐰚: 𐰉𐰆𐰡𐰃: 𐰇𐰕𐰢: 𐰽𐰴𐰦𐰢: 𐰚𐰇𐰼𐰇𐰼: 𐰚𐰇𐰕𐰢: 𐰚𐰇𐰼𐰢𐰕: 𐱅𐰏: 𐰋𐰃𐰠𐰼: 𐰋𐰃𐰠𐰏𐰢: 𐰋𐰃𐰠𐰢𐰕: 𐱅𐰏: 𐰉𐰆𐰡𐰃: 𐰇𐰕𐰢: 𐰽𐰴𐰦𐰢: 𐰇𐰓: 𐱅𐰭𐰼𐰃: 𐰖𐰽𐰺: 𐰚𐰃𐰾𐰃: 𐰆𐰍𐰞𐰃: 𐰸𐰆𐰯: 𐰇𐰠𐰏𐰠𐰃: 𐱅𐰇𐰼𐰇𐰢𐰾:
	</BackgroundMarquee>

	<!-- Decorative Turkic border -->
	<div class="font-oldturcic text-xl text-blue-400/20 mb-6 tracking-[0.4em] leading-none text-center">
		𐰚𐰇𐰠𐱅𐰃𐰏𐰤
	</div>

	<h2 class="text-4xl sm:text-5xl lg:text-6xl font-sinistre mb-6 text-center">
		<span class="text-blue-300 glow-text-blue">Summon </span><span class="text-gray-600">Me</span>
	</h2>

	<p class="text-gray-400 text-lg mb-10 text-center max-w-xl mx-auto">
		Ready to build something remarkable? Reach out for collaborations, opportunities, or just to connect.
	</p>

	<div class="max-w-2xl mx-auto">
		<form class="space-y-6">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
				<div class="group">
					<label for="name" class="font-sinistre text-lg block mb-2">Your Name</label>
					<input type="text" id="name" class="w-full bg-transparent border-b-2 border-[#90c5ff20] focus:border-blue-400 outline-none py-2 transition-colors group-hover:border-[#90c5ff30]" placeholder="John Doe" />
				</div>
				<div class="group">
					<label for="email" class="font-sinistre text-lg block mb-2">Email</label>
					<input type="email" id="email" class="w-full bg-transparent border-b-2 border-[#90c5ff20] focus:border-blue-400 outline-none py-2 transition-colors group-hover:border-[#90c5ff30]" placeholder="john@example.com" />
				</div>
			</div>
			<div class="group">
				<label for="message" class="font-sinistre text-lg block mb-2">Message</label>
				<textarea id="message" rows="5" class="w-full bg-transparent border-b-2 border-[#90c5ff20] focus:border-blue-400 outline-none py-2 transition-colors resize-none group-hover:border-[#90c5ff30]" placeholder="Your message..."></textarea>
			</div>
			<div class="flex justify-center">
				<button type="submit" class="px-10 py-4 bg-blue-600/10 border border-blue-500/30 hover:bg-blue-600/20 hover:border-blue-400/50 hover:shadow-[0_0_30px_rgba(59,130,246,0.2)] transition-all font-sinistre text-xl rounded-sm group relative overflow-hidden">
					<span class="relative z-10 flex items-center gap-2">
						Transmit
						<span class="transition-transform group-hover:translate-x-1">&rarr;</span>
					</span>
					<div class="absolute inset-0 bg-gradient-to-r from-blue-500/0 via-blue-500/20 to-blue-500/0 -translate-x-full group-hover:translate-x-full transition-transform duration-500"></div>
				</button>
			</div>
		</form>

		<!-- Social links -->
		<div class="flex justify-center gap-10 mt-12">
			<a href="https://github.com/atduyar" target="_blank" rel="noopener" class="text-gray-500 hover:text-blue-300 hover:shadow-[0_0_10px_rgba(96,165,250,0.3)] transition-all flex items-center gap-2 px-3 py-1 rounded-sm">
				<span class="font-oldturcic text-lg leading-none">𐰋</span>
				<span>GitHub</span>
			</a>
			<a href="https://linkedin.com/in/atduyar" target="_blank" rel="noopener" class="text-gray-500 hover:text-blue-300 hover:shadow-[0_0_10px_rgba(96,165,250,0.3)] transition-all flex items-center gap-2 px-3 py-1 rounded-sm">
				<span class="font-oldturcic text-lg leading-none">𐰠</span>
				<span>LinkedIn</span>
			</a>
		</div>

		<div class="font-oldturcic text-xl text-blue-400/20 mt-12 tracking-[0.4em] leading-none text-center">
			𐰉𐰆𐰡𐰃 𐰇𐰕𐰢 𐰽𐰴𐰦𐰢
		</div>
	</div>

	<!-- Radial effect on hover -->
	<div class="select-none pointer-events-none absolute left-0 top-0 h-full w-full transition-[--x] duration-600 ease-out [--x:0%] group-has-[button:hover]:[--x:100%] to-30% opacity-30 from-blue-500 to-transparent mix-blend-hard-light bg-radial-[circle_at_50%_80%,var(--tw-gradient-from)_var(--x)] group-has-[button:hover]:opacity-60"></div>
</section>
:
<!-- Summon/Contact Section -->
<section id="contact" class="px-4 md:px-8 lg:px-16 py-24 relative group">
	<BackgroundMarquee class="group-has-[button:hover]:text-white duration-500 transition-all">
		𐰚𐰇𐰠𐱅𐰃𐰏𐰤: 𐰖𐰸: 𐰼𐰾𐰼: 𐰸𐰆𐰯: 𐰇𐰠𐱅𐰲𐰃: 𐰼𐱅𐰏𐰕: 𐰃𐰤𐰢: 𐰚𐰇𐰠𐱅𐰃𐰏𐰤: 𐰚𐰼𐰏𐰚: 𐰉𐰆𐰡𐰃: 𐰇𐰕𐰢: 𐰽𐰴𐰦𐰢: 𐰚𐰇𐰼𐰇𐰼: 𐰚𐰇𐰕𐰢: 𐰚𐰇𐰼𐰢𐰕: 𐱅𐰏: 𐰋𐰃𐰠𐰼: 𐰋𐰃𐰠𐰏𐰢: 𐰋𐰃𐰠𐰢𐰕: 𐱅𐰏: 𐰉𐰆𐰡𐰃: 𐰇𐰕𐰢: 𐰽𐰴𐰦𐰢: 𐰇𐰓: 𐱅𐰭𐰼𐰃: 𐰖𐰽𐰺: 𐰚𐰃𐰾𐰃: 𐰆𐰍𐰞𐰃: 𐰸𐰆𐰯: 𐰇𐰠𐰏𐰠𐰃: 𐱅𐰇𐰼𐰇𐰢𐰾:
	</BackgroundMarquee>

	<div class="max-w-2xl mx-auto text-center relative z-10">
		<!-- Decorative Turkic border top -->
		<div class="font-oldturcic text-xl text-blue-400/20 mb-6 tracking-[0.4em] leading-none">
			𐰚𐰇𐰠𐱅𐰃𐰏𐰤
		</div>

		<h2 class="font-sinistre text-4xl sm:text-5xl lg:text-6xl mb-8">
			<span class="text-blue-300">Summon</span> <span class="text-gray-600">Me</span>
		</h2>

		<p class="text-lg text-gray-500 mb-12">
			Ready to forge something legendary? Reach out for collaborations, opportunities, or tales of code.
		</p>

		<a href="mailto:atduyar@gmail.com" class="inline-block px-10 py-4 border-2 border-blue-400 text-blue-300 font-sinistre text-xl hover:bg-blue-400 hover:text-[#0d0e12] transition-all duration-300">
			Send Word
		</a>

		<div class="flex justify-center gap-10 mt-12">
			<a href="https://github.com/atduyar" target="_blank" rel="noopener" class="text-gray-600 hover:text-blue-300 transition-colors flex items-center gap-2">
				<span class="font-oldturcic text-lg leading-none">𐰋</span>
				<span>GitHub</span>
			</a>
			<a href="https://linkedin.com/in/atduyar" target="_blank" rel="noopener" class="text-gray-600 hover:text-blue-300 transition-colors flex items-center gap-2">
				<span class="font-oldturcic text-lg leading-none">𐰠</span>
				<span>LinkedIn</span>
			</a>
		</div>

		<!-- Bottom Turkic text -->
		<div class="font-oldturcic text-xl text-blue-400/20 mt-12 tracking-[0.4em] leading-none">
			𐰉𐰆𐰡𐰃 𐰇𐰕𐰢 𐰽𐰴𐰦𐰢
		</div>
	</div>

	<!-- Radial effect on hover -->
	<div class="select-none pointer-events-none absolute left-0 top-0 h-full w-full transition-[--x] duration-600 ease-out [--x:0%] group-has-[a:hover]:[--x:100%] to-30% opacity-50 from-blue-900 to-transparent mix-blend-hard-light bg-radial-[circle_at_50%_50%,var(--tw-gradient-from)_var(--x)] group-has-[a:hover]:opacity-100"></div>
</section>
}


