									<div class="text-xs text-gray-500">Assignment creation, submission, and progress tracking</div>
								</div>
								<div class="group/feature relative border border-indigo-400/10 hover:border-indigo-400/30 p-4 transition-all">
									<div class="absolute top-0 right-0 w-2 h-2 border-t border-r border-indigo-400/30"></div>
									<div class="font-mono text-xs text-indigo-400/60 mb-2">04</div>
									<div class="font-sinistre text-indigo-200 mb-1">Content Delivery</div>
									<div class="text-xs text-gray-500">Personalized resources based on consultation history</div>
								</div>
							</div>
						</div>

						<div class="flex flex-wrap gap-2 pt-4 border-t border-indigo-400/10">
							<span class="font-mono text-xs text-purple-400 border border-purple-400/30 px-3 py-1.5">C#</span>
							<span class="font-mono text-xs text-purple-400 border border-purple-400/30 px-3 py-1.5">.NET</span>
							<span class="font-mono text-xs text-purple-400 border border-purple-400/30 px-3 py-1.5">Clean Architecture</span>
							<span class="font-mono text-xs text-purple-400 border border-purple-400/30 px-3 py-1.5">PostgreSQL</span>
