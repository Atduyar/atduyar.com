---

<!-- Projects & Experience as Architectural Blueprints -->
<section id="projects" class="px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14] relative overflow-hidden">
	<!-- Blueprint grid background -->
	<div class="absolute inset-0 opacity-[0.06]" style="background-image: linear-gradient(rgba(96,165,250,0.4) 1px, transparent 1px), linear-gradient(90deg, rgba(96,165,250,0.4) 1px, transparent 1px); background-size: 20px 20px;"></div>
	<div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(96,165,250,0.3) 1px, transparent 1px), linear-gradient(90deg, rgba(96,165,250,0.3) 1px, transparent 1px); background-size: 100px 100px;"></div>

	<div class="relative z-10">
		<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-4 flex items-center gap-4">
			<span class="font-oldturcic text-2xl md:text-3xl text-blue-400/30 leading-none">𐰽𐰴</span>
			Projects
			<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
		</h2>
		<p class="text-gray-500 mb-12 max-w-2xl font-mono text-sm">FIELD DEPLOYMENTS // DENIZ EGECE CO. LTD. // 2022-2023</p>

		<!-- Blueprint style projects -->
		<div class="space-y-8">
			<!-- EgeceTV -->
			<div class="blueprint-item group relative border border-blue-400/20 hover:border-blue-400/50 transition-all duration-500 bg-[#0a0b0d]/50 overflow-hidden">
				<!-- Corner markers -->
				<div class="absolute -top-1 -left-1 w-4 h-4 border-t-2 border-l-2 border-blue-400/50 transition-all group-hover:w-6 group-hover:h-6 group-hover:border-blue-400"></div>
				<div class="absolute -top-1 -right-1 w-4 h-4 border-t-2 border-r-2 border-blue-400/50 transition-all group-hover:w-6 group-hover:h-6 group-hover:border-blue-400"></div>
				<div class="absolute -bottom-1 -left-1 w-4 h-4 border-b-2 border-l-2 border-blue-400/50 transition-all group-hover:w-6 group-hover:h-6 group-hover:border-blue-400"></div>
				<div class="absolute -bottom-1 -right-1 w-4 h-4 border-b-2 border-r-2 border-blue-400/50 transition-all group-hover:w-6 group-hover:h-6 group-hover:border-blue-400"></div>

				<!-- Header always visible -->
				<div class="p-6 cursor-pointer" onclick="toggleProject('egecetv')">
					<div class="flex flex-col lg:flex-row gap-6">
						<div class="flex-1">
							<div class="flex items-center gap-4 mb-4">
								<div class="font-mono text-xs text-blue-400/60 border border-blue-400/30 px-2 py-1">SECTION A</div>
								<h3 class="font-sinistre text-2xl text-blue-200 group-hover:text-blue-100 transition-colors">EgeceTV</h3>
								<div class="ml-auto flex items-center gap-2 text-blue-400/60 group-hover:text-blue-400 transition-colors">
									<span class="font-mono text-xs hidden sm:block">EXPAND SPECS</span>
									<svg id="icon-egecetv" class="w-5 h-5 transform transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
									</svg>
								</div>
							</div>
							<p class="text-gray-400 text-sm leading-relaxed">
								Health and education streaming platform built from the ground up. Led technical decision-making for backend architecture and database design, serving ~1,000 videos across 5 platforms.
							</p>
						</div>
						<!-- Quick stats -->
						<div class="lg:w-56 flex flex-col justify-center gap-2 font-mono text-xs text-gray-500 border-l border-blue-400/10 lg:pl-6">
							<div class="flex justify-between border-b border-dashed border-gray-700 pb-1">
								<span>Users:</span>
								<span class="text-blue-300">17,000+</span>
							</div>
							<div class="flex justify-between border-b border-dashed border-gray-700 pb-1">
								<span>Platforms:</span>
								<span class="text-emerald-300">5</span>
							</div>
							<div class="flex justify-between">
								<span>Role:</span>
								<span class="text-amber-300">Founding Eng.</span>
							</div>
						</div>
					</div>
				</div>

				<!-- Expandable Details -->
				<div id="details-egecetv" class="hidden border-t border-blue-400/20">
					<div class="p-6 space-y-6">
						<!-- Architecture Overview -->
						<div class="grid md:grid-cols-2 gap-6">
							<div class="space-y-4">
								<h4 class="font-sinistre text-lg text-blue-300 flex items-center gap-2">
									<span class="w-2 h-2 bg-blue-400 rounded-full"></span>
									System Architecture
								</h4>
								<div class="font-mono text-xs text-gray-400 space-y-2 bg-[#0d0e12] p-4 border border-blue-400/10">
									<div class="flex items-center gap-2">
										<span class="text-blue-400">[CDN]</span>
										<span class="text-gray-600">→</span>
										<span class="text-cyan-400">[Next.js]</span>
										<span class="text-gray-600">→</span>
										<span class="text-emerald-400">[GraphQL]</span>
									</div>
									<div class="flex items-center gap-2 pl-16">
										<span class="text-gray-600">↓</span>
									</div>
									<div class="flex items-center gap-2 pl-8">
										<span class="text-purple-400">[Prisma]</span>
										<span class="text-gray-600">→</span>
										<span class="text-amber-400">[MySQL]</span>
									</div>
								</div>
								<div class="text-sm text-gray-400 space-y-2">
									<p><span class="text-blue-300">Challenge:</span> Delivering seamless video streaming across web, iOS, Android, Android TV, and Apple TV platforms simultaneously.</p>
									<p><span class="text-emerald-300">Solution:</span> Implemented a unified GraphQL API with platform-specific resolvers and adaptive bitrate streaming via CDN integration.</p>
								</div>
							</div>
							<div class="space-y-4">
								<h4 class="font-sinistre text-lg text-blue-300 flex items-center gap-2">
									<span class="w-2 h-2 bg-blue-400 rounded-full"></span>
									Technical Specs
								</h4>
								<div class="grid grid-cols-2 gap-3 font-mono text-xs">
									<div class="border border-blue-400/20 p-3">
										<div class="text-gray-500 mb-1">Database</div>
										<div class="text-blue-300">MySQL 8.0</div>
										<div class="text-gray-600 text-[10px]">Prisma ORM</div>
									</div>
									<div class="border border-blue-400/20 p-3">
										<div class="text-gray-500 mb-1">API</div>
										<div class="text-blue-300">GraphQL</div>
										<div class="text-gray-600 text-[10px]">Apollo Server</div>
									</div>
									<div class="border border-blue-400/20 p-3">
										<div class="text-gray-500 mb-1">Frontend</div>
										<div class="text-blue-300">Next.js 14</div>
										<div class="text-gray-600 text-[10px]">App Router</div>
									</div>
									<div class="border border-blue-400/20 p-3">
										<div class="text-gray-500 mb-1">Deploy</div>
										<div class="text-blue-300">GitHub Actions</div>
										<div class="text-gray-600 text-[10px]">CI/CD Pipeline</div>
									</div>
								</div>
							</div>
						</div>

						<!-- Key Features -->
						<div class="border-t border-blue-400/10 pt-6">
							<h4 class="font-sinistre text-lg text-blue-300 mb-4 flex items-center gap-2">
								<span class="w-2 h-2 bg-blue-400 rounded-full"></span>
								Key Features Implemented
							</h4>
							<div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
								<div class="group/feature relative border border-blue-400/10 hover:border-blue-400/30 p-4 transition-all">
									<div class="absolute top-0 right-0 w-2 h-2 border-t border-r border-blue-400/30"></div>
									<div class="font-mono text-xs text-blue-400/60 mb-2">01</div>
									<div class="font-sinistre text-blue-200 mb-1">Adaptive Streaming</div>
									<div class="text-xs text-gray-500">HLS/DASH protocols with automatic quality switching based on bandwidth</div>
								</div>
								<div class="group/feature relative border border-blue-400/10 hover:border-blue-400/30 p-4 transition-all">
									<div class="absolute top-0 right-0 w-2 h-2 border-t border-r border-blue-400/30"></div>
									<div class="font-mono text-xs text-blue-400/60 mb-2">02</div>
									<div class="font-sinistre text-blue-200 mb-1">Multi-Platform</div>
									<div class="text-xs text-gray-500">Unified codebase approach with platform-specific optimizations</div>
								</div>
								<div class="group/feature relative border border-blue-400/10 hover:border-blue-400/30 p-4 transition-all">
									<div class="absolute top-0 right-0 w-2 h-2 border-t border-r border-blue-400/30"></div>
									<div class="font-mono text-xs text-blue-400/60 mb-2">03</div>
									<div class="font-sinistre text-blue-200 mb-1">Content CMS</div>
									<div class="text-xs text-gray-500">Custom admin panel for video management and categorization</div>
								</div>
								<div class="group/feature relative border border-blue-400/10 hover:border-blue-400/30 p-4 transition-all">
									<div class="absolute top-0 right-0 w-2 h-2 border-t border-r border-blue-400/30"></div>
									<div class="font-mono text-xs text-blue-400/60 mb-2">04</div>
									<div class="font-sinistre text-blue-200 mb-1">Analytics</div>
									<div class="text-xs text-gray-500">View tracking and user engagement metrics dashboard</div>
								</div>
							</div>
						</div>

						<!-- Tech Stack Tags -->
						<div class="flex flex-wrap gap-2 pt-4 border-t border-blue-400/10">
							<span class="font-mono text-xs text-cyan-400 border border-cyan-400/30 px-3 py-1.5">Next.js</span>
							<span class="font-mono text-xs text-cyan-400 border border-cyan-400/30 px-3 py-1.5">GraphQL</span>
							<span class="font-mono text-xs text-cyan-400 border border-cyan-400/30 px-3 py-1.5">MySQL</span>
							<span class="font-mono text-xs text-cyan-400 border border-cyan-400/30 px-3 py-1.5">Prisma.js</span>
							<span class="font-mono text-xs text-cyan-400 border border-cyan-400/30 px-3 py-1.5">Linux</span>
							<span class="font-mono text-xs text-cyan-400 border border-cyan-400/30 px-3 py-1.5">GitHub Actions</span>
						</div>
					</div>
				</div>
			</div>

			<!-- Distance Education Platform -->
			<div class="blueprint-item group relative border border-indigo-400/20 hover:border-indigo-400/50 transition-all duration-500 bg-[#0a0b0d]/50 overflow-hidden">
				<div class="absolute -top-1 -left-1 w-4 h-4 border-t-2 border-l-2 border-indigo-400/50 transition-all group-hover:w-6 group-hover:h-6 group-hover:border-indigo-400"></div>
				<div class="absolute -top-1 -right-1 w-4 h-4 border-t-2 border-r-2 border-indigo-400/50 transition-all group-hover:w-6 group-hover:h-6 group-hover:border-indigo-400"></div>
				<div class="absolute -bottom-1 -left-1 w-4 h-4 border-b-2 border-l-2 border-indigo-400/50 transition-all group-hover:w-6 group-hover:h-6 group-hover:border-indigo-400"></div>
				<div class="absolute -bottom-1 -right-1 w-4 h-4 border-b-2 border-r-2 border-indigo-400/50 transition-all group-hover:w-6 group-hover:h-6 group-hover:border-indigo-400"></div>

				<div class="p-6 cursor-pointer" onclick="toggleProject('distance')">
					<div class="flex flex-col lg:flex-row gap-6">
						<div class="flex-1">
							<div class="flex items-center gap-4 mb-4">
								<div class="font-mono text-xs text-indigo-400/60 border border-indigo-400/30 px-2 py-1">SECTION B</div>
								<h3 class="font-sinistre text-2xl text-indigo-200 group-hover:text-indigo-100 transition-colors">Distance Education Platform</h3>
								<div class="ml-auto flex items-center gap-2 text-indigo-400/60 group-hover:text-indigo-400 transition-colors">
									<span class="font-mono text-xs hidden sm:block">EXPAND SPECS</span>
									<svg id="icon-distance" class="w-5 h-5 transform transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
									</svg>
								</div>
							</div>
							<p class="text-gray-400 text-sm leading-relaxed">
								Platform connecting clients with psychologists and dietitians. Real-time video conferencing, reservation scheduling, homework tracking, and personalized content delivery.
							</p>
						</div>
						<div class="lg:w-56 flex flex-col justify-center gap-2 font-mono text-xs text-gray-500 border-l border-indigo-400/10 lg:pl-6">
							<div class="flex justify-between border-b border-dashed border-gray-700 pb-1">
								<span>Architecture:</span>
								<span class="text-indigo-300">Clean Arch</span>
							</div>
							<div class="flex justify-between border-b border-dashed border-gray-700 pb-1">
								<span>Team:</span>
								<span class="text-emerald-300">5 devs</span>
							</div>
							<div class="flex justify-between">
								<span>Platforms:</span>
								<span class="text-amber-300">iOS / Android</span>
							</div>
						</div>
					</div>
				</div>

				<div id="details-distance" class="hidden border-t border-indigo-400/20">
					<div class="p-6 space-y-6">
						<div class="grid md:grid-cols-2 gap-6">
							<div class="space-y-4">
								<h4 class="font-sinistre text-lg text-indigo-300 flex items-center gap-2">
									<span class="w-2 h-2 bg-indigo-400 rounded-full"></span>
									Clean Architecture Layers
								</h4>
								<div class="font-mono text-xs text-gray-400 space-y-2 bg-[#0d0e12] p-4 border border-indigo-400/10">
									<div class="flex items-center gap-2">
										<span class="text-indigo-400">[API]</span>
										<span class="text-gray-600">→</span>
										<span class="text-purple-400">[Application]</span>
									</div>
									<div class="flex items-center gap-2 pl-8">
										<span class="text-gray-600">↓</span>
									</div>
									<div class="flex items-center gap-2">
										<span class="text-cyan-400">[Domain]</span>
										<span class="text-gray-600">←</span>
										<span class="text-emerald-400">[Infrastructure]</span>
									</div>
								</div>
								<div class="text-sm text-gray-400 space-y-2">
									<p><span class="text-indigo-300">Challenge:</span> Building a HIPAA-compliant system with real-time video and sensitive health data.</p>
									<p><span class="text-emerald-300">Solution:</span> Clean Architecture with encrypted data at rest/transit, WebRTC for video, and strict access controls.</p>
								</div>
							</div>
							<div class="space-y-4">
								<h4 class="font-sinistre text-lg text-indigo-300 flex items-center gap-2">
									<span class="w-2 h-2 bg-indigo-400 rounded-full"></span>
									Infrastructure
								</h4>
								<div class="grid grid-cols-2 gap-3 font-mono text-xs">
									<div class="border border-indigo-400/20 p-3">
										<div class="text-gray-500 mb-1">Backend</div>
										<div class="text-indigo-300">.NET 8</div>
										<div class="text-gray-600 text-[10px]">Minimal APIs</div>
									</div>
									<div class="border border-indigo-400/20 p-3">
										<div class="text-gray-500 mb-1">Database</div>
										<div class="text-indigo-300">PostgreSQL</div>
										<div class="text-gray-600 text-[10px]">Entity Framework</div>
									</div>
									<div class="border border-indigo-400/20 p-3">
										<div class="text-gray-500 mb-1">Video</div>
										<div class="text-indigo-300">WebRTC</div>
										<div class="text-gray-600 text-[10px]">Custom Signaling</div>
									</div>
									<div class="border border-indigo-400/20 p-3">
										<div class="text-gray-500 mb-1">Cloud</div>
										<div class="text-indigo-300">AWS</div>
										<div class="text-gray-600 text-[10px]">ECS + S3</div>
									</div>
								</div>
							</div>
						</div>

						<div class="border-t border-indigo-400/10 pt-6">
							<h4 class="font-sinistre text-lg text-indigo-300 mb-4 flex items-center gap-2">
								<span class="w-2 h-2 bg-indigo-400 rounded-full"></span>
								Core Modules
							</h4>
							<div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
								<div class="group/feature relative border border-indigo-400/10 hover:border-indigo-400/30 p-4 transition-all">
									<div class="absolute top-0 right-0 w-2 h-2 border-t border-r border-indigo-400/30"></div>
									<div class="font-mono text-xs text-indigo-400/60 mb-2">01</div>
									<div class="font-sinistre text-indigo-200 mb-1">Video Consultation</div>
									<div class="text-xs text-gray-500">End-to-end encrypted WebRTC sessions with recording capability</div>
								</div>
								<div class="group/feature relative border border-indigo-400/10 hover:border-indigo-400/30 p-4 transition-all">
									<div class="absolute top-0 right-0 w-2 h-2 border-t border-r border-indigo-400/30"></div>
									<div class="font-mono text-xs text-indigo-400/60 mb-2">02</div>
									<div class="font-sinistre text-indigo-200 mb-1">Smart Scheduling</div>
									<div class="text-xs text-gray-500">Calendar integration with timezone handling and reminders</div>
								</div>
								<div class="group/feature relative border border-indigo-400/10 hover:border-indigo-400/30 p-4 transition-all">
									<div class="absolute top-0 right-0 w-2 h-2 border-t border-r border-indigo-400/30"></div>
									<div class="font-mono text-xs text-indigo-400/60 mb-2">03</div>
