---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="ATDUYAR" description="Ahmet Tarik Duyar - Kinetic Portfolio" bodyClass="bg-[#0f0f0f] text-white min-h-screen overflow-x-hidden cursor-default">
	<!-- Gradient orbs background -->
	<div class="fixed inset-0 pointer-events-none overflow-hidden">
		<div class="absolute top-0 left-1/4 w-[600px] h-[600px] bg-gradient-to-br from-violet-600/20 to-transparent rounded-full blur-[120px] animate-float-slow"></div>
		<div class="absolute bottom-0 right-1/4 w-[500px] h-[500px] bg-gradient-to-tl from-cyan-500/15 to-transparent rounded-full blur-[100px] animate-float-slow-reverse"></div>
		<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-gradient-radial from-fuchsia-500/5 to-transparent rounded-full"></div>
	</div>

	<main class="relative z-10">
		<!-- Sticky Nav -->
		<nav class="fixed top-0 left-0 right-0 z-50 px-8 py-6">
			<div class="max-w-7xl mx-auto flex justify-between items-center">
				<a href="#" class="font-sinistre text-2xl tracking-wider hover:text-violet-400 transition-colors">ATD</a>
				<div class="flex gap-8 text-sm tracking-widest uppercase">
					<a href="#work" class="hover:text-violet-400 transition-colors relative group">
						Work
						<span class="absolute -bottom-1 left-0 w-0 h-px bg-violet-400 group-hover:w-full transition-all"></span>
					</a>
					<a href="#about" class="hover:text-violet-400 transition-colors relative group">
						About
						<span class="absolute -bottom-1 left-0 w-0 h-px bg-violet-400 group-hover:w-full transition-all"></span>
					</a>
					<a href="#contact" class="hover:text-violet-400 transition-colors relative group">
						Contact
						<span class="absolute -bottom-1 left-0 w-0 h-px bg-violet-400 group-hover:w-full transition-all"></span>
					</a>
				</div>
			</div>
		</nav>

		<!-- Hero with kinetic text -->
		<section class="min-h-screen flex items-center justify-center relative px-8">
			<div class="text-center">
				<!-- Animated badge -->
				<div class="inline-flex items-center gap-3 px-4 py-2 rounded-full border border-white/10 bg-white/5 backdrop-blur-sm mb-12 animate-fade-down">
					<span class="w-2 h-2 bg-emerald-400 rounded-full animate-pulse"></span>
					<span class="text-sm tracking-wider uppercase">Available for work</span>
				</div>
				
				<!-- Giant kinetic name -->
				<h1 class="relative">
					<span class="block font-sinistre text-[18vw] md:text-[15vw] leading-[0.8] tracking-tighter">
						<span class="inline-block hover:animate-wiggle hover:text-violet-400 transition-colors cursor-pointer">A</span><span class="inline-block hover:animate-wiggle hover:text-cyan-400 transition-colors cursor-pointer">H</span><span class="inline-block hover:animate-wiggle hover:text-fuchsia-400 transition-colors cursor-pointer">M</span><span class="inline-block hover:animate-wiggle hover:text-amber-400 transition-colors cursor-pointer">E</span><span class="inline-block hover:animate-wiggle hover:text-emerald-400 transition-colors cursor-pointer">T</span>
					</span>
					<span class="block font-sinistre text-[18vw] md:text-[15vw] leading-[0.8] tracking-tighter bg-gradient-to-r from-violet-400 via-fuchsia-400 to-cyan-400 bg-clip-text text-transparent">
						TARIK
					</span>
					<span class="block font-sinistre text-[18vw] md:text-[15vw] leading-[0.8] tracking-tighter text-white/20 hover:text-white transition-colors duration-500">
						DUYAR
					</span>
				</h1>
				
				<!-- Role badge -->
				<div class="mt-16 flex flex-wrap justify-center gap-4">
					<span class="px-6 py-2 rounded-full border border-violet-500/30 bg-violet-500/10 text-violet-300 text-sm tracking-wider">Backend</span>
					<span class="px-6 py-2 rounded-full border border-cyan-500/30 bg-cyan-500/10 text-cyan-300 text-sm tracking-wider">Systems</span>
					<span class="px-6 py-2 rounded-full border border-fuchsia-500/30 bg-fuchsia-500/10 text-fuchsia-300 text-sm tracking-wider">Full-Stack</span>
				</div>
			</div>
			
			<!-- Scroll indicator -->
			<div class="absolute bottom-12 left-1/2 -translate-x-1/2 flex flex-col items-center gap-3 animate-bounce-slow">
				<span class="text-xs tracking-widest uppercase text-white/40">Scroll</span>
				<div class="w-px h-12 bg-gradient-to-b from-white/40 to-transparent"></div>
			</div>
		</section>

		<!-- About with parallax cards -->
		<section id="about" class="py-32 px-8">
			<div class="max-w-5xl mx-auto">
				<h2 class="font-sinistre text-6xl md:text-8xl mb-16 text-center">
					<span class="text-white/20">Building</span> <span class="bg-gradient-to-r from-violet-400 to-cyan-400 bg-clip-text text-transparent">Systems</span>
				</h2>
				
				<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
					<!-- Card 1 -->
					<div class="group relative p-8 rounded-2xl bg-gradient-to-br from-white/5 to-transparent border border-white/10 hover:border-violet-500/50 transition-all duration-500 overflow-hidden">
						<div class="absolute inset-0 bg-gradient-to-br from-violet-500/0 to-violet-500/10 opacity-0 group-hover:opacity-100 transition-opacity"></div>
						<div class="relative z-10">
							<div class="w-12 h-12 rounded-xl bg-violet-500/20 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
								<span class="text-2xl">&#9670;</span>
							</div>
							<h3 class="font-sinistre text-2xl mb-4">17,000+ Users</h3>
							<p class="text-white/60 leading-relaxed">Architected a streaming platform at Deniz Egece serving thousands of paid users with real-time video delivery.</p>
						</div>
					</div>
					
					<!-- Card 2 -->
					<div class="group relative p-8 rounded-2xl bg-gradient-to-br from-white/5 to-transparent border border-white/10 hover:border-cyan-500/50 transition-all duration-500 overflow-hidden">
						<div class="absolute inset-0 bg-gradient-to-br from-cyan-500/0 to-cyan-500/10 opacity-0 group-hover:opacity-100 transition-opacity"></div>
						<div class="relative z-10">
							<div class="w-12 h-12 rounded-xl bg-cyan-500/20 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
								<span class="text-2xl">&#9671;</span>
							</div>
							<h3 class="font-sinistre text-2xl mb-4">Honor Student</h3>
							<p class="text-white/60 leading-relaxed">Software Engineering at International University of Sarajevo. Deep focus on algorithms and system design.</p>
						</div>
					</div>
					
					<!-- Card 3 - Full width -->
					<div class="md:col-span-2 group relative p-8 rounded-2xl bg-gradient-to-r from-violet-500/10 via-fuchsia-500/10 to-cyan-500/10 border border-white/10 hover:border-fuchsia-500/50 transition-all duration-500 overflow-hidden">
						<div class="relative z-10">
							<h3 class="font-sinistre text-2xl mb-4">Technical Expertise</h3>
							<div class="flex flex-wrap gap-3">
								<span class="px-4 py-2 rounded-full bg-white/5 border border-white/10 text-white/70 text-sm hover:bg-white/10 hover:text-white transition-all cursor-default">Rust</span>
								<span class="px-4 py-2 rounded-full bg-white/5 border border-white/10 text-white/70 text-sm hover:bg-white/10 hover:text-white transition-all cursor-default">C</span>
								<span class="px-4 py-2 rounded-full bg-white/5 border border-white/10 text-white/70 text-sm hover:bg-white/10 hover:text-white transition-all cursor-default">Go</span>
								<span class="px-4 py-2 rounded-full bg-white/5 border border-white/10 text-white/70 text-sm hover:bg-white/10 hover:text-white transition-all cursor-default">TypeScript</span>
								<span class="px-4 py-2 rounded-full bg-white/5 border border-white/10 text-white/70 text-sm hover:bg-white/10 hover:text-white transition-all cursor-default">Node.js</span>
								<span class="px-4 py-2 rounded-full bg-white/5 border border-white/10 text-white/70 text-sm hover:bg-white/10 hover:text-white transition-all cursor-default">PostgreSQL</span>
								<span class="px-4 py-2 rounded-full bg-white/5 border border-white/10 text-white/70 text-sm hover:bg-white/10 hover:text-white transition-all cursor-default">Redis</span>
								<span class="px-4 py-2 rounded-full bg-white/5 border border-white/10 text-white/70 text-sm hover:bg-white/10 hover:text-white transition-all cursor-default">Docker</span>
								<span class="px-4 py-2 rounded-full bg-white/5 border border-white/10 text-white/70 text-sm hover:bg-white/10 hover:text-white transition-all cursor-default">Kubernetes</span>
								<span class="px-4 py-2 rounded-full bg-white/5 border border-white/10 text-white/70 text-sm hover:bg-white/10 hover:text-white transition-all cursor-default">Linux</span>
								<span class="px-4 py-2 rounded-full bg-white/5 border border-white/10 text-white/70 text-sm hover:bg-white/10 hover:text-white transition-all cursor-default">AWS</span>
								<span class="px-4 py-2 rounded-full bg-white/5 border border-white/10 text-white/70 text-sm hover:bg-white/10 hover:text-white transition-all cursor-default">FFmpeg</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Work section with hover reveals -->
		<section id="work" class="py-32 px-8">
			<div class="max-w-6xl mx-auto">
				<h2 class="font-sinistre text-6xl md:text-8xl mb-16 text-center">
					<span class="bg-gradient-to-r from-fuchsia-400 to-amber-400 bg-clip-text text-transparent">Work</span>
				</h2>
				
				<!-- Project 1 -->
				<div class="project-item group border-t border-white/10 py-12 hover:py-16 transition-all cursor-pointer">
					<div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
						<div class="flex-1">
							<span class="text-sm text-white/40 tracking-wider uppercase mb-2 block">Deniz Egece</span>
							<h3 class="font-sinistre text-4xl md:text-5xl group-hover:translate-x-4 transition-transform">
								<span class="group-hover:text-violet-400 transition-colors">Streaming Platform</span>
							</h3>
						</div>
						<div class="flex items-center gap-6">
							<span class="text-white/40">2023</span>
							<div class="w-12 h-12 rounded-full border border-white/20 flex items-center justify-center group-hover:bg-violet-500 group-hover:border-violet-500 transition-all">
								<span class="text-xl group-hover:rotate-45 transition-transform">&rarr;</span>
							</div>
						</div>
					</div>
					<div class="overflow-hidden max-h-0 group-hover:max-h-40 transition-all duration-500">
						<p class="text-white/60 mt-6 max-w-2xl">
							End-to-end video streaming architecture with transcoding pipelines, payment integrations, and analytics dashboard. Serving 17,000+ paid subscribers.
						</p>
					</div>
				</div>
				
				<!-- Project 2 -->
				<div class="project-item group border-t border-white/10 py-12 hover:py-16 transition-all cursor-pointer">
					<div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
						<div class="flex-1">
							<span class="text-sm text-white/40 tracking-wider uppercase mb-2 block">Personal</span>
							<h3 class="font-sinistre text-4xl md:text-5xl group-hover:translate-x-4 transition-transform">
								<span class="group-hover:text-cyan-400 transition-colors">Portfolio Website</span>
							</h3>
						</div>
						<div class="flex items-center gap-6">
							<span class="text-white/40">2024</span>
							<div class="w-12 h-12 rounded-full border border-white/20 flex items-center justify-center group-hover:bg-cyan-500 group-hover:border-cyan-500 transition-all">
								<span class="text-xl group-hover:rotate-45 transition-transform">&rarr;</span>
							</div>
						</div>
					</div>
					<div class="overflow-hidden max-h-0 group-hover:max-h-40 transition-all duration-500">
						<p class="text-white/60 mt-6 max-w-2xl">
							Custom portfolio featuring Sinistre variable font, Old Turkic script heritage elements, and crafted micro-interactions. Built with Astro and Tailwind.
						</p>
					</div>
				</div>
				
				<!-- Project 3 -->
				<div class="project-item group border-y border-white/10 py-12 hover:py-16 transition-all cursor-pointer">
					<div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
						<div class="flex-1">
							<span class="text-sm text-white/40 tracking-wider uppercase mb-2 block">Open Source</span>
							<h3 class="font-sinistre text-4xl md:text-5xl group-hover:translate-x-4 transition-transform">
								<span class="group-hover:text-fuchsia-400 transition-colors">Contributions</span>
							</h3>
						</div>
						<div class="flex items-center gap-6">
							<span class="text-white/40">Ongoing</span>
							<div class="w-12 h-12 rounded-full border border-white/20 flex items-center justify-center group-hover:bg-fuchsia-500 group-hover:border-fuchsia-500 transition-all">
								<span class="text-xl group-hover:rotate-45 transition-transform">&rarr;</span>
							</div>
						</div>
					</div>
					<div class="overflow-hidden max-h-0 group-hover:max-h-40 transition-all duration-500">
						<p class="text-white/60 mt-6 max-w-2xl">
							Active contributor to various open-source projects. Passionate about sharing knowledge and building community tools.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Contact with gradient text -->
		<section id="contact" class="py-32 px-8 relative">
			<div class="max-w-4xl mx-auto text-center">
				<h2 class="font-sinistre text-7xl md:text-9xl mb-8">
					<span class="bg-gradient-to-r from-violet-400 via-fuchsia-400 to-cyan-400 bg-clip-text text-transparent animate-gradient">
						Say Hello
					</span>
				</h2>
				<p class="text-xl text-white/60 mb-12 max-w-lg mx-auto">
					Got a project in mind? Let's build something extraordinary together.
				</p>
				
				<a href="mailto:contact@atduyar.com" class="group inline-flex items-center gap-4 px-10 py-5 rounded-full bg-gradient-to-r from-violet-600 to-fuchsia-600 hover:from-violet-500 hover:to-fuchsia-500 transition-all text-lg font-medium">
					<span>Get in Touch</span>
					<span class="group-hover:translate-x-2 transition-transform">&rarr;</span>
				</a>
				
				<div class="flex justify-center gap-8 mt-16">
					<a href="https://github.com/atduyar" target="_blank" rel="noopener" class="text-white/40 hover:text-white transition-colors">GitHub</a>
					<a href="https://linkedin.com/in/atduyar" target="_blank" rel="noopener" class="text-white/40 hover:text-white transition-colors">LinkedIn</a>
					<a href="mailto:contact@atduyar.com" class="text-white/40 hover:text-white transition-colors">Email</a>
				</div>
			</div>
		</section>

		<!-- Footer -->
		<footer class="py-8 px-8 border-t border-white/10">
			<div class="max-w-7xl mx-auto flex justify-between items-center text-sm text-white/40">
				<span>&copy; 2026 Ahmet Tarik Duyar</span>
				<span>Built with passion</span>
			</div>
		</footer>
	</main>
</BaseLayout>

<style>
	@keyframes float-slow {
		0%, 100% { transform: translateY(0) rotate(0deg); }
		50% { transform: translateY(-30px) rotate(5deg); }
	}
	
	@keyframes float-slow-reverse {
		0%, 100% { transform: translateY(0) rotate(0deg); }
		50% { transform: translateY(30px) rotate(-5deg); }
	}
	
	@keyframes wiggle {
		0%, 100% { transform: rotate(0deg); }
		25% { transform: rotate(-10deg); }
		75% { transform: rotate(10deg); }
	}
	
	@keyframes bounce-slow {
		0%, 100% { transform: translateX(-50%) translateY(0); }
		50% { transform: translateX(-50%) translateY(-10px); }
	}
	
	@keyframes fade-down {
		from { opacity: 0; transform: translateY(-20px); }
		to { opacity: 1; transform: translateY(0); }
	}
	
	@keyframes gradient {
		0%, 100% { background-position: 0% 50%; }
		50% { background-position: 100% 50%; }
	}
	
	.animate-float-slow {
		animation: float-slow 20s ease-in-out infinite;
	}
	
	.animate-float-slow-reverse {
		animation: float-slow-reverse 25s ease-in-out infinite;
	}
	
	.hover\:animate-wiggle:hover {
		animation: wiggle 0.3s ease-in-out;
	}
	
	.animate-bounce-slow {
		animation: bounce-slow 2s ease-in-out infinite;
	}
	
	.animate-fade-down {
		animation: fade-down 0.8s ease-out forwards;
	}
	
	.animate-gradient {
		background-size: 200% auto;
		animation: gradient 5s ease infinite;
	}
	
</style>
