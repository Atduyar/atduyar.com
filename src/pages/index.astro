					<div class="relative">
						<div class="flex items-start justify-between mb-4">
							<h4 class="font-sinistre text-3xl text-white group-hover:text-blue-300 transition-colors">NeuroevolutionFlappyBird</h4>
							<span class="font-oldturcic text-4xl opacity-20 text-gray-500 group-hover:opacity-100 group-hover:text-blue-300 transition-all duration-300">𐰖</span>
