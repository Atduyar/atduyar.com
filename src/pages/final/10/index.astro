---
import BackgroundMarquee from "../../../components/BackgroundMarquee.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout title="Ahmet Tarik Duyar" description="Full-Stack Software Engineer Portfolio" bodyClass="bg-[#0a0b0d] text-white w-screen overflow-x-hidden">
	<main class="bg-[#0d0e12] border-x border-[#90c5ff14] max-w-7xl mx-auto min-h-dvh relative">
		<!-- Subtle noise overlay -->
		<div class="fixed inset-0 pointer-events-none opacity-[0.015] z-50" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 256 256%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22n%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23n)%22/%3E%3C/svg%3E');"></div>
		
		<!-- Navigation -->
		<nav class="py-6 px-4 md:px-8 border-b border-[#90c5ff14] sticky top-0 bg-[#0d0e12]/90 backdrop-blur-sm z-40">
			<div class="flex justify-between items-center">
				<a href="#hero" class="group flex items-center gap-3">
					<div class="w-10 h-10 rounded-full border border-blue-400/30 flex items-center justify-center group-hover:border-blue-400/60 transition-colors relative overflow-hidden">
						<div class="absolute inset-0 bg-blue-500/10 group-hover:bg-blue-500/20 transition-colors"></div>
						<img src="/favicon.svg" alt="Logo" class="w-6 h-6 relative z-10" />
					</div>
					<span class="font-sinistre text-xl tracking-wide hidden sm:block">Atduyar</span>
				</a>
				<ul class="flex gap-3 md:gap-6 text-sm">
					<li><a href="#dossier" class="nav-link font-sinistre hover:text-blue-300 transition-all">Dossier</a></li>
					<li><a href="#armory" class="nav-link font-sinistre hover:text-blue-300 transition-all">Armory</a></li>
					<li><a href="#campaign" class="nav-link font-sinistre hover:text-blue-300 transition-all">Campaign</a></li>
					<li><a href="#ritual" class="nav-link font-sinistre px-4 py-1 border border-blue-500/30 hover:bg-blue-600/10 rounded-full">Summon</a></li>
				</ul>
			</div>
		</nav>

		<!-- Hero Section -->
		<section id="hero" class="min-h-[85vh] flex flex-col justify-center px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14] relative overflow-hidden">
			<div class="absolute inset-0">
				<div class="absolute top-1/4 left-1/4 w-[500px] h-[500px] bg-blue-500/10 rounded-full blur-[150px]"></div>
				<div class="absolute bottom-1/3 right-1/4 w-[400px] h-[400px] bg-indigo-500/10 rounded-full blur-[120px]"></div>
			</div>
			
			<div class="relative z-10">
				<p class="font-oldturcic text-blue-400/50 text-lg mb-4 tracking-[0.4em] animate-fade-in leading-none">𐰚𐰇𐰠𐱅𐰃𐰏𐰤</p>
				<h1 class="text-5xl sm:text-7xl lg:text-8xl xl:text-9xl font-sinistre leading-[0.9] mb-8">
					<span class="block animate-slide-up" style="animation-delay: 0.1s;">I'm Ahmet</span>
					<span class="block animate-slide-up" style="animation-delay: 0.2s;">
						<span class="text-blue-300">Tarik</span> Duyar
					</span>
				</h1>
				<p class="text-lg md:text-xl text-gray-400 max-w-xl animate-fade-in leading-relaxed" style="animation-delay: 0.5s;">
					Building robust backend architectures and scalable systems. 
					Passionate about C, Rust, and Linux.
				</p>
				<div class="flex gap-4 mt-10 animate-fade-in" style="animation-delay: 0.7s;">
					<a href="#campaign" class="group px-6 py-3 bg-blue-600/10 border border-blue-500/30 hover:bg-blue-600/20 hover:border-blue-400/50 transition-all font-sinistre text-lg rounded-sm">
						View Campaigns
					</a>
					<a href="#ritual" class="px-6 py-3 border border-[#90c5ff14] hover:border-[#90c5ff30] transition-all font-sinistre text-lg rounded-sm">
						Begin Ritual
					</a>
				</div>
			</div>
		</section>

		<!-- SECTION 1: THE DOSSIER - About as Classified File -->
		<section id="dossier" class="px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14] relative overflow-hidden">
			<!-- Paper texture background -->
			<div class="absolute inset-0 opacity-[0.02]" style="background: repeating-linear-gradient(0deg, transparent, transparent 28px, rgba(144,197,255,0.3) 28px, rgba(144,197,255,0.3) 29px);"></div>
			
			<div class="relative z-10">
				<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-4 flex items-center gap-4">
					<span class="font-oldturcic text-2xl md:text-3xl text-blue-400/30 leading-none">𐰋𐰃𐰠</span>
					The Dossier
					<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
				</h2>
				<p class="text-gray-500 mb-8">CLASSIFICATION: <span class="text-red-400 font-mono">CONFIDENTIAL</span></p>
				
				<!-- File folder container -->
				<div class="relative max-w-4xl">
					<!-- Folder tabs -->
					<div class="flex gap-2 mb-0">
						<div class="px-4 py-2 bg-amber-900/30 border border-amber-700/30 border-b-0 rounded-t-sm text-xs font-mono text-amber-300/80">PERSONNEL</div>
						<div class="px-4 py-2 bg-[#0d0e12] border border-[#90c5ff14] border-b-0 rounded-t-sm text-xs font-mono text-gray-500">CLASSIFIED</div>
					</div>
					
					<!-- Main file content -->
					<div class="border border-amber-700/20 bg-gradient-to-br from-amber-950/20 via-[#0d0e12] to-[#0d0e12] p-6 md:p-8 relative">
						<!-- Stamps -->
						<div class="absolute top-4 right-4 flex flex-col gap-2">
							<div class="border-2 border-red-500/40 text-red-400/60 text-xs font-mono px-3 py-1 rotate-[-8deg]">APPROVED</div>
							<div class="border-2 border-blue-500/40 text-blue-400/60 text-xs font-mono px-3 py-1 rotate-[4deg]">VERIFIED</div>
						</div>
						
						<!-- Subject header -->
						<div class="border-b border-amber-700/20 pb-4 mb-6">
							<div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
								<div>
									<span class="text-gray-500 font-mono text-xs">SUBJECT:</span>
									<p class="text-white font-sinistre">Ahmet Tarik Duyar</p>
								</div>
								<div>
									<span class="text-gray-500 font-mono text-xs">CODENAME:</span>
									<p class="text-blue-300 font-mono">ATDUYAR</p>
								</div>
								<div>
									<span class="text-gray-500 font-mono text-xs">STATUS:</span>
									<p class="text-emerald-400 font-mono">ACTIVE</p>
								</div>
								<div>
									<span class="text-gray-500 font-mono text-xs">CLEARANCE:</span>
									<p class="text-amber-300 font-mono">LEVEL 5</p>
								</div>
							</div>
						</div>
						
						<!-- Dossier content -->
						<div class="space-y-4 text-gray-300 leading-relaxed">
							<p>
								<span class="font-mono text-xs text-gray-500">PROFILE:</span><br/>
								Subject is a <span class="bg-amber-500/20 px-1">Full-Stack Software Engineer</span> with demonstrated expertise in 
								<span class="bg-blue-500/20 px-1">backend architectures</span>, <span class="bg-blue-500/20 px-1">database design</span>, 
								and <span class="bg-blue-500/20 px-1">systems programming</span>.
							</p>
							<p>
								<span class="font-mono text-xs text-gray-500">OPERATIONS:</span><br/>
								Successfully deployed streaming infrastructure at <span class="text-white">Deniz Egece Co. Ltd.</span>, 
								serving <span class="text-blue-300 font-mono">17,000+</span> users. Platform achieved 
								<span class="text-emerald-400">99.9% uptime</span> under high-load conditions.
							</p>
							<p>
								<span class="font-mono text-xs text-gray-500">EDUCATION:</span><br/>
								Currently enrolled at <span class="text-white">International University of Sarajevo</span> — 
								Software Engineering program. Status: <span class="text-amber-300">Honor Student</span>.
							</p>
							<p class="text-gray-500 italic text-sm">
								[REDACTED SECTIONS AVAILABLE WITH LEVEL 7 CLEARANCE]
							</p>
						</div>
						
						<!-- File metadata footer -->
						<div class="mt-8 pt-4 border-t border-amber-700/20 flex justify-between items-center text-xs font-mono text-gray-600">
							<span>FILE#: ATD-2024-0527</span>
							<span>LAST UPDATED: 2026.02</span>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- SECTION 2: THE ARMORY - Skills as RPG Inventory -->
		<section id="armory" class="px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14] relative overflow-hidden">
			<div class="relative z-10">
				<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-4 flex items-center gap-4">
					<span class="font-oldturcic text-2xl md:text-3xl text-blue-400/30 leading-none">𐰽𐰴</span>
					The Armory
					<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
				</h2>
				<p class="text-gray-500 mb-8">Equipped abilities and their rarity classifications.</p>
				
				<!-- Inventory grid -->
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
					<!-- LEGENDARY: Backend -->
					<div class="inventory-item group relative border-2 border-amber-500/40 bg-gradient-to-br from-amber-500/10 via-[#0d0e12] to-[#0d0e12] p-4 hover:border-amber-400/60 transition-all">
						<div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-amber-500 via-yellow-400 to-amber-500 opacity-60"></div>
						<div class="flex items-start gap-4">
							<div class="w-16 h-16 border border-amber-500/40 bg-amber-500/10 flex items-center justify-center text-2xl rounded-sm">
								⚔️
							</div>
							<div class="flex-1">
								<div class="flex items-center gap-2 mb-1">
									<span class="text-xs font-mono text-amber-400 bg-amber-500/20 px-2 py-0.5 rounded-full">LEGENDARY</span>
								</div>
								<h3 class="font-sinistre text-lg text-amber-200">Backend Mastery</h3>
								<p class="text-xs text-gray-500 mt-1">Node.js, Rust, Go, Python</p>
							</div>
						</div>
						<div class="mt-4 space-y-2">
							<div class="flex justify-between text-xs">
								<span class="text-gray-500">+45 Scalability</span>
								<span class="text-gray-500">+38 Performance</span>
							</div>
							<div class="flex justify-between text-xs">
								<span class="text-gray-500">+42 Reliability</span>
								<span class="text-amber-400">+50 API Design</span>
							</div>
						</div>
						<!-- Shine effect -->
						<div class="absolute inset-0 bg-gradient-to-r from-transparent via-amber-400/10 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000 pointer-events-none"></div>
					</div>
					
					<!-- EPIC: Database -->
					<div class="inventory-item group relative border-2 border-purple-500/40 bg-gradient-to-br from-purple-500/10 via-[#0d0e12] to-[#0d0e12] p-4 hover:border-purple-400/60 transition-all">
						<div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-purple-500 via-fuchsia-400 to-purple-500 opacity-60"></div>
						<div class="flex items-start gap-4">
							<div class="w-16 h-16 border border-purple-500/40 bg-purple-500/10 flex items-center justify-center text-2xl rounded-sm">
								🗄️
							</div>
							<div class="flex-1">
								<div class="flex items-center gap-2 mb-1">
									<span class="text-xs font-mono text-purple-400 bg-purple-500/20 px-2 py-0.5 rounded-full">EPIC</span>
								</div>
								<h3 class="font-sinistre text-lg text-purple-200">Database Sorcery</h3>
								<p class="text-xs text-gray-500 mt-1">PostgreSQL, Redis, MongoDB</p>
							</div>
						</div>
						<div class="mt-4 space-y-2">
							<div class="flex justify-between text-xs">
								<span class="text-gray-500">+40 Query Speed</span>
								<span class="text-gray-500">+35 Data Integrity</span>
							</div>
							<div class="flex justify-between text-xs">
								<span class="text-purple-400">+45 Optimization</span>
								<span class="text-gray-500">+30 Scaling</span>
							</div>
						</div>
						<div class="absolute inset-0 bg-gradient-to-r from-transparent via-purple-400/10 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000 pointer-events-none"></div>
					</div>
					
					<!-- EPIC: Systems -->
					<div class="inventory-item group relative border-2 border-cyan-500/40 bg-gradient-to-br from-cyan-500/10 via-[#0d0e12] to-[#0d0e12] p-4 hover:border-cyan-400/60 transition-all">
						<div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-cyan-500 via-teal-400 to-cyan-500 opacity-60"></div>
						<div class="flex items-start gap-4">
							<div class="w-16 h-16 border border-cyan-500/40 bg-cyan-500/10 flex items-center justify-center text-2xl rounded-sm">
								🔧
							</div>
							<div class="flex-1">
								<div class="flex items-center gap-2 mb-1">
									<span class="text-xs font-mono text-cyan-400 bg-cyan-500/20 px-2 py-0.5 rounded-full">EPIC</span>
								</div>
								<h3 class="font-sinistre text-lg text-cyan-200">Systems Craft</h3>
								<p class="text-xs text-gray-500 mt-1">C, Rust, Linux</p>
							</div>
						</div>
						<div class="mt-4 space-y-2">
							<div class="flex justify-between text-xs">
								<span class="text-gray-500">+38 Memory Mgmt</span>
								<span class="text-cyan-400">+42 Low-Level</span>
							</div>
							<div class="flex justify-between text-xs">
								<span class="text-gray-500">+35 Concurrency</span>
								<span class="text-gray-500">+30 Kernel</span>
							</div>
						</div>
						<div class="absolute inset-0 bg-gradient-to-r from-transparent via-cyan-400/10 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000 pointer-events-none"></div>
					</div>
					
					<!-- RARE: Frontend -->
					<div class="inventory-item group relative border-2 border-blue-500/40 bg-gradient-to-br from-blue-500/10 via-[#0d0e12] to-[#0d0e12] p-4 hover:border-blue-400/60 transition-all">
						<div class="absolute top-0 left-0 right-0 h-1 bg-blue-500 opacity-60"></div>
						<div class="flex items-start gap-4">
							<div class="w-16 h-16 border border-blue-500/40 bg-blue-500/10 flex items-center justify-center text-2xl rounded-sm">
								🎨
							</div>
							<div class="flex-1">
								<div class="flex items-center gap-2 mb-1">
									<span class="text-xs font-mono text-blue-400 bg-blue-500/20 px-2 py-0.5 rounded-full">RARE</span>
								</div>
								<h3 class="font-sinistre text-lg text-blue-200">Frontend Arts</h3>
								<p class="text-xs text-gray-500 mt-1">React, TypeScript, Tailwind</p>
							</div>
						</div>
						<div class="mt-4 space-y-2">
							<div class="flex justify-between text-xs">
								<span class="text-gray-500">+30 UI/UX</span>
								<span class="text-blue-400">+35 Components</span>
							</div>
						</div>
					</div>
					
					<!-- RARE: DevOps -->
					<div class="inventory-item group relative border-2 border-emerald-500/40 bg-gradient-to-br from-emerald-500/10 via-[#0d0e12] to-[#0d0e12] p-4 hover:border-emerald-400/60 transition-all">
						<div class="absolute top-0 left-0 right-0 h-1 bg-emerald-500 opacity-60"></div>
						<div class="flex items-start gap-4">
							<div class="w-16 h-16 border border-emerald-500/40 bg-emerald-500/10 flex items-center justify-center text-2xl rounded-sm">
								☁️
							</div>
							<div class="flex-1">
								<div class="flex items-center gap-2 mb-1">
									<span class="text-xs font-mono text-emerald-400 bg-emerald-500/20 px-2 py-0.5 rounded-full">RARE</span>
								</div>
								<h3 class="font-sinistre text-lg text-emerald-200">Cloud Warfare</h3>
								<p class="text-xs text-gray-500 mt-1">Docker, K8s, AWS</p>
							</div>
						</div>
						<div class="mt-4 space-y-2">
							<div class="flex justify-between text-xs">
								<span class="text-emerald-400">+32 Deployment</span>
								<span class="text-gray-500">+28 Scaling</span>
							</div>
						</div>
					</div>
					
					<!-- UNCOMMON: Streaming -->
					<div class="inventory-item group relative border-2 border-gray-500/40 bg-gradient-to-br from-gray-500/10 via-[#0d0e12] to-[#0d0e12] p-4 hover:border-gray-400/60 transition-all">
						<div class="absolute top-0 left-0 right-0 h-1 bg-gray-500 opacity-60"></div>
						<div class="flex items-start gap-4">
							<div class="w-16 h-16 border border-gray-500/40 bg-gray-500/10 flex items-center justify-center text-2xl rounded-sm">
								📺
							</div>
							<div class="flex-1">
								<div class="flex items-center gap-2 mb-1">
									<span class="text-xs font-mono text-gray-400 bg-gray-500/20 px-2 py-0.5 rounded-full">UNCOMMON</span>
								</div>
								<h3 class="font-sinistre text-lg text-gray-200">Stream Forge</h3>
								<p class="text-xs text-gray-500 mt-1">FFmpeg, Real-time</p>
							</div>
						</div>
						<div class="mt-4 space-y-2">
							<div class="flex justify-between text-xs">
								<span class="text-gray-400">+25 Transcoding</span>
								<span class="text-gray-500">+20 Delivery</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- SECTION 3: THE CAMPAIGN MAP - Projects as Conquered Territories -->
		<section id="campaign" class="px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14] relative overflow-hidden">
			<!-- Map grid background -->
			<div class="absolute inset-0 opacity-[0.04]" style="background-image: linear-gradient(rgba(144,197,255,0.3) 1px, transparent 1px), linear-gradient(90deg, rgba(144,197,255,0.3) 1px, transparent 1px); background-size: 50px 50px;"></div>
			
			<div class="relative z-10">
				<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-4 flex items-center gap-4">
					<span class="font-oldturcic text-2xl md:text-3xl text-blue-400/30 leading-none">𐰼𐱅</span>
					The Campaign Map
					<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
				</h2>
				<p class="text-gray-500 mb-8">Territories conquered and campaigns ongoing.</p>
				
				<!-- Map visualization -->
				<div class="relative">
					<!-- Campaign territories -->
					<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
						<!-- Territory 1: Streaming Platform - CONQUERED -->
						<div class="territory group relative">
							<div class="absolute -top-3 -left-3 w-8 h-8 bg-emerald-500 rounded-full flex items-center justify-center shadow-[0_0_20px_rgba(52,211,153,0.5)] z-10">
								<span class="text-sm">🏴</span>
							</div>
							<div class="border-2 border-emerald-500/30 bg-gradient-to-br from-emerald-500/5 to-transparent p-6 hover:border-emerald-400/50 transition-all">
								<div class="flex items-center gap-2 mb-3">
									<span class="font-mono text-xs text-emerald-400 bg-emerald-500/20 px-2 py-0.5 rounded-full">CONQUERED</span>
									<span class="text-xs text-gray-500">Territory #001</span>
								</div>
								<h3 class="font-sinistre text-2xl text-emerald-200 mb-2">Streaming Platform</h3>
								<p class="text-sm text-gray-400 mb-4">The fortress of Deniz Egece Co. Ltd. Full control established over video transcoding pipelines and payment systems.</p>
								
								<!-- Territory stats -->
								<div class="grid grid-cols-3 gap-4 text-center border-t border-emerald-500/20 pt-4">
									<div>
										<div class="text-xl font-sinistre text-emerald-300">17K+</div>
										<div class="text-xs text-gray-500">Citizens</div>
									</div>
									<div>
										<div class="text-xl font-sinistre text-emerald-300">99.9%</div>
										<div class="text-xs text-gray-500">Stability</div>
									</div>
									<div>
										<div class="text-xl font-sinistre text-emerald-300">2023</div>
										<div class="text-xs text-gray-500">Year</div>
									</div>
								</div>
								
								<!-- Route line decoration -->
								<div class="absolute -right-6 top-1/2 w-6 h-0.5 bg-gradient-to-r from-emerald-500/50 to-transparent hidden lg:block"></div>
							</div>
						</div>
						
						<!-- Territory 2: Portfolio - ACTIVE SIEGE -->
						<div class="territory group relative">
							<div class="absolute -top-3 -left-3 w-8 h-8 bg-amber-500 rounded-full flex items-center justify-center shadow-[0_0_20px_rgba(245,158,11,0.5)] z-10 animate-pulse">
								<span class="text-sm">⚔️</span>
							</div>
							<div class="border-2 border-amber-500/30 bg-gradient-to-br from-amber-500/5 to-transparent p-6 hover:border-amber-400/50 transition-all">
								<div class="flex items-center gap-2 mb-3">
									<span class="font-mono text-xs text-amber-400 bg-amber-500/20 px-2 py-0.5 rounded-full animate-pulse">ACTIVE SIEGE</span>
									<span class="text-xs text-gray-500">Territory #002</span>
								</div>
								<h3 class="font-sinistre text-2xl text-amber-200 mb-2">Personal Portfolio</h3>
								<p class="text-sm text-gray-400 mb-4">The citadel of atduyar.com. Custom fortifications with Sinistre typography and Turkic heritage elements.</p>
								
