<script>
	// Terminal functionality
	const commands = {
		help: `Available commands:
  whoami     - Learn about me
  skills     - View my technical skills
  projects   - See my projects
  contact    - Get contact information
  fortune    - Get a random dev wisdom
  neofetch   - System information
  clear      - Clear the terminal
  sudo rm -rf / - Don't even try it`,
		
		whoami: `Ahmet Tarik Duyar
Full-Stack Software Engineer
Location: Sarajevo, Bosnia
Status: Open for opportunities`,
		
		skills: `TECHNICAL SKILLS
├── Backend: Node.js, Rust, Go, Python
├── Database: PostgreSQL, Redis, MongoDB
├── Systems: C, Linux, Networking
├── Frontend: React, TypeScript, Tailwind
└── DevOps: Docker, K8s, AWS, Cloudflare`,
		
		projects: `FEATURED PROJECTS
[1] Streaming Platform @ Deniz Egece Co.
    └── 17K+ users, 99.9% uptime
[2] Personal Portfolio @ atduyar.com
    └── Custom design, Astro + Tailwind`,
		
		contact: `CONTACT INFORMATION
Email:    contact@atduyar.com
GitHub:   github.com/atduyar
LinkedIn: linkedin.com/in/atduyar`,
		
		fortune: () => {
			const fortunes = [
				'"There are only two hard things in CS: cache invalidation and naming things."',
				'"It works on my machine." - Every developer ever',
				'"Give a man a program, frustrate him for a day. Teach a man to program, frustrate him for a lifetime."',
				'"A good programmer is someone who always looks both ways before crossing a one-way street."',
				'"The best code is no code at all."',
				'"First, solve the problem. Then, write the code."',
				'"Weeks of coding can save you hours of planning."',
			];
			return fortunes[Math.floor(Math.random() * fortunes.length)];
		},
		
		neofetch: `       ▄▄▄▄▄▄▄       atduyar@portfolio
      ██▀▀▀▀▀██      ─────────────────
     ██      ██      OS: Arch btw
     ██  ▄▄  ██      Kernel: 6.7.0-arch1
     ██ ████ ██      Shell: zsh 5.9
      ████████       Editor: Neovim
       ▀████▀        Languages: Rust, C, TS
                     Coffee: Always`,
		
		'sudo rm -rf /': 'Nice try. Permission denied. Also, why would you do that?',
		
		'exit': 'You cannot escape. The terminal is eternal.',
		
		'ls': `drwxr-xr-x  projects/
drwxr-xr-x  skills/
-rw-r--r--  about.md
-rw-r--r--  contact.txt`,
	};

	document.addEventListener('DOMContentLoaded', () => {
		const input = document.getElementById('terminal-input');
		const history = document.getElementById('command-history');
		
		if (input && history) {
			input.addEventListener('keydown', (e) => {
				if (e.key === 'Enter') {
					const cmd = input.value.trim().toLowerCase();
					if (cmd) {
						// Add command to history
						const cmdLine = document.createElement('div');
						cmdLine.innerHTML = `<span class="text-emerald-400">$</span> ${cmd}`;
						history.appendChild(cmdLine);
						
						// Get response
						let response;
						if (cmd === 'clear') {
							history.innerHTML = '';
							input.value = '';
							return;
						} else if (commands[cmd]) {
							response = typeof commands[cmd] === 'function' ? commands[cmd]() : commands[cmd];
						} else {
							response = `Command not found: ${cmd}. Type 'help' for available commands.`;
						}
						
						// Add response to history
						const responseLine = document.createElement('pre');
						responseLine.className = 'text-gray-400 text-xs mt-1 mb-3 whitespace-pre-wrap';
						responseLine.textContent = response;
						history.appendChild(responseLine);
						
						// Clear input and scroll
						input.value = '';
						history.scrollTop = history.scrollHeight;
					}
				}
			});
		}
	});

	// Helper to run command from hint buttons
	function runCommand(cmd) {
		const input = document.getElementById('terminal-input');
		if (input) {
			input.value = cmd;
			input.dispatchEvent(new KeyboardEvent('keydown', { key: 'Enter' }));
		}
	}
</script>

