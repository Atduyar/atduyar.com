---
import BackgroundMarquee from "../../../components/BackgroundMarquee.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout title="Ahmet Tarik Duyar" description="Full-Stack Software Engineer Portfolio" bodyClass="bg-[#0a0b0d] text-white w-screen overflow-x-hidden">
	<main class="bg-[#0d0e12] border-x border-[#90c5ff14] max-w-7xl mx-auto min-h-dvh relative">
		<!-- Subtle noise overlay -->
		<div class="fixed inset-0 pointer-events-none opacity-[0.015] z-50" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 256 256%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22n%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23n)%22/%3E%3C/svg%3E');"></div>
		
		<!-- Navigation -->
		<nav class="py-6 px-4 md:px-8 border-b border-[#90c5ff14] sticky top-0 bg-[#0d0e12]/90 backdrop-blur-sm z-40">
			<div class="flex justify-between items-center">
				<a href="#hero" class="group flex items-center gap-3">
					<div class="w-10 h-10 rounded-full border border-blue-400/30 flex items-center justify-center group-hover:border-blue-400/60 transition-colors relative overflow-hidden">
						<div class="absolute inset-0 bg-blue-500/10 group-hover:bg-blue-500/20 transition-colors"></div>
						<img src="/favicon.svg" alt="Logo" class="w-6 h-6 relative z-10" />
					</div>
					<span class="font-sinistre text-xl tracking-wide hidden sm:block">Atduyar</span>
				</a>
				<ul class="flex gap-3 md:gap-6 text-sm">
					<li><a href="#chronicle" class="nav-link font-sinistre hover:text-blue-300 transition-all">Chronicle</a></li>
					<li><a href="#casefile" class="nav-link font-sinistre hover:text-blue-300 transition-all">Case File</a></li>
					<li><a href="#terminal" class="nav-link font-sinistre hover:text-blue-300 transition-all">Terminal</a></li>
					<li><a href="#beacon" class="nav-link font-sinistre px-4 py-1 border border-blue-500/30 hover:bg-blue-600/10 rounded-full">Signal</a></li>
				</ul>
			</div>
		</nav>

		<!-- Hero Section -->
		<section id="hero" class="min-h-[85vh] flex flex-col justify-center px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14] relative overflow-hidden">
			<div class="absolute inset-0">
				<div class="absolute top-1/4 left-1/4 w-[500px] h-[500px] bg-blue-500/10 rounded-full blur-[150px]"></div>
				<div class="absolute bottom-1/3 right-1/4 w-[400px] h-[400px] bg-indigo-500/10 rounded-full blur-[120px]"></div>
			</div>
			
			<div class="relative z-10">
				<p class="font-oldturcic text-blue-400/50 text-lg mb-4 tracking-[0.4em] animate-fade-in leading-none">𐰚𐰇𐰠𐱅𐰃𐰏𐰤</p>
				<h1 class="text-5xl sm:text-7xl lg:text-8xl xl:text-9xl font-sinistre leading-[0.9] mb-8">
					<span class="block animate-slide-up" style="animation-delay: 0.1s;">I'm Ahmet</span>
					<span class="block animate-slide-up" style="animation-delay: 0.2s;">
						<span class="text-blue-300">Tarik</span> Duyar
					</span>
				</h1>
				<p class="text-lg md:text-xl text-gray-400 max-w-xl animate-fade-in leading-relaxed" style="animation-delay: 0.5s;">
					Building robust backend architectures and scalable systems. 
					Passionate about C, Rust, and Linux.
				</p>
				<div class="flex gap-4 mt-10 animate-fade-in" style="animation-delay: 0.7s;">
					<a href="#casefile" class="group px-6 py-3 bg-blue-600/10 border border-blue-500/30 hover:bg-blue-600/20 hover:border-blue-400/50 transition-all font-sinistre text-lg rounded-sm">
						View Case Files
					</a>
					<a href="#beacon" class="px-6 py-3 border border-[#90c5ff14] hover:border-[#90c5ff30] transition-all font-sinistre text-lg rounded-sm">
						Send Signal
					</a>
				</div>
			</div>
		</section>

		<!-- SECTION 1: THE CHRONICLE - Blog as Newspaper -->
		<section id="chronicle" class="px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14] relative overflow-hidden">
			<div class="relative z-10">
				<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-4 flex items-center gap-4">
					<span class="font-oldturcic text-2xl md:text-3xl text-blue-400/30 leading-none">𐰋𐰃𐰠</span>
					The Chronicle
					<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
				</h2>
				<p class="text-gray-500 mb-8 font-mono text-sm">DISPATCHES FROM THE ENGINEERING FRONT</p>
				
				<!-- Newspaper layout -->
				<div class="border border-[#90c5ff14] bg-[#0a0b0d]">
					<!-- Masthead -->
					<div class="border-b-4 border-double border-[#90c5ff20] px-6 py-4 text-center">
						<h3 class="font-sinistre text-4xl tracking-[0.2em] text-blue-100">THE DEVELOPER TIMES</h3>
						<div class="flex justify-center gap-8 mt-2 text-xs font-mono text-gray-500">
							<span>EST. 2022</span>
							<span>SARAJEVO EDITION</span>
							<span>VOL. III, NO. 27</span>
						</div>
					</div>
					
					<!-- Articles grid -->
					<div class="grid grid-cols-1 md:grid-cols-12 gap-0 divide-y md:divide-y-0 md:divide-x divide-[#90c5ff14]">
						<!-- Lead article -->
						<article class="md:col-span-7 p-6">
							<span class="text-xs font-mono text-blue-400 mb-2 block">FEATURED</span>
							<h4 class="font-sinistre text-2xl mb-3 leading-tight hover:text-blue-300 transition-colors cursor-pointer">
								Why Rust Changed How I Think About Memory Safety
							</h4>
							<p class="text-sm text-gray-400 leading-relaxed mb-4 first-letter:text-4xl first-letter:font-sinistre first-letter:float-left first-letter:mr-2 first-letter:text-blue-300">
								After years of writing C and dealing with segmentation faults at 3 AM, discovering Rust felt like finding a map in a maze. The borrow checker, initially frustrating, became a trusted companion that catches mistakes before they become production incidents.
							</p>
							<p class="text-sm text-gray-500 leading-relaxed mb-4">
								In this article, I explore the mental shift required to embrace ownership semantics and how it has influenced my approach to system design across all languages.
							</p>
							<div class="flex items-center justify-between text-xs text-gray-600">
								<span>5 min read</span>
								<a href="#" class="text-blue-400 hover:text-blue-300 transition-colors">Read full article →</a>
							</div>
						</article>
						
						<!-- Side articles -->
						<div class="md:col-span-5 divide-y divide-[#90c5ff14]">
							<article class="p-6">
								<span class="text-xs font-mono text-gray-500 mb-2 block">SYSTEMS</span>
								<h4 class="font-sinistre text-lg mb-2 leading-tight hover:text-blue-300 transition-colors cursor-pointer">
									Building a Custom Linux Kernel Module: Lessons Learned
								</h4>
								<p class="text-xs text-gray-500 leading-relaxed">
									What happens when you decide to dive into kernel space for the first time...
								</p>
								<span class="text-xs text-gray-600 mt-2 block">3 min read</span>
							</article>
							
							<article class="p-6">
								<span class="text-xs font-mono text-gray-500 mb-2 block">ARCHITECTURE</span>
								<h4 class="font-sinistre text-lg mb-2 leading-tight hover:text-blue-300 transition-colors cursor-pointer">
									Scaling to 17K Users: Database Decisions That Mattered
								</h4>
								<p class="text-xs text-gray-500 leading-relaxed">
									Not all indexes are created equal. A retrospective on the streaming platform...
								</p>
								<span class="text-xs text-gray-600 mt-2 block">7 min read</span>
							</article>
							
							<article class="p-6">
								<span class="text-xs font-mono text-gray-500 mb-2 block">OPINION</span>
								<h4 class="font-sinistre text-lg mb-2 leading-tight hover:text-blue-300 transition-colors cursor-pointer">
									The Case for Learning C in 2026
								</h4>
								<p class="text-xs text-gray-500 leading-relaxed">
									In an age of high-level abstractions, understanding the machine still matters...
								</p>
								<span class="text-xs text-gray-600 mt-2 block">4 min read</span>
							</article>
						</div>
					</div>
					
					<!-- Footer ticker -->
					<div class="border-t border-[#90c5ff14] bg-[#90c5ff05] px-6 py-2 overflow-hidden">
						<div class="flex whitespace-nowrap animate-scroll-ticker text-xs text-gray-500">
							<span class="px-8">NEW: PostgreSQL 17 Deep Dive Coming Soon</span>
							<span class="px-8">TUTORIAL: Async Rust Patterns</span>
							<span class="px-8">REVIEW: Neovim vs Helix for Rust Development</span>
							<span class="px-8">GUIDE: Zero-Downtime Deployments</span>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- SECTION 2: CASE FILE - Project Deep Dive -->
		<section id="casefile" class="px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14] relative overflow-hidden">
			<div class="relative z-10">
				<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-4 flex items-center gap-4">
					<span class="font-oldturcic text-2xl md:text-3xl text-blue-400/30 leading-none">𐰼𐱅</span>
					Case File
					<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
				</h2>
				<p class="text-gray-500 mb-8">Detailed analysis of a major engineering undertaking.</p>
				
				<!-- Case Study: Streaming Platform -->
				<div class="border border-[#90c5ff20] bg-[#0a0b0d]">
					<!-- Case header -->
					<div class="bg-gradient-to-r from-blue-900/20 to-transparent border-b border-[#90c5ff14] px-8 py-6">
						<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
							<div>
								<span class="font-mono text-xs text-blue-400 bg-blue-500/20 px-2 py-1 rounded-full">CASE STUDY</span>
								<h3 class="font-sinistre text-3xl mt-3 text-blue-100">Streaming Platform</h3>
								<p class="text-gray-400 mt-1">Deniz Egece Co. Ltd. | 2023-Present</p>
							</div>
							<div class="flex gap-6 text-center">
								<div>
									<div class="text-3xl font-sinistre text-blue-300">17K+</div>
									<div class="text-xs text-gray-500">Users</div>
								</div>
								<div>
									<div class="text-3xl font-sinistre text-emerald-300">99.9%</div>
									<div class="text-xs text-gray-500">Uptime</div>
								</div>
								<div>
									<div class="text-3xl font-sinistre text-amber-300">40%</div>
									<div class="text-xs text-gray-500">Faster</div>
								</div>
							</div>
						</div>
					</div>
					
					<!-- Case body -->
					<div class="p-8 space-y-8">
						<!-- The Challenge -->
						<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
							<div class="lg:col-span-4">
								<div class="sticky top-24">
									<h4 class="font-sinistre text-xl text-red-300 mb-2 flex items-center gap-2">
										<span class="w-8 h-px bg-red-400/50"></span>
										The Challenge
									</h4>
								</div>
							</div>
							<div class="lg:col-span-8">
								<p class="text-gray-300 leading-relaxed mb-4">
									The company needed a complete streaming solution capable of handling thousands of concurrent users with minimal latency. The existing infrastructure was fragmented, with video processing happening on unreliable third-party services.
								</p>
								<ul class="space-y-2 text-sm text-gray-400">
									<li class="flex items-start gap-2">
										<span class="text-red-400 mt-1">—</span>
										<span>No unified video transcoding pipeline</span>
									</li>
									<li class="flex items-start gap-2">
										<span class="text-red-400 mt-1">—</span>
										<span>Payment system scattered across multiple providers</span>
									</li>
									<li class="flex items-start gap-2">
										<span class="text-red-400 mt-1">—</span>
										<span>Zero visibility into user behavior and system health</span>
									</li>
								</ul>
							</div>
						</div>
						
						<!-- The Solution -->
						<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 pt-8 border-t border-[#90c5ff10]">
							<div class="lg:col-span-4">
								<h4 class="font-sinistre text-xl text-emerald-300 mb-2 flex items-center gap-2">
									<span class="w-8 h-px bg-emerald-400/50"></span>
									The Solution
								</h4>
							</div>
							<div class="lg:col-span-8">
								<p class="text-gray-300 leading-relaxed mb-4">
									I designed and implemented a unified platform from scratch, taking ownership of the entire stack from database schema to deployment pipelines.
								</p>
								<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-6">
									<div class="border border-[#90c5ff14] p-4 bg-[#90c5ff05]">
										<h5 class="font-sinistre text-emerald-200 mb-2">Video Pipeline</h5>
										<p class="text-xs text-gray-400">Custom FFmpeg wrapper with adaptive bitrate encoding, thumbnail generation, and HLS packaging.</p>
									</div>
									<div class="border border-[#90c5ff14] p-4 bg-[#90c5ff05]">
										<h5 class="font-sinistre text-emerald-200 mb-2">Payment Hub</h5>
										<p class="text-xs text-gray-400">Unified payment abstraction supporting multiple providers with automatic failover.</p>
									</div>
									<div class="border border-[#90c5ff14] p-4 bg-[#90c5ff05]">
										<h5 class="font-sinistre text-emerald-200 mb-2">Analytics Engine</h5>
										<p class="text-xs text-gray-400">Real-time dashboard tracking user engagement, revenue, and system metrics.</p>
									</div>
									<div class="border border-[#90c5ff14] p-4 bg-[#90c5ff05]">
										<h5 class="font-sinistre text-emerald-200 mb-2">Auth System</h5>
										<p class="text-xs text-gray-400">Multi-platform authentication with JWT tokens and session management.</p>
									</div>
								</div>
							</div>
						</div>
						
						<!-- Tech Stack -->
						<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 pt-8 border-t border-[#90c5ff10]">
							<div class="lg:col-span-4">
								<h4 class="font-sinistre text-xl text-blue-300 mb-2 flex items-center gap-2">
									<span class="w-8 h-px bg-blue-400/50"></span>
									Architecture
								</h4>
							</div>
							<div class="lg:col-span-8">
								<!-- Architecture diagram -->
								<div class="border border-[#90c5ff14] p-6 bg-[#0d0e12] font-mono text-xs">
									<pre class="text-gray-400 overflow-x-auto">
┌─────────────┐     ┌─────────────┐     ┌─────────────┐
│   Client    │────▶│   CDN/LB    │────▶│   Node.js   │
│  (Web/App)  │     │ Cloudflare  │     │   Backend   │
└─────────────┘     └─────────────┘     └──────┬──────┘
                                               │
                    ┌──────────────────────────┼──────────────────────────┐
                    │                          │                          │
              ┌─────▼─────┐            ┌───────▼───────┐          ┌───────▼───────┐
              │ PostgreSQL│            │  Redis Cache  │          │    FFmpeg     │
              │    (DB)   │            │   (Sessions)  │          │  (Transcode)  │
              └───────────┘            └───────────────┘          └───────────────┘
									</pre>
								</div>
								<div class="flex flex-wrap gap-2 mt-4">
									<span class="px-3 py-1 text-xs border border-[#90c5ff20] bg-[#90c5ff08] rounded-full">Node.js</span>
									<span class="px-3 py-1 text-xs border border-[#90c5ff20] bg-[#90c5ff08] rounded-full">PostgreSQL</span>
									<span class="px-3 py-1 text-xs border border-[#90c5ff20] bg-[#90c5ff08] rounded-full">Redis</span>
									<span class="px-3 py-1 text-xs border border-[#90c5ff20] bg-[#90c5ff08] rounded-full">FFmpeg</span>
									<span class="px-3 py-1 text-xs border border-[#90c5ff20] bg-[#90c5ff08] rounded-full">Docker</span>
									<span class="px-3 py-1 text-xs border border-[#90c5ff20] bg-[#90c5ff08] rounded-full">Cloudflare</span>
								</div>
							</div>
						</div>
						
						<!-- Results -->
						<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 pt-8 border-t border-[#90c5ff10]">
							<div class="lg:col-span-4">
								<h4 class="font-sinistre text-xl text-amber-300 mb-2 flex items-center gap-2">
									<span class="w-8 h-px bg-amber-400/50"></span>
									Results
								</h4>
							</div>
							<div class="lg:col-span-8">
								<div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
									<div class="text-center p-4 border border-amber-500/20 bg-amber-500/5">
										<div class="text-2xl font-sinistre text-amber-300">17,000+</div>
										<div class="text-xs text-gray-500 mt-1">Paid Users</div>
									</div>
									<div class="text-center p-4 border border-amber-500/20 bg-amber-500/5">
										<div class="text-2xl font-sinistre text-amber-300">99.9%</div>
										<div class="text-xs text-gray-500 mt-1">Uptime</div>
									</div>
									<div class="text-center p-4 border border-amber-500/20 bg-amber-500/5">
										<div class="text-2xl font-sinistre text-amber-300">40%</div>
										<div class="text-xs text-gray-500 mt-1">Faster Load</div>
									</div>
									<div class="text-center p-4 border border-amber-500/20 bg-amber-500/5">
										<div class="text-2xl font-sinistre text-amber-300">3</div>
										<div class="text-xs text-gray-500 mt-1">Platforms</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- SECTION 3: THE TERMINAL - Fun Interactive Area -->
		<section id="terminal" class="px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14] relative overflow-hidden">
			<div class="relative z-10">
				<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-4 flex items-center gap-4">
					<span class="font-oldturcic text-2xl md:text-3xl text-blue-400/30 leading-none">𐰽𐰴</span>
					The Terminal
					<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
				</h2>
				<p class="text-gray-500 mb-8">Try some commands. Not all paths lead somewhere useful.</p>
				
				<!-- Terminal window -->
				<div class="max-w-3xl mx-auto">
					<div class="border border-[#90c5ff20] rounded-t-lg overflow-hidden">
						<!-- Terminal header -->
						<div class="bg-[#1a1b1f] px-4 py-2 flex items-center gap-2">
							<div class="w-3 h-3 rounded-full bg-red-500/80"></div>
							<div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
							<div class="w-3 h-3 rounded-full bg-green-500/80"></div>
							<span class="ml-4 font-mono text-xs text-gray-500">atduyar@portfolio:~</span>
						</div>
						
						<!-- Terminal body -->
						<div class="bg-[#0a0b0d] p-6 font-mono text-sm min-h-[400px]" id="terminal-body">
							<div class="terminal-output space-y-2 text-gray-300">
								<p class="text-emerald-400">Welcome to atduyar's terminal v1.0.0</p>
								<p class="text-gray-500">Type 'help' to see available commands.</p>
								<p class="text-gray-500">---</p>
								<br/>
								<div class="command-history" id="command-history"></div>
							</div>
							
							<!-- Input line -->
							<div class="flex items-center gap-2 mt-4">
								<span class="text-emerald-400">$</span>
								<input 
									type="text" 
									id="terminal-input" 
									class="flex-1 bg-transparent outline-none text-gray-100 caret-emerald-400"
									placeholder="type a command..."
									autocomplete="off"
								/>
								<span class="animate-blink text-emerald-400">_</span>
							</div>
						</div>
					</div>
					
					<!-- Command hints -->
					<div class="bg-[#1a1b1f] border border-t-0 border-[#90c5ff20] rounded-b-lg px-4 py-3">
						<div class="flex flex-wrap gap-4 text-xs font-mono text-gray-500">
							<span class="hover:text-blue-300 cursor-pointer" onclick="runCommand('help')">help</span>
							<span class="hover:text-blue-300 cursor-pointer" onclick="runCommand('whoami')">whoami</span>
							<span class="hover:text-blue-300 cursor-pointer" onclick="runCommand('skills')">skills</span>
							<span class="hover:text-blue-300 cursor-pointer" onclick="runCommand('projects')">projects</span>
							<span class="hover:text-blue-300 cursor-pointer" onclick="runCommand('contact')">contact</span>
							<span class="hover:text-blue-300 cursor-pointer" onclick="runCommand('fortune')">fortune</span>
							<span class="hover:text-blue-300 cursor-pointer" onclick="runCommand('clear')">clear</span>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- SECTION 4: THE STACK - Tech Stack as Geological Layers -->
		<section id="stack" class="px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14] relative overflow-hidden">
			<div class="relative z-10">
				<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-4 flex items-center gap-4">
					<span class="font-oldturcic text-2xl md:text-3xl text-blue-400/30 leading-none">𐰇𐰕</span>
					The Stack
					<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
				</h2>
				<p class="text-gray-500 mb-8">Layers of technology, from bedrock to surface.</p>
				
				<!-- Geological stack -->
				<div class="max-w-3xl mx-auto space-y-0">
					<!-- Surface: Frontend -->
					<div class="stratum group relative">
						<div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-emerald-400 to-emerald-600"></div>
