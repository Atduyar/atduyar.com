---
import BackgroundMarquee from "../../../components/BackgroundMarquee.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout title="Ahmet Tarik Duyar" description="Full-Stack Software Engineer Portfolio" bodyClass="bg-[#0c0c0c] text-[#e8e8e8] w-screen overflow-x-hidden font-mono selection:bg-[#00ff88] selection:text-[#0c0c0c]">
	<!-- Grid overlay -->
	<div class="fixed inset-0 pointer-events-none z-10 opacity-[0.03]" style="background-image: linear-gradient(#00ff88 1px, transparent 1px), linear-gradient(90deg, #00ff88 1px, transparent 1px); background-size: 60px 60px;"></div>
	
	<main class="max-w-[1400px] mx-auto min-h-dvh relative">
		<!-- Navigation -->
		<nav class="py-4 px-4 md:px-8 border-b border-[#2a2a2a] sticky top-0 bg-[#0c0c0c]/95 backdrop-blur-sm z-40">
			<div class="flex justify-between items-center">
				<a href="#hero" class="group flex items-center gap-3">
					<div class="flex items-center gap-2">
						<span class="text-[#00ff88]">&gt;</span>
						<span class="font-sinistre text-xl tracking-tight">atduyar</span>
						<span class="w-2 h-5 bg-[#00ff88] animate-blink"></span>
					</div>
				</a>
				<ul class="flex gap-1 md:gap-2 text-sm">
					<li><a href="#about" class="nav-link px-3 py-2 hover:bg-[#00ff88] hover:text-[#0c0c0c] transition-colors">[about]</a></li>
					<li><a href="#skills" class="nav-link px-3 py-2 hover:bg-[#00ff88] hover:text-[#0c0c0c] transition-colors">[skills]</a></li>
					<li><a href="#work" class="nav-link px-3 py-2 hover:bg-[#00ff88] hover:text-[#0c0c0c] transition-colors">[work]</a></li>
					<li><a href="#contact" class="nav-link px-3 py-2 bg-[#00ff88] text-[#0c0c0c] hover:bg-[#00cc6a] transition-colors">[contact]</a></li>
				</ul>
			</div>
		</nav>

		<!-- Hero Section -->
		<section id="hero" class="min-h-[90vh] flex items-center px-4 md:px-8 py-20 border-b border-[#2a2a2a] relative overflow-hidden">
			<!-- Geometric shapes -->
			<div class="absolute right-0 top-0 w-1/2 h-full pointer-events-none hidden lg:block">
				<div class="absolute top-20 right-20 w-32 h-32 border border-[#00ff88]/30 rotate-45 animate-shape-drift"></div>
				<div class="absolute top-40 right-48 w-48 h-48 border border-[#2a2a2a] rotate-12 animate-shape-drift" style="animation-delay: -2s;"></div>
				<div class="absolute bottom-32 right-32 w-24 h-24 bg-[#00ff88]/10 rotate-[30deg] animate-shape-drift" style="animation-delay: -4s;"></div>
				<div class="absolute top-1/2 right-1/4 w-4 h-4 bg-[#00ff88]"></div>
			</div>
			
			<div class="relative z-10 max-w-3xl">
				<div class="text-sm text-[#666] mb-6 font-mono animate-type-in">
					<span class="text-[#00ff88]">$</span> whoami
				</div>
				
				<h1 class="text-4xl sm:text-6xl lg:text-7xl font-sinistre leading-[1.1] mb-6">
					<span class="block animate-line-reveal" style="animation-delay: 0.2s;">
						<span class="text-[#666]">const</span> developer <span class="text-[#00ff88]">=</span>
					</span>
					<span class="block animate-line-reveal" style="animation-delay: 0.4s;">
						<span class="text-[#00ff88]">"</span>Ahmet Tarik<span class="text-[#00ff88]">"</span>;
					</span>
				</h1>
				
				<div class="text-lg md:text-xl text-[#888] mb-10 leading-relaxed animate-fade-in" style="animation-delay: 0.8s;">
					<p class="mb-4">
						<span class="text-[#00ff88]">//</span> Full-Stack Software Engineer
					</p>
					<p>
						Building robust backend systems and scalable architectures. Passionate about C, Rust, and Linux internals.
					</p>
				</div>
				
				<div class="flex flex-wrap gap-4 animate-fade-in" style="animation-delay: 1s;">
					<a href="#work" class="px-6 py-3 bg-[#00ff88] text-[#0c0c0c] font-bold hover:bg-[#00cc6a] transition-colors flex items-center gap-2">
						<span>view_work()</span>
						<span>&rarr;</span>
					</a>
					<a href="#contact" class="px-6 py-3 border border-[#2a2a2a] hover:border-[#00ff88] transition-colors">
						init_contact()
					</a>
				</div>
			</div>
		</section>

		<!-- About Section -->
		<section id="about" class="px-4 md:px-8 py-20 border-b border-[#2a2a2a]">
			<div class="grid lg:grid-cols-12 gap-12">
				<div class="lg:col-span-4">
					<div class="sticky top-24">
						<p class="text-[#666] text-sm mb-2">01</p>
						<h2 class="text-3xl md:text-4xl font-sinistre mb-4">
							<span class="text-[#00ff88]">&lt;</span>about<span class="text-[#00ff88]">/&gt;</span>
						</h2>
						<div class="w-16 h-1 bg-[#00ff88]"></div>
					</div>
				</div>
				
				<div class="lg:col-span-8 space-y-8">
					<div class="grid md:grid-cols-2 gap-8">
						<div class="p-6 border border-[#2a2a2a] hover:border-[#00ff88]/50 transition-colors">
							<p class="text-[#666] text-sm mb-4 font-mono">// background</p>
							<p class="text-[#aaa] leading-relaxed">
								Full-Stack Software Engineer with professional experience in backend architectures, database design, and critical systems.
							</p>
						</div>
						<div class="p-6 border border-[#2a2a2a] hover:border-[#00ff88]/50 transition-colors">
							<p class="text-[#666] text-sm mb-4 font-mono">// experience</p>
							<p class="text-[#aaa] leading-relaxed">
								At <span class="text-white">Deniz Egece Co.</span>, architected streaming platform serving <span class="text-[#00ff88]">17,000+</span> paid users.
							</p>
						</div>
						<div class="p-6 border border-[#2a2a2a] hover:border-[#00ff88]/50 transition-colors">
							<p class="text-[#666] text-sm mb-4 font-mono">// education</p>
							<p class="text-[#aaa] leading-relaxed">
								<span class="text-white">Honor Student</span> in Software Engineering at International University of Sarajevo.
							</p>
						</div>
						<div class="p-6 border border-[#2a2a2a] hover:border-[#00ff88]/50 transition-colors">
							<p class="text-[#666] text-sm mb-4 font-mono">// focus</p>
							<p class="text-[#aaa] leading-relaxed">
								Deep into <span class="text-[#00ff88]">C</span>, <span class="text-[#00ff88]">Rust</span>, <span class="text-[#00ff88]">TypeScript</span>, and <span class="text-[#00ff88]">Linux</span> systems.
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Skills Section -->
		<section id="skills" class="px-4 md:px-8 py-20 border-b border-[#2a2a2a]">
			<div class="grid lg:grid-cols-12 gap-12">
				<div class="lg:col-span-4">
					<div class="sticky top-24">
						<p class="text-[#666] text-sm mb-2">02</p>
						<h2 class="text-3xl md:text-4xl font-sinistre mb-4">
							<span class="text-[#00ff88]">&lt;</span>skills<span class="text-[#00ff88]">/&gt;</span>
						</h2>
						<div class="w-16 h-1 bg-[#00ff88]"></div>
					</div>
				</div>
				
				<div class="lg:col-span-8">
					<div class="space-y-4">
						{[
							{ name: "Backend Development", tech: "Node.js, Rust, Go, Python", level: 95 },
							{ name: "Database Design", tech: "PostgreSQL, Redis, MongoDB", level: 90 },
							{ name: "Systems Programming", tech: "C, Rust, Linux", level: 85 },
							{ name: "Frontend Development", tech: "React, TypeScript, Tailwind", level: 80 },
							{ name: "DevOps & Cloud", tech: "Docker, K8s, AWS, Cloudflare", level: 85 },
							{ name: "Streaming Tech", tech: "FFmpeg, Real-time systems", level: 90 }
						].map((skill, i) => (
							<div class="group p-4 border border-[#2a2a2a] hover:border-[#00ff88]/50 transition-all">
								<div class="flex justify-between items-start mb-3">
									<div>
										<p class="text-lg font-sinistre mb-1">{skill.name}</p>
										<p class="text-[#666] text-sm">{skill.tech}</p>
									</div>
									<span class="text-[#00ff88] font-mono text-sm">{skill.level}%</span>
								</div>
								<div class="h-1 bg-[#2a2a2a] overflow-hidden">
									<div 
										class="h-full bg-[#00ff88] transition-all duration-1000 group-hover:animate-pulse"
										style={`width: ${skill.level}%`}
									></div>
								</div>
							</div>
						))}
					</div>
				</div>
			</div>
		</section>

		<!-- Projects Section -->
		<section id="work" class="px-4 md:px-8 py-20 border-b border-[#2a2a2a]">
			<div class="grid lg:grid-cols-12 gap-12">
				<div class="lg:col-span-4">
					<div class="sticky top-24">
						<p class="text-[#666] text-sm mb-2">03</p>
						<h2 class="text-3xl md:text-4xl font-sinistre mb-4">
							<span class="text-[#00ff88]">&lt;</span>projects<span class="text-[#00ff88]">/&gt;</span>
						</h2>
						<div class="w-16 h-1 bg-[#00ff88]"></div>
					</div>
				</div>
				
				<div class="lg:col-span-8 space-y-8">
					<!-- Project 1 -->
					<div class="group border border-[#2a2a2a] hover:border-[#00ff88] transition-all">
						<div class="p-6 border-b border-[#2a2a2a] bg-[#111] flex justify-between items-center">
							<div class="flex items-center gap-3">
								<div class="flex gap-1.5">
									<span class="w-3 h-3 rounded-full bg-[#ff5f57]"></span>
									<span class="w-3 h-3 rounded-full bg-[#febc2e]"></span>
									<span class="w-3 h-3 rounded-full bg-[#28c840]"></span>
								</div>
								<span class="text-[#666] text-sm">streaming-platform.ts</span>
							</div>
							<span class="text-[#00ff88] text-sm">featured</span>
						</div>
						<div class="p-6">
							<h3 class="font-sinistre text-2xl mb-2">Streaming Platform</h3>
							<p class="text-[#666] text-sm mb-4">Deniz Egece Co. Ltd.</p>
							<p class="text-[#aaa] leading-relaxed mb-6">
								Full-featured streaming platform serving 17,000+ paid users. Video transcoding pipelines, payment integrations, and real-time analytics dashboard.
							</p>
							<div class="flex flex-wrap gap-2">
								<span class="px-3 py-1 text-xs bg-[#00ff88]/10 text-[#00ff88] border border-[#00ff88]/30">Node.js</span>
								<span class="px-3 py-1 text-xs bg-[#00ff88]/10 text-[#00ff88] border border-[#00ff88]/30">PostgreSQL</span>
								<span class="px-3 py-1 text-xs bg-[#00ff88]/10 text-[#00ff88] border border-[#00ff88]/30">FFmpeg</span>
							</div>
						</div>
					</div>
					
					<!-- Project 2 -->
					<div class="group border border-[#2a2a2a] hover:border-[#00ff88] transition-all">
						<div class="p-6 border-b border-[#2a2a2a] bg-[#111] flex justify-between items-center">
							<div class="flex items-center gap-3">
								<div class="flex gap-1.5">
									<span class="w-3 h-3 rounded-full bg-[#ff5f57]"></span>
									<span class="w-3 h-3 rounded-full bg-[#febc2e]"></span>
									<span class="w-3 h-3 rounded-full bg-[#28c840]"></span>
								</div>
								<span class="text-[#666] text-sm">portfolio.astro</span>
							</div>
							<span class="text-[#00ff88] text-sm">personal</span>
						</div>
						<div class="p-6">
							<h3 class="font-sinistre text-2xl mb-2">This Portfolio</h3>
							<p class="text-[#666] text-sm mb-4">atduyar.com</p>
							<p class="text-[#aaa] leading-relaxed mb-6">
								Custom portfolio with Sinistre variable font, Old Turkic script heritage elements, and meticulously crafted interactions.
							</p>
							<div class="flex flex-wrap gap-2">
								<span class="px-3 py-1 text-xs bg-[#00ff88]/10 text-[#00ff88] border border-[#00ff88]/30">Astro</span>
								<span class="px-3 py-1 text-xs bg-[#00ff88]/10 text-[#00ff88] border border-[#00ff88]/30">Tailwind</span>
								<span class="px-3 py-1 text-xs bg-[#00ff88]/10 text-[#00ff88] border border-[#00ff88]/30">Cloudflare</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Experience Section -->
		<section class="px-4 md:px-8 py-20 border-b border-[#2a2a2a]">
			<div class="grid lg:grid-cols-12 gap-12">
				<div class="lg:col-span-4">
					<div class="sticky top-24">
						<p class="text-[#666] text-sm mb-2">04</p>
						<h2 class="text-3xl md:text-4xl font-sinistre mb-4">
							<span class="text-[#00ff88]">&lt;</span>history<span class="text-[#00ff88]">/&gt;</span>
						</h2>
						<div class="w-16 h-1 bg-[#00ff88]"></div>
					</div>
				</div>
				
				<div class="lg:col-span-8">
					<div class="relative">
						<div class="absolute left-0 top-0 bottom-0 w-px bg-[#2a2a2a]"></div>
						
						<div class="pl-8 pb-12 relative">
							<div class="absolute left-0 top-1 w-3 h-3 bg-[#00ff88] -translate-x-1/2"></div>
							<p class="text-[#00ff88] text-sm mb-2 font-mono">2023 - present</p>
							<h3 class="font-sinistre text-xl mb-1">Full-Stack Developer</h3>
							<p class="text-[#666] text-sm mb-3">Deniz Egece Co. Ltd.</p>
							<p class="text-[#aaa] text-sm leading-relaxed">Led streaming infrastructure, database architecture, and user-facing applications.</p>
						</div>
						
						<div class="pl-8 relative">
							<div class="absolute left-0 top-1 w-3 h-3 border border-[#00ff88] bg-[#0c0c0c] -translate-x-1/2"></div>
							<p class="text-[#00ff88] text-sm mb-2 font-mono">2022 - present</p>
							<h3 class="font-sinistre text-xl mb-1">Software Engineering</h3>
							<p class="text-[#666] text-sm mb-3">Int'l University of Sarajevo</p>
							<p class="text-[#aaa] text-sm leading-relaxed">Honor Student. Focus on CS fundamentals, algorithms, and system design.</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Contact Section -->
		<section id="contact" class="px-4 md:px-8 py-20 relative group">
			<BackgroundMarquee class="group-has-[button:hover]:text-[#00ff88]/30 duration-500 transition-all opacity-5">
				𐰚𐰇𐰠𐱅𐰃𐰏𐰤: 𐰖𐰸: 𐰼𐰾𐰼: 𐰸𐰆𐰯: 𐰇𐰠𐱅𐰲𐰃: 𐰼𐱅𐰏𐰕: 𐰃𐰤𐰢: 𐰚𐰇𐰠𐱅𐰃𐰏𐰤: 𐰚𐰼𐰏𐰚: 𐰉𐰆𐰡𐰃: 𐰇𐰕𐰢: 𐰽𐰴𐰦𐰢: 𐰚𐰇𐰼𐰇𐰼: 𐰚𐰇𐰕𐰢: 𐰚𐰇𐰼𐰢𐰕: 𐱅𐰏: 𐰋𐰃𐰠𐰼: 𐰋𐰃𐰠𐰏𐰢: 𐰋𐰃𐰠𐰢𐰕: 𐱅𐰏: 𐰉𐰆𐰡𐰃: 𐰇𐰕𐰢: 𐰽𐰴𐰦𐰢: 𐰇𐰓: 𐱅𐰭𐰼𐰃: 𐰖𐰽𐰺: 𐰚𐰃𐰾𐰃: 𐰆𐰍𐰞𐰃: 𐰸𐰆𐰯: 𐰇𐰠𐰏𐰠𐰃: 𐱅𐰇𐰼𐰇𐰢𐰾:
			</BackgroundMarquee>
			
			<div class="grid lg:grid-cols-12 gap-12 relative z-10">
				<div class="lg:col-span-4">
					<div class="sticky top-24">
						<p class="text-[#666] text-sm mb-2">05</p>
						<h2 class="text-3xl md:text-4xl font-sinistre mb-4">
							<span class="text-[#00ff88]">&lt;</span>contact<span class="text-[#00ff88]">/&gt;</span>
						</h2>
						<div class="w-16 h-1 bg-[#00ff88]"></div>
					</div>
				</div>
				
				<div class="lg:col-span-8">
					<div class="p-6 border border-[#2a2a2a] bg-[#111]">
						<div class="flex items-center gap-3 pb-4 border-b border-[#2a2a2a] mb-6">
							<div class="flex gap-1.5">
								<span class="w-3 h-3 rounded-full bg-[#ff5f57]"></span>
								<span class="w-3 h-3 rounded-full bg-[#febc2e]"></span>
								<span class="w-3 h-3 rounded-full bg-[#28c840]"></span>
							</div>
							<span class="text-[#666] text-sm">contact-form.tsx</span>
						</div>
						
						<p class="text-[#666] mb-6">
							<span class="text-[#00ff88]">//</span> Ready to build something great? Let's connect.
						</p>
						
						<form class="space-y-6">
							<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
								<div>
									<label for="name" class="text-sm text-[#666] mb-2 block">const name =</label>
									<input type="text" id="name" class="w-full bg-[#0c0c0c] border border-[#2a2a2a] focus:border-[#00ff88] px-4 py-3 outline-none transition-colors font-mono" placeholder='"John Doe"' />
								</div>
								<div>
									<label for="email" class="text-sm text-[#666] mb-2 block">const email =</label>
									<input type="email" id="email" class="w-full bg-[#0c0c0c] border border-[#2a2a2a] focus:border-[#00ff88] px-4 py-3 outline-none transition-colors font-mono" placeholder='"john@example.com"' />
								</div>
							</div>
							<div>
								<label for="message" class="text-sm text-[#666] mb-2 block">const message =</label>
								<textarea id="message" rows="5" class="w-full bg-[#0c0c0c] border border-[#2a2a2a] focus:border-[#00ff88] px-4 py-3 outline-none transition-colors resize-none font-mono" placeholder='`Your message here...`'></textarea>
							</div>
							<div class="flex justify-end">
								<button type="submit" class="px-8 py-3 bg-[#00ff88] text-[#0c0c0c] font-bold hover:bg-[#00cc6a] transition-colors flex items-center gap-2 group">
									<span>sendMessage()</span>
									<span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
								</button>
							</div>
						</form>
					</div>
				</div>
			</div>
			
			<!-- Glow effect -->
			<div class="select-none pointer-events-none absolute right-0 bottom-0 w-1/2 h-1/2 transition-opacity duration-500 opacity-0 group-has-[button:hover]:opacity-100">
				<div class="absolute inset-0 bg-[#00ff88]/10 blur-[100px]"></div>
			</div>
		</section>

		<!-- Footer -->
		<footer class="py-8 px-4 md:px-8 border-t border-[#2a2a2a]">
			<div class="flex flex-col md:flex-row justify-between items-center gap-6">
				<div class="flex items-center gap-2 text-sm">
					<span class="text-[#00ff88]">&gt;</span>
					<span class="font-sinistre">atduyar</span>
					<span class="text-[#666]">v1.0.0</span>
				</div>
				<div class="flex gap-6 text-sm">
					<a href="https://github.com/atduyar" target="_blank" rel="noopener" class="text-[#666] hover:text-[#00ff88] transition-colors">[github]</a>
					<a href="https://linkedin.com/in/atduyar" target="_blank" rel="noopener" class="text-[#666] hover:text-[#00ff88] transition-colors">[linkedin]</a>
					<a href="mailto:contact@atduyar.com" class="text-[#666] hover:text-[#00ff88] transition-colors">[email]</a>
				</div>
				<p class="text-[#444] text-xs">&copy; 2026 // MIT License</p>
			</div>
		</footer>
	</main>
</BaseLayout>

<style>
	/* Blinking cursor */
	@keyframes blink {
		0%, 100% { opacity: 1; }
		50% { opacity: 0; }
	}
	
	.animate-blink {
		animation: blink 1s step-end infinite;
	}
	
	/* Type-in animation */
	@keyframes type-in {
		from {
			opacity: 0;
			transform: translateX(-10px);
		}
		to {
			opacity: 1;
			transform: translateX(0);
		}
	}
	
	.animate-type-in {
		animation: type-in 0.5s ease-out forwards;
	}
	
	/* Line reveal animation */
	@keyframes line-reveal {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
	
	.animate-line-reveal {
		animation: line-reveal 0.6s ease-out forwards;
		opacity: 0;
	}
	
	/* Fade in */
	@keyframes fade-in {
		from { opacity: 0; }
		to { opacity: 1; }
	}
	
	.animate-fade-in {
		animation: fade-in 0.8s ease-out forwards;
		opacity: 0;
	}
	
	/* Geometric shapes drift */
	@keyframes shape-drift {
		0%, 100% {
			transform: rotate(45deg) translateY(0);
		}
		50% {
			transform: rotate(50deg) translateY(-20px);
		}
	}
	
	.animate-shape-drift {
		animation: shape-drift 8s ease-in-out infinite;
	}
</style>
