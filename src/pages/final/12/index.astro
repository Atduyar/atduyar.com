---
import BackgroundMarquee from "../../../components/BackgroundMarquee.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout title="Ahmet Tarik Duyar" description="Full-Stack Software Engineer Portfolio" bodyClass="bg-[#0a0b0d] text-white w-screen overflow-x-hidden">
	<main class="bg-[#0d0e12] border-x border-[#90c5ff14] max-w-7xl mx-auto min-h-dvh relative">
		<!-- Subtle noise overlay -->
		<div class="fixed inset-0 pointer-events-none opacity-[0.015] z-50" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 256 256%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22n%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23n)%22/%3E%3C/svg%3E');"></div>
		
		<!-- Navigation -->
		<nav class="py-6 px-4 md:px-8 border-b border-[#90c5ff14] sticky top-0 bg-[#0d0e12]/90 backdrop-blur-sm z-40">
			<div class="flex justify-between items-center">
				<a href="#hero" class="group flex items-center gap-3">
					<div class="w-10 h-10 rounded-full border border-blue-400/30 flex items-center justify-center group-hover:border-blue-400/60 transition-colors relative overflow-hidden">
						<div class="absolute inset-0 bg-blue-500/10 group-hover:bg-blue-500/20 transition-colors"></div>
						<img src="/favicon.svg" alt="Logo" class="w-6 h-6 relative z-10" />
					</div>
					<span class="font-sinistre text-xl tracking-wide hidden sm:block">Atduyar</span>
				</a>
				<ul class="flex gap-3 md:gap-6 text-sm">
					<li><a href="#codex" class="nav-link font-sinistre hover:text-blue-300 transition-all">Codex</a></li>
					<li><a href="#schematic" class="nav-link font-sinistre hover:text-blue-300 transition-all">Schematic</a></li>
					<li><a href="#jukebox" class="nav-link font-sinistre hover:text-blue-300 transition-all">Jukebox</a></li>
					<li><a href="#postcard" class="nav-link font-sinistre px-4 py-1 border border-blue-500/30 hover:bg-blue-600/10 rounded-full">Write</a></li>
				</ul>
			</div>
		</nav>

		<!-- Hero Section -->
		<section id="hero" class="min-h-[85vh] flex flex-col justify-center px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14] relative overflow-hidden">
			<div class="absolute inset-0">
				<div class="absolute top-1/4 left-1/4 w-[500px] h-[500px] bg-blue-500/10 rounded-full blur-[150px]"></div>
				<div class="absolute bottom-1/3 right-1/4 w-[400px] h-[400px] bg-indigo-500/10 rounded-full blur-[120px]"></div>
			</div>
			
			<div class="relative z-10">
				<p class="font-oldturcic text-blue-400/50 text-lg mb-4 tracking-[0.4em] animate-fade-in leading-none">𐰚𐰇𐰠𐱅𐰃𐰏𐰤</p>
				<h1 class="text-5xl sm:text-7xl lg:text-8xl xl:text-9xl font-sinistre leading-[0.9] mb-8">
					<span class="block animate-slide-up" style="animation-delay: 0.1s;">I'm Ahmet</span>
					<span class="block animate-slide-up" style="animation-delay: 0.2s;">
						<span class="text-blue-300">Tarik</span> Duyar
					</span>
				</h1>
				<p class="text-lg md:text-xl text-gray-400 max-w-xl animate-fade-in leading-relaxed" style="animation-delay: 0.5s;">
					Building robust backend architectures and scalable systems. 
					Passionate about C, Rust, and Linux.
				</p>
				<div class="flex gap-4 mt-10 animate-fade-in" style="animation-delay: 0.7s;">
					<a href="#codex" class="group px-6 py-3 bg-blue-600/10 border border-blue-500/30 hover:bg-blue-600/20 hover:border-blue-400/50 transition-all font-sinistre text-lg rounded-sm">
						Read the Codex
					</a>
					<a href="#postcard" class="px-6 py-3 border border-[#90c5ff14] hover:border-[#90c5ff30] transition-all font-sinistre text-lg rounded-sm">
						Send Postcard
					</a>
				</div>
			</div>
		</section>

		<!-- SECTION 1: THE CODEX - Blog as Illuminated Manuscript -->
		<section id="codex" class="py-20 border-b border-[#90c5ff14] relative overflow-hidden">
			<!-- Parchment texture background -->
			<div class="absolute inset-0 opacity-[0.03]" style="background: url('data:image/svg+xml,%3Csvg width=%22100%22 height=%22100%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noise%22%3E%3CfeTurbulence baseFrequency=%220.4%22 type=%22fractalNoise%22 numOctaves=%223%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noise)%22/%3E%3C/svg%3E');"></div>
			
			<div class="px-4 md:px-8 lg:px-16 relative z-10">
				<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-4 flex items-center gap-4">
					<span class="font-oldturcic text-2xl md:text-3xl text-blue-400/30 leading-none">𐰋𐰃𐰠</span>
					The Codex
					<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
				</h2>
				<p class="text-gray-500 mb-12 italic">Wisdom inscribed for those who seek knowledge.</p>
			</div>
			
			<!-- Manuscript container - full width with asymmetric layout -->
			<div class="relative">
				<!-- Decorative margin lines -->
				<div class="absolute left-[5%] top-0 bottom-0 w-px bg-gradient-to-b from-transparent via-red-900/30 to-transparent"></div>
				<div class="absolute left-[7%] top-0 bottom-0 w-px bg-gradient-to-b from-transparent via-red-900/20 to-transparent"></div>
				
				<!-- Main manuscript area -->
				<div class="grid grid-cols-12 gap-0">
					<!-- Left marginalia column -->
					<div class="col-span-2 pr-4 hidden lg:block">
						<div class="sticky top-24 space-y-8 text-right">
							<!-- Marginalia notes -->
							<div class="text-xs text-amber-600/40 italic leading-relaxed">
								<p>Anno Domini</p>
								<p>MMXXVI</p>
							</div>
							<div class="text-xs text-red-700/30 italic">
								<p>Nota bene:</p>
								<p>Systems must</p>
								<p>be understood</p>
								<p>from first</p>
								<p>principles.</p>
							</div>
							<!-- Decorative seal -->
							<div class="w-12 h-12 ml-auto rounded-full bg-gradient-to-br from-red-900/40 to-red-950/60 border border-red-800/30 flex items-center justify-center">
								<span class="font-oldturcic text-red-400/50 text-lg">𐰚</span>
							</div>
						</div>
					</div>
					
					<!-- Main content column -->
					<div class="col-span-12 lg:col-span-7 px-4 lg:px-8 border-l border-amber-900/10 lg:border-l-0">
						<!-- Article 1: Featured with illuminated capital -->
						<article class="mb-16 relative">
							<!-- Chapter number -->
							<div class="absolute -left-16 top-0 font-sinistre text-6xl text-amber-900/20 hidden lg:block">I</div>
							
							<div class="flex gap-6">
								<!-- Illuminated capital letter -->
								<div class="flex-shrink-0 w-24 h-24 border-2 border-amber-700/30 bg-gradient-to-br from-amber-900/10 to-blue-900/10 flex items-center justify-center relative">
									<!-- Decorative corners -->
									<div class="absolute top-0 left-0 w-3 h-3 border-t-2 border-l-2 border-amber-600/40"></div>
									<div class="absolute top-0 right-0 w-3 h-3 border-t-2 border-r-2 border-amber-600/40"></div>
									<div class="absolute bottom-0 left-0 w-3 h-3 border-b-2 border-l-2 border-amber-600/40"></div>
									<div class="absolute bottom-0 right-0 w-3 h-3 border-b-2 border-r-2 border-amber-600/40"></div>
									<!-- The capital -->
									<span class="font-sinistre text-5xl text-transparent bg-clip-text bg-gradient-to-br from-amber-400 via-amber-600 to-red-700">W</span>
									<!-- Decorative flourishes -->
									<div class="absolute -bottom-2 -right-2 w-6 h-6 border-r border-b border-amber-700/30"></div>
								</div>
								
								<div class="flex-1">
									<h3 class="font-sinistre text-2xl mb-3 text-amber-100 hover:text-amber-200 transition-colors cursor-pointer">
										Why Memory Safety Will Define the Next Decade of Systems Programming
									</h3>
									<p class="text-gray-400 leading-loose" style="text-align: justify; hyphens: auto;">
										<span class="text-amber-200/80">hen I first encountered Rust's borrow checker,</span> I dismissed it as an unnecessary complexity. Having written C for years, I believed that careful programming was sufficient. I was wrong. The mental overhead of tracking lifetimes manually across a codebase of thousands of lines is not just difficult—it is fundamentally opposed to how human cognition works. We are pattern matchers, not state machines.
									</p>
								</div>
							</div>
							
							<div class="mt-6 pl-0 lg:pl-32 text-gray-400 leading-loose space-y-4" style="text-align: justify;">
								<p>
									The revelation came during a midnight debugging session. A segmentation fault that had eluded me for three days turned out to be a use-after-free buried deep in a callback chain. In Rust, this code would not have compiled. The compiler, that tireless sentinel, would have caught my error before it ever reached production.
								</p>
								<p>
									This is not merely about preventing bugs. It is about changing how we think about systems. When memory safety is guaranteed by the type system, we are free to reason about higher-level concerns: architecture, performance characteristics, user experience. The cognitive load shifts from defensive programming to creative problem-solving.
								</p>
								<!-- Annotation in the margin style -->
								<div class="border-l-2 border-amber-700/30 pl-4 my-6 text-amber-200/60 italic text-sm">
									"The borrow checker is not a constraint. It is a collaborator that catches mistakes before they become incidents."
								</div>
								<p>
									For those beginning this journey, I offer this counsel: embrace the friction. The compiler's complaints are not obstacles but teachings. Each error message is a lesson in thinking about ownership, about the flow of data through your system. In time, you will find that your C code improves too—you will see potential issues before they manifest, trained by the discipline Rust demands.
								</p>
							</div>
							
							<!-- Article footer with date and reading time -->
							<div class="mt-8 pt-4 border-t border-amber-900/20 flex items-center justify-between text-xs text-gray-600">
								<span class="italic">Inscribed on the 15th day of January, Year of Our Lord 2026</span>
								<span>XII minutes of contemplation</span>
							</div>
						</article>
						
						<!-- Decorative divider -->
						<div class="flex items-center gap-4 my-12">
							<div class="flex-1 h-px bg-gradient-to-r from-transparent via-amber-900/30 to-transparent"></div>
							<span class="font-oldturcic text-amber-700/30">𐰠𐱅𐰃</span>
							<div class="flex-1 h-px bg-gradient-to-r from-transparent via-amber-900/30 to-transparent"></div>
						</div>
						
						<!-- Article 2 -->
						<article class="mb-16 relative">
							<div class="absolute -left-16 top-0 font-sinistre text-6xl text-amber-900/20 hidden lg:block">II</div>
							
							<div class="flex gap-6">
								<div class="flex-shrink-0 w-24 h-24 border-2 border-blue-700/30 bg-gradient-to-br from-blue-900/10 to-indigo-900/10 flex items-center justify-center relative">
									<div class="absolute top-0 left-0 w-3 h-3 border-t-2 border-l-2 border-blue-600/40"></div>
									<div class="absolute top-0 right-0 w-3 h-3 border-t-2 border-r-2 border-blue-600/40"></div>
									<div class="absolute bottom-0 left-0 w-3 h-3 border-b-2 border-l-2 border-blue-600/40"></div>
									<div class="absolute bottom-0 right-0 w-3 h-3 border-b-2 border-r-2 border-blue-600/40"></div>
									<span class="font-sinistre text-5xl text-transparent bg-clip-text bg-gradient-to-br from-blue-400 via-blue-600 to-indigo-700">T</span>
								</div>
								
								<div class="flex-1">
									<h3 class="font-sinistre text-2xl mb-3 text-blue-100 hover:text-blue-200 transition-colors cursor-pointer">
										The Database as a Living System: Lessons from Scaling PostgreSQL
									</h3>
									<p class="text-gray-400 leading-loose" style="text-align: justify;">
										<span class="text-blue-200/80">he greatest error one can make</span> when designing a database schema is to treat it as a static artifact. A database is a living system, breathing with every query, growing with every insert. It must be nurtured, observed, and occasionally—with great care—restructured.
									</p>
								</div>
							</div>
							
							<div class="mt-6 pl-0 lg:pl-32 text-gray-400 leading-loose space-y-4" style="text-align: justify;">
								<p>
									When our streaming platform reached ten thousand users, the cracks began to show. Queries that once returned in milliseconds now took seconds. The dashboard, once responsive, became a source of frustration. The database was telling us something, if only we would listen.
								</p>
								<p>
									The solution was not merely to add indexes—though we did. It was to understand the access patterns, to see the database not as a storage mechanism but as a query-answering machine. We denormalized where it made sense. We introduced materialized views for complex aggregations. We learned to read EXPLAIN ANALYZE as one reads poetry.
								</p>
							</div>
							
							<div class="mt-8 pt-4 border-t border-blue-900/20 flex items-center justify-between text-xs text-gray-600">
								<span class="italic">Inscribed on the 3rd day of February, Year of Our Lord 2026</span>
								<span>VIII minutes of contemplation</span>
							</div>
						</article>
						
						<!-- Article 3: Shorter entry -->
						<article class="mb-16 relative">
							<div class="absolute -left-16 top-0 font-sinistre text-6xl text-amber-900/20 hidden lg:block">III</div>
							
							<div class="flex gap-6">
								<div class="flex-shrink-0 w-24 h-24 border-2 border-emerald-700/30 bg-gradient-to-br from-emerald-900/10 to-teal-900/10 flex items-center justify-center relative">
									<div class="absolute top-0 left-0 w-3 h-3 border-t-2 border-l-2 border-emerald-600/40"></div>
									<div class="absolute top-0 right-0 w-3 h-3 border-t-2 border-r-2 border-emerald-600/40"></div>
									<div class="absolute bottom-0 left-0 w-3 h-3 border-b-2 border-l-2 border-emerald-600/40"></div>
									<div class="absolute bottom-0 right-0 w-3 h-3 border-b-2 border-r-2 border-emerald-600/40"></div>
									<span class="font-sinistre text-5xl text-transparent bg-clip-text bg-gradient-to-br from-emerald-400 via-emerald-600 to-teal-700">I</span>
								</div>
								
								<div class="flex-1">
									<h3 class="font-sinistre text-2xl mb-3 text-emerald-100 hover:text-emerald-200 transition-colors cursor-pointer">
										In Defense of the Monolith: When Microservices Are Not the Answer
									</h3>
									<p class="text-gray-400 leading-loose" style="text-align: justify;">
										<span class="text-emerald-200/80">n an age of distributed systems,</span> it has become heresy to speak well of the monolith. Yet I will make this case: for many applications, a well-structured monolith is not merely acceptable—it is optimal. The complexity tax of microservices is paid in debugging, in deployment, in the cognitive overhead of distributed tracing.
									</p>
								</div>
							</div>
							
							<div class="mt-8 pt-4 border-t border-emerald-900/20 flex items-center justify-between text-xs text-gray-600">
								<span class="italic">Inscribed on the 20th day of December, Year of Our Lord 2025</span>
								<span>V minutes of contemplation</span>
							</div>
						</article>
					</div>
					
					<!-- Right annotation column -->
					<div class="col-span-3 pl-8 hidden lg:block border-l border-amber-900/10">
						<div class="sticky top-24 space-y-12">
							<!-- Index of topics -->
							<div>
								<h4 class="font-sinistre text-sm text-amber-600/60 mb-4 tracking-wider">INDEX</h4>
								<ul class="space-y-2 text-xs text-gray-500">
									<li class="hover:text-amber-300 cursor-pointer transition-colors">I. Memory Safety</li>
									<li class="hover:text-amber-300 cursor-pointer transition-colors">II. Database Systems</li>
									<li class="hover:text-amber-300 cursor-pointer transition-colors">III. Architecture</li>
									<li class="text-gray-700">IV. Coming soon...</li>
									<li class="text-gray-700">V. Coming soon...</li>
								</ul>
							</div>
							
							<!-- Glossary -->
							<div>
								<h4 class="font-sinistre text-sm text-amber-600/60 mb-4 tracking-wider">GLOSSARY</h4>
								<div class="space-y-3 text-xs">
									<div>
										<span class="text-amber-300/60">Borrow Checker</span>
										<p class="text-gray-600 mt-1">Rust's compile-time analysis that enforces ownership rules</p>
									</div>
									<div>
										<span class="text-amber-300/60">EXPLAIN ANALYZE</span>
										<p class="text-gray-600 mt-1">PostgreSQL command revealing query execution plans</p>
									</div>
								</div>
							</div>
							
							<!-- Decorative element -->
							<div class="border border-amber-900/20 p-4 bg-gradient-to-br from-amber-950/20 to-transparent">
								<p class="text-xs text-amber-700/40 italic text-center leading-relaxed">
									"The wise developer writes code for the maintainer who follows, for that maintainer may be oneself."
								</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- SECTION 2: THE WIRE - Incoming Messages as Telegraph -->
		<section id="wire" class="px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14] relative overflow-hidden">
			<div class="relative z-10">
				<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-4 flex items-center gap-4">
					<span class="font-oldturcic text-2xl md:text-3xl text-blue-400/30 leading-none">𐰽𐰴</span>
					The Wire
					<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
				</h2>
				<p class="text-gray-500 mb-8">Incoming transmissions from the field.</p>
				
				<!-- Telegraph machine frame -->
				<div class="max-w-3xl mx-auto border border-amber-900/30 bg-[#0a0b0d]">
					<!-- Machine header -->
					<div class="bg-amber-950/30 border-b border-amber-900/30 px-6 py-3 flex items-center justify-between">
						<div class="flex items-center gap-3">
							<div class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></div>
							<span class="font-mono text-xs text-amber-400/80">RECEIVING</span>
						</div>
						<span class="font-mono text-xs text-amber-700/60">WIRE SERVICE // ATDUYAR DISPATCH</span>
					</div>
					
					<!-- Tape output -->
					<div class="p-6 space-y-4 font-mono text-sm">
						<!-- Message 1 -->
						<div class="border-b border-amber-900/20 pb-4">
							<div class="flex items-center gap-2 text-amber-600/60 text-xs mb-2">
								<span>---</span>
								<span>2026.02.09</span>
								<span>21:45:00 UTC</span>
								<span>---</span>
							</div>
							<p class="text-amber-100/80 uppercase tracking-wider">
								PORTFOLIO V12 DEPLOYED STOP ALL SYSTEMS NOMINAL STOP LIGHTHOUSE BEACON ACTIVE STOP
							</p>
						</div>
						
						<!-- Message 2 -->
						<div class="border-b border-amber-900/20 pb-4">
							<div class="flex items-center gap-2 text-amber-600/60 text-xs mb-2">
								<span>---</span>
								<span>2026.02.01</span>
								<span>14:22:00 UTC</span>
								<span>---</span>
							</div>
							<p class="text-amber-100/80 uppercase tracking-wider">
								NEW BLOG ENTRY COMMITTED STOP TOPIC MEMORY SAFETY STOP RUST BORROW CHECKER ANALYSIS COMPLETE STOP
							</p>
						</div>
						
						<!-- Message 3 -->
						<div class="border-b border-amber-900/20 pb-4">
							<div class="flex items-center gap-2 text-amber-600/60 text-xs mb-2">
								<span>---</span>
								<span>2026.01.15</span>
								<span>09:00:00 UTC</span>
								<span>---</span>
							</div>
							<p class="text-amber-100/80 uppercase tracking-wider">
								STREAMING PLATFORM MILESTONE STOP SEVENTEEN THOUSAND USERS REACHED STOP UPTIME NINETY NINE POINT NINE PERCENT STOP
							</p>
						</div>
						
						<!-- Message 4: Incoming animation -->
						<div class="text-amber-500/60">
							<span class="animate-pulse">AWAITING NEXT TRANSMISSION...</span>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- SECTION 3: THE SCHEMATIC - Skills as Circuit Board -->
		<section id="schematic" class="px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14] relative overflow-hidden">
			<!-- Circuit trace pattern -->
			<div class="absolute inset-0 opacity-[0.03]">
				<svg class="w-full h-full" viewBox="0 0 800 400">
					<defs>
						<pattern id="circuit" x="0" y="0" width="100" height="100" patternUnits="userSpaceOnUse">
							<path d="M0,50 L30,50 L30,30 L70,30 L70,50 L100,50" stroke="#60a5fa" fill="none" stroke-width="0.5"/>
							<path d="M50,0 L50,30 M50,70 L50,100" stroke="#60a5fa" fill="none" stroke-width="0.5"/>
							<circle cx="30" cy="30" r="3" fill="none" stroke="#60a5fa" stroke-width="0.5"/>
							<circle cx="70" cy="30" r="3" fill="none" stroke="#60a5fa" stroke-width="0.5"/>
						</pattern>
					</defs>
					<rect width="100%" height="100%" fill="url(#circuit)"/>
				</svg>
			</div>
			
			<div class="relative z-10">
				<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-4 flex items-center gap-4">
					<span class="font-oldturcic text-2xl md:text-3xl text-blue-400/30 leading-none">𐰼𐱅</span>
					The Schematic
					<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
				</h2>
				<p class="text-gray-500 mb-8 font-mono text-xs">INTEGRATED SKILL CIRCUIT // REV 3.1</p>
				
				<!-- Circuit board layout -->
				<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
					<!-- Component: Backend IC -->
					<div class="component group">
						<div class="border-2 border-blue-500/30 bg-[#0a0b0d] p-4 relative hover:border-blue-400/60 transition-all">
							<!-- IC pins -->
							<div class="absolute -left-1 top-1/4 w-2 h-1 bg-blue-500/40"></div>
							<div class="absolute -left-1 top-2/4 w-2 h-1 bg-blue-500/40"></div>
							<div class="absolute -left-1 top-3/4 w-2 h-1 bg-blue-500/40"></div>
							<div class="absolute -right-1 top-1/4 w-2 h-1 bg-blue-500/40"></div>
