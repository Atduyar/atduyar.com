<script>
	// Jukebox functionality
	function playTrack(title, artist) {
		const nowPlaying = document.getElementById('now-playing');
		const trackArtist = document.getElementById('track-artist');
		const bars = document.querySelectorAll('.visualizer-bar');
		
		if (nowPlaying) nowPlaying.textContent = title;
		if (trackArtist) trackArtist.textContent = artist;
		
		// Animate visualizer
		bars.forEach(bar => {
			bar.classList.add('animate-visualizer');
		});
		
		// Stop animation after 5 seconds
		setTimeout(() => {
			bars.forEach(bar => {
				bar.classList.remove('animate-visualizer');
			});
		}, 5000);
	}
	
	// Make function available globally
	window.playTrack = playTrack;
</script>

<style>
	@keyframes fade-in {
		from { opacity: 0; }
		to { opacity: 1; }
	}
	
	@keyframes slide-up {
		from { 
			opacity: 0;
			transform: translateY(40px);
		}
		to { 
			opacity: 1;
			transform: translateY(0);
		}
	}
	
	@keyframes spin-very-slow {
		from { transform: rotate(0deg); }
		to { transform: rotate(360deg); }
	}
	
	@keyframes visualizer {
		0%, 100% { height: 16px; }
		25% { height: 48px; }
		50% { height: 24px; }
		75% { height: 56px; }
	}
	
	.animate-fade-in {
		animation: fade-in 1s ease-out forwards;
		opacity: 0;
	}
	
	.animate-slide-up {
		animation: slide-up 0.8s ease-out forwards;
		opacity: 0;
	}
	
	.animate-spin-very-slow {
		animation: spin-very-slow 8s linear infinite;
	}
	
	.animate-visualizer {
		animation: visualizer 0.5s ease-in-out infinite;
	}
	
	.visualizer-bar:nth-child(2) { animation-delay: 0.1s; }
	.visualizer-bar:nth-child(3) { animation-delay: 0.2s; }
	.visualizer-bar:nth-child(4) { animation-delay: 0.05s; }
	.visualizer-bar:nth-child(5) { animation-delay: 0.15s; }
	.visualizer-bar:nth-child(6) { animation-delay: 0.25s; }
	.visualizer-bar:nth-child(7) { animation-delay: 0.08s; }
	.visualizer-bar:nth-child(8) { animation-delay: 0.18s; }
	.visualizer-bar:nth-child(9) { animation-delay: 0.12s; }
	.visualizer-bar:nth-child(10) { animation-delay: 0.22s; }
</style>
