---
import BackgroundMarquee from "../../../components/BackgroundMarquee.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout title="Ahmet Tarik Duyar" description="Full-Stack Software Engineer Portfolio" bodyClass="bg-[#0a0b0d] text-white w-screen overflow-x-hidden">
	<main class="bg-[#0d0e12] border-x border-[#90c5ff14] max-w-7xl mx-auto min-h-dvh relative">
		<!-- Subtle noise overlay -->
		<div class="fixed inset-0 pointer-events-none opacity-[0.015] z-50" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 256 256%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22n%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%u003E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23n)%22/%3E%3C/svg%3E');"></div>
		
		<!-- Navigation -->
		<nav class="py-6 px-4 md:px-8 border-b border-[#90c5ff14] sticky top-0 bg-[#0d0e12]/90 backdrop-blur-sm z-40">
			<div class="flex justify-between items-center">
				<a href="#hero" class="group flex items-center gap-3">
					<img src="/favicon.svg" alt="Logo" class="w-8 h-8 transition-transform group-hover:rotate-12" />
					<span class="font-sinistre text-xl tracking-wide hidden sm:block">Atduyar</span>
				</a>
				<ul class="flex gap-4 md:gap-8">
					<li><a href="#about" class="nav-link font-sinistre text-lg hover:text-blue-300 transition-all">About</a></li>
					<li><a href="#arsenal" class="nav-link font-sinistre text-lg hover:text-blue-300 transition-all">Arsenal</a></li>
					<li><a href="#conquests" class="nav-link font-sinistre text-lg hover:text-blue-300 transition-all">Conquests</a></li>
					<li><a href="#summon" class="nav-link font-sinistre text-lg px-4 py-1 border border-blue-500/30 hover:bg-blue-600/10 transition-all">Summon</a></li>
				</ul>
			</div>
		</nav>

		<!-- Hero Section -->
		<section id="hero" class="min-h-[80vh] flex flex-col justify-center px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14] relative overflow-hidden">
			<div class="absolute inset-0 opacity-5">
				<div class="absolute top-1/4 left-1/4 w-96 h-96 bg-blue-500 rounded-full blur-[128px]"></div>
				<div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-indigo-500 rounded-full blur-[128px]"></div>
			</div>
			
			<!-- Floating Turkic Glyphs -->
			<div class="absolute inset-0 overflow-hidden pointer-events-none">
				<span class="absolute top-1/4 left-[10%] font-oldturcic text-6xl md:text-8xl text-blue-400/[0.06] leading-none animate-float-1">𐰚</span>
				<span class="absolute top-1/3 right-[15%] font-oldturcic text-5xl md:text-6xl text-blue-400/[0.06] leading-none animate-float-2">𐰇</span>
				<span class="absolute bottom-1/4 left-[20%] font-oldturcic text-5xl md:text-7xl text-blue-400/[0.06] leading-none animate-float-3">𐰠</span>
				<span class="absolute bottom-1/3 right-[25%] font-oldturcic text-7xl md:text-9xl text-blue-400/[0.06] leading-none animate-float-1">𐱅</span>
			</div>
			
			<div class="relative z-10">
				<p class="font-oldturcic text-blue-400/40 text-lg mb-4 tracking-[0.4em] animate-fade-in leading-none">𐰚𐰇𐰠𐱅𐰃𐰏𐰤</p>
				<h1 class="text-5xl sm:text-7xl lg:text-8xl xl:text-9xl font-sinistre leading-[0.9] mb-8">
					<span class="block animate-slide-up" style="animation-delay: 0.1s;">I'm Ahmet</span>
					<span class="block animate-slide-up text-blue-300" style="animation-delay: 0.2s;">Tarik Duyar</span>
				</h1>
				<p class="text-lg md:text-xl text-gray-400 max-w-xl animate-fade-in" style="animation-delay: 0.5s;">
					Building robust backend architectures and scalable systems. 
					Passionate about C, Rust, and Linux.
				</p>
				<div class="flex gap-4 mt-10 animate-fade-in" style="animation-delay: 0.7s;">
					<a href="#conquests" class="px-6 py-3 bg-blue-600/10 border border-blue-500/30 hover:bg-blue-600/20 hover:border-blue-400/50 transition-all font-sinistre text-lg rounded-sm">
						View Conquests
					</a>
					<a href="#summon" class="px-6 py-3 border border-[#90c5ff14] hover:border-[#90c5ff30] transition-all font-sinistre text-lg rounded-sm">
						Summon Me
					</a>
				</div>
			</div>
		</section>

		<!-- About Section -->
		<section id="about" class="px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14]">
			<div class="flex flex-col lg:flex-row gap-12 items-start">
				<div class="flex-1">
					<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-8 flex items-center gap-4">
						<span class="font-oldturcic text-2xl md:text-3xl text-blue-400/30 leading-none">𐰋𐰃𐰠</span>
						About Me
						<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
					</h2>
					<div class="space-y-6 text-gray-300 text-lg leading-relaxed">
						<p>
							I'm a Full-Stack Software Engineer with a year of professional experience specializing in building robust backend architectures, designing scalable databases, and managing critical systems.
						</p>
						<p>
							During my time at <span class="text-white">Deniz Egece Co. Ltd.</span>, I took ownership of architecting and deploying a streaming platform serving over <span class="text-blue-300">17,000 paid users</span>.
						</p>
						<p>
							As an <span class="text-white">Honor Student</span> in Software Engineering at the International University of Sarajevo, I'm deeply focused on computer science fundamentals.
						</p>
					</div>
				</div>
				<div class="w-full lg:w-80 flex-shrink-0">
					<div class="aspect-square bg-gradient-to-br from-[#90c5ff08] to-transparent border border-[#90c5ff14] rounded-sm p-8 flex items-center justify-center relative">
						<img src="/favicon.svg" alt="Logo" class="w-full h-full opacity-80" />
						<div class="absolute top-0 left-0 w-6 h-6 border-t border-l border-blue-400/30"></div>
						<div class="absolute top-0 right-0 w-6 h-6 border-t border-r border-blue-400/30"></div>
						<div class="absolute bottom-0 left-0 w-6 h-6 border-b border-l border-blue-400/30"></div>
						<div class="absolute bottom-0 right-0 w-6 h-6 border-b border-r border-blue-400/30"></div>
					</div>
				</div>
			</div>
		</section>

		<!-- ARSENAL SECTION - Skills as Weapons -->
		<section id="arsenal" class="px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14] relative overflow-hidden">
			<!-- Scrolling Turkic background -->
			<div class="absolute inset-0 flex items-center overflow-hidden pointer-events-none">
				<div class="flex whitespace-nowrap animate-scroll-slow">
					<span class="font-oldturcic text-[150px] md:text-[200px] text-blue-400/[0.03] leading-none px-8">
						𐰸𐰆𐰯 𐰇𐰠𐱅𐰲𐰃 𐰼𐱅𐰏𐰕 𐰃𐰤𐰢
					</span>
					<span class="font-oldturcic text-[150px] md:text-[200px] text-blue-400/[0.03] leading-none px-8">
						𐰸𐰆𐰯 𐰇𐰠𐱅𐰲𐰃 𐰼𐱅𐰏𐰕 𐰃𐰤𐰢
					</span>
				</div>
			</div>
			
			<div class="relative z-10">
				<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-4 flex items-center gap-4">
					<span class="font-oldturcic text-2xl md:text-3xl text-blue-400/30 leading-none">𐰸𐰆𐰯</span>
					Arsenal
					<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
				</h2>
				<p class="text-gray-500 mb-12 max-w-xl">Weapons forged through years of battle. Each tool mastered, each language conquered.</p>
				
				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					<!-- Weapon Card 1 - Backend -->
					<div class="group relative p-6 border border-[#90c5ff14] hover:border-blue-400/40 transition-all bg-gradient-to-br from-[#90c5ff05] to-transparent">
						<div class="flex items-start gap-6">
							<!-- Weapon Icon -->
							<div class="w-16 h-24 flex flex-col items-center justify-center border border-blue-400/20 bg-blue-500/5 relative">
								<span class="font-oldturcic text-3xl text-blue-400 leading-none">𐰋</span>
								<div class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-8 h-1 bg-blue-400/30"></div>
							</div>
							<div class="flex-1">
								<div class="flex items-center justify-between mb-2">
									<h3 class="font-sinistre text-xl text-blue-300">Backend Blade</h3>
									<span class="text-xs text-blue-400/60 uppercase tracking-wider">Legendary</span>
								</div>
								<p class="text-sm text-gray-500 mb-4">Node.js, Rust, Go, Python. The primary weapons for building scalable systems.</p>
								<!-- Power Meter -->
								<div class="flex items-center gap-2">
									<span class="text-xs text-gray-600 w-12">Power</span>
									<div class="flex-1 h-2 bg-[#90c5ff10] overflow-hidden">
										<div class="h-full bg-gradient-to-r from-blue-500 to-blue-400 w-[95%] group-hover:animate-pulse"></div>
									</div>
									<span class="text-xs text-blue-400">95</span>
								</div>
							</div>
						</div>
					</div>
					
					<!-- Weapon Card 2 - Database -->
					<div class="group relative p-6 border border-[#90c5ff14] hover:border-indigo-400/40 transition-all bg-gradient-to-br from-[#90c5ff05] to-transparent">
						<div class="flex items-start gap-6">
							<div class="w-16 h-24 flex flex-col items-center justify-center border border-indigo-400/20 bg-indigo-500/5 relative">
								<span class="font-oldturcic text-3xl text-indigo-400 leading-none">𐰃</span>
								<div class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-8 h-1 bg-indigo-400/30"></div>
							</div>
							<div class="flex-1">
								<div class="flex items-center justify-between mb-2">
									<h3 class="font-sinistre text-xl text-indigo-300">Data Shield</h3>
									<span class="text-xs text-indigo-400/60 uppercase tracking-wider">Epic</span>
								</div>
								<p class="text-sm text-gray-500 mb-4">PostgreSQL, Redis, MongoDB. Defensive structures that guard precious data.</p>
								<div class="flex items-center gap-2">
									<span class="text-xs text-gray-600 w-12">Power</span>
									<div class="flex-1 h-2 bg-[#90c5ff10] overflow-hidden">
										<div class="h-full bg-gradient-to-r from-indigo-500 to-indigo-400 w-[90%] group-hover:animate-pulse"></div>
									</div>
									<span class="text-xs text-indigo-400">90</span>
								</div>
							</div>
						</div>
					</div>
					
					<!-- Weapon Card 3 - Systems -->
					<div class="group relative p-6 border border-[#90c5ff14] hover:border-cyan-400/40 transition-all bg-gradient-to-br from-[#90c5ff05] to-transparent">
						<div class="flex items-start gap-6">
							<div class="w-16 h-24 flex flex-col items-center justify-center border border-cyan-400/20 bg-cyan-500/5 relative">
								<span class="font-oldturcic text-3xl text-cyan-400 leading-none">𐰠</span>
								<div class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-8 h-1 bg-cyan-400/30"></div>
							</div>
							<div class="flex-1">
								<div class="flex items-center justify-between mb-2">
									<h3 class="font-sinistre text-xl text-cyan-300">System Spear</h3>
									<span class="text-xs text-cyan-400/60 uppercase tracking-wider">Legendary</span>
								</div>
								<p class="text-sm text-gray-500 mb-4">C, Rust, Linux. Piercing through to the metal, where true power lies.</p>
								<div class="flex items-center gap-2">
									<span class="text-xs text-gray-600 w-12">Power</span>
									<div class="flex-1 h-2 bg-[#90c5ff10] overflow-hidden">
										<div class="h-full bg-gradient-to-r from-cyan-500 to-cyan-400 w-[88%] group-hover:animate-pulse"></div>
									</div>
									<span class="text-xs text-cyan-400">88</span>
								</div>
							</div>
						</div>
					</div>
					
					<!-- Weapon Card 4 - Cloud -->
					<div class="group relative p-6 border border-[#90c5ff14] hover:border-amber-400/40 transition-all bg-gradient-to-br from-[#90c5ff05] to-transparent">
						<div class="flex items-start gap-6">
							<div class="w-16 h-24 flex flex-col items-center justify-center border border-amber-400/20 bg-amber-500/5 relative">
								<span class="font-oldturcic text-3xl text-amber-400 leading-none">𐱅</span>
								<div class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-8 h-1 bg-amber-400/30"></div>
							</div>
							<div class="flex-1">
								<div class="flex items-center justify-between mb-2">
									<h3 class="font-sinistre text-xl text-amber-300">Cloud Bow</h3>
									<span class="text-xs text-amber-400/60 uppercase tracking-wider">Epic</span>
								</div>
								<p class="text-sm text-gray-500 mb-4">Docker, Kubernetes, AWS. Striking from the clouds with precision.</p>
								<div class="flex items-center gap-2">
									<span class="text-xs text-gray-600 w-12">Power</span>
									<div class="flex-1 h-2 bg-[#90c5ff10] overflow-hidden">
										<div class="h-full bg-gradient-to-r from-amber-500 to-amber-400 w-[85%] group-hover:animate-pulse"></div>
									</div>
									<span class="text-xs text-amber-400">85</span>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- CONQUESTS SECTION - Projects as Victories -->
		<section id="conquests" class="px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14]">
			<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-4 flex items-center gap-4">
				<span class="font-oldturcic text-2xl md:text-3xl text-blue-400/30 leading-none">𐰼𐱅</span>
				Conquests
				<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
			</h2>
			<p class="text-gray-500 mb-12 max-w-xl">Territories claimed. Battles won. Each project a victory etched in digital stone.</p>
			
			<div class="space-y-8">
				<!-- Conquest 1 - Streaming Platform -->
				<div class="group relative border border-[#90c5ff14] hover:border-blue-400/30 transition-all overflow-hidden">
					<!-- Victory Banner -->
					<div class="absolute top-0 right-0 bg-blue-500/20 border-l border-b border-blue-400/30 px-4 py-2">
						<span class="text-xs text-blue-300 uppercase tracking-wider font-sinistre">Major Victory</span>
					</div>
					
					<div class="p-8">
						<div class="flex items-start gap-6">
							<!-- Victory Shield -->
							<div class="hidden md:flex w-24 h-28 flex-col items-center justify-center border-2 border-blue-400/30 bg-gradient-to-b from-blue-500/10 to-transparent relative">
								<span class="font-oldturcic text-4xl text-blue-400 leading-none">𐰇𐰕</span>
								<div class="absolute -bottom-2 left-1/2 -translate-x-1/2 text-xs text-blue-400/60">17K+</div>
							</div>
							
							<div class="flex-1">
								<h3 class="font-sinistre text-2xl md:text-3xl mb-2 group-hover:text-blue-200 transition-colors">Streaming Platform</h3>
								<p class="text-blue-400/60 text-sm mb-4">Deniz Egece Co. Ltd. | 2023</p>
								<p class="text-gray-400 leading-relaxed mb-6">
									Conquered the realm of video streaming, serving 17,000+ loyal subscribers. Built transcoding pipelines, payment fortifications, and real-time analytics watchtowers.
								</p>
								
								<!-- Battle Stats -->
								<div class="grid grid-cols-3 gap-4 mb-6">
									<div class="text-center p-3 border border-[#90c5ff14] bg-[#90c5ff05]">
										<div class="text-2xl font-sinistre text-blue-300">17K</div>
										<div class="text-xs text-gray-500">Users Served</div>
									</div>
									<div class="text-center p-3 border border-[#90c5ff14] bg-[#90c5ff05]">
										<div class="text-2xl font-sinistre text-blue-300">99.9%</div>
										<div class="text-xs text-gray-500">Uptime</div>
									</div>
									<div class="text-center p-3 border border-[#90c5ff14] bg-[#90c5ff05]">
										<div class="text-2xl font-sinistre text-blue-300">4</div>
										<div class="text-xs text-gray-500">Platforms</div>
									</div>
								</div>
								
								<div class="flex gap-2 flex-wrap">
									<span class="px-3 py-1 text-xs border border-[#90c5ff20] bg-[#90c5ff08]">Node.js</span>
									<span class="px-3 py-1 text-xs border border-[#90c5ff20] bg-[#90c5ff08]">PostgreSQL</span>
									<span class="px-3 py-1 text-xs border border-[#90c5ff20] bg-[#90c5ff08]">FFmpeg</span>
									<span class="px-3 py-1 text-xs border border-[#90c5ff20] bg-[#90c5ff08]">Redis</span>
								</div>
							</div>
						</div>
					</div>
				</div>
				
				<!-- Conquest 2 - Portfolio -->
				<div class="group relative border border-[#90c5ff14] hover:border-indigo-400/30 transition-all overflow-hidden">
					<div class="absolute top-0 right-0 bg-indigo-500/20 border-l border-b border-indigo-400/30 px-4 py-2">
						<span class="text-xs text-indigo-300 uppercase tracking-wider font-sinistre">Personal Triumph</span>
					</div>
					
					<div class="p-8">
						<div class="flex items-start gap-6">
							<div class="hidden md:flex w-24 h-28 flex-col items-center justify-center border-2 border-indigo-400/30 bg-gradient-to-b from-indigo-500/10 to-transparent relative">
								<span class="font-oldturcic text-4xl text-indigo-400 leading-none">𐰋𐰃</span>
								<div class="absolute -bottom-2 left-1/2 -translate-x-1/2 text-xs text-indigo-400/60">2024</div>
							</div>
							
							<div class="flex-1">
								<h3 class="font-sinistre text-2xl md:text-3xl mb-2 group-hover:text-indigo-200 transition-colors">Digital Monument</h3>
								<p class="text-indigo-400/60 text-sm mb-4">atduyar.com | Personal Project</p>
								<p class="text-gray-400 leading-relaxed mb-6">
									A monument to heritage and craft. Unique typography honoring Old Turkic scripts, modern web technologies, and meticulous attention to every interaction.
								</p>
								
								<div class="flex gap-2 flex-wrap">
									<span class="px-3 py-1 text-xs border border-[#90c5ff20] bg-[#90c5ff08]">Astro</span>
									<span class="px-3 py-1 text-xs border border-[#90c5ff20] bg-[#90c5ff08]">Tailwind</span>
									<span class="px-3 py-1 text-xs border border-[#90c5ff20] bg-[#90c5ff08]">Cloudflare</span>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Experience Section -->
		<section id="experience" class="px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14]">
			<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-12 flex items-center gap-4">
				<span class="font-oldturcic text-2xl md:text-3xl text-blue-400/30 leading-none">𐰇𐰕</span>
				Campaign History
				<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
			</h2>
			<div class="relative">
				<div class="absolute left-0 md:left-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-[#90c5ff30] via-[#90c5ff14] to-transparent"></div>
				
				<div class="relative pl-8 md:pl-0 md:w-1/2 md:pr-12 mb-12">
					<div class="absolute left-0 md:left-auto md:right-0 top-2 w-2 h-2 rounded-full bg-blue-400 md:translate-x-1/2"></div>
					<div class="p-6 border border-[#90c5ff14] hover:border-[#90c5ff30] transition-all">
						<span class="text-blue-400/80 text-sm">2023 - Present</span>
						<h3 class="font-sinistre text-xl mt-2">Full-Stack Developer</h3>
						<p class="text-gray-500 text-sm mb-3">Deniz Egece Co. Ltd.</p>
						<p class="text-gray-400 text-sm">Led development of streaming infrastructure, database architecture, and user-facing applications.</p>
					</div>
				</div>
				
				<div class="relative pl-8 md:pl-0 md:w-1/2 md:ml-auto md:pl-12">
					<div class="absolute left-0 md:left-0 top-2 w-2 h-2 rounded-full bg-indigo-400 md:-translate-x-1/2"></div>
					<div class="p-6 border border-[#90c5ff14] hover:border-[#90c5ff30] transition-all">
						<span class="text-indigo-400/80 text-sm">2022 - Present</span>
						<h3 class="font-sinistre text-xl mt-2">Software Engineering</h3>
						<p class="text-gray-500 text-sm mb-3">International University of Sarajevo</p>
						<p class="text-gray-400 text-sm">Honor Student. Deep focus on computer science fundamentals, algorithms, and system design.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Summon Section -->
		<section id="summon" class="px-4 md:px-8 lg:px-16 py-24 relative group">
			<BackgroundMarquee class="group-has-[button:hover]:text-white duration-500 transition-all">
				𐰚𐰇𐰠𐱅𐰃𐰏𐰤: 𐰖𐰸: 𐰼𐰾𐰼: 𐰸𐰆𐰯: 𐰇𐰠𐱅𐰲𐰃: 𐰼𐱅𐰏𐰕: 𐰃𐰤𐰢:
			</BackgroundMarquee>
			
