---
import BackgroundMarquee from "../../../components/BackgroundMarquee.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout title="Ahmet Tarik Duyar" description="Full-Stack Software Engineer Portfolio" bodyClass="bg-[#0a0b0d] text-white w-screen overflow-x-hidden">
	<main class="bg-[#0d0e12] border-x border-[#90c5ff14] max-w-7xl mx-auto min-h-dvh relative">
		<!-- Subtle noise overlay -->
		<div class="fixed inset-0 pointer-events-none opacity-[0.015] z-50" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 256 256%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22n%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23n)%22/%3E%3C/svg%3E');"></div>
		
		<!-- Navigation -->
		<nav class="py-6 px-4 md:px-8 border-b border-[#90c5ff14] sticky top-0 bg-[#0d0e12]/90 backdrop-blur-sm z-40">
			<div class="flex justify-between items-center">
				<a href="#hero" class="group flex items-center gap-3">
					<div class="w-10 h-10 rounded-full border border-blue-400/30 flex items-center justify-center group-hover:border-blue-400/60 transition-colors relative overflow-hidden">
						<div class="absolute inset-0 bg-blue-500/10 group-hover:bg-blue-500/20 transition-colors"></div>
						<img src="/favicon.svg" alt="Logo" class="w-6 h-6 relative z-10" />
					</div>
					<span class="font-sinistre text-xl tracking-wide hidden sm:block">Atduyar</span>
				</a>
				<ul class="flex gap-4 md:gap-8">
					<li><a href="#laboratory" class="nav-link font-sinistre text-lg hover:text-blue-300 transition-all">Lab</a></li>
					<li><a href="#missions" class="nav-link font-sinistre text-lg hover:text-blue-300 transition-all">Missions</a></li>
					<li><a href="#reactor" class="nav-link font-sinistre text-lg hover:text-blue-300 transition-all">Reactor</a></li>
					<li><a href="#transmission" class="nav-link font-sinistre text-lg px-4 py-1 border border-blue-500/30 hover:bg-blue-600/10 rounded-full">Transmit</a></li>
				</ul>
			</div>
		</nav>

		<!-- Hero Section -->
		<section id="hero" class="min-h-[85vh] flex flex-col justify-center px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14] relative overflow-hidden">
			<div class="absolute inset-0">
				<div class="absolute top-1/4 left-1/4 w-[500px] h-[500px] bg-blue-500/10 rounded-full blur-[150px]"></div>
				<div class="absolute bottom-1/3 right-1/4 w-[400px] h-[400px] bg-indigo-500/10 rounded-full blur-[120px]"></div>
			</div>
			
			<!-- Floating atoms decoration -->
			<div class="absolute inset-0 overflow-hidden pointer-events-none">
				<div class="atom absolute top-[20%] right-[15%] w-24 h-24">
					<div class="absolute inset-0 border border-blue-400/20 rounded-full animate-spin-slow"></div>
					<div class="absolute inset-2 border border-blue-400/15 rounded-full animate-spin-reverse"></div>
					<div class="absolute inset-[40%] bg-blue-400/30 rounded-full"></div>
				</div>
				<div class="atom absolute bottom-[25%] left-[10%] w-16 h-16">
					<div class="absolute inset-0 border border-indigo-400/20 rounded-full animate-spin-slow"></div>
					<div class="absolute inset-1 border border-indigo-400/15 rounded-full animate-spin-reverse"></div>
					<div class="absolute inset-[35%] bg-indigo-400/30 rounded-full"></div>
				</div>
			</div>
			
			<div class="relative z-10">
				<p class="font-oldturcic text-blue-400/50 text-lg mb-4 tracking-[0.4em] animate-fade-in leading-none">𐰚𐰇𐰠𐱅𐰃𐰏𐰤</p>
				<h1 class="text-5xl sm:text-7xl lg:text-8xl xl:text-9xl font-sinistre leading-[0.9] mb-8">
					<span class="block animate-slide-up" style="animation-delay: 0.1s;">I'm Ahmet</span>
					<span class="block animate-slide-up" style="animation-delay: 0.2s;">
						<span class="text-blue-300">Tarik</span> Duyar
					</span>
				</h1>
				<p class="text-lg md:text-xl text-gray-400 max-w-xl animate-fade-in leading-relaxed" style="animation-delay: 0.5s;">
					Building robust backend architectures and scalable systems. 
					Passionate about C, Rust, and Linux.
				</p>
				<div class="flex gap-4 mt-10 animate-fade-in" style="animation-delay: 0.7s;">
					<a href="#missions" class="group px-6 py-3 bg-blue-600/10 border border-blue-500/30 hover:bg-blue-600/20 hover:border-blue-400/50 transition-all font-sinistre text-lg rounded-sm">
						View Missions
					</a>
					<a href="#transmission" class="px-6 py-3 border border-[#90c5ff14] hover:border-[#90c5ff30] transition-all font-sinistre text-lg rounded-sm">
						Transmit Signal
					</a>
				</div>
			</div>
		</section>

		<!-- About Section -->
		<section id="about" class="px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14]">
			<div class="flex flex-col lg:flex-row gap-12 items-start">
				<div class="flex-1">
					<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-8 flex items-center gap-4">
						<span class="font-oldturcic text-2xl md:text-3xl text-blue-400/30 leading-none">𐰋𐰃𐰠</span>
						About Me
						<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
					</h2>
					<div class="space-y-6 text-gray-300 text-lg leading-relaxed">
						<p>
							I'm a Full-Stack Software Engineer with a year of professional experience specializing in building robust backend architectures, designing scalable databases, and managing critical systems.
						</p>
						<p>
							During my time at <span class="text-white">Deniz Egece Co. Ltd.</span>, I took ownership of architecting and deploying a streaming platform serving over <span class="text-blue-300">17,000 paid users</span>, demonstrating my ability to deliver end-to-end solutions across various platforms.
						</p>
						<p>
							As an <span class="text-white">Honor Student</span> in Software Engineering at the International University of Sarajevo, I'm deeply focused on computer science fundamentals while actively exploring C, Rust, JavaScript, and Linux.
						</p>
					</div>
				</div>
				<div class="w-full lg:w-80 flex-shrink-0">
					<div class="aspect-square rounded-sm p-8 flex items-center justify-center relative group border border-[#90c5ff14]">
						<img src="/favicon.svg" alt="Logo" class="w-full h-full opacity-80 relative z-10" />
					</div>
				</div>
			</div>
		</section>

		<!-- THE LABORATORY - Skills as Periodic Table Elements -->
		<section id="laboratory" class="px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14] relative overflow-hidden">
			<!-- Grid pattern background -->
			<div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(144,197,255,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(144,197,255,0.5) 1px, transparent 1px); background-size: 40px 40px;"></div>
			
			<div class="relative z-10">
				<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-4 flex items-center gap-4">
					<span class="font-oldturcic text-2xl md:text-3xl text-blue-400/30 leading-none">𐰽𐰴</span>
					The Laboratory
					<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
				</h2>
				<p class="text-gray-500 mb-12 max-w-2xl">Elements of expertise synthesized through years of experimentation and discovery.</p>
				
				<!-- Periodic Table Style Grid -->
				<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
					<!-- Element: Backend -->
					<div class="element-card group relative aspect-square border border-[#90c5ff20] hover:border-blue-400/50 transition-all bg-gradient-to-br from-blue-500/5 to-transparent p-3 cursor-pointer">
						<div class="absolute top-2 left-2 text-[10px] text-blue-400/60 font-mono">01</div>
						<div class="absolute top-2 right-2 text-[10px] text-gray-600 font-mono">138.2</div>
						<div class="flex flex-col items-center justify-center h-full">
							<span class="text-3xl sm:text-4xl font-sinistre text-blue-300 group-hover:scale-110 transition-transform">Be</span>
							<span class="text-[10px] sm:text-xs text-gray-500 mt-1 text-center">Backend</span>
						</div>
						<div class="absolute bottom-2 left-0 right-0 text-[8px] text-gray-600 text-center">Node.js • Rust • Go</div>
						<!-- Hover glow -->
						<div class="absolute inset-0 bg-blue-500/0 group-hover:bg-blue-500/10 transition-colors rounded-sm"></div>
					</div>
					
					<!-- Element: Database -->
					<div class="element-card group relative aspect-square border border-[#90c5ff20] hover:border-indigo-400/50 transition-all bg-gradient-to-br from-indigo-500/5 to-transparent p-3 cursor-pointer">
						<div class="absolute top-2 left-2 text-[10px] text-indigo-400/60 font-mono">02</div>
						<div class="absolute top-2 right-2 text-[10px] text-gray-600 font-mono">95.7</div>
						<div class="flex flex-col items-center justify-center h-full">
							<span class="text-3xl sm:text-4xl font-sinistre text-indigo-300 group-hover:scale-110 transition-transform">Db</span>
							<span class="text-[10px] sm:text-xs text-gray-500 mt-1 text-center">Database</span>
						</div>
						<div class="absolute bottom-2 left-0 right-0 text-[8px] text-gray-600 text-center">PostgreSQL • Redis</div>
						<div class="absolute inset-0 bg-indigo-500/0 group-hover:bg-indigo-500/10 transition-colors rounded-sm"></div>
					</div>
					
					<!-- Element: Systems -->
					<div class="element-card group relative aspect-square border border-[#90c5ff20] hover:border-cyan-400/50 transition-all bg-gradient-to-br from-cyan-500/5 to-transparent p-3 cursor-pointer">
						<div class="absolute top-2 left-2 text-[10px] text-cyan-400/60 font-mono">03</div>
						<div class="absolute top-2 right-2 text-[10px] text-gray-600 font-mono">201.4</div>
						<div class="flex flex-col items-center justify-center h-full">
							<span class="text-3xl sm:text-4xl font-sinistre text-cyan-300 group-hover:scale-110 transition-transform">Sy</span>
							<span class="text-[10px] sm:text-xs text-gray-500 mt-1 text-center">Systems</span>
						</div>
						<div class="absolute bottom-2 left-0 right-0 text-[8px] text-gray-600 text-center">C • Rust • Linux</div>
						<div class="absolute inset-0 bg-cyan-500/0 group-hover:bg-cyan-500/10 transition-colors rounded-sm"></div>
					</div>
					
					<!-- Element: Frontend -->
					<div class="element-card group relative aspect-square border border-[#90c5ff20] hover:border-emerald-400/50 transition-all bg-gradient-to-br from-emerald-500/5 to-transparent p-3 cursor-pointer">
						<div class="absolute top-2 left-2 text-[10px] text-emerald-400/60 font-mono">04</div>
						<div class="absolute top-2 right-2 text-[10px] text-gray-600 font-mono">88.3</div>
						<div class="flex flex-col items-center justify-center h-full">
							<span class="text-3xl sm:text-4xl font-sinistre text-emerald-300 group-hover:scale-110 transition-transform">Fe</span>
							<span class="text-[10px] sm:text-xs text-gray-500 mt-1 text-center">Frontend</span>
						</div>
						<div class="absolute bottom-2 left-0 right-0 text-[8px] text-gray-600 text-center">React • TypeScript</div>
						<div class="absolute inset-0 bg-emerald-500/0 group-hover:bg-emerald-500/10 transition-colors rounded-sm"></div>
					</div>
					
					<!-- Element: DevOps -->
					<div class="element-card group relative aspect-square border border-[#90c5ff20] hover:border-amber-400/50 transition-all bg-gradient-to-br from-amber-500/5 to-transparent p-3 cursor-pointer">
						<div class="absolute top-2 left-2 text-[10px] text-amber-400/60 font-mono">05</div>
						<div class="absolute top-2 right-2 text-[10px] text-gray-600 font-mono">156.9</div>
						<div class="flex flex-col items-center justify-center h-full">
							<span class="text-3xl sm:text-4xl font-sinistre text-amber-300 group-hover:scale-110 transition-transform">Dv</span>
							<span class="text-[10px] sm:text-xs text-gray-500 mt-1 text-center">DevOps</span>
						</div>
						<div class="absolute bottom-2 left-0 right-0 text-[8px] text-gray-600 text-center">Docker • K8s • AWS</div>
						<div class="absolute inset-0 bg-amber-500/0 group-hover:bg-amber-500/10 transition-colors rounded-sm"></div>
					</div>
					
					<!-- Element: Streaming -->
					<div class="element-card group relative aspect-square border border-[#90c5ff20] hover:border-rose-400/50 transition-all bg-gradient-to-br from-rose-500/5 to-transparent p-3 cursor-pointer">
						<div class="absolute top-2 left-2 text-[10px] text-rose-400/60 font-mono">06</div>
						<div class="absolute top-2 right-2 text-[10px] text-gray-600 font-mono">243.1</div>
						<div class="flex flex-col items-center justify-center h-full">
							<span class="text-3xl sm:text-4xl font-sinistre text-rose-300 group-hover:scale-110 transition-transform">St</span>
							<span class="text-[10px] sm:text-xs text-gray-500 mt-1 text-center">Streaming</span>
						</div>
						<div class="absolute bottom-2 left-0 right-0 text-[8px] text-gray-600 text-center">FFmpeg • Real-time</div>
						<div class="absolute inset-0 bg-rose-500/0 group-hover:bg-rose-500/10 transition-colors rounded-sm"></div>
					</div>
				</div>
			</div>
		</section>

		<!-- MISSION CONTROL - Projects as Space Missions -->
		<section id="missions" class="px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14] relative overflow-hidden">
			<!-- Starfield background -->
			<div class="absolute inset-0 overflow-hidden">
				<div class="star absolute w-1 h-1 bg-white/20 rounded-full top-[10%] left-[20%] animate-twinkle"></div>
				<div class="star absolute w-0.5 h-0.5 bg-white/30 rounded-full top-[30%] left-[70%] animate-twinkle" style="animation-delay: 0.5s;"></div>
				<div class="star absolute w-1 h-1 bg-white/15 rounded-full top-[60%] left-[40%] animate-twinkle" style="animation-delay: 1s;"></div>
				<div class="star absolute w-0.5 h-0.5 bg-white/25 rounded-full top-[80%] left-[85%] animate-twinkle" style="animation-delay: 1.5s;"></div>
				<div class="star absolute w-1 h-1 bg-white/20 rounded-full top-[45%] left-[15%] animate-twinkle" style="animation-delay: 0.7s;"></div>
			</div>
			
			<div class="relative z-10">
				<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-4 flex items-center gap-4">
					<span class="font-oldturcic text-2xl md:text-3xl text-blue-400/30 leading-none">𐰼𐱅</span>
					Mission Control
					<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
				</h2>
				<p class="text-gray-500 mb-12 max-w-2xl">Active and completed missions in the software engineering frontier.</p>
				
				<div class="space-y-6">
					<!-- Mission 1: Streaming Platform -->
					<div class="mission-card group border border-[#90c5ff14] hover:border-blue-400/30 transition-all relative overflow-hidden">
						<!-- Mission header bar -->
						<div class="bg-blue-500/10 border-b border-[#90c5ff14] px-6 py-3 flex items-center justify-between">
							<div class="flex items-center gap-4">
								<div class="w-3 h-3 rounded-full bg-emerald-400 animate-pulse shadow-[0_0_10px_rgba(52,211,153,0.5)]"></div>
								<span class="font-mono text-sm text-emerald-400">MISSION ACTIVE</span>
							</div>
							<span class="font-mono text-xs text-gray-500">ID: STRM-2023-001</span>
						</div>
						
						<div class="p-6 md:p-8">
							<div class="flex flex-col lg:flex-row gap-8">
								<!-- Mission info -->
								<div class="flex-1">
									<h3 class="font-sinistre text-2xl mb-2 group-hover:text-blue-200 transition-colors">Streaming Platform</h3>
									<p class="text-blue-400/60 text-sm mb-4">Deniz Egece Co. Ltd.</p>
									<p class="text-gray-400 leading-relaxed mb-4">
										Architected and deployed a full-featured streaming platform serving 17,000+ paid users. 
										Implemented video transcoding pipelines, payment integrations, and real-time analytics.
									</p>
									<div class="flex gap-2 flex-wrap">
										<span class="px-3 py-1 text-xs border border-[#90c5ff20] bg-[#90c5ff08] rounded-full">Node.js</span>
										<span class="px-3 py-1 text-xs border border-[#90c5ff20] bg-[#90c5ff08] rounded-full">PostgreSQL</span>
										<span class="px-3 py-1 text-xs border border-[#90c5ff20] bg-[#90c5ff08] rounded-full">FFmpeg</span>
									</div>
								</div>
								
								<!-- Telemetry panel -->
								<div class="lg:w-64 space-y-4">
									<div class="text-xs text-gray-500 font-mono mb-2">TELEMETRY</div>
									<div class="space-y-3">
										<div>
											<div class="flex justify-between text-xs mb-1">
												<span class="text-gray-500">Users Served</span>
												<span class="text-blue-300 font-mono">17,000+</span>
											</div>
											<div class="h-1.5 bg-[#90c5ff10] rounded-full overflow-hidden">
												<div class="h-full bg-blue-400/60 rounded-full" style="width: 85%;"></div>
											</div>
										</div>
										<div>
											<div class="flex justify-between text-xs mb-1">
												<span class="text-gray-500">Uptime</span>
												<span class="text-emerald-300 font-mono">99.9%</span>
											</div>
											<div class="h-1.5 bg-[#90c5ff10] rounded-full overflow-hidden">
												<div class="h-full bg-emerald-400/60 rounded-full" style="width: 99%;"></div>
											</div>
										</div>
										<div>
											<div class="flex justify-between text-xs mb-1">
												<span class="text-gray-500">Completion</span>
												<span class="text-amber-300 font-mono">100%</span>
											</div>
											<div class="h-1.5 bg-[#90c5ff10] rounded-full overflow-hidden">
												<div class="h-full bg-amber-400/60 rounded-full" style="width: 100%;"></div>
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
					
					<!-- Mission 2: Portfolio -->
					<div class="mission-card group border border-[#90c5ff14] hover:border-indigo-400/30 transition-all relative overflow-hidden">
						<div class="bg-indigo-500/10 border-b border-[#90c5ff14] px-6 py-3 flex items-center justify-between">
							<div class="flex items-center gap-4">
								<div class="w-3 h-3 rounded-full bg-blue-400 animate-pulse shadow-[0_0_10px_rgba(96,165,250,0.5)]"></div>
								<span class="font-mono text-sm text-blue-400">IN DEVELOPMENT</span>
							</div>
							<span class="font-mono text-xs text-gray-500">ID: PORT-2024-001</span>
						</div>
						
						<div class="p-6 md:p-8">
							<div class="flex flex-col lg:flex-row gap-8">
								<div class="flex-1">
									<h3 class="font-sinistre text-2xl mb-2 group-hover:text-indigo-200 transition-colors">Personal Portfolio</h3>
									<p class="text-indigo-400/60 text-sm mb-4">atduyar.com</p>
									<p class="text-gray-400 leading-relaxed mb-4">
										Custom portfolio featuring unique typography with Sinistre variable font,
										Old Turkic script elements, and meticulously crafted interactions.
									</p>
									<div class="flex gap-2 flex-wrap">
										<span class="px-3 py-1 text-xs border border-[#90c5ff20] bg-[#90c5ff08] rounded-full">Astro</span>
										<span class="px-3 py-1 text-xs border border-[#90c5ff20] bg-[#90c5ff08] rounded-full">Tailwind</span>
										<span class="px-3 py-1 text-xs border border-[#90c5ff20] bg-[#90c5ff08] rounded-full">Cloudflare</span>
									</div>
								</div>
								
								<div class="lg:w-64 space-y-4">
									<div class="text-xs text-gray-500 font-mono mb-2">TELEMETRY</div>
									<div class="space-y-3">
										<div>
											<div class="flex justify-between text-xs mb-1">
												<span class="text-gray-500">Design Iterations</span>
												<span class="text-indigo-300 font-mono">9+</span>
											</div>
											<div class="h-1.5 bg-[#90c5ff10] rounded-full overflow-hidden">
												<div class="h-full bg-indigo-400/60 rounded-full" style="width: 90%;"></div>
											</div>
										</div>
										<div>
											<div class="flex justify-between text-xs mb-1">
												<span class="text-gray-500">Lighthouse Score</span>
												<span class="text-emerald-300 font-mono">98</span>
											</div>
											<div class="h-1.5 bg-[#90c5ff10] rounded-full overflow-hidden">
												<div class="h-full bg-emerald-400/60 rounded-full" style="width: 98%;"></div>
											</div>
										</div>
										<div>
											<div class="flex justify-between text-xs mb-1">
												<span class="text-gray-500">Completion</span>
												<span class="text-amber-300 font-mono">75%</span>
											</div>
											<div class="h-1.5 bg-[#90c5ff10] rounded-full overflow-hidden">
												<div class="h-full bg-amber-400/60 rounded-full" style="width: 75%;"></div>
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- NEW SECTION: REACTOR CORE - Current Focus/Learning Areas -->
		<section id="reactor" class="px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14] relative overflow-hidden">
			<div class="relative z-10">
				<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-4 flex items-center gap-4">
					<span class="font-oldturcic text-2xl md:text-3xl text-blue-400/30 leading-none">𐰇𐰕</span>
					Reactor Core
					<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
				</h2>
				<p class="text-gray-500 mb-12 max-w-2xl">Current energy allocation across active learning and research domains.</p>
				
				<!-- Reactor visualization -->
				<div class="flex flex-col lg:flex-row gap-12 items-center">
					<!-- Central reactor core -->
