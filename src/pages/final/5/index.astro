---
import BackgroundMarquee from "../../../components/BackgroundMarquee.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout title="Ahmet Tarik Duyar" description="Full-Stack Software Engineer Portfolio" bodyClass="bg-[#0a0b0d] text-white w-screen overflow-x-hidden">
	<main class="bg-[#0d0e12] border-x border-[#90c5ff14] max-w-7xl mx-auto min-h-dvh relative">
		<!-- Subtle noise overlay -->
		<div class="fixed inset-0 pointer-events-none opacity-[0.015] z-50" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 256 256%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22n%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23n)%22/%3E%3C/svg%3E');"></div>
		
		<!-- Vertical Turkic text sidebar -->
		<aside class="fixed left-4 top-1/2 -translate-y-1/2 z-30 hidden xl:block">
			<div class="font-oldturcic text-blue-400/20 text-2xl writing-vertical tracking-[0.5em] leading-none">
				𐰚𐰇𐰠𐱅𐰃𐰏𐰤𐰖𐰸𐰼𐰾𐰼
			</div>
		</aside>

		<!-- Navigation -->
		<nav class="py-6 px-4 md:px-8 border-b border-[#90c5ff14] sticky top-0 bg-[#0d0e12]/90 backdrop-blur-sm z-40">
			<div class="flex justify-between items-center">
				<a href="#hero" class="group flex items-center gap-3">
					<img src="/favicon.svg" alt="Logo" class="w-8 h-8 transition-transform group-hover:rotate-12" />
					<span class="font-oldturcic text-xl text-blue-400 leading-none hidden sm:block">𐱅𐰭𐰼𐰃</span>
				</a>
				<ul class="flex gap-4 md:gap-8">
					<li><a href="#origin" class="nav-link font-sinistre text-lg hover:text-blue-300 transition-all hover:-translate-y-0.5 relative after:absolute after:bottom-0 after:left-0 after:w-0 after:h-px after:bg-blue-300 hover:after:w-full after:transition-all">Origin</a></li>
					<li><a href="#craft" class="nav-link font-sinistre text-lg hover:text-blue-300 transition-all hover:-translate-y-0.5 relative after:absolute after:bottom-0 after:left-0 after:w-0 after:h-px after:bg-blue-300 hover:after:w-full after:transition-all">Craft</a></li>
					<li><a href="#chronicle" class="nav-link font-sinistre text-lg hover:text-blue-300 transition-all hover:-translate-y-0.5 relative after:absolute after:bottom-0 after:left-0 after:w-0 after:h-px after:bg-blue-300 hover:after:w-full after:transition-all">Chronicle</a></li>
					<li><a href="#summon" class="nav-link font-sinistre text-lg px-4 py-1 border border-blue-500/30 hover:bg-blue-600/10 hover:border-blue-400/50 transition-all">Summon</a></li>
				</ul>
			</div>
		</nav>

		<!-- Hero Section - Centered & Poetic -->
		<section id="hero" class="min-h-screen flex flex-col items-center justify-center px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14] relative overflow-hidden">
			<!-- Gradient blobs -->
			<div class="absolute inset-0 opacity-5">
				<div class="absolute top-1/4 left-1/4 w-96 h-96 bg-blue-500 rounded-full blur-[128px]"></div>
				<div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-indigo-500 rounded-full blur-[128px]"></div>
			</div>
			
			<div class="relative z-10 text-center max-w-4xl">
				<!-- Decorative top ornament -->
				<div class="flex items-center justify-center gap-4 mb-8 animate-fade-in">
					<div class="w-16 h-px bg-gradient-to-r from-transparent to-blue-400/50"></div>
					<span class="font-oldturcic text-lg text-blue-400/40 leading-none">𐰋𐰃𐰠𐰼</span>
					<div class="w-16 h-px bg-gradient-to-l from-transparent to-blue-400/50"></div>
				</div>
				
				<p class="font-oldturcic text-blue-400/40 text-xl mb-6 tracking-[0.4em] animate-fade-in leading-none" style="animation-delay: 0.1s;">𐰚𐰇𐰠𐱅𐰃𐰏𐰤</p>
				
				<h1 class="text-5xl sm:text-7xl lg:text-8xl xl:text-9xl font-sinistre leading-[0.9] mb-8">
					<span class="block animate-rise-1">Ahmet Tarik</span>
					<span class="block animate-rise-2 text-blue-300">Duyar</span>
				</h1>
				
				<!-- Subtitle with decorative lines -->
				<div class="flex items-center justify-center gap-4 mb-8 animate-fade-in-delayed">
					<div class="h-px w-12 sm:w-20 bg-gradient-to-r from-transparent to-blue-400/50"></div>
					<p class="text-sm sm:text-base tracking-[0.3em] uppercase text-gray-500">Software Engineer</p>
					<div class="h-px w-12 sm:w-20 bg-gradient-to-l from-transparent to-blue-400/50"></div>
				</div>
				
				<p class="text-lg md:text-xl text-gray-400 max-w-xl mx-auto animate-fade-in-delayed leading-relaxed" style="animation-delay: 0.6s;">
					From the lands where ancient scripts carved wisdom into stone, I carry the same precision into modern architecture.
				</p>
				
				<!-- Bottom ornament -->
				<div class="flex items-center justify-center gap-4 mt-12 animate-fade-in-delayed" style="animation-delay: 0.8s;">
					<div class="w-24 h-px bg-gradient-to-r from-transparent via-blue-400/30 to-transparent"></div>
				</div>
			</div>
			
			<!-- Scroll prompt -->
			<div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-3">
				<span class="text-xs tracking-widest uppercase text-gray-600">Descend</span>
				<div class="w-px h-12 bg-gradient-to-b from-blue-400/50 to-transparent animate-pulse"></div>
			</div>
		</section>

		<!-- Origin/About Section -->
		<section id="origin" class="px-4 md:px-8 lg:px-16 py-24 border-b border-[#90c5ff14]">
			<div class="flex flex-col lg:flex-row gap-12 items-start">
				<div class="flex-1">
					<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-8 flex items-center gap-4">
						<span class="font-oldturcic text-2xl md:text-3xl text-blue-400/30 leading-none">𐰋𐰃𐰠</span>
						Origin
						<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
					</h2>
					<div class="space-y-6 text-gray-300 text-lg leading-relaxed">
						<p>
							A Full-Stack Software Engineer from the lands where ancient scripts once carved wisdom into stone. I carry the same precision into modern architecture.
						</p>
						<p>
							At <span class="text-blue-300">Deniz Egece Co. Ltd.</span>, I architected a streaming platform serving <span class="text-blue-300">17,000+ subscribers</span>, managing video transcoding pipelines, payment systems, and real-time analytics.
						</p>
						<p>
							Currently an <span class="text-white">Honor Student</span> at the International University of Sarajevo, diving deep into the roots of computing: C, Rust, and Linux systems.
						</p>
					</div>
				</div>
				<div class="w-full lg:w-72 flex-shrink-0">
					<!-- Decorative card with emblem and corner decorations -->
					<div class="aspect-square border border-[#90c5ff14] bg-gradient-to-br from-[#90c5ff05] to-transparent p-6 flex items-center justify-center relative">
						<img src="/favicon.svg" alt="Emblem" class="w-3/4 opacity-60" />
						<!-- Corner decorations -->
						<div class="absolute top-0 left-0 w-6 h-6 border-t border-l border-blue-400/40"></div>
						<div class="absolute top-0 right-0 w-6 h-6 border-t border-r border-blue-400/40"></div>
						<div class="absolute bottom-0 left-0 w-6 h-6 border-b border-l border-blue-400/40"></div>
						<div class="absolute bottom-0 right-0 w-6 h-6 border-b border-r border-blue-400/40"></div>
					</div>
				</div>
			</div>
		</section>

		<!-- Craft/Skills Section -->
		<section id="craft" class="px-4 md:px-8 lg:px-16 py-24 border-b border-[#90c5ff14] relative overflow-hidden">
			<!-- Scrolling Turkic text background -->
			<div class="absolute inset-0 flex items-center overflow-hidden pointer-events-none">
				<div class="flex whitespace-nowrap animate-scroll-slow">
					<span class="font-oldturcic text-[80px] sm:text-[120px] md:text-[160px] lg:text-[200px] text-blue-400/[0.04] leading-none px-8">
						𐰚𐰇𐰠𐱅𐰃𐰏𐰤 𐰖𐰸 𐰼𐰾𐰼 𐰸𐰆𐰯 𐰇𐰠𐱅𐰲𐰃 𐰼𐱅𐰏𐰕 𐰃𐰤𐰢
					</span>
					<span class="font-oldturcic text-[80px] sm:text-[120px] md:text-[160px] lg:text-[200px] text-blue-400/[0.04] leading-none px-8">
						𐰚𐰇𐰠𐱅𐰃𐰏𐰤 𐰖𐰸 𐰼𐰾𐰼 𐰸𐰆𐰯 𐰇𐰠𐱅𐰲𐰃 𐰼𐱅𐰏𐰕 𐰃𐰤𐰢
					</span>
				</div>
			</div>
			
			<div class="relative z-10">
				<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-12 flex items-center gap-4">
					<span class="font-oldturcic text-2xl md:text-3xl text-blue-400/30 leading-none">𐰽𐰴</span>
					Craft
					<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
				</h2>
				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
					<!-- Skill cards with ancient aesthetic -->
					<div class="group p-6 border border-[#90c5ff14] hover:border-[#90c5ff30] bg-[#0d0e12]/80 backdrop-blur-sm transition-all duration-300 relative overflow-hidden">
						<div class="absolute inset-0 bg-gradient-to-br from-blue-600/0 to-blue-600/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
						<div class="relative z-10">
							<span class="font-oldturcic text-2xl text-blue-400/50 block mb-4 leading-none">𐰋</span>
							<h3 class="font-sinistre text-xl text-blue-300 mb-3">Backend Mastery</h3>
							<p class="text-sm text-gray-500 leading-relaxed">Node.js, Rust, Go, Python. Building systems that endure.</p>
						</div>
					</div>
					
					<div class="group p-6 border border-[#90c5ff14] hover:border-[#90c5ff30] bg-[#0d0e12]/80 backdrop-blur-sm transition-all duration-300 relative overflow-hidden">
						<div class="absolute inset-0 bg-gradient-to-br from-indigo-600/0 to-indigo-600/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
						<div class="relative z-10">
							<span class="font-oldturcic text-2xl text-indigo-400/50 block mb-4 leading-none">𐰃</span>
							<h3 class="font-sinistre text-xl text-indigo-300 mb-3">Database Architecture</h3>
							<p class="text-sm text-gray-500 leading-relaxed">PostgreSQL, Redis, MongoDB. Data carved in silicon.</p>
						</div>
					</div>
					
					<div class="group p-6 border border-[#90c5ff14] hover:border-[#90c5ff30] bg-[#0d0e12]/80 backdrop-blur-sm transition-all duration-300 relative overflow-hidden">
						<div class="absolute inset-0 bg-gradient-to-br from-cyan-600/0 to-cyan-600/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
						<div class="relative z-10">
							<span class="font-oldturcic text-2xl text-cyan-400/50 block mb-4 leading-none">𐰠</span>
							<h3 class="font-sinistre text-xl text-cyan-300 mb-3">Systems Programming</h3>
							<p class="text-sm text-gray-500 leading-relaxed">C, Rust, Linux. Close to the metal.</p>
						</div>
					</div>
					
					<div class="group p-6 border border-[#90c5ff14] hover:border-[#90c5ff30] bg-[#0d0e12]/80 backdrop-blur-sm transition-all duration-300 relative overflow-hidden">
						<div class="absolute inset-0 bg-gradient-to-br from-emerald-600/0 to-emerald-600/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
						<div class="relative z-10">
							<span class="font-oldturcic text-2xl text-emerald-400/50 block mb-4 leading-none">𐱅</span>
							<h3 class="font-sinistre text-xl text-emerald-300 mb-3">Cloud Infrastructure</h3>
							<p class="text-sm text-gray-500 leading-relaxed">Docker, Kubernetes, AWS. Clouds over the steppe.</p>
						</div>
					</div>
					
					<div class="group p-6 border border-[#90c5ff14] hover:border-[#90c5ff30] bg-[#0d0e12]/80 backdrop-blur-sm transition-all duration-300 relative overflow-hidden">
						<div class="absolute inset-0 bg-gradient-to-br from-amber-600/0 to-amber-600/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
						<div class="relative z-10">
							<span class="font-oldturcic text-2xl text-amber-400/50 block mb-4 leading-none">𐰏</span>
							<h3 class="font-sinistre text-xl text-amber-300 mb-3">Streaming Technology</h3>
							<p class="text-sm text-gray-500 leading-relaxed">FFmpeg, HLS, Real-time. Rivers of data.</p>
						</div>
					</div>
					
					<div class="group p-6 border border-[#90c5ff14] hover:border-[#90c5ff30] bg-[#0d0e12]/80 backdrop-blur-sm transition-all duration-300 relative overflow-hidden">
						<div class="absolute inset-0 bg-gradient-to-br from-rose-600/0 to-rose-600/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
						<div class="relative z-10">
							<span class="font-oldturcic text-2xl text-rose-400/50 block mb-4 leading-none">𐰚</span>
							<h3 class="font-sinistre text-xl text-rose-300 mb-3">Frontend Craft</h3>
							<p class="text-sm text-gray-500 leading-relaxed">React, TypeScript, Tailwind. The visible layer.</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Chronicle/Experience Section - Epic Timeline -->
		<section id="chronicle" class="px-4 md:px-8 lg:px-16 py-24 border-b border-[#90c5ff14]">
			<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-16 flex items-center gap-4">
				<span class="font-oldturcic text-2xl md:text-3xl text-blue-400/30 leading-none">𐰇𐰕</span>
				Chronicle
				<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
			</h2>
			
			<div class="space-y-16 max-w-3xl">
				<!-- Chronicle Entry 1 -->
				<article class="relative pl-8 border-l border-blue-400/20">
					<div class="absolute left-0 top-0 w-2 h-2 rounded-full bg-blue-400 -translate-x-1/2"></div>
					<span class="text-sm text-blue-400/60 tracking-wider">The Beginning</span>
					<h3 class="font-sinistre text-2xl mt-2 mb-4">Software Engineering @ IUS</h3>
					<p class="text-gray-500 leading-relaxed">
						Honor Student pursuing the ancient arts of computation. Deep study of algorithms, data structures, and the foundations upon which all systems are built. Mastery of C, Rust, and the Linux kernel.
					</p>
				</article>
				
				<!-- Chronicle Entry 2 -->
				<article class="relative pl-8 border-l border-blue-400/20">
					<div class="absolute left-0 top-0 w-2 h-2 rounded-full bg-indigo-400 -translate-x-1/2"></div>
					<span class="text-sm text-indigo-400/60 tracking-wider">The First Campaign</span>
					<h3 class="font-sinistre text-2xl mt-2 mb-4">Streaming Platform @ Deniz Egece</h3>
					<p class="text-gray-500 leading-relaxed mb-4">
						Architected a fortress of streaming serving 17,000+ warriors. Video transcoding pipelines flowing like rivers, payment gates guarding the treasury, analytics watching over all.
					</p>
					<div class="flex flex-wrap gap-2">
						<span class="px-3 py-1 text-xs border border-blue-400/20 text-blue-400/60">Node.js</span>
						<span class="px-3 py-1 text-xs border border-blue-400/20 text-blue-400/60">PostgreSQL</span>
						<span class="px-3 py-1 text-xs border border-blue-400/20 text-blue-400/60">FFmpeg</span>
						<span class="px-3 py-1 text-xs border border-blue-400/20 text-blue-400/60">Redis</span>
					</div>
				</article>
				
				<!-- Chronicle Entry 3 -->
				<article class="relative pl-8 border-l border-blue-400/20">
					<div class="absolute left-0 top-0 w-2 h-2 rounded-full bg-cyan-400 -translate-x-1/2"></div>
					<span class="text-sm text-cyan-400/60 tracking-wider">The Heritage</span>
					<h3 class="font-sinistre text-2xl mt-2 mb-4">Portfolio of the Steppe</h3>
					<p class="text-gray-500 leading-relaxed mb-4">
						A digital monument honoring the ancient Turkic scripts while embracing the modern web. Custom typography, cultural references woven through code.
					</p>
					<div class="flex flex-wrap gap-2">
						<span class="px-3 py-1 text-xs border border-blue-400/20 text-blue-400/60">Astro</span>
						<span class="px-3 py-1 text-xs border border-blue-400/20 text-blue-400/60">Tailwind</span>
						<span class="px-3 py-1 text-xs border border-blue-400/20 text-blue-400/60">Cloudflare</span>
					</div>
				</article>
			</div>
		</section>

		<!-- Summon/Contact Section -->
		<section id="summon" class="px-4 md:px-8 lg:px-16 py-24 relative group">
			<BackgroundMarquee class="group-has-[button:hover]:text-white duration-500 transition-all">
				𐰚𐰇𐰠𐱅𐰃𐰏𐰤: 𐰖𐰸: 𐰼𐰾𐰼: 𐰸𐰆𐰯: 𐰇𐰠𐱅𐰲𐰃: 𐰼𐱅𐰏𐰕: 𐰃𐰤𐰢: 𐰚𐰇𐰠𐱅𐰃𐰏𐰤: 𐰚𐰼𐰏𐰚: 𐰉𐰆𐰡𐰃: 𐰇𐰕𐰢: 𐰽𐰴𐰦𐰢: 𐰚𐰇𐰼𐰇𐰼: 𐰚𐰇𐰕𐰢: 𐰚𐰇𐰼𐰢𐰕: 𐱅𐰏: 𐰋𐰃𐰠𐰼: 𐰋𐰃𐰠𐰏𐰢: 𐰋𐰃𐰠𐰢𐰕: 𐱅𐰏: 𐰉𐰆𐰡𐰃: 𐰇𐰕𐰢: 𐰽𐰴𐰦𐰢: 𐰇𐰓: 𐱅𐰭𐰼𐰃: 𐰖𐰽𐰺: 𐰚𐰃𐰾𐰃: 𐰆𐰍𐰞𐰃: 𐰸𐰆𐰯: 𐰇𐰠𐰏𐰠𐰃: 𐱅𐰇𐰼𐰇𐰢𐰾:
			</BackgroundMarquee>
			
			<div class="max-w-2xl mx-auto text-center relative z-10">
				<!-- Decorative Turkic border top -->
				<div class="font-oldturcic text-xl text-blue-400/20 mb-6 tracking-[0.4em] leading-none">
					𐰚𐰇𐰠𐱅𐰃𐰏𐰤
				</div>
				
				<h2 class="font-sinistre text-4xl sm:text-5xl lg:text-6xl mb-8">
					<span class="text-blue-300">Summon</span> <span class="text-gray-600">Me</span>
				</h2>
				
				<p class="text-lg text-gray-500 mb-12">
					Ready to forge something legendary? Reach out for collaborations, opportunities, or tales of code.
				</p>
				
				<a href="mailto:contact@atduyar.com" class="inline-block px-10 py-4 border-2 border-blue-400 text-blue-300 font-sinistre text-xl hover:bg-blue-400 hover:text-[#0d0e12] transition-all duration-300">
					Send Word
				</a>
				
				<div class="flex justify-center gap-10 mt-12">
					<a href="https://github.com/atduyar" target="_blank" rel="noopener" class="text-gray-600 hover:text-blue-300 transition-colors flex items-center gap-2">
						<span class="font-oldturcic text-lg leading-none">𐰋</span>
						<span>GitHub</span>
					</a>
					<a href="https://linkedin.com/in/atduyar" target="_blank" rel="noopener" class="text-gray-600 hover:text-blue-300 transition-colors flex items-center gap-2">
						<span class="font-oldturcic text-lg leading-none">𐰠</span>
						<span>LinkedIn</span>
					</a>
				</div>
				
				<!-- Bottom Turkic text -->
				<div class="font-oldturcic text-xl text-blue-400/20 mt-12 tracking-[0.4em] leading-none">
					𐰉𐰆𐰡𐰃 𐰇𐰕𐰢 𐰽𐰴𐰦𐰢
				</div>
			</div>
			
			<!-- Radial effect on hover -->
			<div class="select-none pointer-events-none absolute left-0 top-0 h-full w-full transition-[--x] duration-600 ease-out [--x:0%] group-has-[a:hover]:[--x:100%] to-30% opacity-50 from-blue-900 to-transparent mix-blend-hard-light bg-radial-[circle_at_50%_50%,var(--tw-gradient-from)_var(--x)] group-has-[a:hover]:opacity-100"></div>
		</section>

		<!-- Footer -->
		<footer class="px-4 md:px-8 lg:px-16 py-12 border-t border-[#90c5ff14]">
			<div class="flex flex-col md:flex-row justify-between items-center gap-4">
				<div class="flex items-center gap-3">
					<span class="font-oldturcic text-blue-400/40 text-lg leading-none">𐱅𐰭𐰼𐰃</span>
					<span class="font-sinistre">&copy; 2026 Ahmet Tarik Duyar</span>
				</div>
				<p class="font-oldturcic text-xs text-blue-400/20 leading-none">𐰚𐰇𐰠𐱅𐰃𐰏𐰤 𐰖𐰸 𐰼𐰾𐰼</p>
			</div>
		</footer>
	</main>
</BaseLayout>

<style>
	.writing-vertical {
		writing-mode: vertical-rl;
		text-orientation: mixed;
	}

	@keyframes fade-in {
		from { opacity: 0; }
		to { opacity: 1; }
	}
	
	@keyframes rise-1 {
		from { opacity: 0; transform: translateY(30px); }
		to { opacity: 1; transform: translateY(0); }
	}
	
	@keyframes rise-2 {
		from { opacity: 0; transform: translateY(30px); }
