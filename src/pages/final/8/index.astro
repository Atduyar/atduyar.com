---
import BackgroundMarquee from "../../../components/BackgroundMarquee.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout title="Ahmet Tarik Duyar" description="Full-Stack Software Engineer Portfolio" bodyClass="bg-[#0a0b0d] text-white w-screen overflow-x-hidden">
	<main class="bg-[#0d0e12] border-x border-[#90c5ff14] max-w-7xl mx-auto min-h-dvh relative">
		<!-- Subtle noise overlay -->
		<div class="fixed inset-0 pointer-events-none opacity-[0.015] z-50" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 256 256%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22n%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23n)%22/%3E%3C/svg%3E');"></div>
		
		<!-- Navigation -->
		<nav class="py-6 px-4 md:px-8 border-b border-[#90c5ff14] sticky top-0 bg-[#0d0e12]/90 backdrop-blur-sm z-40">
			<div class="flex justify-between items-center">
				<a href="#hero" class="group flex items-center gap-3">
					<div class="w-10 h-10 rounded-full border border-blue-400/30 flex items-center justify-center group-hover:border-blue-400/60 transition-colors relative overflow-hidden">
						<div class="absolute inset-0 bg-blue-500/10 group-hover:bg-blue-500/20 transition-colors"></div>
						<img src="/favicon.svg" alt="Logo" class="w-6 h-6 relative z-10" />
					</div>
					<span class="font-sinistre text-xl tracking-wide hidden sm:block">Atduyar</span>
				</a>
				<ul class="flex gap-4 md:gap-8">
					<li><a href="#blueprint" class="nav-link font-sinistre text-lg hover:text-blue-300 transition-all">Blueprint</a></li>
					<li><a href="#expedition" class="nav-link font-sinistre text-lg hover:text-blue-300 transition-all">Expedition</a></li>
					<li><a href="#vault" class="nav-link font-sinistre text-lg hover:text-blue-300 transition-all">Vault</a></li>
					<li><a href="#coordinates" class="nav-link font-sinistre text-lg px-4 py-1 border border-blue-500/30 hover:bg-blue-600/10 rounded-full">Locate</a></li>
				</ul>
			</div>
		</nav>

		<!-- Hero Section -->
		<section id="hero" class="min-h-[85vh] flex flex-col justify-center px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14] relative overflow-hidden">
			<div class="absolute inset-0">
				<div class="absolute top-1/4 left-1/4 w-[500px] h-[500px] bg-blue-500/10 rounded-full blur-[150px]"></div>
				<div class="absolute bottom-1/3 right-1/4 w-[400px] h-[400px] bg-indigo-500/10 rounded-full blur-[120px]"></div>
			</div>
			
			<!-- Compass decoration -->
			<div class="absolute top-20 right-10 w-32 h-32 opacity-20 hidden lg:block">
				<svg viewBox="0 0 100 100" class="w-full h-full animate-spin-very-slow">
					<circle cx="50" cy="50" r="45" fill="none" stroke="currentColor" stroke-width="0.5" class="text-blue-400"/>
					<circle cx="50" cy="50" r="35" fill="none" stroke="currentColor" stroke-width="0.3" class="text-blue-400"/>
					<line x1="50" y1="5" x2="50" y2="15" stroke="currentColor" stroke-width="1" class="text-blue-400"/>
					<line x1="50" y1="85" x2="50" y2="95" stroke="currentColor" stroke-width="1" class="text-blue-400"/>
					<line x1="5" y1="50" x2="15" y2="50" stroke="currentColor" stroke-width="1" class="text-blue-400"/>
					<line x1="85" y1="50" x2="95" y2="50" stroke="currentColor" stroke-width="1" class="text-blue-400"/>
					<text x="50" y="12" text-anchor="middle" class="text-[6px] fill-blue-300">N</text>
				</svg>
			</div>
			
			<div class="relative z-10">
				<p class="font-oldturcic text-blue-400/50 text-lg mb-4 tracking-[0.4em] animate-fade-in leading-none">𐰚𐰇𐰠𐱅𐰃𐰏𐰤</p>
				<h1 class="text-5xl sm:text-7xl lg:text-8xl xl:text-9xl font-sinistre leading-[0.9] mb-8">
					<span class="block animate-slide-up" style="animation-delay: 0.1s;">I'm Ahmet</span>
					<span class="block animate-slide-up" style="animation-delay: 0.2s;">
						<span class="text-blue-300">Tarik</span> Duyar
					</span>
				</h1>
				<p class="text-lg md:text-xl text-gray-400 max-w-xl animate-fade-in leading-relaxed" style="animation-delay: 0.5s;">
					Building robust backend architectures and scalable systems. 
					Passionate about C, Rust, and Linux.
				</p>
				<div class="flex gap-4 mt-10 animate-fade-in" style="animation-delay: 0.7s;">
					<a href="#expedition" class="group px-6 py-3 bg-blue-600/10 border border-blue-500/30 hover:bg-blue-600/20 hover:border-blue-400/50 transition-all font-sinistre text-lg rounded-sm">
						View Expeditions
					</a>
					<a href="#coordinates" class="px-6 py-3 border border-[#90c5ff14] hover:border-[#90c5ff30] transition-all font-sinistre text-lg rounded-sm">
						Find Me
					</a>
				</div>
			</div>
		</section>

		<!-- About Section -->
		<section id="about" class="px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14]">
			<div class="flex flex-col lg:flex-row gap-12 items-start">
				<div class="flex-1">
					<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-8 flex items-center gap-4">
						<span class="font-oldturcic text-2xl md:text-3xl text-blue-400/30 leading-none">𐰋𐰃𐰠</span>
						About Me
						<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
					</h2>
					<div class="space-y-6 text-gray-300 text-lg leading-relaxed">
						<p>
							I'm a Full-Stack Software Engineer with a year of professional experience specializing in building robust backend architectures, designing scalable databases, and managing critical systems.
						</p>
						<p>
							During my time at <span class="text-white">Deniz Egece Co. Ltd.</span>, I took ownership of architecting and deploying a streaming platform serving over <span class="text-blue-300">17,000 paid users</span>, demonstrating my ability to deliver end-to-end solutions across various platforms.
						</p>
						<p>
							As an <span class="text-white">Honor Student</span> in Software Engineering at the International University of Sarajevo, I'm deeply focused on computer science fundamentals while actively exploring C, Rust, JavaScript, and Linux.
						</p>
					</div>
				</div>
				<div class="w-full lg:w-80 flex-shrink-0">
					<div class="aspect-square rounded-sm p-8 flex items-center justify-center relative group border border-[#90c5ff14]">
						<img src="/favicon.svg" alt="Logo" class="w-full h-full opacity-80 relative z-10" />
					</div>
				</div>
			</div>
		</section>

		<!-- THE BLUEPRINT - Skills as Architectural Drawings -->
		<section id="blueprint" class="px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14] relative overflow-hidden">
			<!-- Blueprint grid background -->
			<div class="absolute inset-0 opacity-[0.06]" style="background-image: linear-gradient(rgba(96,165,250,0.4) 1px, transparent 1px), linear-gradient(90deg, rgba(96,165,250,0.4) 1px, transparent 1px); background-size: 20px 20px;"></div>
			<div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(96,165,250,0.3) 1px, transparent 1px), linear-gradient(90deg, rgba(96,165,250,0.3) 1px, transparent 1px); background-size: 100px 100px;"></div>
			
			<div class="relative z-10">
				<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-4 flex items-center gap-4">
					<span class="font-oldturcic text-2xl md:text-3xl text-blue-400/30 leading-none">𐰽𐰴</span>
					The Blueprint
					<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
				</h2>
				<p class="text-gray-500 mb-12 max-w-2xl font-mono text-sm">TECHNICAL SPECIFICATIONS // REV 2.4 // SCALE 1:1</p>
				
				<!-- Blueprint style skills -->
				<div class="space-y-8">
					<!-- Backend Architecture -->
					<div class="blueprint-item group relative border border-blue-400/20 hover:border-blue-400/40 transition-all p-6 bg-[#0a0b0d]/50">
						<!-- Corner markers -->
						<div class="absolute -top-1 -left-1 w-3 h-3 border-t-2 border-l-2 border-blue-400/40"></div>
						<div class="absolute -top-1 -right-1 w-3 h-3 border-t-2 border-r-2 border-blue-400/40"></div>
						<div class="absolute -bottom-1 -left-1 w-3 h-3 border-b-2 border-l-2 border-blue-400/40"></div>
						<div class="absolute -bottom-1 -right-1 w-3 h-3 border-b-2 border-r-2 border-blue-400/40"></div>
						
						<div class="flex flex-col md:flex-row gap-6">
							<div class="flex-1">
								<div class="flex items-center gap-4 mb-4">
									<div class="font-mono text-xs text-blue-400/60 border border-blue-400/30 px-2 py-1">SECTION A</div>
									<h3 class="font-sinistre text-2xl text-blue-200">Backend Architecture</h3>
								</div>
								<p class="text-gray-400 text-sm leading-relaxed mb-4">
									Primary structural framework. Load-bearing systems designed for high throughput and fault tolerance.
								</p>
								<div class="flex gap-3 flex-wrap font-mono text-xs">
									<span class="text-cyan-400 border-b border-cyan-400/30 pb-0.5">Node.js</span>
									<span class="text-cyan-400 border-b border-cyan-400/30 pb-0.5">Rust</span>
									<span class="text-cyan-400 border-b border-cyan-400/30 pb-0.5">Go</span>
									<span class="text-cyan-400 border-b border-cyan-400/30 pb-0.5">Python</span>
								</div>
							</div>
							<!-- Measurement annotations -->
							<div class="md:w-48 flex flex-col justify-center gap-2 font-mono text-xs text-gray-500">
								<div class="flex justify-between border-b border-dashed border-gray-700 pb-1">
									<span>Capacity:</span>
									<span class="text-blue-300">17k+ users</span>
								</div>
								<div class="flex justify-between border-b border-dashed border-gray-700 pb-1">
									<span>Uptime:</span>
									<span class="text-emerald-300">99.9%</span>
								</div>
								<div class="flex justify-between">
									<span>Load:</span>
									<span class="text-amber-300">High</span>
								</div>
							</div>
						</div>
					</div>
					
					<!-- Database Layer -->
					<div class="blueprint-item group relative border border-indigo-400/20 hover:border-indigo-400/40 transition-all p-6 bg-[#0a0b0d]/50">
						<div class="absolute -top-1 -left-1 w-3 h-3 border-t-2 border-l-2 border-indigo-400/40"></div>
						<div class="absolute -top-1 -right-1 w-3 h-3 border-t-2 border-r-2 border-indigo-400/40"></div>
						<div class="absolute -bottom-1 -left-1 w-3 h-3 border-b-2 border-l-2 border-indigo-400/40"></div>
						<div class="absolute -bottom-1 -right-1 w-3 h-3 border-b-2 border-r-2 border-indigo-400/40"></div>
						
						<div class="flex flex-col md:flex-row gap-6">
							<div class="flex-1">
								<div class="flex items-center gap-4 mb-4">
									<div class="font-mono text-xs text-indigo-400/60 border border-indigo-400/30 px-2 py-1">SECTION B</div>
									<h3 class="font-sinistre text-2xl text-indigo-200">Database Layer</h3>
								</div>
								<p class="text-gray-400 text-sm leading-relaxed mb-4">
									Foundation systems. Data persistence and retrieval optimized for complex relational queries.
								</p>
								<div class="flex gap-3 flex-wrap font-mono text-xs">
									<span class="text-purple-400 border-b border-purple-400/30 pb-0.5">PostgreSQL</span>
									<span class="text-purple-400 border-b border-purple-400/30 pb-0.5">Redis</span>
									<span class="text-purple-400 border-b border-purple-400/30 pb-0.5">MongoDB</span>
								</div>
							</div>
							<div class="md:w-48 flex flex-col justify-center gap-2 font-mono text-xs text-gray-500">
								<div class="flex justify-between border-b border-dashed border-gray-700 pb-1">
									<span>Indexing:</span>
									<span class="text-indigo-300">Optimized</span>
								</div>
								<div class="flex justify-between border-b border-dashed border-gray-700 pb-1">
									<span>Sharding:</span>
									<span class="text-emerald-300">Enabled</span>
								</div>
								<div class="flex justify-between">
									<span>Backup:</span>
									<span class="text-amber-300">Hourly</span>
								</div>
							</div>
						</div>
					</div>
					
					<!-- Systems & Infrastructure -->
					<div class="blueprint-item group relative border border-cyan-400/20 hover:border-cyan-400/40 transition-all p-6 bg-[#0a0b0d]/50">
						<div class="absolute -top-1 -left-1 w-3 h-3 border-t-2 border-l-2 border-cyan-400/40"></div>
						<div class="absolute -top-1 -right-1 w-3 h-3 border-t-2 border-r-2 border-cyan-400/40"></div>
						<div class="absolute -bottom-1 -left-1 w-3 h-3 border-b-2 border-l-2 border-cyan-400/40"></div>
						<div class="absolute -bottom-1 -right-1 w-3 h-3 border-b-2 border-r-2 border-cyan-400/40"></div>
						
						<div class="flex flex-col md:flex-row gap-6">
							<div class="flex-1">
								<div class="flex items-center gap-4 mb-4">
									<div class="font-mono text-xs text-cyan-400/60 border border-cyan-400/30 px-2 py-1">SECTION C</div>
									<h3 class="font-sinistre text-2xl text-cyan-200">Systems & Infrastructure</h3>
								</div>
								<p class="text-gray-400 text-sm leading-relaxed mb-4">
									Low-level engineering. Operating system internals and hardware-software interface optimization.
								</p>
								<div class="flex gap-3 flex-wrap font-mono text-xs">
									<span class="text-teal-400 border-b border-teal-400/30 pb-0.5">C</span>
									<span class="text-teal-400 border-b border-teal-400/30 pb-0.5">Rust</span>
									<span class="text-teal-400 border-b border-teal-400/30 pb-0.5">Linux</span>
									<span class="text-teal-400 border-b border-teal-400/30 pb-0.5">Docker</span>
								</div>
							</div>
							<div class="md:w-48 flex flex-col justify-center gap-2 font-mono text-xs text-gray-500">
								<div class="flex justify-between border-b border-dashed border-gray-700 pb-1">
									<span>Memory:</span>
									<span class="text-cyan-300">Optimized</span>
								</div>
								<div class="flex justify-between border-b border-dashed border-gray-700 pb-1">
									<span>Latency:</span>
									<span class="text-emerald-300">&lt;10ms</span>
								</div>
								<div class="flex justify-between">
									<span>Threads:</span>
									<span class="text-amber-300">Async</span>
								</div>
							</div>
						</div>
					</div>
				</div>
				
				<!-- Blueprint stamp -->
				<div class="mt-8 flex justify-end">
					<div class="border-2 border-blue-400/30 px-4 py-2 rotate-[-3deg]">
						<div class="font-mono text-xs text-blue-400/60">APPROVED FOR CONSTRUCTION</div>
						<div class="font-sinistre text-lg text-blue-300">A.T.D. // 2026</div>
					</div>
				</div>
			</div>
		</section>

		<!-- EXPEDITION LOG - Experience as Explorer's Journal -->
		<section id="expedition" class="px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14] relative">
			<div class="relative z-10">
				<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-4 flex items-center gap-4">
					<span class="font-oldturcic text-2xl md:text-3xl text-blue-400/30 leading-none">𐰼𐱅</span>
					Expedition Log
					<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
				</h2>
				<p class="text-gray-500 mb-12 max-w-2xl italic">"Every journey through code is a discovery of new territories."</p>
				
				<!-- Journal entries -->
				<div class="space-y-12">
					<!-- Entry 1 -->
					<div class="journal-entry relative pl-8 border-l-2 border-blue-400/30">
						<!-- Date marker -->
						<div class="absolute -left-3 top-0 w-6 h-6 rounded-full bg-[#0d0e12] border-2 border-blue-400/50 flex items-center justify-center">
							<div class="w-2 h-2 rounded-full bg-blue-400"></div>
						</div>
						
						<div class="bg-gradient-to-r from-[#90c5ff05] to-transparent p-6 border border-[#90c5ff14] hover:border-blue-400/30 transition-all">
							<div class="flex flex-col md:flex-row md:items-center gap-4 mb-4">
								<div class="flex items-center gap-3">
									<span class="font-mono text-sm text-blue-400/80 bg-blue-500/10 px-3 py-1 rounded-full">2023 - Present</span>
									<span class="text-2xl">🧭</span>
								</div>
								<div class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent hidden md:block"></div>
								<span class="font-mono text-xs text-gray-500">LAT 43.8563° N, LONG 18.4131° E</span>
							</div>
							
							<h3 class="font-sinistre text-2xl mb-2">Deniz Egece Co. Ltd.</h3>
							<p class="text-blue-300/80 text-sm mb-4 font-mono">Full-Stack Developer</p>
							
							<div class="text-gray-400 leading-relaxed space-y-3 italic">
								<p>
									"Day 1: Arrived at the frontier. The terrain is challenging - a streaming platform serving thousands requires careful navigation. 
									I've begun mapping the database architecture..."
								</p>
								<p>
									"Month 6: Major milestone achieved. The platform now serves over 17,000 paid users. 
									Implemented video transcoding pipelines that reduced processing time by 40%."
								</p>
								<p>
									"Present: Continuing to expand the territory. Real-time analytics dashboard deployed. 
									Payment integrations running smoothly across multiple regions."
								</p>
							</div>
							
							<!-- Collected artifacts -->
							<div class="mt-6 pt-4 border-t border-[#90c5ff14]">
								<span class="font-mono text-xs text-gray-500">ARTIFACTS COLLECTED:</span>
								<div class="flex gap-2 mt-2 flex-wrap">
									<span class="px-3 py-1 text-xs bg-blue-500/10 border border-blue-400/20 rounded-full">Node.js</span>
									<span class="px-3 py-1 text-xs bg-blue-500/10 border border-blue-400/20 rounded-full">PostgreSQL</span>
									<span class="px-3 py-1 text-xs bg-blue-500/10 border border-blue-400/20 rounded-full">FFmpeg</span>
									<span class="px-3 py-1 text-xs bg-blue-500/10 border border-blue-400/20 rounded-full">AWS</span>
								</div>
							</div>
						</div>
					</div>
					
					<!-- Entry 2 -->
					<div class="journal-entry relative pl-8 border-l-2 border-indigo-400/30">
						<div class="absolute -left-3 top-0 w-6 h-6 rounded-full bg-[#0d0e12] border-2 border-indigo-400/50 flex items-center justify-center">
							<div class="w-2 h-2 rounded-full bg-indigo-400"></div>
						</div>
						
						<div class="bg-gradient-to-r from-indigo-500/5 to-transparent p-6 border border-[#90c5ff14] hover:border-indigo-400/30 transition-all">
							<div class="flex flex-col md:flex-row md:items-center gap-4 mb-4">
								<div class="flex items-center gap-3">
									<span class="font-mono text-sm text-indigo-400/80 bg-indigo-500/10 px-3 py-1 rounded-full">2022 - Present</span>
									<span class="text-2xl">🎓</span>
								</div>
								<div class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent hidden md:block"></div>
								<span class="font-mono text-xs text-gray-500">SARAJEVO, BOSNIA</span>
							</div>
							
							<h3 class="font-sinistre text-2xl mb-2">International University of Sarajevo</h3>
							<p class="text-indigo-300/80 text-sm mb-4 font-mono">Software Engineering (Honor Student)</p>
							
							<div class="text-gray-400 leading-relaxed space-y-3 italic">
								<p>
									"The academy provides the theoretical maps for the journeys ahead. 
									Computer science fundamentals serve as the compass for all future expeditions."
								</p>
								<p>
									"Deep exploration into algorithms, data structures, and system design. 
									Each semester reveals new territories to conquer."
								</p>
							</div>
							
							<div class="mt-6 pt-4 border-t border-[#90c5ff14]">
								<span class="font-mono text-xs text-gray-500">KNOWLEDGE ACQUIRED:</span>
								<div class="flex gap-2 mt-2 flex-wrap">
									<span class="px-3 py-1 text-xs bg-indigo-500/10 border border-indigo-400/20 rounded-full">Algorithms</span>
									<span class="px-3 py-1 text-xs bg-indigo-500/10 border border-indigo-400/20 rounded-full">Data Structures</span>
									<span class="px-3 py-1 text-xs bg-indigo-500/10 border border-indigo-400/20 rounded-full">System Design</span>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- NEW SECTION: THE VAULT - Achievements/Certifications -->
		<section id="vault" class="px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14] relative overflow-hidden">
			<div class="relative z-10">
				<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-4 flex items-center gap-4">
					<span class="font-oldturcic text-2xl md:text-3xl text-blue-400/30 leading-none">𐰇𐰕</span>
					The Vault
					<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
				</h2>
				<p class="text-gray-500 mb-12 max-w-2xl">Secured achievements and milestones from the journey.</p>
				
				<!-- Vault items grid -->
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
					<!-- Vault Item 1 -->
					<div class="vault-item group relative">
						<div class="absolute inset-0 bg-gradient-to-br from-amber-500/10 to-transparent rounded-sm opacity-0 group-hover:opacity-100 transition-opacity"></div>
						<div class="border border-amber-400/20 hover:border-amber-400/40 transition-all p-6 rounded-sm relative">
