---
import BackgroundMarquee from "../../../components/BackgroundMarquee.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout title="Ahmet Tarik Duyar" description="Full-Stack Software Engineer Portfolio" bodyClass="bg-[#0a0b0d] text-white w-screen overflow-x-hidden">
	<main class="bg-[#0d0e12] border-x border-[#90c5ff14] max-w-7xl mx-auto min-h-dvh relative">
		<!-- Subtle noise overlay -->
		<div class="fixed inset-0 pointer-events-none opacity-[0.015] z-50" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 256 256%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22n%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23n)%22/%3E%3C/svg%3E');"></div>
		
		<!-- Navigation -->
		<nav class="py-6 px-4 md:px-8 border-b border-[#90c5ff14] sticky top-0 bg-[#0d0e12]/90 backdrop-blur-sm z-40">
			<div class="flex justify-between items-center">
				<a href="#hero" class="group flex items-center gap-3">
					<img src="/favicon.svg" alt="Logo" class="w-8 h-8 transition-transform group-hover:rotate-12" />
					<span class="font-sinistre text-xl tracking-wide hidden sm:block">Atduyar</span>
				</a>
				<ul class="flex gap-4 md:gap-8">
					<li><a href="#about" class="nav-link font-sinistre text-lg hover:text-blue-300 transition-all">About</a></li>
					<li><a href="#codex" class="nav-link font-sinistre text-lg hover:text-blue-300 transition-all">Codex</a></li>
					<li><a href="#forge" class="nav-link font-sinistre text-lg hover:text-blue-300 transition-all">Forge</a></li>
					<li><a href="#summon" class="nav-link font-sinistre text-lg px-4 py-1 border border-blue-500/30 hover:bg-blue-600/10 transition-all">Summon</a></li>
				</ul>
			</div>
		</nav>

		<!-- Hero Section -->
		<section id="hero" class="min-h-[80vh] flex flex-col justify-center px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14] relative overflow-hidden">
			<div class="absolute inset-0 opacity-5">
				<div class="absolute top-1/4 left-1/4 w-96 h-96 bg-blue-500 rounded-full blur-[128px]"></div>
				<div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-indigo-500 rounded-full blur-[128px]"></div>
			</div>
			
			<div class="absolute inset-0 overflow-hidden pointer-events-none">
				<span class="absolute top-1/4 left-[10%] font-oldturcic text-6xl md:text-8xl text-blue-400/[0.06] leading-none animate-float-1">𐰚</span>
				<span class="absolute top-1/3 right-[15%] font-oldturcic text-5xl md:text-6xl text-blue-400/[0.06] leading-none animate-float-2">𐰇</span>
				<span class="absolute bottom-1/4 left-[20%] font-oldturcic text-5xl md:text-7xl text-blue-400/[0.06] leading-none animate-float-3">𐰠</span>
				<span class="absolute bottom-1/3 right-[25%] font-oldturcic text-7xl md:text-9xl text-blue-400/[0.06] leading-none animate-float-1">𐱅</span>
			</div>
			
			<div class="relative z-10">
				<p class="font-oldturcic text-blue-400/40 text-lg mb-4 tracking-[0.4em] animate-fade-in leading-none">𐰚𐰇𐰠𐱅𐰃𐰏𐰤</p>
				<h1 class="text-5xl sm:text-7xl lg:text-8xl xl:text-9xl font-sinistre leading-[0.9] mb-8">
					<span class="block animate-slide-up" style="animation-delay: 0.1s;">I'm Ahmet</span>
					<span class="block animate-slide-up text-blue-300" style="animation-delay: 0.2s;">Tarik Duyar</span>
				</h1>
				<p class="text-lg md:text-xl text-gray-400 max-w-xl animate-fade-in" style="animation-delay: 0.5s;">
					Building robust backend architectures and scalable systems. 
					Passionate about C, Rust, and Linux.
				</p>
				<div class="flex gap-4 mt-10 animate-fade-in" style="animation-delay: 0.7s;">
					<a href="#forge" class="px-6 py-3 bg-blue-600/10 border border-blue-500/30 hover:bg-blue-600/20 hover:border-blue-400/50 transition-all font-sinistre text-lg rounded-sm">
						View Creations
					</a>
					<a href="#summon" class="px-6 py-3 border border-[#90c5ff14] hover:border-[#90c5ff30] transition-all font-sinistre text-lg rounded-sm">
						Summon Me
					</a>
				</div>
			</div>
		</section>

		<!-- About Section -->
		<section id="about" class="px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14]">
			<div class="flex flex-col lg:flex-row gap-12 items-start">
				<div class="flex-1">
					<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-8 flex items-center gap-4">
						<span class="font-oldturcic text-2xl md:text-3xl text-blue-400/30 leading-none">𐰋𐰃𐰠</span>
						About Me
						<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
					</h2>
					<div class="space-y-6 text-gray-300 text-lg leading-relaxed">
						<p>
							I'm a Full-Stack Software Engineer with a year of professional experience specializing in building robust backend architectures, designing scalable databases, and managing critical systems.
						</p>
						<p>
							During my time at <span class="text-white">Deniz Egece Co. Ltd.</span>, I took ownership of architecting and deploying a streaming platform serving over <span class="text-blue-300">17,000 paid users</span>.
						</p>
						<p>
							As an <span class="text-white">Honor Student</span> in Software Engineering at the International University of Sarajevo, I'm deeply focused on computer science fundamentals.
						</p>
					</div>
				</div>
				<div class="w-full lg:w-80 flex-shrink-0">
					<div class="aspect-square bg-gradient-to-br from-[#90c5ff08] to-transparent border border-[#90c5ff14] rounded-sm p-8 flex items-center justify-center relative">
						<img src="/favicon.svg" alt="Logo" class="w-full h-full opacity-80" />
						<div class="absolute top-0 left-0 w-6 h-6 border-t border-l border-blue-400/30"></div>
						<div class="absolute top-0 right-0 w-6 h-6 border-t border-r border-blue-400/30"></div>
						<div class="absolute bottom-0 left-0 w-6 h-6 border-b border-l border-blue-400/30"></div>
						<div class="absolute bottom-0 right-0 w-6 h-6 border-b border-r border-blue-400/30"></div>
					</div>
				</div>
			</div>
		</section>

		<!-- CODEX SECTION - Skills as Ancient Manuscript -->
		<section id="codex" class="px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14] relative">
			<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-4 flex items-center gap-4">
				<span class="font-oldturcic text-2xl md:text-3xl text-blue-400/30 leading-none">𐰋𐰃𐰠𐰼</span>
				The Codex
				<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
			</h2>
			<p class="text-gray-500 mb-12 max-w-xl">Ancient knowledge inscribed in digital parchment. Each entry a mastery earned through study and practice.</p>
			
			<!-- Manuscript style layout -->
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
				<!-- Page 1 -->
				<div class="codex-page relative p-8 border border-[#90c5ff14] bg-gradient-to-br from-[#0d0e12] to-[#0a0b0d]">
					<!-- Page number -->
					<div class="absolute top-4 right-4 font-oldturcic text-blue-400/20 text-sm leading-none">I</div>
					
					<!-- Entry 1 - Backend -->
					<article class="mb-8 pb-8 border-b border-[#90c5ff10]">
						<div class="flex items-start gap-4">
							<!-- Illuminated Letter -->
							<div class="w-16 h-16 flex items-center justify-center border-2 border-blue-400/30 bg-gradient-to-br from-blue-500/10 to-transparent flex-shrink-0">
								<span class="font-oldturcic text-3xl text-blue-400 leading-none">𐰋</span>
							</div>
							<div class="flex-1">
								<h3 class="font-sinistre text-xl text-blue-300 mb-2">On the Art of Backend</h3>
								<p class="text-gray-400 text-sm leading-relaxed italic">
									"In the depths of servers, where logic flows like ancient rivers, one masters Node.js, Rust, Go, and Python. These are the tongues of the machine, spoken with precision and purpose."
								</p>
								<div class="flex gap-2 mt-3">
									<span class="text-xs text-blue-400/50">Node.js</span>
									<span class="text-xs text-gray-600">|</span>
									<span class="text-xs text-blue-400/50">Rust</span>
									<span class="text-xs text-gray-600">|</span>
									<span class="text-xs text-blue-400/50">Go</span>
									<span class="text-xs text-gray-600">|</span>
									<span class="text-xs text-blue-400/50">Python</span>
								</div>
							</div>
						</div>
					</article>
					
					<!-- Entry 2 - Database -->
					<article class="mb-8 pb-8 border-b border-[#90c5ff10]">
						<div class="flex items-start gap-4">
							<div class="w-16 h-16 flex items-center justify-center border-2 border-indigo-400/30 bg-gradient-to-br from-indigo-500/10 to-transparent flex-shrink-0">
								<span class="font-oldturcic text-3xl text-indigo-400 leading-none">𐰃</span>
							</div>
							<div class="flex-1">
								<h3 class="font-sinistre text-xl text-indigo-300 mb-2">The Doctrine of Data</h3>
								<p class="text-gray-400 text-sm leading-relaxed italic">
									"As the scribe guards sacred texts, so must one protect and structure data. PostgreSQL for the relational truths, Redis for swift memory, MongoDB for flexible forms."
								</p>
								<div class="flex gap-2 mt-3">
									<span class="text-xs text-indigo-400/50">PostgreSQL</span>
									<span class="text-xs text-gray-600">|</span>
									<span class="text-xs text-indigo-400/50">Redis</span>
									<span class="text-xs text-gray-600">|</span>
									<span class="text-xs text-indigo-400/50">MongoDB</span>
								</div>
							</div>
						</div>
					</article>
					
					<!-- Entry 3 - Systems -->
					<article>
						<div class="flex items-start gap-4">
							<div class="w-16 h-16 flex items-center justify-center border-2 border-cyan-400/30 bg-gradient-to-br from-cyan-500/10 to-transparent flex-shrink-0">
								<span class="font-oldturcic text-3xl text-cyan-400 leading-none">𐰠</span>
							</div>
							<div class="flex-1">
								<h3 class="font-sinistre text-xl text-cyan-300 mb-2">Systems Arcana</h3>
								<p class="text-gray-400 text-sm leading-relaxed italic">
									"To truly understand, one must descend to the metal itself. C for the foundations, Rust for safe power, Linux as the eternal realm where all computation dwells."
								</p>
								<div class="flex gap-2 mt-3">
									<span class="text-xs text-cyan-400/50">C</span>
									<span class="text-xs text-gray-600">|</span>
									<span class="text-xs text-cyan-400/50">Rust</span>
									<span class="text-xs text-gray-600">|</span>
									<span class="text-xs text-cyan-400/50">Linux</span>
								</div>
							</div>
						</div>
					</article>
					
					<!-- Decorative corner flourishes -->
					<div class="absolute top-0 left-0 w-12 h-12 border-t-2 border-l-2 border-blue-400/20"></div>
					<div class="absolute bottom-0 right-0 w-12 h-12 border-b-2 border-r-2 border-blue-400/20"></div>
				</div>
				
				<!-- Page 2 -->
				<div class="codex-page relative p-8 border border-[#90c5ff14] bg-gradient-to-br from-[#0d0e12] to-[#0a0b0d]">
					<div class="absolute top-4 right-4 font-oldturcic text-blue-400/20 text-sm leading-none">II</div>
					
					<!-- Entry 4 - Frontend -->
					<article class="mb-8 pb-8 border-b border-[#90c5ff10]">
						<div class="flex items-start gap-4">
							<div class="w-16 h-16 flex items-center justify-center border-2 border-emerald-400/30 bg-gradient-to-br from-emerald-500/10 to-transparent flex-shrink-0">
								<span class="font-oldturcic text-3xl text-emerald-400 leading-none">𐱅</span>
							</div>
							<div class="flex-1">
								<h3 class="font-sinistre text-xl text-emerald-300 mb-2">The Visible Layer</h3>
								<p class="text-gray-400 text-sm leading-relaxed italic">
									"What the eye perceives must be crafted with care. React for dynamic interfaces, TypeScript for disciplined code, Tailwind for swift styling of the digital canvas."
								</p>
								<div class="flex gap-2 mt-3">
									<span class="text-xs text-emerald-400/50">React</span>
									<span class="text-xs text-gray-600">|</span>
									<span class="text-xs text-emerald-400/50">TypeScript</span>
									<span class="text-xs text-gray-600">|</span>
									<span class="text-xs text-emerald-400/50">Tailwind</span>
								</div>
							</div>
						</div>
					</article>
					
					<!-- Entry 5 - Cloud -->
					<article class="mb-8 pb-8 border-b border-[#90c5ff10]">
						<div class="flex items-start gap-4">
							<div class="w-16 h-16 flex items-center justify-center border-2 border-amber-400/30 bg-gradient-to-br from-amber-500/10 to-transparent flex-shrink-0">
								<span class="font-oldturcic text-3xl text-amber-400 leading-none">𐰏</span>
							</div>
							<div class="flex-1">
								<h3 class="font-sinistre text-xl text-amber-300 mb-2">Heavenly Infrastructure</h3>
								<p class="text-gray-400 text-sm leading-relaxed italic">
									"Above the earth, in digital clouds, containers sail like ships. Docker for vessels, Kubernetes for fleets, AWS for the vast sky itself."
								</p>
								<div class="flex gap-2 mt-3">
									<span class="text-xs text-amber-400/50">Docker</span>
									<span class="text-xs text-gray-600">|</span>
									<span class="text-xs text-amber-400/50">Kubernetes</span>
									<span class="text-xs text-gray-600">|</span>
									<span class="text-xs text-amber-400/50">AWS</span>
								</div>
							</div>
						</div>
					</article>
					
					<!-- Entry 6 - Streaming -->
					<article>
						<div class="flex items-start gap-4">
							<div class="w-16 h-16 flex items-center justify-center border-2 border-rose-400/30 bg-gradient-to-br from-rose-500/10 to-transparent flex-shrink-0">
								<span class="font-oldturcic text-3xl text-rose-400 leading-none">𐰚</span>
							</div>
							<div class="flex-1">
								<h3 class="font-sinistre text-xl text-rose-300 mb-2">Rivers of Light</h3>
								<p class="text-gray-400 text-sm leading-relaxed italic">
									"Video flows like water through channels unseen. FFmpeg transforms, HLS delivers, and real-time systems ensure the stream never falters."
								</p>
								<div class="flex gap-2 mt-3">
									<span class="text-xs text-rose-400/50">FFmpeg</span>
									<span class="text-xs text-gray-600">|</span>
									<span class="text-xs text-rose-400/50">HLS</span>
									<span class="text-xs text-gray-600">|</span>
									<span class="text-xs text-rose-400/50">Real-time</span>
								</div>
							</div>
						</div>
					</article>
					
					<div class="absolute top-0 left-0 w-12 h-12 border-t-2 border-l-2 border-blue-400/20"></div>
					<div class="absolute bottom-0 right-0 w-12 h-12 border-b-2 border-r-2 border-blue-400/20"></div>
				</div>
			</div>
		</section>

		<!-- THE FORGE SECTION - Projects as Crafted Artifacts -->
		<section id="forge" class="px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14] relative overflow-hidden">
			<!-- Heat glow background -->
			<div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-gradient-to-t from-orange-500/5 via-blue-500/5 to-transparent blur-3xl pointer-events-none"></div>
			
			<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-4 flex items-center gap-4">
				<span class="font-oldturcic text-2xl md:text-3xl text-blue-400/30 leading-none">𐰸𐰆𐰯</span>
				The Forge
				<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
			</h2>
			<p class="text-gray-500 mb-12 max-w-xl">Where raw ideas are hammered into existence. Each artifact tempered through countless iterations.</p>
			
			<div class="space-y-8 relative z-10">
				<!-- Artifact 1 - Streaming Platform -->
				<div class="group artifact-card relative overflow-hidden">
					<!-- Glowing ember effect -->
					<div class="absolute inset-0 bg-gradient-to-r from-orange-500/0 via-orange-500/5 to-orange-500/0 opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
					<div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-orange-400/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
					
					<div class="border border-[#90c5ff14] group-hover:border-orange-400/30 transition-all p-8">
						<div class="flex items-center gap-4 mb-6">
							<!-- Artifact symbol -->
							<div class="w-20 h-20 relative">
								<div class="absolute inset-0 border-2 border-orange-400/30 rotate-45 group-hover:border-orange-400/60 transition-colors"></div>
								<div class="absolute inset-2 border border-blue-400/20 rotate-45"></div>
								<div class="absolute inset-0 flex items-center justify-center">
									<span class="font-oldturcic text-2xl text-orange-400 leading-none group-hover:animate-pulse">𐰇𐰕</span>
								</div>
							</div>
							<div>
								<div class="flex items-center gap-3 mb-1">
									<h3 class="font-sinistre text-2xl md:text-3xl group-hover:text-orange-200 transition-colors">Streaming Platform</h3>
									<span class="text-xs text-orange-400/60 uppercase tracking-wider border border-orange-400/30 px-2 py-0.5">Masterwork</span>
								</div>
								<p class="text-blue-400/60 text-sm">Forged for Deniz Egece Co. Ltd. | 2023</p>
							</div>
						</div>
						
						<p class="text-gray-400 leading-relaxed mb-6">
							A grand artifact serving 17,000+ souls. Video transcoding hammered to perfection, payment systems forged with security, analytics polished to reveal hidden truths.
						</p>
						
						<!-- Forge specifications -->
						<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
							<div class="p-3 bg-[#90c5ff05] border border-[#90c5ff10] text-center">
								<div class="text-xs text-gray-500 mb-1">Material</div>
								<div class="text-sm text-blue-300">Node.js</div>
							</div>
							<div class="p-3 bg-[#90c5ff05] border border-[#90c5ff10] text-center">
								<div class="text-xs text-gray-500 mb-1">Foundation</div>
								<div class="text-sm text-blue-300">PostgreSQL</div>
							</div>
							<div class="p-3 bg-[#90c5ff05] border border-[#90c5ff10] text-center">
								<div class="text-xs text-gray-500 mb-1">Enchantment</div>
								<div class="text-sm text-blue-300">FFmpeg</div>
							</div>
							<div class="p-3 bg-[#90c5ff05] border border-[#90c5ff10] text-center">
								<div class="text-xs text-gray-500 mb-1">Binding</div>
								<div class="text-sm text-blue-300">Redis</div>
							</div>
						</div>
						
						<!-- Heat indicator -->
						<div class="flex items-center gap-3">
							<span class="text-xs text-gray-500">Forge Heat</span>
							<div class="flex-1 h-2 bg-[#90c5ff10] overflow-hidden">
								<div class="h-full w-full bg-gradient-to-r from-blue-500 via-orange-500 to-red-500 group-hover:animate-heat-pulse"></div>
							</div>
							<span class="text-xs text-orange-400">Maximum</span>
						</div>
					</div>
				</div>
				
				<!-- Artifact 2 - Portfolio -->
				<div class="group artifact-card relative overflow-hidden">
					<div class="absolute inset-0 bg-gradient-to-r from-indigo-500/0 via-indigo-500/5 to-indigo-500/0 opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
					<div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-indigo-400/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
					
					<div class="border border-[#90c5ff14] group-hover:border-indigo-400/30 transition-all p-8">
						<div class="flex items-center gap-4 mb-6">
							<div class="w-20 h-20 relative">
								<div class="absolute inset-0 border-2 border-indigo-400/30 rotate-45 group-hover:border-indigo-400/60 transition-colors"></div>
								<div class="absolute inset-2 border border-blue-400/20 rotate-45"></div>
								<div class="absolute inset-0 flex items-center justify-center">
									<span class="font-oldturcic text-2xl text-indigo-400 leading-none group-hover:animate-pulse">𐰋𐰃</span>
								</div>
							</div>
							<div>
								<div class="flex items-center gap-3 mb-1">
									<h3 class="font-sinistre text-2xl md:text-3xl group-hover:text-indigo-200 transition-colors">Digital Monument</h3>
									<span class="text-xs text-indigo-400/60 uppercase tracking-wider border border-indigo-400/30 px-2 py-0.5">Artisan</span>
								</div>
								<p class="text-indigo-400/60 text-sm">Personal creation | 2024</p>
							</div>
						</div>
						
						<p class="text-gray-400 leading-relaxed mb-6">
							A monument to heritage, forged with unique typography honoring Old Turkic scripts. Each interaction carefully tempered, each animation precisely timed.
						</p>
						
						<div class="grid grid-cols-3 gap-4 mb-6">
							<div class="p-3 bg-[#90c5ff05] border border-[#90c5ff10] text-center">
								<div class="text-xs text-gray-500 mb-1">Material</div>
								<div class="text-sm text-indigo-300">Astro</div>
							</div>
							<div class="p-3 bg-[#90c5ff05] border border-[#90c5ff10] text-center">
								<div class="text-xs text-gray-500 mb-1">Polish</div>
								<div class="text-sm text-indigo-300">Tailwind</div>
							</div>
							<div class="p-3 bg-[#90c5ff05] border border-[#90c5ff10] text-center">
								<div class="text-xs text-gray-500 mb-1">Deployment</div>
