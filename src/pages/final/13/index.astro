---
import BackgroundMarquee from "../../../components/BackgroundMarquee.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout title="Ahmet Tarik Duyar - Blog Explorations" description="10 Unique Blog Section Designs" bodyClass="bg-[#0a0b0d] text-white w-screen overflow-x-hidden">
	<main class="bg-[#0d0e12] border-x border-[#90c5ff14] max-w-7xl mx-auto min-h-dvh relative">
		<!-- Subtle noise overlay -->
		<div class="fixed inset-0 pointer-events-none opacity-[0.015] z-50" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 256 256%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22n%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23n)%22/%3E%3C/svg%3E');"></div>
		
		<!-- Navigation -->
		<nav class="py-6 px-4 md:px-8 border-b border-[#90c5ff14] sticky top-0 bg-[#0d0e12]/90 backdrop-blur-sm z-40">
			<div class="flex justify-between items-center">
				<a href="#hero" class="group flex items-center gap-3">
					<div class="w-10 h-10 rounded-full border border-blue-400/30 flex items-center justify-center group-hover:border-blue-400/60 transition-colors relative overflow-hidden">
						<div class="absolute inset-0 bg-blue-500/10 group-hover:bg-blue-500/20 transition-colors"></div>
						<img src="/favicon.svg" alt="Logo" class="w-6 h-6 relative z-10" />
					</div>
					<span class="font-sinistre text-xl tracking-wide hidden sm:block">Atduyar</span>
				</a>
				<div class="flex items-center gap-4">
					<span class="text-xs text-gray-500 font-mono hidden md:block">10 BLOG DESIGNS</span>
					<span class="text-xs text-blue-400/60 font-mono">/final/13</span>
				</div>
			</div>
		</nav>

		<!-- Hero Section -->
		<section id="hero" class="min-h-[60vh] flex flex-col justify-center px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14] relative overflow-hidden">
			<div class="absolute inset-0">
				<div class="absolute top-1/4 left-1/4 w-[500px] h-[500px] bg-blue-500/10 rounded-full blur-[150px]"></div>
				<div class="absolute bottom-1/3 right-1/4 w-[400px] h-[400px] bg-indigo-500/10 rounded-full blur-[120px]"></div>
			</div>
			
			<div class="relative z-10">
				<p class="font-oldturcic text-blue-400/50 text-lg mb-4 tracking-[0.4em] animate-fade-in leading-none">𐰚𐰇𐰠𐱅𐰃𐰏𐰤</p>
				<h1 class="text-4xl sm:text-6xl lg:text-7xl font-sinistre leading-[0.9] mb-8">
					<span class="block animate-slide-up" style="animation-delay: 0.1s;">Ten Ways to</span>
					<span class="block animate-slide-up" style="animation-delay: 0.2s;">
						<span class="text-blue-300">Tell</span> a Story
					</span>
				</h1>
				<p class="text-lg md:text-xl text-gray-400 max-w-xl animate-fade-in leading-relaxed" style="animation-delay: 0.5s;">
					Each section below reimagines the blog format through a different lens.
					Scroll to explore all ten interpretations.
				</p>
			</div>
		</section>

		<!-- ============================================== -->
		<!-- BLOG DESIGN 1: THE BROADCAST -->
		<!-- Blog as a pirate radio station with frequencies -->
		<!-- ============================================== -->
		<section id="broadcast" class="py-20 border-b border-[#90c5ff14] relative overflow-hidden">
			<!-- Radio static background -->
			<div class="absolute inset-0 opacity-[0.02]" style="background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(255,255,255,0.03) 2px, rgba(255,255,255,0.03) 4px);"></div>
			
			<div class="px-4 md:px-8 lg:px-16 relative z-10">
				<div class="flex items-center gap-4 mb-2">
					<span class="font-mono text-xs text-red-500 animate-pulse">ON AIR</span>
					<div class="w-3 h-3 rounded-full bg-red-500 animate-pulse shadow-[0_0_12px_rgba(239,68,68,0.6)]"></div>
				</div>
				<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-4 flex items-center gap-4">
					<span class="font-oldturcic text-2xl md:text-3xl text-blue-400/30 leading-none">𐰋𐰃𐰠</span>
					The Broadcast
					<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
				</h2>
				<p class="text-gray-500 mb-12 font-mono text-sm">FREQUENCY: 107.3 FM // PIRATE RADIO // BROADCASTING FROM SARAJEVO</p>
				
				<!-- Radio dial interface -->
				<div class="max-w-4xl mx-auto">
					<!-- Frequency display -->
					<div class="border border-amber-800/40 bg-gradient-to-b from-amber-950/20 to-[#0a0b0d] rounded-t-lg overflow-hidden">
						<!-- Dial header with frequency markers -->
						<div class="bg-amber-950/30 border-b border-amber-800/30 px-6 py-4">
							<div class="flex items-center justify-between text-xs font-mono text-amber-600/60">
								<span>88</span>
								<span>92</span>
								<span>96</span>
								<span>100</span>
								<span class="text-amber-400">104</span>
								<span class="text-amber-400">108</span>
							</div>
							<div class="h-1 bg-amber-900/30 mt-2 rounded relative">
								<div class="absolute right-[15%] top-1/2 -translate-y-1/2 w-3 h-3 bg-amber-400 rounded-full shadow-[0_0_10px_rgba(251,191,36,0.5)]"></div>
							</div>
						</div>
						
						<!-- Current broadcast -->
						<div class="p-8">
							<div class="text-center mb-8">
								<div class="font-mono text-6xl text-amber-300 tracking-wider">107.3</div>
								<div class="text-amber-600/60 text-sm mt-2">ATDUYAR FM</div>
							</div>
							
							<!-- Now playing - Featured article -->
							<div class="border border-amber-700/30 bg-amber-950/20 p-6 mb-6">
								<div class="flex items-center gap-2 text-xs text-amber-500/60 mb-3">
									<span class="uppercase tracking-wider">Now Playing</span>
									<span class="flex-1 border-t border-dashed border-amber-700/30"></span>
									<span>23:47 CET</span>
								</div>
								<h3 class="font-sinistre text-2xl text-amber-100 mb-3 hover:text-amber-200 transition-colors cursor-pointer">
									The Art of Debugging: A Midnight Monologue
								</h3>
								<p class="text-gray-400 leading-relaxed mb-4">
									Tonight we discuss the meditative practice of debugging at 3 AM. When the world sleeps and the only light is your monitor's glow, something shifts in how you perceive code. The bug becomes less an enemy and more a puzzle, a conversation partner who speaks only in segfaults and undefined behaviors...
								</p>
								<div class="flex items-center gap-4 text-xs text-amber-600/60">
									<span>Duration: 18 min</span>
									<span>Category: Philosophy</span>
								</div>
							</div>
							
							<!-- Broadcast schedule -->
							<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
								<div class="border border-amber-900/30 p-4 hover:border-amber-700/50 transition-colors cursor-pointer group">
									<div class="font-mono text-xs text-amber-600/40 mb-1">UP NEXT // 00:15</div>
									<h4 class="font-sinistre text-lg text-amber-200 group-hover:text-amber-100">Building a Redis Clone in Rust</h4>
									<p class="text-sm text-gray-500 mt-1">A deep dive into memory management and protocol design.</p>
								</div>
								<div class="border border-amber-900/30 p-4 hover:border-amber-700/50 transition-colors cursor-pointer group">
									<div class="font-mono text-xs text-amber-600/40 mb-1">TOMORROW // 22:00</div>
									<h4 class="font-sinistre text-lg text-amber-200 group-hover:text-amber-100">The PostgreSQL Episodes, Part III</h4>
									<p class="text-sm text-gray-500 mt-1">Query optimization war stories from production.</p>
								</div>
							</div>
						</div>
					</div>
					
					<!-- Radio controls -->
					<div class="bg-gradient-to-b from-gray-800 to-gray-900 border border-t-0 border-gray-700 rounded-b-lg p-4 flex items-center justify-between">
						<div class="flex items-center gap-4">
							<div class="w-8 h-8 rounded-full bg-gray-700 border border-gray-600"></div>
							<div class="w-8 h-8 rounded-full bg-gray-700 border border-gray-600"></div>
						</div>
						<div class="flex items-center gap-2">
							<div class="w-2 h-2 rounded-full bg-emerald-500 shadow-[0_0_6px_rgba(52,211,153,0.5)]"></div>
							<span class="font-mono text-xs text-gray-500">SIGNAL STRONG</span>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ============================================== -->
		<!-- BLOG DESIGN 2: THE EXCAVATION -->
		<!-- Blog as archaeological dig site layers -->
		<!-- ============================================== -->
		<section id="excavation" class="py-20 border-b border-[#90c5ff14] relative overflow-hidden">
			<!-- Soil texture background -->
			<div class="absolute inset-0 opacity-[0.03]" style="background: url('data:image/svg+xml,%3Csvg width=%22100%22 height=%22100%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22soil%22%3E%3CfeTurbulence baseFrequency=%220.8%22 type=%22fractalNoise%22 numOctaves=%224%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23soil)%22/%3E%3C/svg%3E');"></div>
			
			<div class="px-4 md:px-8 lg:px-16 relative z-10">
				<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-4 flex items-center gap-4">
					<span class="font-oldturcic text-2xl md:text-3xl text-blue-400/30 leading-none">𐰽𐰴</span>
					The Excavation
					<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
				</h2>
				<p class="text-gray-500 mb-12">Unearthing knowledge, layer by layer. Each stratum reveals older wisdom.</p>
				
				<!-- Dig site visualization -->
				<div class="max-w-4xl mx-auto">
					<!-- Grid overlay -->
					<div class="relative">
						<!-- Excavation grid markers -->
						<div class="flex justify-between text-xs font-mono text-amber-700/40 mb-2 px-4">
							<span>A</span><span>B</span><span>C</span><span>D</span><span>E</span><span>F</span>
						</div>
						
						<!-- Soil layers -->
						<div class="border-2 border-amber-900/40 relative">
							<!-- Topsoil - Recent posts (2026) -->
							<div class="relative border-b-2 border-dashed border-amber-800/30" style="background: linear-gradient(180deg, #1a1510 0%, #15120d 100%);">
								<div class="absolute left-0 top-0 bottom-0 w-12 border-r border-amber-900/30 flex items-center justify-center">
									<span class="font-mono text-xs text-amber-600/40 -rotate-90 whitespace-nowrap">2026 CE</span>
								</div>
								<div class="pl-16 pr-6 py-6">
									<div class="flex items-start gap-4 mb-4">
										<div class="w-8 h-8 rounded border border-amber-600/40 bg-amber-900/20 flex items-center justify-center flex-shrink-0">
											<span class="font-mono text-xs text-amber-500">A1</span>
										</div>
										<div>
											<h3 class="font-sinistre text-xl text-amber-100 mb-1 hover:text-amber-200 transition-colors cursor-pointer">
												Fresh Discovery: WebAssembly on the Server
											</h3>
											<p class="text-gray-500 text-sm">Recently uncovered thoughts on WASM runtime integration with Node.js. Artifact condition: pristine.</p>
											<div class="flex items-center gap-3 mt-2 text-xs text-amber-700/60">
												<span>Excavated: Feb 2026</span>
												<span>Layer Depth: 0-5cm</span>
											</div>
										</div>
									</div>
								</div>
							</div>
							
							<!-- Second layer - 2025 -->
							<div class="relative border-b-2 border-dashed border-amber-800/30" style="background: linear-gradient(180deg, #181410 0%, #14110c 100%);">
								<div class="absolute left-0 top-0 bottom-0 w-12 border-r border-amber-900/30 flex items-center justify-center">
									<span class="font-mono text-xs text-amber-600/40 -rotate-90 whitespace-nowrap">2025 CE</span>
								</div>
								<div class="pl-16 pr-6 py-6 space-y-4">
									<div class="flex items-start gap-4">
										<div class="w-8 h-8 rounded border border-amber-600/30 bg-amber-900/10 flex items-center justify-center flex-shrink-0">
											<span class="font-mono text-xs text-amber-600/60">B2</span>
										</div>
										<div>
											<h3 class="font-sinistre text-lg text-amber-200/80 mb-1 hover:text-amber-200 transition-colors cursor-pointer">
												Partially Restored: The Streaming Architecture Papers
											</h3>
											<p class="text-gray-500 text-sm">Documentation of HLS implementation decisions. Some fragments missing.</p>
											<div class="flex items-center gap-3 mt-2 text-xs text-amber-700/60">
												<span>Layer Depth: 5-15cm</span>
												<span>Condition: Good</span>
											</div>
										</div>
									</div>
									<div class="flex items-start gap-4">
										<div class="w-8 h-8 rounded border border-amber-600/30 bg-amber-900/10 flex items-center justify-center flex-shrink-0">
											<span class="font-mono text-xs text-amber-600/60">C2</span>
										</div>
										<div>
											<h3 class="font-sinistre text-lg text-amber-200/80 mb-1 hover:text-amber-200 transition-colors cursor-pointer">
												Container Orchestration Tablets
											</h3>
											<p class="text-gray-500 text-sm">Ancient wisdom on Kubernetes deployment strategies.</p>
										</div>
									</div>
								</div>
							</div>
							
							<!-- Deep layer - 2024 and earlier -->
							<div class="relative" style="background: linear-gradient(180deg, #15120e 0%, #100d09 100%);">
								<div class="absolute left-0 top-0 bottom-0 w-12 border-r border-amber-900/30 flex items-center justify-center">
									<span class="font-mono text-xs text-amber-700/30 -rotate-90 whitespace-nowrap">ANCIENT</span>
								</div>
								<div class="pl-16 pr-6 py-6">
									<div class="flex items-start gap-4 opacity-70">
										<div class="w-8 h-8 rounded border border-amber-700/20 bg-amber-950/20 flex items-center justify-center flex-shrink-0">
											<span class="font-mono text-xs text-amber-700/40">D4</span>
										</div>
										<div>
											<h3 class="font-sinistre text-lg text-amber-300/50 mb-1 cursor-pointer">
												Fragmentary: First Steps in Systems Programming
											</h3>
											<p class="text-gray-600 text-sm">Early writings on C and memory management. Weathered but significant.</p>
											<div class="flex items-center gap-3 mt-2 text-xs text-amber-800/40">
												<span>Layer Depth: 30-50cm</span>
												<span>Condition: Fragile</span>
												<span class="text-amber-600/50">EXCAVATION IN PROGRESS</span>
											</div>
										</div>
									</div>
									
									<!-- Dig deeper prompt -->
									<div class="mt-6 pt-6 border-t border-dashed border-amber-900/20 text-center">
										<p class="text-xs text-amber-700/40 font-mono">[ DEEPER STRATA AWAIT EXCAVATION ]</p>
									</div>
								</div>
							</div>
						</div>
						
						<!-- Grid side markers -->
						<div class="absolute right-0 top-0 bottom-0 w-8 flex flex-col justify-between text-xs font-mono text-amber-700/40 py-4">
							<span>1</span><span>2</span><span>3</span><span>4</span>
						</div>
					</div>
					
					<!-- Excavation notes -->
					<div class="mt-6 p-4 border border-dashed border-amber-900/30 bg-amber-950/10">
						<div class="text-xs text-amber-600/60 font-mono">
							FIELD NOTES: Site ATD-2024. Grid reference 44.5N, 18.4E. Artifacts suggest continuous habitation and knowledge accumulation. Recommend continued systematic excavation.
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ============================================== -->
		<!-- BLOG DESIGN 3: THE OBSERVATORY LOG -->
		<!-- Blog as astronomical observation entries -->
		<!-- ============================================== -->
		<section id="observatory" class="py-20 border-b border-[#90c5ff14] relative overflow-hidden">
			<!-- Star field background -->
			<div class="absolute inset-0">
				<div class="absolute inset-0 opacity-30" style="background: radial-gradient(1px 1px at 20px 30px, white, transparent), radial-gradient(1px 1px at 40px 70px, rgba(255,255,255,0.8), transparent), radial-gradient(1px 1px at 50px 160px, rgba(255,255,255,0.6), transparent), radial-gradient(1px 1px at 90px 40px, white, transparent), radial-gradient(1px 1px at 130px 80px, rgba(255,255,255,0.7), transparent), radial-gradient(1px 1px at 160px 120px, white, transparent); background-size: 200px 200px;"></div>
			</div>
			
			<div class="px-4 md:px-8 lg:px-16 relative z-10">
				<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-4 flex items-center gap-4">
					<span class="font-oldturcic text-2xl md:text-3xl text-blue-400/30 leading-none">𐰼𐱅</span>
					The Observatory Log
					<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
				</h2>
				<p class="text-gray-500 mb-12">Nightly observations from the code observatory. Celestial phenomena in the digital sky.</p>
				
				<!-- Observatory interface -->
				<div class="max-w-4xl mx-auto">
					<!-- Telescope viewfinder header -->
					<div class="flex items-center justify-between mb-6 font-mono text-xs text-blue-400/60">
						<span>OBSERVATORY: ATDUYAR-1</span>
						<span>APERTURE: 200mm</span>
						<span>CONDITIONS: CLEAR</span>
					</div>
					
					<!-- Observation entries -->
					<div class="space-y-6">
						<!-- Entry 1 -->
						<div class="border border-blue-900/40 bg-gradient-to-r from-blue-950/20 to-transparent relative group hover:border-blue-700/50 transition-all">
							<div class="absolute left-0 top-0 bottom-0 w-1 bg-blue-500/50"></div>
							<div class="p-6 pl-8">
								<div class="flex items-start justify-between gap-4">
									<div>
										<div class="font-mono text-xs text-blue-500/60 mb-2">
											OBSERVATION #2026-037 // 02:34:17 UTC // RA 14h 29m 42s, Dec +38 21 18
										</div>
										<h3 class="font-sinistre text-xl text-blue-100 mb-2 group-hover:text-blue-200 transition-colors cursor-pointer">
											Binary System: Rust and C Interoperability
										</h3>
										<p class="text-gray-400 leading-relaxed">
											Observed a stable binary system where two languages orbit a common center of mass. The Rust component exhibits strong type safety emissions, while the C companion shows remarkable performance luminosity. FFI bridge visible at the Lagrange point. Recommend continued monitoring for gravitational coupling patterns.
										</p>
									</div>
									<!-- Star magnitude indicator -->
									<div class="flex-shrink-0 w-16 h-16 rounded-full border border-blue-500/30 flex items-center justify-center bg-blue-950/30">
										<div class="text-center">
											<div class="font-mono text-lg text-blue-300">1.2</div>
											<div class="text-[8px] text-blue-500/60">MAG</div>
										</div>
									</div>
								</div>
								<div class="flex items-center gap-6 mt-4 text-xs text-gray-600">
									<span>Exposure: 45 min read</span>
									<span>Classification: Technical Binary</span>
									<span>Visibility: Excellent</span>
								</div>
							</div>
						</div>
						
						<!-- Entry 2 -->
						<div class="border border-indigo-900/40 bg-gradient-to-r from-indigo-950/20 to-transparent relative group hover:border-indigo-700/50 transition-all">
							<div class="absolute left-0 top-0 bottom-0 w-1 bg-indigo-500/50"></div>
							<div class="p-6 pl-8">
								<div class="flex items-start justify-between gap-4">
									<div>
										<div class="font-mono text-xs text-indigo-500/60 mb-2">
											OBSERVATION #2026-031 // 23:12:44 UTC // RA 05h 14m 32s, Dec -08 12 06
										</div>
										<h3 class="font-sinistre text-xl text-indigo-100 mb-2 group-hover:text-indigo-200 transition-colors cursor-pointer">
											Nebula: The Cloud of Microservices
										</h3>
										<p class="text-gray-400 leading-relaxed">
											A vast diffuse structure spanning multiple containers. Core density suggests active service formation. Hydrogen-alpha emissions indicate heavy message queue activity. Several proto-services detected in the outer regions. Warning: gravitational instability in the authentication sector.
										</p>
									</div>
									<div class="flex-shrink-0 w-16 h-16 rounded-full border border-indigo-500/30 flex items-center justify-center bg-indigo-950/30">
										<div class="text-center">
											<div class="font-mono text-lg text-indigo-300">2.8</div>
											<div class="text-[8px] text-indigo-500/60">MAG</div>
										</div>
									</div>
								</div>
							</div>
						</div>
						
						<!-- Entry 3 -->
						<div class="border border-purple-900/40 bg-gradient-to-r from-purple-950/20 to-transparent relative group hover:border-purple-700/50 transition-all">
							<div class="absolute left-0 top-0 bottom-0 w-1 bg-purple-500/50"></div>
							<div class="p-6 pl-8">
								<div class="flex items-start justify-between gap-4">
									<div>
										<div class="font-mono text-xs text-purple-500/60 mb-2">
											OBSERVATION #2026-024 // 04:56:08 UTC // VARIABLE OBJECT
										</div>
										<h3 class="font-sinistre text-xl text-purple-100 mb-2 group-hover:text-purple-200 transition-colors cursor-pointer">
											Variable Star: The Deployment Pipeline
										</h3>
										<p class="text-gray-400 leading-relaxed">
											Irregular variable with a period of approximately 2 weeks. Brightness fluctuates between magnitudes 0.5 (successful deploy) and 6.0 (rollback event). Currently in a stable phase. Next predicted maximum: sprint end.
										</p>
									</div>
									<div class="flex-shrink-0 w-16 h-16 rounded-full border border-purple-500/30 flex items-center justify-center bg-purple-950/30 relative">
										<div class="absolute inset-0 rounded-full animate-pulse bg-purple-500/10"></div>
										<div class="text-center relative">
											<div class="font-mono text-lg text-purple-300">VAR</div>
											<div class="text-[8px] text-purple-500/60">TYPE</div>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
					
					<!-- Observatory footer -->
					<div class="mt-8 p-4 border border-blue-900/20 bg-blue-950/10 rounded font-mono text-xs text-blue-400/60 text-center">
						END OF OBSERVATION SESSION // DOME CLOSING // NEXT SESSION: CLEAR SKIES PERMITTING
					</div>
