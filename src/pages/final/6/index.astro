---
import BackgroundMarquee from "../../../components/BackgroundMarquee.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout title="Ahmet Tarik Duyar" description="Full-Stack Software Engineer Portfolio" bodyClass="bg-[#0a0b0d] text-white w-screen overflow-x-hidden">
	<main class="bg-[#0d0e12] border-x border-[#90c5ff14] max-w-7xl mx-auto min-h-dvh relative">
		<!-- Subtle noise overlay -->
		<div class="fixed inset-0 pointer-events-none opacity-[0.015] z-50" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 256 256%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22n%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23n)%22/%3E%3C/svg%3E');"></div>
		
		<!-- Navigation -->
		<nav class="py-6 px-4 md:px-8 border-b border-[#90c5ff14] sticky top-0 bg-[#0d0e12]/90 backdrop-blur-sm z-40">
			<div class="flex justify-between items-center">
				<a href="#hero" class="group flex items-center gap-3">
					<div class="w-10 h-10 rounded-full border border-blue-400/30 flex items-center justify-center group-hover:border-blue-400/60 transition-colors relative overflow-hidden">
						<div class="absolute inset-0 bg-blue-500/10 group-hover:bg-blue-500/20 transition-colors"></div>
						<img src="/favicon.svg" alt="Logo" class="w-6 h-6 relative z-10" />
					</div>
					<span class="font-sinistre text-xl tracking-wide hidden sm:block">Atduyar</span>
				</a>
				<ul class="flex gap-4 md:gap-8">
					<li><a href="#about" class="nav-link font-sinistre text-lg hover:text-blue-300 transition-all hover:-translate-y-0.5 relative after:absolute after:bottom-0 after:left-0 after:w-0 after:h-px after:bg-blue-300 hover:after:w-full after:transition-all">About</a></li>
					<li><a href="#skills" class="nav-link font-sinistre text-lg hover:text-blue-300 transition-all hover:-translate-y-0.5 relative after:absolute after:bottom-0 after:left-0 after:w-0 after:h-px after:bg-blue-300 hover:after:w-full after:transition-all">Skills</a></li>
					<li><a href="#projects" class="nav-link font-sinistre text-lg hover:text-blue-300 transition-all hover:-translate-y-0.5 relative after:absolute after:bottom-0 after:left-0 after:w-0 after:h-px after:bg-blue-300 hover:after:w-full after:transition-all">Projects</a></li>
					<li><a href="#invoke" class="nav-link font-sinistre text-lg px-4 py-1 border border-blue-500/30 hover:bg-blue-600/10 hover:border-blue-400/50 transition-all rounded-full">Invoke</a></li>
				</ul>
			</div>
		</nav>

		<!-- Hero Section with Interactive Runes -->
		<section id="hero" class="min-h-[90vh] flex flex-col justify-center px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14] relative overflow-hidden">
			<!-- Parallax gradient layers -->
			<div class="absolute inset-0">
				<div class="absolute top-1/4 left-1/4 w-[500px] h-[500px] bg-blue-500/10 rounded-full blur-[150px] parallax-layer" data-depth="0.2"></div>
				<div class="absolute bottom-1/3 right-1/4 w-[400px] h-[400px] bg-indigo-500/10 rounded-full blur-[120px] parallax-layer" data-depth="0.3"></div>
				<div class="absolute top-1/2 right-1/3 w-[300px] h-[300px] bg-cyan-500/5 rounded-full blur-[100px] parallax-layer" data-depth="0.1"></div>
			</div>
			
			<!-- Interactive Floating Runes -->
			<div class="absolute inset-0 overflow-hidden pointer-events-none" id="rune-container">
				<span class="rune absolute top-[15%] left-[8%] font-oldturcic text-5xl md:text-7xl text-blue-400/[0.08] leading-none" data-speed="0.02">𐰚</span>
				<span class="rune absolute top-[25%] right-[12%] font-oldturcic text-4xl md:text-5xl text-blue-400/[0.1] leading-none" data-speed="0.03">𐰇</span>
				<span class="rune absolute bottom-[30%] left-[15%] font-oldturcic text-6xl md:text-8xl text-blue-400/[0.06] leading-none" data-speed="0.015">𐰠</span>
				<span class="rune absolute top-[55%] right-[20%] font-oldturcic text-7xl md:text-9xl text-blue-400/[0.05] leading-none" data-speed="0.025">𐱅</span>
				<span class="rune absolute top-[40%] left-[5%] font-oldturcic text-3xl md:text-4xl text-blue-400/[0.12] leading-none" data-speed="0.035">𐰃</span>
				<span class="rune absolute bottom-[20%] right-[8%] font-oldturcic text-5xl md:text-6xl text-blue-400/[0.07] leading-none" data-speed="0.02">𐰏</span>
				<span class="rune absolute top-[70%] left-[25%] font-oldturcic text-4xl md:text-5xl text-indigo-400/[0.08] leading-none" data-speed="0.028">𐰼</span>
				<span class="rune absolute top-[10%] right-[30%] font-oldturcic text-5xl md:text-6xl text-cyan-400/[0.06] leading-none" data-speed="0.018">𐰽</span>
			</div>
			
			<div class="relative z-10">
				<!-- Glowing ring decoration -->
				<div class="absolute -top-20 -left-20 w-40 h-40 border border-blue-400/10 rounded-full animate-pulse-ring"></div>
				
				<p class="font-oldturcic text-blue-400/50 text-lg mb-4 tracking-[0.4em] animate-fade-in leading-none">𐰚𐰇𐰠𐱅𐰃𐰏𐰤</p>
				<h1 class="text-5xl sm:text-7xl lg:text-8xl xl:text-9xl font-sinistre leading-[0.9] mb-8">
					<span class="block animate-slide-up glow-text" style="animation-delay: 0.1s;">I'm Ahmet</span>
					<span class="block animate-slide-up" style="animation-delay: 0.2s;">
						<span class="text-blue-300 glow-text-blue">Tarik</span> Duyar
					</span>
				</h1>
				<p class="text-lg md:text-xl text-gray-400 max-w-xl animate-fade-in leading-relaxed" style="animation-delay: 0.5s;">
					Building robust backend architectures and scalable systems. 
					Passionate about C, Rust, and Linux.
				</p>
				<div class="flex gap-4 mt-10 animate-fade-in" style="animation-delay: 0.7s;">
					<a href="#projects" class="group px-6 py-3 bg-blue-600/10 border border-blue-500/30 hover:bg-blue-600/20 hover:border-blue-400/50 transition-all font-sinistre text-lg rounded-sm relative overflow-hidden">
						<span class="relative z-10">View Projects</span>
						<div class="absolute inset-0 bg-gradient-to-r from-blue-500/0 via-blue-500/10 to-blue-500/0 -translate-x-full group-hover:translate-x-full transition-transform duration-700"></div>
					</a>
					<a href="#invoke" class="px-6 py-3 border border-[#90c5ff14] hover:border-[#90c5ff30] transition-all font-sinistre text-lg rounded-sm hover:shadow-[0_0_20px_rgba(144,197,255,0.1)]">
						Invoke Me
					</a>
				</div>
			</div>
		</section>

		<!-- About Section with Glowing Border -->
		<section id="about" class="px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14]">
			<div class="flex flex-col lg:flex-row gap-12 items-start">
				<div class="flex-1">
					<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-8 flex items-center gap-4">
						<span class="font-oldturcic text-2xl md:text-3xl text-blue-400/30 leading-none">𐰋𐰃𐰠</span>
						About Me
						<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
					</h2>
					<div class="space-y-6 text-gray-300 text-lg leading-relaxed">
						<p>
							I'm a Full-Stack Software Engineer with a year of professional experience specializing in building robust backend architectures, designing scalable databases, and managing critical systems.
						</p>
						<p>
							During my time at <span class="text-white">Deniz Egece Co. Ltd.</span>, I took ownership of architecting and deploying a streaming platform serving over <span class="text-blue-300 glow-text-blue-subtle">17,000 paid users</span>, demonstrating my ability to deliver end-to-end solutions across various platforms.
						</p>
						<p>
							As an <span class="text-white">Honor Student</span> in Software Engineering at the International University of Sarajevo, I'm deeply focused on computer science fundamentals while actively exploring C, Rust, JavaScript, and Linux.
						</p>
					</div>
				</div>
				<div class="w-full lg:w-80 flex-shrink-0">
					<!-- Emblem with animated border -->
					<div class="aspect-square rounded-sm p-8 flex items-center justify-center relative group">
						<div class="absolute inset-0 border border-[#90c5ff14] group-hover:border-blue-400/30 transition-colors rounded-sm"></div>
						<div class="absolute inset-0 bg-gradient-to-br from-[#90c5ff08] to-transparent rounded-sm"></div>
						<!-- Animated corner accents -->
						<div class="absolute top-0 left-0 w-8 h-8 border-t-2 border-l-2 border-blue-400/0 group-hover:border-blue-400/50 transition-colors rounded-tl-sm"></div>
						<div class="absolute top-0 right-0 w-8 h-8 border-t-2 border-r-2 border-blue-400/0 group-hover:border-blue-400/50 transition-colors rounded-tr-sm"></div>
						<div class="absolute bottom-0 left-0 w-8 h-8 border-b-2 border-l-2 border-blue-400/0 group-hover:border-blue-400/50 transition-colors rounded-bl-sm"></div>
						<div class="absolute bottom-0 right-0 w-8 h-8 border-b-2 border-r-2 border-blue-400/0 group-hover:border-blue-400/50 transition-colors rounded-br-sm"></div>
						<img src="/favicon.svg" alt="Logo" class="w-full h-full opacity-80 relative z-10 group-hover:opacity-100 transition-opacity" />
					</div>
				</div>
			</div>
		</section>

		<!-- Skills Section - Hexagon Grid Style -->
		<section id="skills" class="px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14] relative overflow-hidden">
			<!-- Scrolling Turkic background -->
			<div class="absolute inset-0 flex items-center overflow-hidden pointer-events-none">
				<div class="flex whitespace-nowrap animate-scroll-slow opacity-50">
					<span class="font-oldturcic text-[100px] sm:text-[150px] md:text-[200px] text-blue-400/[0.03] leading-none px-8">
						𐰚𐰇𐰠𐱅𐰃𐰏𐰤 𐰖𐰸 𐰼𐰾𐰼 𐰸𐰆𐰯
					</span>
					<span class="font-oldturcic text-[100px] sm:text-[150px] md:text-[200px] text-blue-400/[0.03] leading-none px-8">
						𐰚𐰇𐰠𐱅𐰃𐰏𐰤 𐰖𐰸 𐰼𐰾𐰼 𐰸𐰆𐰯
					</span>
				</div>
			</div>
			
			<div class="relative z-10">
				<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-12 flex items-center gap-4">
					<span class="font-oldturcic text-2xl md:text-3xl text-blue-400/30 leading-none">𐰽𐰴</span>
					Skills & Expertise
					<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
				</h2>
				
				<!-- Hexagon-inspired grid -->
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
					{[
						{ glyph: "𐰋", title: "Backend Development", desc: "Node.js, Rust, Go, Python", color: "blue" },
						{ glyph: "𐰃", title: "Database Design", desc: "PostgreSQL, Redis, MongoDB", color: "indigo" },
						{ glyph: "𐰠", title: "Systems Programming", desc: "C, Rust, Linux", color: "cyan" },
						{ glyph: "𐱅", title: "Frontend Development", desc: "React, TypeScript, Tailwind", color: "emerald" },
						{ glyph: "𐰏", title: "DevOps & Cloud", desc: "Docker, K8s, AWS", color: "amber" },
						{ glyph: "𐰚", title: "Streaming Tech", desc: "FFmpeg, Real-time systems", color: "rose" }
					].map((skill) => (
						<div class="skill-hex group relative p-6 border border-[#90c5ff14] hover:border-blue-400/40 transition-all bg-[#0d0e12] overflow-hidden">
							<!-- Glow effect on hover -->
							<div class={`absolute inset-0 bg-gradient-to-br from-${skill.color}-500/0 to-${skill.color}-500/10 opacity-0 group-hover:opacity-100 transition-opacity`}></div>
							<div class={`absolute -top-10 -right-10 w-20 h-20 bg-${skill.color}-500/20 rounded-full blur-2xl opacity-0 group-hover:opacity-100 transition-opacity`}></div>
							
							<div class="relative z-10 flex items-start gap-4">
								<div class="w-12 h-12 flex items-center justify-center border border-blue-400/20 group-hover:border-blue-400/40 transition-colors rounded-sm bg-blue-500/5">
									<span class={`font-oldturcic text-2xl text-${skill.color}-400/60 group-hover:text-${skill.color}-400 transition-colors leading-none`}>{skill.glyph}</span>
								</div>
								<div class="flex-1">
									<h3 class="font-sinistre text-lg mb-1 group-hover:text-blue-200 transition-colors">{skill.title}</h3>
									<p class="text-gray-500 text-sm">{skill.desc}</p>
								</div>
							</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- Projects Section -->
		<section id="projects" class="px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14]">
			<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-12 flex items-center gap-4">
				<span class="font-oldturcic text-2xl md:text-3xl text-blue-400/30 leading-none">𐰼𐱅</span>
				Featured Projects
				<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
			</h2>
			<div class="space-y-6">
				<!-- Project 1 -->
				<div class="project-card group p-8 border border-[#90c5ff14] hover:border-blue-400/30 transition-all relative overflow-hidden rounded-sm">
					<div class="absolute inset-0 bg-gradient-to-r from-blue-600/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
					<!-- Shine effect -->
					<div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/5 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000"></div>
					<div class="relative z-10">
						<div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4 mb-4">
							<div class="flex items-center gap-4">
								<div class="w-10 h-10 border border-blue-400/30 rounded-sm flex items-center justify-center">
									<span class="font-oldturcic text-lg text-blue-400/60 leading-none">𐰇𐰕</span>
								</div>
								<div>
									<h3 class="font-sinistre text-2xl mb-1 group-hover:text-blue-200 transition-colors">Streaming Platform</h3>
									<p class="text-blue-400/60 text-sm">Deniz Egece Co. Ltd.</p>
								</div>
							</div>
							<div class="flex gap-2 flex-wrap">
								<span class="px-3 py-1 text-xs border border-[#90c5ff20] bg-[#90c5ff08] rounded-full">Node.js</span>
								<span class="px-3 py-1 text-xs border border-[#90c5ff20] bg-[#90c5ff08] rounded-full">PostgreSQL</span>
								<span class="px-3 py-1 text-xs border border-[#90c5ff20] bg-[#90c5ff08] rounded-full">FFmpeg</span>
							</div>
						</div>
						<p class="text-gray-400 leading-relaxed">
							Architected and deployed a full-featured streaming platform serving 17,000+ paid users. 
							Implemented video transcoding pipelines, payment integrations, and real-time analytics dashboard.
						</p>
					</div>
				</div>
				
				<!-- Project 2 -->
				<div class="project-card group p-8 border border-[#90c5ff14] hover:border-indigo-400/30 transition-all relative overflow-hidden rounded-sm">
					<div class="absolute inset-0 bg-gradient-to-r from-indigo-600/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
					<div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/5 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000"></div>
					<div class="relative z-10">
						<div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4 mb-4">
							<div class="flex items-center gap-4">
								<div class="w-10 h-10 border border-indigo-400/30 rounded-sm flex items-center justify-center">
									<span class="font-oldturcic text-lg text-indigo-400/60 leading-none">𐰋𐰃</span>
								</div>
								<div>
									<h3 class="font-sinistre text-2xl mb-1 group-hover:text-indigo-200 transition-colors">Personal Portfolio</h3>
									<p class="text-indigo-400/60 text-sm">atduyar.com</p>
								</div>
							</div>
							<div class="flex gap-2 flex-wrap">
								<span class="px-3 py-1 text-xs border border-[#90c5ff20] bg-[#90c5ff08] rounded-full">Astro</span>
								<span class="px-3 py-1 text-xs border border-[#90c5ff20] bg-[#90c5ff08] rounded-full">Tailwind</span>
								<span class="px-3 py-1 text-xs border border-[#90c5ff20] bg-[#90c5ff08] rounded-full">Cloudflare</span>
							</div>
						</div>
						<p class="text-gray-400 leading-relaxed">
							Custom portfolio website featuring unique typography with the Sinistre variable font,
							Old Turkic script elements paying homage to heritage, and meticulously crafted interactions.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Experience Section -->
		<section id="experience" class="px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14]">
			<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-12 flex items-center gap-4">
				<span class="font-oldturcic text-2xl md:text-3xl text-blue-400/30 leading-none">𐰇𐰕</span>
				Experience
				<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
			</h2>
			<div class="relative">
				<!-- Timeline line with glow -->
				<div class="absolute left-0 md:left-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-blue-400/40 via-[#90c5ff14] to-transparent"></div>
				
				<div class="relative pl-8 md:pl-0 md:w-1/2 md:pr-12 mb-12 group">
					<div class="absolute left-0 md:left-auto md:right-0 top-2 w-3 h-3 rounded-full bg-blue-400 md:translate-x-1/2 shadow-[0_0_10px_rgba(96,165,250,0.5)]"></div>
					<div class="p-6 border border-[#90c5ff14] hover:border-blue-400/30 transition-all rounded-sm group-hover:shadow-[0_0_30px_rgba(96,165,250,0.05)]">
						<span class="text-blue-400/80 text-sm">2023 - Present</span>
						<h3 class="font-sinistre text-xl mt-2">Full-Stack Developer</h3>
						<p class="text-gray-500 text-sm mb-3">Deniz Egece Co. Ltd.</p>
						<p class="text-gray-400 text-sm">Led development of streaming infrastructure, database architecture, and user-facing applications.</p>
					</div>
				</div>
				
				<div class="relative pl-8 md:pl-0 md:w-1/2 md:ml-auto md:pl-12 group">
					<div class="absolute left-0 md:left-0 top-2 w-3 h-3 rounded-full bg-indigo-400 md:-translate-x-1/2 shadow-[0_0_10px_rgba(129,140,248,0.5)]"></div>
					<div class="p-6 border border-[#90c5ff14] hover:border-indigo-400/30 transition-all rounded-sm group-hover:shadow-[0_0_30px_rgba(129,140,248,0.05)]">
						<span class="text-indigo-400/80 text-sm">2022 - Present</span>
						<h3 class="font-sinistre text-xl mt-2">Software Engineering</h3>
						<p class="text-gray-500 text-sm mb-3">International University of Sarajevo</p>
						<p class="text-gray-400 text-sm">Honor Student. Deep focus on computer science fundamentals, algorithms, and system design.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Invoke/Contact Section -->
		<section id="invoke" class="px-4 md:px-8 lg:px-16 py-24 relative group">
			<BackgroundMarquee class="group-has-[button:hover]:text-blue-300/30 duration-700 transition-all">
				𐰚𐰇𐰠𐱅𐰃𐰏𐰤: 𐰖𐰸: 𐰼𐰾𐰼: 𐰸𐰆𐰯: 𐰇𐰠𐱅𐰲𐰃: 𐰼𐱅𐰏𐰕: 𐰃𐰤𐰢: 𐰚𐰇𐰠𐱅𐰃𐰏𐰤: 𐰚𐰼𐰏𐰚: 𐰉𐰆𐰡𐰃: 𐰇𐰕𐰢: 𐰽𐰴𐰦𐰢: 𐰚𐰇𐰼𐰇𐰼: 𐰚𐰇𐰕𐰢: 𐰚𐰇𐰼𐰢𐰕: 𐱅𐰏: 𐰋𐰃𐰠𐰼: 𐰋𐰃𐰠𐰏𐰢: 𐰋𐰃𐰠𐰢𐰕: 𐱅𐰏: 𐰉𐰆𐰡𐰃: 𐰇𐰕𐰢: 𐰽𐰴𐰦𐰢: 𐰇𐰓: 𐱅𐰭𐰼𐰃: 𐰖𐰽𐰺: 𐰚𐰃𐰾𐰃: 𐰆𐰍𐰞𐰃: 𐰸𐰆𐰯: 𐰇𐰠𐰏𐰠𐰃: 𐱅𐰇𐰼𐰇𐰢𐰾:
			</BackgroundMarquee>
			
			<!-- Decorative Turkic border -->
			<div class="font-oldturcic text-xl text-blue-400/20 mb-6 tracking-[0.4em] leading-none text-center">
				𐰚𐰇𐰠𐱅𐰃𐰏𐰤
			</div>
			
			<h2 class="text-4xl sm:text-5xl lg:text-6xl font-sinistre mb-6 text-center">
				<span class="text-blue-300 glow-text-blue">Invoke</span> <span class="text-gray-600">Me</span>
			</h2>
			
			<p class="text-gray-400 text-lg mb-10 text-center max-w-xl mx-auto">
				Ready to build something remarkable? Reach out for collaborations, opportunities, or just to connect.
			</p>
			
			<div class="max-w-2xl mx-auto">
				<form class="space-y-6">
					<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
						<div class="group">
							<label for="name" class="font-sinistre text-lg block mb-2">Your Name</label>
