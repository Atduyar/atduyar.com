---
import BackgroundMarquee from "../../../components/BackgroundMarquee.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout title="Ahmet Tarik Duyar" description="Full-Stack Software Engineer Portfolio" bodyClass="bg-[#0a0b0d] text-white w-screen overflow-x-hidden">
	<main class="bg-[#0d0e12] border-x border-[#90c5ff14] max-w-7xl mx-auto min-h-dvh relative">
		<!-- Subtle noise overlay -->
		<div class="fixed inset-0 pointer-events-none opacity-[0.015] z-50" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 256 256%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22n%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23n)%22/%3E%3C/svg%3E');"></div>
		
		<!-- Navigation -->
		<nav class="py-6 px-4 md:px-8 border-b border-[#90c5ff14] sticky top-0 bg-[#0d0e12]/90 backdrop-blur-sm z-40">
			<div class="flex justify-between items-center">
				<a href="#hero" class="group flex items-center gap-3">
					<div class="w-10 h-10 rounded-full border border-blue-400/30 flex items-center justify-center group-hover:border-blue-400/60 transition-colors relative overflow-hidden">
						<div class="absolute inset-0 bg-blue-500/10 group-hover:bg-blue-500/20 transition-colors"></div>
						<img src="/favicon.svg" alt="Logo" class="w-6 h-6 relative z-10" />
					</div>
					<span class="font-sinistre text-xl tracking-wide hidden sm:block">Atduyar</span>
				</a>
				<ul class="flex gap-4 md:gap-8">
					<li><a href="#network" class="nav-link font-sinistre text-lg hover:text-blue-300 transition-all">Network</a></li>
					<li><a href="#gallery" class="nav-link font-sinistre text-lg hover:text-blue-300 transition-all">Gallery</a></li>
					<li><a href="#observatory" class="nav-link font-sinistre text-lg hover:text-blue-300 transition-all">Observatory</a></li>
					<li><a href="#frequency" class="nav-link font-sinistre text-lg px-4 py-1 border border-blue-500/30 hover:bg-blue-600/10 rounded-full">Tune In</a></li>
				</ul>
			</div>
		</nav>

		<!-- Hero Section -->
		<section id="hero" class="min-h-[85vh] flex flex-col justify-center px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14] relative overflow-hidden">
			<div class="absolute inset-0">
				<div class="absolute top-1/4 left-1/4 w-[500px] h-[500px] bg-blue-500/10 rounded-full blur-[150px]"></div>
				<div class="absolute bottom-1/3 right-1/4 w-[400px] h-[400px] bg-indigo-500/10 rounded-full blur-[120px]"></div>
			</div>
			
			<!-- Neural network background decoration -->
			<svg class="absolute inset-0 w-full h-full opacity-10" viewBox="0 0 800 600">
				<defs>
					<linearGradient id="lineGrad" x1="0%" y1="0%" x2="100%" y2="0%">
						<stop offset="0%" style="stop-color:#60a5fa;stop-opacity:0" />
						<stop offset="50%" style="stop-color:#60a5fa;stop-opacity:0.5" />
						<stop offset="100%" style="stop-color:#60a5fa;stop-opacity:0" />
					</linearGradient>
				</defs>
				<g class="animate-pulse-slow">
					<circle cx="100" cy="150" r="4" fill="#60a5fa" opacity="0.4"/>
					<circle cx="250" cy="100" r="3" fill="#818cf8" opacity="0.3"/>
					<circle cx="400" cy="200" r="5" fill="#60a5fa" opacity="0.5"/>
					<circle cx="550" cy="120" r="3" fill="#818cf8" opacity="0.3"/>
					<circle cx="700" cy="180" r="4" fill="#60a5fa" opacity="0.4"/>
					<circle cx="150" cy="350" r="3" fill="#818cf8" opacity="0.3"/>
					<circle cx="350" cy="400" r="4" fill="#60a5fa" opacity="0.4"/>
					<circle cx="500" cy="350" r="5" fill="#818cf8" opacity="0.5"/>
					<circle cx="650" cy="420" r="3" fill="#60a5fa" opacity="0.3"/>
					<line x1="100" y1="150" x2="250" y2="100" stroke="url(#lineGrad)" stroke-width="1"/>
					<line x1="250" y1="100" x2="400" y2="200" stroke="url(#lineGrad)" stroke-width="1"/>
					<line x1="400" y1="200" x2="550" y2="120" stroke="url(#lineGrad)" stroke-width="1"/>
					<line x1="550" y1="120" x2="700" y2="180" stroke="url(#lineGrad)" stroke-width="1"/>
					<line x1="100" y1="150" x2="150" y2="350" stroke="url(#lineGrad)" stroke-width="1"/>
					<line x1="400" y1="200" x2="350" y2="400" stroke="url(#lineGrad)" stroke-width="1"/>
					<line x1="400" y1="200" x2="500" y2="350" stroke="url(#lineGrad)" stroke-width="1"/>
					<line x1="700" y1="180" x2="650" y2="420" stroke="url(#lineGrad)" stroke-width="1"/>
				</g>
			</svg>
			
			<div class="relative z-10">
				<p class="font-oldturcic text-blue-400/50 text-lg mb-4 tracking-[0.4em] animate-fade-in leading-none">𐰚𐰇𐰠𐱅𐰃𐰏𐰤</p>
				<h1 class="text-5xl sm:text-7xl lg:text-8xl xl:text-9xl font-sinistre leading-[0.9] mb-8">
					<span class="block animate-slide-up" style="animation-delay: 0.1s;">I'm Ahmet</span>
					<span class="block animate-slide-up" style="animation-delay: 0.2s;">
						<span class="text-blue-300">Tarik</span> Duyar
					</span>
				</h1>
				<p class="text-lg md:text-xl text-gray-400 max-w-xl animate-fade-in leading-relaxed" style="animation-delay: 0.5s;">
					Building robust backend architectures and scalable systems. 
					Passionate about C, Rust, and Linux.
				</p>
				<div class="flex gap-4 mt-10 animate-fade-in" style="animation-delay: 0.7s;">
					<a href="#gallery" class="group px-6 py-3 bg-blue-600/10 border border-blue-500/30 hover:bg-blue-600/20 hover:border-blue-400/50 transition-all font-sinistre text-lg rounded-sm">
						Enter Gallery
					</a>
					<a href="#frequency" class="px-6 py-3 border border-[#90c5ff14] hover:border-[#90c5ff30] transition-all font-sinistre text-lg rounded-sm">
						Tune In
					</a>
				</div>
			</div>
		</section>

		<!-- About Section -->
		<section id="about" class="px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14]">
			<div class="flex flex-col lg:flex-row gap-12 items-start">
				<div class="flex-1">
					<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-8 flex items-center gap-4">
						<span class="font-oldturcic text-2xl md:text-3xl text-blue-400/30 leading-none">𐰋𐰃𐰠</span>
						About Me
						<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
					</h2>
					<div class="space-y-6 text-gray-300 text-lg leading-relaxed">
						<p>
							I'm a Full-Stack Software Engineer with a year of professional experience specializing in building robust backend architectures, designing scalable databases, and managing critical systems.
						</p>
						<p>
							During my time at <span class="text-white">Deniz Egece Co. Ltd.</span>, I took ownership of architecting and deploying a streaming platform serving over <span class="text-blue-300">17,000 paid users</span>, demonstrating my ability to deliver end-to-end solutions across various platforms.
						</p>
						<p>
							As an <span class="text-white">Honor Student</span> in Software Engineering at the International University of Sarajevo, I'm deeply focused on computer science fundamentals while actively exploring C, Rust, JavaScript, and Linux.
						</p>
					</div>
				</div>
				<div class="w-full lg:w-80 flex-shrink-0">
					<div class="aspect-square rounded-sm p-8 flex items-center justify-center relative group border border-[#90c5ff14]">
						<img src="/favicon.svg" alt="Logo" class="w-full h-full opacity-80 relative z-10" />
					</div>
				</div>
			</div>
		</section>

		<!-- NEURAL NETWORK - Skills as Connected Nodes -->
		<section id="network" class="px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14] relative overflow-hidden">
			<div class="relative z-10">
				<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-4 flex items-center gap-4">
					<span class="font-oldturcic text-2xl md:text-3xl text-blue-400/30 leading-none">𐰽𐰴</span>
					Neural Network
					<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
				</h2>
				<p class="text-gray-500 mb-12 max-w-2xl">Interconnected knowledge nodes forming a cohesive system architecture.</p>
				
				<!-- Neural Network Visualization -->
				<div class="relative min-h-[500px]" id="neural-network">
					<!-- SVG Connection Lines -->
					<svg class="absolute inset-0 w-full h-full pointer-events-none" id="network-lines">
						<!-- Lines will be drawn via CSS/position -->
					</svg>
					
					<!-- Layer 1: Input Layer -->
					<div class="flex flex-col gap-6 absolute left-0 top-1/2 -translate-y-1/2">
						<div class="node-input w-4 h-4 rounded-full bg-blue-400/40 border border-blue-400/60 animate-pulse-node" style="animation-delay: 0s;"></div>
						<div class="node-input w-4 h-4 rounded-full bg-blue-400/40 border border-blue-400/60 animate-pulse-node" style="animation-delay: 0.2s;"></div>
						<div class="node-input w-4 h-4 rounded-full bg-blue-400/40 border border-blue-400/60 animate-pulse-node" style="animation-delay: 0.4s;"></div>
					</div>
					
					<!-- Layer 2: Hidden Layer - Skills -->
					<div class="grid grid-cols-2 md:grid-cols-3 gap-4 md:gap-6 mx-8 md:mx-16 lg:mx-24">
						<!-- Backend Node -->
						<div class="neural-node group relative">
							<div class="absolute -inset-4 bg-blue-500/10 rounded-full blur-xl opacity-0 group-hover:opacity-100 transition-opacity"></div>
							<div class="relative border border-blue-400/30 hover:border-blue-400/60 transition-all bg-[#0d0e12] p-5 rounded-full aspect-square flex flex-col items-center justify-center text-center">
								<div class="w-3 h-3 rounded-full bg-blue-400 mb-2 group-hover:animate-ping"></div>
								<span class="font-sinistre text-sm text-blue-200">Backend</span>
								<span class="text-[10px] text-gray-500 mt-1">Node.js, Rust</span>
							</div>
							<!-- Connection dots -->
							<div class="absolute -left-2 top-1/2 w-2 h-2 rounded-full bg-blue-400/40"></div>
							<div class="absolute -right-2 top-1/2 w-2 h-2 rounded-full bg-blue-400/40"></div>
						</div>
						
						<!-- Database Node -->
						<div class="neural-node group relative">
							<div class="absolute -inset-4 bg-indigo-500/10 rounded-full blur-xl opacity-0 group-hover:opacity-100 transition-opacity"></div>
							<div class="relative border border-indigo-400/30 hover:border-indigo-400/60 transition-all bg-[#0d0e12] p-5 rounded-full aspect-square flex flex-col items-center justify-center text-center">
								<div class="w-3 h-3 rounded-full bg-indigo-400 mb-2 group-hover:animate-ping"></div>
								<span class="font-sinistre text-sm text-indigo-200">Database</span>
								<span class="text-[10px] text-gray-500 mt-1">PostgreSQL</span>
							</div>
							<div class="absolute -left-2 top-1/2 w-2 h-2 rounded-full bg-indigo-400/40"></div>
							<div class="absolute -right-2 top-1/2 w-2 h-2 rounded-full bg-indigo-400/40"></div>
						</div>
						
						<!-- Systems Node -->
						<div class="neural-node group relative">
							<div class="absolute -inset-4 bg-cyan-500/10 rounded-full blur-xl opacity-0 group-hover:opacity-100 transition-opacity"></div>
							<div class="relative border border-cyan-400/30 hover:border-cyan-400/60 transition-all bg-[#0d0e12] p-5 rounded-full aspect-square flex flex-col items-center justify-center text-center">
								<div class="w-3 h-3 rounded-full bg-cyan-400 mb-2 group-hover:animate-ping"></div>
								<span class="font-sinistre text-sm text-cyan-200">Systems</span>
								<span class="text-[10px] text-gray-500 mt-1">C, Linux</span>
							</div>
							<div class="absolute -left-2 top-1/2 w-2 h-2 rounded-full bg-cyan-400/40"></div>
							<div class="absolute -right-2 top-1/2 w-2 h-2 rounded-full bg-cyan-400/40"></div>
						</div>
						
						<!-- Frontend Node -->
						<div class="neural-node group relative">
							<div class="absolute -inset-4 bg-emerald-500/10 rounded-full blur-xl opacity-0 group-hover:opacity-100 transition-opacity"></div>
							<div class="relative border border-emerald-400/30 hover:border-emerald-400/60 transition-all bg-[#0d0e12] p-5 rounded-full aspect-square flex flex-col items-center justify-center text-center">
								<div class="w-3 h-3 rounded-full bg-emerald-400 mb-2 group-hover:animate-ping"></div>
								<span class="font-sinistre text-sm text-emerald-200">Frontend</span>
								<span class="text-[10px] text-gray-500 mt-1">React, TS</span>
							</div>
							<div class="absolute -left-2 top-1/2 w-2 h-2 rounded-full bg-emerald-400/40"></div>
							<div class="absolute -right-2 top-1/2 w-2 h-2 rounded-full bg-emerald-400/40"></div>
						</div>
						
						<!-- DevOps Node -->
						<div class="neural-node group relative">
							<div class="absolute -inset-4 bg-amber-500/10 rounded-full blur-xl opacity-0 group-hover:opacity-100 transition-opacity"></div>
							<div class="relative border border-amber-400/30 hover:border-amber-400/60 transition-all bg-[#0d0e12] p-5 rounded-full aspect-square flex flex-col items-center justify-center text-center">
								<div class="w-3 h-3 rounded-full bg-amber-400 mb-2 group-hover:animate-ping"></div>
								<span class="font-sinistre text-sm text-amber-200">DevOps</span>
								<span class="text-[10px] text-gray-500 mt-1">Docker, K8s</span>
							</div>
							<div class="absolute -left-2 top-1/2 w-2 h-2 rounded-full bg-amber-400/40"></div>
							<div class="absolute -right-2 top-1/2 w-2 h-2 rounded-full bg-amber-400/40"></div>
						</div>
						
						<!-- Streaming Node -->
						<div class="neural-node group relative">
							<div class="absolute -inset-4 bg-rose-500/10 rounded-full blur-xl opacity-0 group-hover:opacity-100 transition-opacity"></div>
							<div class="relative border border-rose-400/30 hover:border-rose-400/60 transition-all bg-[#0d0e12] p-5 rounded-full aspect-square flex flex-col items-center justify-center text-center">
								<div class="w-3 h-3 rounded-full bg-rose-400 mb-2 group-hover:animate-ping"></div>
								<span class="font-sinistre text-sm text-rose-200">Streaming</span>
								<span class="text-[10px] text-gray-500 mt-1">FFmpeg</span>
							</div>
							<div class="absolute -left-2 top-1/2 w-2 h-2 rounded-full bg-rose-400/40"></div>
							<div class="absolute -right-2 top-1/2 w-2 h-2 rounded-full bg-rose-400/40"></div>
						</div>
					</div>
					
					<!-- Layer 3: Output Layer -->
					<div class="flex flex-col gap-6 absolute right-0 top-1/2 -translate-y-1/2">
						<div class="node-output w-5 h-5 rounded-full bg-gradient-to-br from-blue-400 to-indigo-500 border-2 border-white/20 shadow-[0_0_15px_rgba(96,165,250,0.5)]"></div>
						<div class="node-output w-5 h-5 rounded-full bg-gradient-to-br from-emerald-400 to-cyan-500 border-2 border-white/20 shadow-[0_0_15px_rgba(52,211,153,0.5)]"></div>
					</div>
				</div>
				
				<!-- Network stats -->
				<div class="flex flex-wrap gap-8 mt-12 justify-center text-center">
					<div>
						<div class="text-3xl font-sinistre text-blue-300">6</div>
						<div class="text-xs text-gray-500 font-mono">ACTIVE NODES</div>
					</div>
					<div>
						<div class="text-3xl font-sinistre text-emerald-300">15+</div>
						<div class="text-xs text-gray-500 font-mono">CONNECTIONS</div>
					</div>
					<div>
						<div class="text-3xl font-sinistre text-amber-300">99.9%</div>
						<div class="text-xs text-gray-500 font-mono">UPTIME</div>
					</div>
				</div>
			</div>
		</section>

		<!-- THE GALLERY - Projects as Art Exhibits -->
		<section id="gallery" class="px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14] relative">
			<!-- Gallery wall texture -->
			<div class="absolute inset-0 opacity-[0.02]" style="background: repeating-linear-gradient(90deg, transparent, transparent 100px, rgba(144,197,255,0.1) 100px, rgba(144,197,255,0.1) 101px);"></div>
			
			<div class="relative z-10">
				<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-4 flex items-center gap-4">
					<span class="font-oldturcic text-2xl md:text-3xl text-blue-400/30 leading-none">𐰼𐱅</span>
					The Gallery
					<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
				</h2>
				<p class="text-gray-500 mb-12 max-w-2xl italic">"Each project is a work of art, crafted with precision and purpose."</p>
				
				<!-- Gallery exhibits -->
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
					<!-- Exhibit 1 -->
					<div class="exhibit group">
						<!-- Picture frame -->
						<div class="relative">
							<!-- Ornate frame -->
							<div class="absolute -inset-4 border-8 border-[#1a1b1f] shadow-[inset_0_0_20px_rgba(0,0,0,0.5),0_0_30px_rgba(0,0,0,0.3)]"></div>
							<div class="absolute -inset-2 border border-[#90c5ff20]"></div>
							
							<!-- Artwork area -->
							<div class="relative bg-gradient-to-br from-blue-900/20 via-[#0d0e12] to-indigo-900/20 aspect-video flex items-center justify-center overflow-hidden">
								<!-- Abstract visualization of the project -->
								<div class="absolute inset-0 opacity-30">
									<div class="absolute top-1/4 left-1/4 w-32 h-32 border border-blue-400/30 rounded-lg rotate-12 animate-float"></div>
									<div class="absolute bottom-1/3 right-1/4 w-24 h-24 border border-indigo-400/30 rounded-lg -rotate-6 animate-float" style="animation-delay: 1s;"></div>
									<div class="absolute top-1/2 left-1/2 w-16 h-16 bg-blue-500/20 rounded-full blur-lg"></div>
								</div>
								
								<!-- Project icon/symbol -->
								<div class="relative text-center">
									<div class="text-6xl mb-4 opacity-80">📺</div>
									<div class="font-sinistre text-2xl text-white/90">Streaming Platform</div>
								</div>
								
								<!-- Gallery lighting effect -->
								<div class="absolute inset-0 bg-gradient-to-b from-white/5 via-transparent to-black/20"></div>
							</div>
						</div>
						
						<!-- Museum plaque -->
						<div class="mt-8 bg-[#0a0b0d] border border-[#90c5ff14] p-4 mx-4">
							<h3 class="font-sinistre text-xl mb-1">Streaming Platform</h3>
							<p class="text-blue-400/60 text-sm mb-2">Deniz Egece Co. Ltd. • 2023</p>
							<p class="text-gray-400 text-sm leading-relaxed mb-3">
								A full-featured streaming platform serving 17,000+ paid users. Features video transcoding pipelines, payment integrations, and real-time analytics.
							</p>
							<div class="flex gap-2 flex-wrap">
								<span class="text-xs text-gray-500 border-b border-gray-700 pb-0.5">Node.js</span>
								<span class="text-xs text-gray-500 border-b border-gray-700 pb-0.5">PostgreSQL</span>
								<span class="text-xs text-gray-500 border-b border-gray-700 pb-0.5">FFmpeg</span>
							</div>
						</div>
					</div>
					
					<!-- Exhibit 2 -->
					<div class="exhibit group">
						<div class="relative">
							<div class="absolute -inset-4 border-8 border-[#1a1b1f] shadow-[inset_0_0_20px_rgba(0,0,0,0.5),0_0_30px_rgba(0,0,0,0.3)]"></div>
							<div class="absolute -inset-2 border border-[#90c5ff20]"></div>
							
							<div class="relative bg-gradient-to-br from-indigo-900/20 via-[#0d0e12] to-purple-900/20 aspect-video flex items-center justify-center overflow-hidden">
								<div class="absolute inset-0 opacity-30">
									<div class="absolute top-1/3 right-1/4 w-28 h-28 border border-indigo-400/30 rounded-full animate-float"></div>
									<div class="absolute bottom-1/4 left-1/3 w-20 h-20 border border-purple-400/30 rounded-lg rotate-45 animate-float" style="animation-delay: 0.5s;"></div>
								</div>
								
								<div class="relative text-center">
									<div class="text-6xl mb-4 opacity-80">🎨</div>
									<div class="font-sinistre text-2xl text-white/90">Personal Portfolio</div>
								</div>
								
								<div class="absolute inset-0 bg-gradient-to-b from-white/5 via-transparent to-black/20"></div>
							</div>
						</div>
						
						<div class="mt-8 bg-[#0a0b0d] border border-[#90c5ff14] p-4 mx-4">
							<h3 class="font-sinistre text-xl mb-1">Personal Portfolio</h3>
							<p class="text-indigo-400/60 text-sm mb-2">atduyar.com • 2024</p>
							<p class="text-gray-400 text-sm leading-relaxed mb-3">
								Custom portfolio featuring Sinistre variable font, Old Turkic script elements, and meticulously crafted interactions.
							</p>
							<div class="flex gap-2 flex-wrap">
								<span class="text-xs text-gray-500 border-b border-gray-700 pb-0.5">Astro</span>
								<span class="text-xs text-gray-500 border-b border-gray-700 pb-0.5">Tailwind</span>
								<span class="text-xs text-gray-500 border-b border-gray-700 pb-0.5">Cloudflare</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- NEW SECTION: THE OBSERVATORY - Technologies Being Watched -->
		<section id="observatory" class="px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14] relative overflow-hidden">
			<!-- Star field background -->
			<div class="absolute inset-0">
				{Array.from({ length: 30 }).map((_, i) => (
					<div 
						class="absolute w-0.5 h-0.5 bg-white/30 rounded-full animate-twinkle"
						style={`top: ${Math.random() * 100}%; left: ${Math.random() * 100}%; animation-delay: ${Math.random() * 3}s;`}
					></div>
				))}
			</div>
			
			<div class="relative z-10">
				<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-4 flex items-center gap-4">
