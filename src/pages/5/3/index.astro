---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout title="Kül Tigin | Duyar" description="Ahmet Tarik Duyar - Monument Portfolio" bodyClass="bg-[#1a1612] text-[#c9b896] min-h-screen overflow-x-hidden">
	<!-- Stone texture -->
	<div class="fixed inset-0 pointer-events-none opacity-[0.08] z-0" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22n%22%3E%3CfeTurbulence type=%22turbulence%22 baseFrequency=%220.02%22 numOctaves=%223%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23n)%22/%3E%3C/svg%3E');"></div>
	
	<!-- Runic border patterns -->
	<div class="fixed top-0 left-0 right-0 h-2 bg-[#8b7355]/20 z-40" style="background-image: repeating-linear-gradient(90deg, transparent 0px, transparent 20px, #8b7355 20px, #8b7355 22px);"></div>
	<div class="fixed bottom-0 left-0 right-0 h-2 bg-[#8b7355]/20 z-40" style="background-image: repeating-linear-gradient(90deg, transparent 0px, transparent 20px, #8b7355 20px, #8b7355 22px);"></div>

	<main class="relative z-10 pt-2 pb-2">
		<!-- Ornate header -->
		<header class="py-8 px-6 md:px-12 border-b border-[#8b7355]/20">
			<div class="max-w-5xl mx-auto flex justify-between items-center">
				<div class="flex items-center gap-4">
					<div class="w-12 h-12 border-2 border-[#8b7355]/40 flex items-center justify-center">
						<img src="/favicon.svg" alt="Seal" class="w-8 h-8 opacity-70" />
					</div>
					<div class="hidden sm:block">
						<span class="font-oldturcic text-lg text-[#8b7355] leading-none block">𐱅𐰭𐰼𐰃</span>
						<span class="text-xs text-[#c9b896]/40 uppercase tracking-widest">Est. MMXXII</span>
					</div>
				</div>
				<nav class="flex items-center gap-6">
					<a href="#inscription" class="text-sm text-[#c9b896]/60 hover:text-[#8b7355] transition-colors uppercase tracking-widest">Inscription</a>
					<a href="#summon" class="px-5 py-2.5 border-2 border-[#8b7355] text-[#8b7355] text-sm uppercase tracking-widest hover:bg-[#8b7355] hover:text-[#1a1612] transition-all">
						Summon
					</a>
				</nav>
			</div>
		</header>

		<!-- Hero - Monument style -->
		<section class="py-24 md:py-32 px-6 md:px-12">
			<div class="max-w-5xl mx-auto">
				<!-- Top inscription band -->
				<div class="text-center mb-12">
					<div class="inline-flex items-center gap-4">
						<div class="w-8 h-px bg-[#8b7355]/40"></div>
						<span class="font-oldturcic text-xl text-[#8b7355]/60 tracking-[0.5em] leading-none">𐰚𐰇𐰠𐱅𐰃𐰏𐰤</span>
						<div class="w-8 h-px bg-[#8b7355]/40"></div>
					</div>
				</div>
				
				<!-- Stone tablet frame -->
				<div class="relative border-4 border-[#8b7355]/30 p-8 md:p-16 bg-gradient-to-b from-[#1a1612] to-[#0f0d0a]">
					<!-- Corner ornaments -->
					<div class="absolute top-0 left-0 w-12 h-12 border-t-4 border-l-4 border-[#8b7355]/50 -translate-x-1 -translate-y-1"></div>
					<div class="absolute top-0 right-0 w-12 h-12 border-t-4 border-r-4 border-[#8b7355]/50 translate-x-1 -translate-y-1"></div>
					<div class="absolute bottom-0 left-0 w-12 h-12 border-b-4 border-l-4 border-[#8b7355]/50 -translate-x-1 translate-y-1"></div>
					<div class="absolute bottom-0 right-0 w-12 h-12 border-b-4 border-r-4 border-[#8b7355]/50 translate-x-1 translate-y-1"></div>
					
					<div class="text-center">
						<h1 class="font-sinistre text-5xl sm:text-6xl md:text-7xl lg:text-8xl leading-[0.9] mb-8">
							<span class="block text-[#c9b896]">Ahmet Tarik</span>
							<span class="block text-[#8b7355] mt-2">Duyar</span>
						</h1>
						
						<div class="w-32 h-px bg-gradient-to-r from-transparent via-[#8b7355]/50 to-transparent mx-auto mb-8"></div>
						
						<p class="font-oldturcic text-lg text-[#8b7355]/50 mb-6 tracking-[0.3em] leading-none">
							𐰖𐰕𐰺 𐰆𐰍𐰞𐰃 𐰇𐰕 𐰸𐰆𐰯
						</p>
						
						<p class="text-lg text-[#c9b896]/60 max-w-xl mx-auto leading-relaxed">
							Software Engineer. Builder of systems. Keeper of the ancient code. From Sarajevo to the digital steppe.
						</p>
					</div>
				</div>
				
				<!-- Bottom inscription band -->
				<div class="text-center mt-12">
					<div class="inline-flex items-center gap-4">
						<div class="w-8 h-px bg-[#8b7355]/40"></div>
						<span class="font-oldturcic text-xl text-[#8b7355]/60 tracking-[0.5em] leading-none">𐰉𐰆𐰡𐰃𐰇𐰕𐰢</span>
						<div class="w-8 h-px bg-[#8b7355]/40"></div>
					</div>
				</div>
			</div>
		</section>

		<!-- Inscription/About Section -->
		<section id="inscription" class="py-24 px-6 md:px-12 border-t border-[#8b7355]/20">
			<div class="max-w-5xl mx-auto">
				<div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
					<!-- Left ornament column -->
					<div class="hidden lg:flex flex-col items-center justify-center">
						<div class="font-oldturcic text-4xl text-[#8b7355]/20 leading-none writing-vertical tracking-[1em]">
							𐰚𐰇𐰠𐱅𐰃𐰏𐰤𐰖𐰸𐰼𐰾𐰼
						</div>
					</div>
					
					<!-- Center content -->
					<div class="lg:col-span-2">
						<div class="flex items-center gap-4 mb-10">
							<span class="font-oldturcic text-2xl text-[#8b7355]/40 leading-none">𐰋𐰃𐰠</span>
							<h2 class="font-sinistre text-3xl md:text-4xl text-[#8b7355]">The Inscription</h2>
						</div>
						
						<div class="space-y-8 text-lg text-[#c9b896]/70 leading-relaxed">
							<p class="first-letter:text-5xl first-letter:font-sinistre first-letter:text-[#8b7355] first-letter:float-left first-letter:mr-3 first-letter:mt-1">
								A Full-Stack Software Engineer from the lands where ancient scripts carved eternal wisdom. At Deniz Egece Co., I built a streaming fortress serving seventeen thousand warriors with video, payments, and analytics.
							</p>
							<p>
								Now an Honor Student at the International University of Sarajevo, studying the sacred texts of computation: C, Rust, and the Linux kernel. Building systems that shall endure.
							</p>
						</div>
						
						<div class="w-full h-px bg-gradient-to-r from-[#8b7355]/30 via-[#8b7355]/10 to-transparent mt-12 mb-12"></div>
						
						<!-- Skill runes -->
						<div class="grid grid-cols-3 sm:grid-cols-6 gap-4">
							<div class="text-center p-4 border border-[#8b7355]/20 hover:border-[#8b7355]/40 transition-colors">
								<span class="font-oldturcic text-xl text-[#8b7355]/60 leading-none">𐰋</span>
								<p class="text-xs text-[#c9b896]/40 mt-2">Backend</p>
							</div>
							<div class="text-center p-4 border border-[#8b7355]/20 hover:border-[#8b7355]/40 transition-colors">
								<span class="font-oldturcic text-xl text-[#8b7355]/60 leading-none">𐰃</span>
								<p class="text-xs text-[#c9b896]/40 mt-2">Data</p>
							</div>
							<div class="text-center p-4 border border-[#8b7355]/20 hover:border-[#8b7355]/40 transition-colors">
								<span class="font-oldturcic text-xl text-[#8b7355]/60 leading-none">𐰠</span>
								<p class="text-xs text-[#c9b896]/40 mt-2">Systems</p>
							</div>
							<div class="text-center p-4 border border-[#8b7355]/20 hover:border-[#8b7355]/40 transition-colors">
								<span class="font-oldturcic text-xl text-[#8b7355]/60 leading-none">𐱅</span>
								<p class="text-xs text-[#c9b896]/40 mt-2">Cloud</p>
							</div>
							<div class="text-center p-4 border border-[#8b7355]/20 hover:border-[#8b7355]/40 transition-colors">
								<span class="font-oldturcic text-xl text-[#8b7355]/60 leading-none">𐰏</span>
								<p class="text-xs text-[#c9b896]/40 mt-2">Stream</p>
							</div>
							<div class="text-center p-4 border border-[#8b7355]/20 hover:border-[#8b7355]/40 transition-colors">
								<span class="font-oldturcic text-xl text-[#8b7355]/60 leading-none">𐰚</span>
								<p class="text-xs text-[#c9b896]/40 mt-2">Frontend</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Works - Carved tablets -->
		<section class="py-24 px-6 md:px-12 border-t border-[#8b7355]/20">
			<div class="max-w-5xl mx-auto">
				<div class="flex items-center gap-4 mb-16">
					<span class="font-oldturcic text-2xl text-[#8b7355]/40 leading-none">𐰼𐱅</span>
					<h2 class="font-sinistre text-3xl md:text-4xl text-[#8b7355]">The Works</h2>
				</div>
				
				<div class="space-y-8">
					<!-- Work tablet 1 -->
					<article class="border-2 border-[#8b7355]/20 p-8 relative hover:border-[#8b7355]/40 transition-colors">
						<div class="absolute top-4 right-4 font-oldturcic text-2xl text-[#8b7355]/20 leading-none">𐰇𐰕</div>
						<span class="text-xs text-[#8b7355]/60 uppercase tracking-widest">Deniz Egece Co. / MMXXIII</span>
						<h3 class="font-sinistre text-2xl md:text-3xl mt-3 mb-4 text-[#c9b896]">Streaming Fortress</h3>
						<p class="text-[#c9b896]/60 mb-6 leading-relaxed max-w-2xl">
							A complete video streaming architecture serving 17,000+ users. Video transcoding rivers, payment gates, and the all-seeing analytics.
						</p>
						<div class="flex flex-wrap gap-2">
							<span class="px-3 py-1 text-xs border border-[#8b7355]/30 text-[#8b7355]/60">Node.js</span>
							<span class="px-3 py-1 text-xs border border-[#8b7355]/30 text-[#8b7355]/60">PostgreSQL</span>
							<span class="px-3 py-1 text-xs border border-[#8b7355]/30 text-[#8b7355]/60">FFmpeg</span>
						</div>
					</article>
					
					<!-- Work tablet 2 -->
					<article class="border-2 border-[#8b7355]/20 p-8 relative hover:border-[#8b7355]/40 transition-colors">
						<div class="absolute top-4 right-4 font-oldturcic text-2xl text-[#8b7355]/20 leading-none">𐰋𐰃</div>
						<span class="text-xs text-[#8b7355]/60 uppercase tracking-widest">Personal / MMXXIV</span>
						<h3 class="font-sinistre text-2xl md:text-3xl mt-3 mb-4 text-[#c9b896]">Digital Monument</h3>
						<p class="text-[#c9b896]/60 mb-6 leading-relaxed max-w-2xl">
							A portfolio honoring the Orkhon inscriptions through modern web craft. Custom typography, cultural elements woven in code.
						</p>
						<div class="flex flex-wrap gap-2">
							<span class="px-3 py-1 text-xs border border-[#8b7355]/30 text-[#8b7355]/60">Astro</span>
							<span class="px-3 py-1 text-xs border border-[#8b7355]/30 text-[#8b7355]/60">Tailwind</span>
							<span class="px-3 py-1 text-xs border border-[#8b7355]/30 text-[#8b7355]/60">Cloudflare</span>
						</div>
					</article>
				</div>
			</div>
		</section>

		<!-- Summon Section -->
		<section id="summon" class="py-24 px-6 md:px-12 border-t border-[#8b7355]/20">
			<div class="max-w-3xl mx-auto text-center">
				<!-- Ornate frame -->
				<div class="border-2 border-[#8b7355]/30 p-12 relative">
					<div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-[#1a1612] px-4">
						<span class="font-oldturcic text-xl text-[#8b7355]/60 leading-none">𐰽𐰴𐰦𐰢</span>
					</div>
					
					<h2 class="font-sinistre text-4xl md:text-5xl mb-6">
						<span class="text-[#8b7355]">Summon</span> <span class="text-[#c9b896]/30">Me</span>
					</h2>
					
					<p class="text-lg text-[#c9b896]/50 mb-10 max-w-md mx-auto">
						Ready to carve something into history? Reach out for collaborations and tales of code.
					</p>
					
					<a href="mailto:contact@atduyar.com" class="inline-block px-12 py-4 border-2 border-[#8b7355] text-[#8b7355] font-sinistre text-xl hover:bg-[#8b7355] hover:text-[#1a1612] transition-all">
						Send Word
					</a>
					
					<div class="flex justify-center gap-10 mt-10 text-sm">
						<a href="https://github.com/atduyar" target="_blank" rel="noopener" class="text-[#c9b896]/40 hover:text-[#8b7355] transition-colors uppercase tracking-widest">
							GitHub
						</a>
						<a href="https://linkedin.com/in/atduyar" target="_blank" rel="noopener" class="text-[#c9b896]/40 hover:text-[#8b7355] transition-colors uppercase tracking-widest">
							LinkedIn
						</a>
					</div>
					
					<div class="absolute -bottom-3 left-1/2 -translate-x-1/2 bg-[#1a1612] px-4">
						<span class="font-oldturcic text-xl text-[#8b7355]/60 leading-none">𐰉𐰆𐰡𐰃</span>
					</div>
				</div>
			</div>
		</section>

		<!-- Footer -->
		<footer class="py-8 px-6 md:px-12 border-t border-[#8b7355]/20">
			<div class="max-w-5xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-4 text-sm text-[#c9b896]/40">
				<div class="flex items-center gap-3">
					<span class="font-oldturcic text-[#8b7355]/40 leading-none">𐱅𐰭𐰼𐰃</span>
					<span>&copy; MMXXVI Ahmet Tarik Duyar</span>
				</div>
				<span class="font-oldturcic text-xs text-[#8b7355]/30 tracking-[0.3em] leading-none">𐰚𐰇𐰠𐱅𐰃𐰏𐰤𐰖𐰸𐰼𐰾𐰼</span>
			</div>
		</footer>
	</main>
</BaseLayout>

<style>
	.writing-vertical {
		writing-mode: vertical-rl;
		text-orientation: mixed;
	}
</style>
