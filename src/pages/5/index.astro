---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<!--
	Variant 5 — "Split"
	Two-column layout: a sticky identity panel on the left (name, role, nav,
	links) and scrolling content on the right. The runic theme lives in a
	faint vertical glyph strip along the left edge. Collapses to a single
	column on mobile.
-->
<BaseLayout
	title="Ahmet Tarik Duyar — Software Engineer"
	description="Full-stack software engineer in Sarajevo. Streaming platforms, .NET systems, Rust."
	bodyClass="bg-[#0b0c10] text-gray-300 antialiased"
>
	<!-- Vertical glyph strip, far left, desktop only -->
	<div class="fixed left-3 top-1/2 -translate-y-1/2 hidden xl:block select-none pointer-events-none" aria-hidden="true">
		<span class="font-oldturcic text-blue-400/10 text-xl tracking-[0.6em] leading-none" style="writing-mode: vertical-rl;">𐰋𐰃𐰠𐰏 𐰃𐱁</span>
	</div>

	<div class="max-w-6xl mx-auto px-6 md:px-12 lg:flex lg:gap-16">
		<!-- Left: identity panel -->
		<header class="lg:w-2/5 lg:sticky lg:top-0 lg:h-screen lg:flex lg:flex-col lg:justify-between py-16 lg:py-24">
			<div>
				<h1 class="font-sinistre text-4xl md:text-5xl text-white mb-3">Ahmet Tarik Duyar</h1>
				<p class="text-blue-300 mb-6">Full-Stack Software Engineer</p>
				<p class="text-gray-400 text-sm leading-relaxed max-w-xs">
					I design, build, and operate production systems — from the database
					schema to the deploy pipeline.
				</p>

				<nav class="hidden lg:block mt-14" aria-label="Sections">
					<ul class="space-y-4 text-xs uppercase tracking-[0.2em]">
						<li><a href="#about" class="group flex items-center gap-3 text-gray-500 hover:text-white transition-colors">
							<span class="h-px w-8 bg-gray-600 group-hover:w-14 group-hover:bg-blue-300 transition-all"></span>About
						</a></li>
						<li><a href="#experience" class="group flex items-center gap-3 text-gray-500 hover:text-white transition-colors">
							<span class="h-px w-8 bg-gray-600 group-hover:w-14 group-hover:bg-blue-300 transition-all"></span>Experience
						</a></li>
						<li><a href="#projects" class="group flex items-center gap-3 text-gray-500 hover:text-white transition-colors">
							<span class="h-px w-8 bg-gray-600 group-hover:w-14 group-hover:bg-blue-300 transition-all"></span>Projects
						</a></li>
					</ul>
				</nav>
			</div>

			<div class="mt-10 lg:mt-0">
				<div class="flex gap-6 text-sm">
					<a href="https://github.com/atduyar" target="_blank" rel="noopener" class="text-gray-500 hover:text-blue-300 transition-colors">GitHub</a>
					<a href="https://linkedin.com/in/atduyar" target="_blank" rel="noopener" class="text-gray-500 hover:text-blue-300 transition-colors">LinkedIn</a>
					<a href="mailto:atduyar@gmail.com" class="text-gray-500 hover:text-blue-300 transition-colors">Email</a>
				</div>
				<p class="text-xs text-gray-600 mt-4">Sarajevo, Bosnia &amp; Herzegovina</p>
			</div>
		</header>

		<!-- Right: content -->
		<main class="lg:w-3/5 py-4 lg:py-24">
			<!-- About -->
			<section id="about" class="mb-20 scroll-mt-24">
				<h2 class="text-xs uppercase tracking-[0.2em] text-gray-500 mb-6 lg:sr-only">About</h2>
				<div class="space-y-5 text-gray-400 leading-relaxed">
					<p>
						For the past three years I've been the engineer behind
						<span class="text-gray-200">EgeceTV</span>, a streaming platform with
						over 17,000 paying subscribers across five platforms. I led its backend
						architecture and database design, built its payment system, and
						automated its releases — and learned what it means to be responsible
						for software people pay for every month.
					</p>
					<p>
						I'm also a computer science honor student at the International
						University of Sarajevo, and below the web stack I work in
						<span class="text-gray-200">Rust, C, and Linux</span> — building a
						key-value store, a game engine, and the infrastructure this site runs on.
					</p>
				</div>
			</section>

			<!-- Experience -->
			<section id="experience" class="mb-20 scroll-mt-24">
				<h2 class="text-xs uppercase tracking-[0.2em] text-gray-500 mb-8">Experience</h2>

				<div class="space-y-4">
					<article class="group grid sm:grid-cols-[8rem_1fr] gap-2 sm:gap-6 p-4 -mx-4 rounded hover:bg-white/[0.03] transition-colors">
						<span class="text-xs text-gray-500 uppercase tracking-wide pt-1 tabular-nums">2022 — Present</span>
						<div>
							<h3 class="text-gray-100 group-hover:text-blue-300 transition-colors">Full-Stack Engineer · Deniz Egece Co. Ltd.</h3>
							<p class="text-sm text-gray-400 leading-relaxed mt-2">
								Founding engineer on the EgeceTV streaming platform; also built a
								distance-education platform for psychologists and dietitians
								(.NET, Clean Architecture, WebRTC) in a five-person team. Owned
								backend architecture, database design, payments, and CI/CD.
							</p>
							<div class="flex flex-wrap gap-2 mt-3">
								<span class="text-xs text-blue-300/90 bg-blue-400/10 rounded-full px-3 py-1">Next.js</span>
								<span class="text-xs text-blue-300/90 bg-blue-400/10 rounded-full px-3 py-1">GraphQL</span>
								<span class="text-xs text-blue-300/90 bg-blue-400/10 rounded-full px-3 py-1">C# / .NET</span>
								<span class="text-xs text-blue-300/90 bg-blue-400/10 rounded-full px-3 py-1">PostgreSQL</span>
								<span class="text-xs text-blue-300/90 bg-blue-400/10 rounded-full px-3 py-1">AWS</span>
							</div>
						</div>
					</article>

					<article class="group grid sm:grid-cols-[8rem_1fr] gap-2 sm:gap-6 p-4 -mx-4 rounded hover:bg-white/[0.03] transition-colors">
						<span class="text-xs text-gray-500 uppercase tracking-wide pt-1 tabular-nums">2021 — 2022</span>
						<div>
							<h3 class="text-gray-100 group-hover:text-blue-300 transition-colors">Freelance Developer</h3>
							<p class="text-sm text-gray-400 leading-relaxed mt-2">
								Built and operated Evrenomi, a C#/.NET blogging platform with a
								95+ Lighthouse score on self-managed Linux infrastructure.
							</p>
							<div class="flex flex-wrap gap-2 mt-3">
								<span class="text-xs text-blue-300/90 bg-blue-400/10 rounded-full px-3 py-1">C#</span>
								<span class="text-xs text-blue-300/90 bg-blue-400/10 rounded-full px-3 py-1">REST</span>
								<span class="text-xs text-blue-300/90 bg-blue-400/10 rounded-full px-3 py-1">Linux</span>
							</div>
						</div>
					</article>
				</div>
			</section>

			<!-- Projects -->
			<section id="projects" class="mb-20 scroll-mt-24">
				<h2 class="text-xs uppercase tracking-[0.2em] text-gray-500 mb-8">Projects</h2>

				<div class="space-y-4">
					<a href="https://github.com/atduyar/rekv" target="_blank" rel="noopener" class="group block p-4 -mx-4 rounded hover:bg-white/[0.03] transition-colors">
						<div class="flex items-baseline justify-between gap-4">
							<h3 class="text-gray-100 group-hover:text-blue-300 transition-colors">REKV <span class="text-gray-600 text-sm">↗</span></h3>
							<span class="text-xs text-gray-600">Rust</span>
						</div>
						<p class="text-sm text-gray-400 leading-relaxed mt-2">
							Type-safe key-value store library: memory-mapped storage, zero-copy
							deserialization, async I/O.
						</p>
					</a>

					<a href="https://github.com/atduyar/make2game" target="_blank" rel="noopener" class="group block p-4 -mx-4 rounded hover:bg-white/[0.03] transition-colors">
						<div class="flex items-baseline justify-between gap-4">
							<h3 class="text-gray-100 group-hover:text-blue-300 transition-colors">Make2Game <span class="text-gray-600 text-sm">↗</span></h3>
							<span class="text-xs text-gray-600">C++ / OpenGL</span>
						</div>
						<p class="text-sm text-gray-400 leading-relaxed mt-2">
							2D game engine built from scratch with Lua scripting and an
							immediate-mode GUI editor.
						</p>
					</a>

					<a href="https://evrenomi.com" target="_blank" rel="noopener" class="group block p-4 -mx-4 rounded hover:bg-white/[0.03] transition-colors">
						<div class="flex items-baseline justify-between gap-4">
							<h3 class="text-gray-100 group-hover:text-blue-300 transition-colors">Evrenomi <span class="text-gray-600 text-sm">↗</span></h3>
							<span class="text-xs text-gray-600">C# / .NET</span>
						</div>
						<p class="text-sm text-gray-400 leading-relaxed mt-2">
							Performance-focused blogging platform — 95+ Lighthouse across all
							metrics.
						</p>
					</a>

					<div class="p-4 -mx-4">
						<div class="flex items-baseline justify-between gap-4">
							<h3 class="text-gray-100">EgeceTV</h3>
							<span class="text-xs text-gray-600">commercial</span>
						</div>
						<p class="text-sm text-gray-400 leading-relaxed mt-2">
							The streaming platform described above — 17K+ subscribers, five
							platforms, one GraphQL API.
						</p>
					</div>
				</div>
			</section>

			<!-- Footer / contact -->
			<footer class="pt-8 border-t border-white/5">
				<p class="text-sm text-gray-400 leading-relaxed max-w-md">
					Open to interesting roles and collaborations — the fastest way to reach
					me is <a href="mailto:atduyar@gmail.com" class="text-blue-400 hover:text-blue-300 transition-colors">atduyar@gmail.com</a>.
				</p>
				<p class="text-xs text-gray-600 mt-8">
					© 2026 Ahmet Tarik Duyar. Built with Astro, deployed on infrastructure I run myself.
				</p>
			</footer>
		</main>
	</div>
</BaseLayout>
