---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="𐱅𐰭𐰼𐰃 | Atduyar" description="Ahmet Tarik Duyar - Ancient Futurism Portfolio" bodyClass="bg-[#0a0908] text-[#e8e4dc] min-h-screen overflow-x-hidden">
	<!-- Ancient pattern overlay -->
	<div class="fixed inset-0 pointer-events-none opacity-[0.02]" style="background-image: url('data:image/svg+xml,%3Csvg width=%2260%22 height=%2260%22 viewBox=%220 0 60 60%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cpath d=%22M30 0L60 30L30 60L0 30Z%22 fill=%22none%22 stroke=%22%23c9a45c%22 stroke-width=%220.5%22/%3E%3C/svg%3E');"></div>
	
	<!-- Golden accent lines -->
	<div class="fixed top-0 left-16 w-px h-full bg-gradient-to-b from-transparent via-[#c9a45c]/20 to-transparent pointer-events-none hidden lg:block"></div>
	<div class="fixed top-0 right-16 w-px h-full bg-gradient-to-b from-transparent via-[#c9a45c]/20 to-transparent pointer-events-none hidden lg:block"></div>

	<main class="relative z-10">
		<!-- Navigation with Turkic script -->
		<nav class="fixed top-0 left-0 right-0 z-50 backdrop-blur-md bg-[#0a0908]/80 border-b border-[#c9a45c]/10">
			<div class="max-w-7xl mx-auto px-6 md:px-12 py-4 flex justify-between items-center">
				<a href="#" class="flex items-center gap-3 group">
					<img src="/favicon.svg" alt="Logo" class="w-10 h-10 opacity-80 group-hover:opacity-100 transition-opacity" />
					<span class="font-oldturcic text-2xl text-[#c9a45c] hidden md:block">𐱅𐰭𐰼𐰃</span>
				</a>
				<div class="flex items-center gap-8">
					<a href="#origin" class="nav-link text-sm tracking-widest uppercase text-[#e8e4dc]/60 hover:text-[#c9a45c] transition-colors">Origin</a>
					<a href="#craft" class="nav-link text-sm tracking-widest uppercase text-[#e8e4dc]/60 hover:text-[#c9a45c] transition-colors">Craft</a>
					<a href="#works" class="nav-link text-sm tracking-widest uppercase text-[#e8e4dc]/60 hover:text-[#c9a45c] transition-colors">Works</a>
					<a href="#summon" class="px-4 py-2 border border-[#c9a45c]/30 text-[#c9a45c] text-sm tracking-widest uppercase hover:bg-[#c9a45c]/10 transition-all">Summon</a>
				</div>
			</div>
		</nav>

		<!-- Hero - Ancient meets modern -->
		<section class="min-h-screen flex items-center justify-center relative pt-20">
			<!-- Floating Turkic glyphs -->
			<div class="absolute inset-0 overflow-hidden pointer-events-none">
				<span class="absolute top-1/4 left-[10%] font-oldturcic text-8xl text-[#c9a45c]/5 animate-float-1">𐰚</span>
				<span class="absolute top-1/3 right-[15%] font-oldturcic text-6xl text-[#c9a45c]/5 animate-float-2">𐰇</span>
				<span class="absolute bottom-1/4 left-[20%] font-oldturcic text-7xl text-[#c9a45c]/5 animate-float-3">𐰠</span>
				<span class="absolute bottom-1/3 right-[25%] font-oldturcic text-9xl text-[#c9a45c]/5 animate-float-1">𐱅</span>
				<span class="absolute top-1/2 left-[5%] font-oldturcic text-5xl text-[#c9a45c]/5 animate-float-2">𐰃</span>
				<span class="absolute top-[60%] right-[8%] font-oldturcic text-6xl text-[#c9a45c]/5 animate-float-3">𐰏</span>
			</div>
			
			<div class="text-center px-6 relative">
				<!-- Turkic inscription above -->
				<p class="font-oldturcic text-2xl md:text-3xl text-[#c9a45c]/40 mb-8 tracking-[0.5em] animate-fade-in">
					𐰚𐰇𐰠𐱅𐰃𐰏𐰤
				</p>
				
				<!-- Main title -->
				<h1 class="font-sinistre text-6xl sm:text-8xl lg:text-[10rem] leading-[0.85] tracking-tight mb-8">
					<span class="block text-[#e8e4dc] animate-rise-1">Ahmet Tarik</span>
					<span class="block text-[#c9a45c] animate-rise-2">Duyar</span>
				</h1>
				
				<!-- Subtitle with decorative elements -->
				<div class="flex items-center justify-center gap-6 mt-12 animate-fade-in-delayed">
					<div class="h-px w-16 bg-gradient-to-r from-transparent to-[#c9a45c]/50"></div>
					<p class="text-lg tracking-[0.3em] uppercase text-[#e8e4dc]/50">Software Engineer</p>
					<div class="h-px w-16 bg-gradient-to-l from-transparent to-[#c9a45c]/50"></div>
				</div>
				
				<!-- Turkic script scroll prompt -->
				<div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-4">
					<p class="font-oldturcic text-sm text-[#c9a45c]/40">𐰆𐰸</p>
					<div class="w-px h-16 bg-gradient-to-b from-[#c9a45c]/40 to-transparent animate-pulse-slow"></div>
				</div>
			</div>
		</section>

		<!-- Origin Section -->
		<section id="origin" class="py-32 px-6 md:px-12 relative">
			<div class="max-w-5xl mx-auto">
				<!-- Section header with Turkic decoration -->
				<div class="flex items-center gap-6 mb-16">
					<span class="font-oldturcic text-4xl text-[#c9a45c]/30">𐰋𐰃𐰠</span>
					<h2 class="font-sinistre text-4xl md:text-6xl">Origin</h2>
					<div class="flex-1 h-px bg-gradient-to-r from-[#c9a45c]/30 to-transparent"></div>
				</div>
				
				<div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
					<div class="lg:col-span-7 space-y-8">
						<p class="text-xl leading-relaxed text-[#e8e4dc]/80">
							A Full-Stack Software Engineer from the lands where ancient scripts once carved wisdom into stone. I carry the same precision into modern architecture.
						</p>
						<p class="text-xl leading-relaxed text-[#e8e4dc]/80">
							At <span class="text-[#c9a45c]">Deniz Egece Co. Ltd.</span>, I architected a streaming platform serving <span class="text-[#c9a45c]">17,000+ subscribers</span>, managing video transcoding pipelines, payment systems, and real-time analytics.
						</p>
						<p class="text-xl leading-relaxed text-[#e8e4dc]/80">
							Currently an Honor Student at the International University of Sarajevo, diving deep into the roots of computing: C, Rust, and Linux systems.
						</p>
					</div>
					<div class="lg:col-span-5 lg:col-start-9">
						<!-- Decorative card with emblem -->
						<div class="aspect-square border border-[#c9a45c]/20 bg-gradient-to-br from-[#c9a45c]/5 to-transparent p-8 flex items-center justify-center relative">
							<img src="/favicon.svg" alt="Emblem" class="w-3/4 opacity-60" />
							<!-- Corner decorations -->
							<div class="absolute top-0 left-0 w-8 h-8 border-t border-l border-[#c9a45c]/40"></div>
							<div class="absolute top-0 right-0 w-8 h-8 border-t border-r border-[#c9a45c]/40"></div>
							<div class="absolute bottom-0 left-0 w-8 h-8 border-b border-l border-[#c9a45c]/40"></div>
							<div class="absolute bottom-0 right-0 w-8 h-8 border-b border-r border-[#c9a45c]/40"></div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Craft/Skills Section -->
		<section id="craft" class="py-32 relative overflow-hidden">
			<!-- Scrolling Turkic text background -->
			<div class="absolute inset-0 flex items-center overflow-hidden pointer-events-none opacity-10">
				<div class="whitespace-nowrap animate-scroll-slow font-oldturcic text-[20vw] text-[#c9a45c]">
					𐰚𐰇𐰠𐱅𐰃𐰏𐰤 𐰖𐰸 𐰼𐰾𐰼 𐰸𐰆𐰯 𐰇𐰠𐱅𐰲𐰃 𐰼𐱅𐰏𐰕 𐰃𐰤𐰢 𐰚𐰇𐰠𐱅𐰃𐰏𐰤 𐰚𐰼𐰏𐰚 𐰉𐰆𐰡𐰃
				</div>
			</div>
			
			<div class="max-w-5xl mx-auto px-6 md:px-12 relative z-10">
				<div class="flex items-center gap-6 mb-16">
					<span class="font-oldturcic text-4xl text-[#c9a45c]/30">𐰽𐰴</span>
					<h2 class="font-sinistre text-4xl md:text-6xl">Craft</h2>
					<div class="flex-1 h-px bg-gradient-to-r from-[#c9a45c]/30 to-transparent"></div>
				</div>
				
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
					<!-- Skill cards with ancient aesthetic -->
					<div class="skill-card group p-6 border border-[#c9a45c]/10 hover:border-[#c9a45c]/40 bg-[#0a0908]/80 backdrop-blur-sm transition-all relative overflow-hidden">
						<div class="absolute inset-0 bg-gradient-to-br from-[#c9a45c]/0 to-[#c9a45c]/5 opacity-0 group-hover:opacity-100 transition-opacity"></div>
						<div class="relative z-10">
							<span class="font-oldturcic text-3xl text-[#c9a45c]/50 block mb-4">𐰋</span>
							<h3 class="font-sinistre text-xl text-[#c9a45c] mb-3">Backend Mastery</h3>
							<p class="text-sm text-[#e8e4dc]/60">Node.js, Rust, Go, Python. Building systems that endure.</p>
						</div>
					</div>
					
					<div class="skill-card group p-6 border border-[#c9a45c]/10 hover:border-[#c9a45c]/40 bg-[#0a0908]/80 backdrop-blur-sm transition-all relative overflow-hidden">
						<div class="absolute inset-0 bg-gradient-to-br from-[#c9a45c]/0 to-[#c9a45c]/5 opacity-0 group-hover:opacity-100 transition-opacity"></div>
						<div class="relative z-10">
							<span class="font-oldturcic text-3xl text-[#c9a45c]/50 block mb-4">𐰃</span>
							<h3 class="font-sinistre text-xl text-[#c9a45c] mb-3">Database Architecture</h3>
							<p class="text-sm text-[#e8e4dc]/60">PostgreSQL, Redis, MongoDB. Data carved in silicon.</p>
						</div>
					</div>
					
					<div class="skill-card group p-6 border border-[#c9a45c]/10 hover:border-[#c9a45c]/40 bg-[#0a0908]/80 backdrop-blur-sm transition-all relative overflow-hidden">
						<div class="absolute inset-0 bg-gradient-to-br from-[#c9a45c]/0 to-[#c9a45c]/5 opacity-0 group-hover:opacity-100 transition-opacity"></div>
						<div class="relative z-10">
							<span class="font-oldturcic text-3xl text-[#c9a45c]/50 block mb-4">𐰠</span>
							<h3 class="font-sinistre text-xl text-[#c9a45c] mb-3">Systems Programming</h3>
							<p class="text-sm text-[#e8e4dc]/60">C, Rust, Linux. Close to the metal.</p>
						</div>
					</div>
					
					<div class="skill-card group p-6 border border-[#c9a45c]/10 hover:border-[#c9a45c]/40 bg-[#0a0908]/80 backdrop-blur-sm transition-all relative overflow-hidden">
						<div class="absolute inset-0 bg-gradient-to-br from-[#c9a45c]/0 to-[#c9a45c]/5 opacity-0 group-hover:opacity-100 transition-opacity"></div>
						<div class="relative z-10">
							<span class="font-oldturcic text-3xl text-[#c9a45c]/50 block mb-4">𐱅</span>
							<h3 class="font-sinistre text-xl text-[#c9a45c] mb-3">Cloud Infrastructure</h3>
							<p class="text-sm text-[#e8e4dc]/60">Docker, Kubernetes, AWS. Clouds over the steppe.</p>
						</div>
					</div>
					
					<div class="skill-card group p-6 border border-[#c9a45c]/10 hover:border-[#c9a45c]/40 bg-[#0a0908]/80 backdrop-blur-sm transition-all relative overflow-hidden">
						<div class="absolute inset-0 bg-gradient-to-br from-[#c9a45c]/0 to-[#c9a45c]/5 opacity-0 group-hover:opacity-100 transition-opacity"></div>
						<div class="relative z-10">
							<span class="font-oldturcic text-3xl text-[#c9a45c]/50 block mb-4">𐰏</span>
							<h3 class="font-sinistre text-xl text-[#c9a45c] mb-3">Streaming Technology</h3>
							<p class="text-sm text-[#e8e4dc]/60">FFmpeg, HLS, Real-time. Rivers of data.</p>
						</div>
					</div>
					
					<div class="skill-card group p-6 border border-[#c9a45c]/10 hover:border-[#c9a45c]/40 bg-[#0a0908]/80 backdrop-blur-sm transition-all relative overflow-hidden">
						<div class="absolute inset-0 bg-gradient-to-br from-[#c9a45c]/0 to-[#c9a45c]/5 opacity-0 group-hover:opacity-100 transition-opacity"></div>
						<div class="relative z-10">
							<span class="font-oldturcic text-3xl text-[#c9a45c]/50 block mb-4">𐰚</span>
							<h3 class="font-sinistre text-xl text-[#c9a45c] mb-3">Frontend Craft</h3>
							<p class="text-sm text-[#e8e4dc]/60">React, TypeScript, Tailwind. The visible layer.</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Works Section -->
		<section id="works" class="py-32 px-6 md:px-12">
			<div class="max-w-5xl mx-auto">
				<div class="flex items-center gap-6 mb-16">
					<span class="font-oldturcic text-4xl text-[#c9a45c]/30">𐰼𐱅</span>
					<h2 class="font-sinistre text-4xl md:text-6xl">Works</h2>
					<div class="flex-1 h-px bg-gradient-to-r from-[#c9a45c]/30 to-transparent"></div>
				</div>
				
				<div class="space-y-8">
					<!-- Work item 1 -->
					<article class="group p-8 border border-[#c9a45c]/10 hover:border-[#c9a45c]/30 transition-all relative">
						<div class="flex flex-col lg:flex-row lg:items-start gap-6">
							<div class="flex-1">
								<div class="flex items-center gap-4 mb-4">
									<span class="font-oldturcic text-xl text-[#c9a45c]/40">𐰇𐰕</span>
									<h3 class="font-sinistre text-2xl md:text-3xl text-[#c9a45c] group-hover:text-[#e8e4dc] transition-colors">Streaming Platform</h3>
								</div>
								<p class="text-[#e8e4dc]/70 mb-4 leading-relaxed">
									Full architecture of a video streaming service serving 17,000+ paid users. Video transcoding, payment integration, analytics dashboard, and real-time delivery systems.
								</p>
								<div class="flex flex-wrap gap-2">
									<span class="px-3 py-1 text-xs border border-[#c9a45c]/20 text-[#c9a45c]/70 hover:border-[#c9a45c]/40 transition-colors">Node.js</span>
									<span class="px-3 py-1 text-xs border border-[#c9a45c]/20 text-[#c9a45c]/70 hover:border-[#c9a45c]/40 transition-colors">PostgreSQL</span>
									<span class="px-3 py-1 text-xs border border-[#c9a45c]/20 text-[#c9a45c]/70 hover:border-[#c9a45c]/40 transition-colors">FFmpeg</span>
									<span class="px-3 py-1 text-xs border border-[#c9a45c]/20 text-[#c9a45c]/70 hover:border-[#c9a45c]/40 transition-colors">Redis</span>
								</div>
							</div>
							<div class="lg:text-right">
								<p class="text-sm text-[#c9a45c]/60 tracking-wider">DENIZ EGECE</p>
								<p class="text-sm text-[#e8e4dc]/40">2023</p>
							</div>
						</div>
					</article>
					
					<!-- Work item 2 -->
					<article class="group p-8 border border-[#c9a45c]/10 hover:border-[#c9a45c]/30 transition-all relative">
						<div class="flex flex-col lg:flex-row lg:items-start gap-6">
							<div class="flex-1">
								<div class="flex items-center gap-4 mb-4">
									<span class="font-oldturcic text-xl text-[#c9a45c]/40">𐰋𐰃</span>
									<h3 class="font-sinistre text-2xl md:text-3xl text-[#c9a45c] group-hover:text-[#e8e4dc] transition-colors">Portfolio Website</h3>
								</div>
								<p class="text-[#e8e4dc]/70 mb-4 leading-relaxed">
									Personal portfolio honoring heritage through Old Turkic script elements while pushing modern web design. Custom fonts, animations, and cultural references.
								</p>
								<div class="flex flex-wrap gap-2">
									<span class="px-3 py-1 text-xs border border-[#c9a45c]/20 text-[#c9a45c]/70 hover:border-[#c9a45c]/40 transition-colors">Astro</span>
									<span class="px-3 py-1 text-xs border border-[#c9a45c]/20 text-[#c9a45c]/70 hover:border-[#c9a45c]/40 transition-colors">Tailwind</span>
									<span class="px-3 py-1 text-xs border border-[#c9a45c]/20 text-[#c9a45c]/70 hover:border-[#c9a45c]/40 transition-colors">Cloudflare</span>
								</div>
							</div>
							<div class="lg:text-right">
								<p class="text-sm text-[#c9a45c]/60 tracking-wider">PERSONAL</p>
								<p class="text-sm text-[#e8e4dc]/40">2024</p>
							</div>
						</div>
					</article>
				</div>
			</div>
		</section>

		<!-- Summon/Contact Section -->
		<section id="summon" class="py-32 px-6 md:px-12 relative">
			<div class="max-w-3xl mx-auto text-center">
				<!-- Decorative Turkic border -->
				<div class="font-oldturcic text-3xl text-[#c9a45c]/20 mb-8 tracking-[0.5em]">
					𐰚𐰇𐰠𐱅𐰃𐰏𐰤
				</div>
				
				<h2 class="font-sinistre text-5xl md:text-7xl mb-8">
					<span class="text-[#c9a45c]">Summon</span> <span class="text-[#e8e4dc]/30">Me</span>
				</h2>
				
				<p class="text-xl text-[#e8e4dc]/60 mb-12 max-w-xl mx-auto">
					Ready to forge something legendary? Reach out for collaborations, opportunities, or tales of code.
				</p>
				
				<a href="mailto:contact@atduyar.com" class="inline-block px-10 py-4 border-2 border-[#c9a45c] text-[#c9a45c] font-sinistre text-xl hover:bg-[#c9a45c] hover:text-[#0a0908] transition-all">
					Send Word
				</a>
				
				<div class="flex justify-center gap-12 mt-16">
					<a href="https://github.com/atduyar" target="_blank" rel="noopener" class="text-[#e8e4dc]/40 hover:text-[#c9a45c] transition-colors flex items-center gap-2">
						<span class="font-oldturcic">𐰋</span>
						<span>GitHub</span>
					</a>
					<a href="https://linkedin.com/in/atduyar" target="_blank" rel="noopener" class="text-[#e8e4dc]/40 hover:text-[#c9a45c] transition-colors flex items-center gap-2">
						<span class="font-oldturcic">𐰠</span>
						<span>LinkedIn</span>
					</a>
				</div>
				
				<!-- Bottom Turkic text -->
				<div class="font-oldturcic text-3xl text-[#c9a45c]/20 mt-16 tracking-[0.5em]">
					𐰉𐰆𐰡𐰃 𐰇𐰕𐰢 𐰽𐰴𐰦𐰢
				</div>
			</div>
		</section>

		<!-- Footer -->
		<footer class="py-8 px-6 md:px-12 border-t border-[#c9a45c]/10">
			<div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-[#e8e4dc]/40">
				<div class="flex items-center gap-3">
					<span class="font-oldturcic text-[#c9a45c]/40">𐱅𐰭𐰼𐰃</span>
					<span>&copy; 2026 Ahmet Tarik Duyar</span>
				</div>
				<p class="font-oldturcic text-xs text-[#c9a45c]/20">𐰚𐰇𐰠𐱅𐰃𐰏𐰤 𐰖𐰸 𐰼𐰾𐰼</p>
			</div>
		</footer>
	</main>
</BaseLayout>

<style>
	@keyframes float-1 {
		0%, 100% { transform: translateY(0) rotate(0deg); opacity: 0.05; }
		50% { transform: translateY(-20px) rotate(5deg); opacity: 0.08; }
	}
	
	@keyframes float-2 {
		0%, 100% { transform: translateY(0) rotate(0deg); opacity: 0.05; }
		50% { transform: translateY(15px) rotate(-3deg); opacity: 0.08; }
	}
	
	@keyframes float-3 {
		0%, 100% { transform: translateY(0) rotate(0deg); opacity: 0.05; }
		50% { transform: translateY(-25px) rotate(8deg); opacity: 0.08; }
	}
	
	@keyframes rise-1 {
		from { opacity: 0; transform: translateY(30px); }
		to { opacity: 1; transform: translateY(0); }
	}
	
	@keyframes rise-2 {
		from { opacity: 0; transform: translateY(30px); }
		to { opacity: 1; transform: translateY(0); }
	}
	
	@keyframes fade-in {
		from { opacity: 0; }
		to { opacity: 1; }
	}
	
	@keyframes scroll-slow {
		from { transform: translateX(0); }
		to { transform: translateX(-50%); }
	}
	
	@keyframes pulse-slow {
		0%, 100% { opacity: 0.4; }
		50% { opacity: 0.1; }
	}
	
	.animate-float-1 { animation: float-1 8s ease-in-out infinite; }
	.animate-float-2 { animation: float-2 10s ease-in-out infinite; }
	.animate-float-3 { animation: float-3 12s ease-in-out infinite; }
	
	.animate-rise-1 { animation: rise-1 1s ease-out 0.2s forwards; opacity: 0; }
	.animate-rise-2 { animation: rise-2 1s ease-out 0.4s forwards; opacity: 0; }
	
	.animate-fade-in { animation: fade-in 1s ease-out 0.6s forwards; opacity: 0; }
	.animate-fade-in-delayed { animation: fade-in 1s ease-out 0.8s forwards; opacity: 0; }
	
	.animate-scroll-slow { animation: scroll-slow 60s linear infinite; }
	
	.animate-pulse-slow { animation: pulse-slow 3s ease-in-out infinite; }
	
</style>
