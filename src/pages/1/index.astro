---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<!--
	Variant 1 — "Quiet"
	Single column, type-first, almost no ornament. The runic identity survives
	as one glyph in the masthead and a faint divider mark. Everything else is
	content: who, where, what shipped, how to reach.
-->
<BaseLayout
	title="Ahmet Tarik Duyar — Software Engineer"
	description="Full-stack software engineer building streaming and education platforms. Based in Sarajevo."
	bodyClass="bg-[#0b0c0f] text-gray-300 antialiased"
>
	<main class="max-w-2xl mx-auto px-6 py-20 md:py-28">
		<!-- Masthead -->
		<header class="mb-20">
			<div class="flex items-baseline gap-3 mb-6">
				<span class="font-oldturcic text-blue-400/60 text-xl leading-none select-none" aria-hidden="true">𐱅</span>
				<h1 class="font-sinistre text-3xl md:text-4xl text-white">Ahmet Tarik Duyar</h1>
			</div>
			<p class="text-gray-400 leading-relaxed">
				Full-stack software engineer in Sarajevo. I build and run production systems
				end to end — most recently a streaming platform serving
				<span class="text-gray-200">17,000+ paid users</span> across five platforms,
				where I owned everything from database design to payments and CI/CD.
			</p>
			<p class="text-gray-400 leading-relaxed mt-4">
				Computer science honor student at the International University of Sarajevo.
				Outside of work I go lower in the stack: C, Rust, and Linux.
			</p>
			<nav class="flex gap-6 mt-8 text-sm">
				<a href="https://github.com/atduyar" target="_blank" rel="noopener" class="text-blue-400 hover:text-blue-300 transition-colors">GitHub</a>
				<a href="https://linkedin.com/in/atduyar" target="_blank" rel="noopener" class="text-blue-400 hover:text-blue-300 transition-colors">LinkedIn</a>
				<a href="mailto:atduyar@gmail.com" class="text-blue-400 hover:text-blue-300 transition-colors">atduyar@gmail.com</a>
			</nav>
		</header>

		<!-- Experience -->
		<section class="mb-16">
			<h2 class="text-xs uppercase tracking-[0.2em] text-gray-500 mb-8">Experience</h2>

			<article class="mb-10">
				<div class="flex flex-wrap items-baseline justify-between gap-2 mb-1">
					<h3 class="text-white font-medium">Full-Stack Engineer · Deniz Egece Co. Ltd.</h3>
					<span class="text-sm text-gray-500 tabular-nums">2022 — Present</span>
				</div>
				<p class="text-sm text-gray-400 leading-relaxed">
					Founding engineer on EgeceTV, a health and education streaming platform.
					Led backend architecture and database design, built the payment system,
					and set up CI/CD. The platform serves ~1,000 videos to 17,000+ subscribers
					on web, iOS, Android, Android TV, and Apple TV.
				</p>
				<p class="text-sm text-gray-400 leading-relaxed mt-2">
					Also worked on a distance-education platform connecting clients with
					psychologists and dietitians — real-time video consultations, scheduling,
					and progress tracking — built with .NET and Clean Architecture in a
					five-person team.
				</p>
				<p class="text-sm text-gray-600 mt-3">Next.js · GraphQL · C# / .NET · MySQL · PostgreSQL · AWS</p>
			</article>

			<article>
				<div class="flex flex-wrap items-baseline justify-between gap-2 mb-1">
					<h3 class="text-white font-medium">Freelance Developer</h3>
					<span class="text-sm text-gray-500 tabular-nums">2021 — 2022</span>
				</div>
				<p class="text-sm text-gray-400 leading-relaxed">
					Built Evrenomi, a blogging platform in C#/.NET, deployed and operated on
					self-managed Linux infrastructure with a 95+ Lighthouse score.
				</p>
				<p class="text-sm text-gray-600 mt-3">C# · REST · Linux</p>
			</article>
		</section>

		<!-- Divider mark -->
		<div class="text-center mb-16 select-none" aria-hidden="true">
			<span class="font-oldturcic text-blue-400/20 text-sm tracking-[0.6em]">𐰋𐰃𐰠</span>
		</div>

		<!-- Projects -->
		<section class="mb-16">
			<h2 class="text-xs uppercase tracking-[0.2em] text-gray-500 mb-8">Selected Projects</h2>
			<ul class="space-y-8">
				<li>
					<div class="flex flex-wrap items-baseline gap-x-3 mb-1">
						<h3 class="text-white font-medium">EgeceTV</h3>
						<span class="text-xs text-gray-600">streaming platform</span>
					</div>
					<p class="text-sm text-gray-400 leading-relaxed">
						Multi-platform video streaming with adaptive bitrate delivery, a custom
						CMS, and subscription payments. One GraphQL API behind five clients.
					</p>
				</li>
				<li>
					<div class="flex flex-wrap items-baseline gap-x-3 mb-1">
						<h3 class="text-white font-medium">REKV</h3>
						<a href="https://github.com/atduyar/rekv" target="_blank" rel="noopener" class="text-xs text-blue-400 hover:text-blue-300 transition-colors">source ↗</a>
					</div>
					<p class="text-sm text-gray-400 leading-relaxed">
						Type-safe key-value store library in Rust — memory-mapped storage,
						zero-copy deserialization, async I/O.
					</p>
				</li>
				<li>
					<div class="flex flex-wrap items-baseline gap-x-3 mb-1">
						<h3 class="text-white font-medium">Make2Game</h3>
						<a href="https://github.com/atduyar/make2game" target="_blank" rel="noopener" class="text-xs text-blue-400 hover:text-blue-300 transition-colors">source ↗</a>
					</div>
					<p class="text-sm text-gray-400 leading-relaxed">
						2D game engine written from scratch in C++ and OpenGL, with Lua
						scripting and an immediate-mode editor.
					</p>
				</li>
				<li>
					<div class="flex flex-wrap items-baseline gap-x-3 mb-1">
						<h3 class="text-white font-medium">Evrenomi</h3>
						<a href="https://evrenomi.com" target="_blank" rel="noopener" class="text-xs text-blue-400 hover:text-blue-300 transition-colors">live ↗</a>
					</div>
					<p class="text-sm text-gray-400 leading-relaxed">
						Performance-focused blogging platform. 95+ Lighthouse across all
						metrics, running on a self-managed Linux VPS.
					</p>
				</li>
			</ul>
		</section>

		<!-- Skills -->
		<section class="mb-20">
			<h2 class="text-xs uppercase tracking-[0.2em] text-gray-500 mb-8">Tools I Use</h2>
			<dl class="space-y-3 text-sm">
				<div class="grid grid-cols-[7rem_1fr] gap-4">
					<dt class="text-gray-600">Web</dt>
					<dd class="text-gray-300">TypeScript, React, Next.js, GraphQL</dd>
				</div>
				<div class="grid grid-cols-[7rem_1fr] gap-4">
					<dt class="text-gray-600">Backend</dt>
					<dd class="text-gray-300">C# / .NET, REST, Clean Architecture</dd>
				</div>
				<div class="grid grid-cols-[7rem_1fr] gap-4">
					<dt class="text-gray-600">Data</dt>
					<dd class="text-gray-300">MySQL, PostgreSQL, Prisma</dd>
				</div>
				<div class="grid grid-cols-[7rem_1fr] gap-4">
					<dt class="text-gray-600">Systems</dt>
					<dd class="text-gray-300">Rust, C, Linux</dd>
				</div>
				<div class="grid grid-cols-[7rem_1fr] gap-4">
					<dt class="text-gray-600">Infra</dt>
					<dd class="text-gray-300">Docker, AWS, GitHub Actions</dd>
				</div>
			</dl>
		</section>

		<!-- Footer -->
		<footer class="pt-8 border-t border-white/5 flex flex-wrap items-center justify-between gap-4 text-sm text-gray-600">
			<span>Sarajevo, Bosnia &amp; Herzegovina</span>
			<a href="mailto:atduyar@gmail.com" class="text-blue-400 hover:text-blue-300 transition-colors">Get in touch →</a>
		</footer>
	</main>
</BaseLayout>
