---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout title="Ahmet Tarik Duyar" description="Full-Stack Software Engineer Portfolio" bodyClass="bg-[#050508] text-white min-h-screen overflow-x-hidden">
	<!-- Animated grid background -->
	<div class="fixed inset-0 pointer-events-none opacity-20">
		<div class="absolute inset-0" style="background-image: linear-gradient(rgba(59,130,246,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(59,130,246,0.1) 1px, transparent 1px); background-size: 60px 60px;"></div>
	</div>
	
	<!-- Glow orbs -->
	<div class="fixed top-1/4 -left-32 w-96 h-96 bg-blue-600/20 rounded-full blur-[150px] pointer-events-none"></div>
	<div class="fixed bottom-1/4 -right-32 w-96 h-96 bg-purple-600/20 rounded-full blur-[150px] pointer-events-none"></div>

	<main class="relative z-10">
		<!-- Floating Nav -->
		<nav class="fixed top-6 left-1/2 -translate-x-1/2 z-50">
			<div class="flex items-center gap-1 p-1.5 rounded-full bg-white/5 backdrop-blur-xl border border-white/10">
				<a href="#" class="px-4 py-2 rounded-full bg-white/10 text-sm font-medium">Home</a>
				<a href="#about" class="px-4 py-2 rounded-full hover:bg-white/5 text-sm text-white/60 hover:text-white transition-all">About</a>
				<a href="#skills" class="px-4 py-2 rounded-full hover:bg-white/5 text-sm text-white/60 hover:text-white transition-all">Skills</a>
				<a href="#projects" class="px-4 py-2 rounded-full hover:bg-white/5 text-sm text-white/60 hover:text-white transition-all">Work</a>
				<a href="#contact" class="px-4 py-2 rounded-full bg-blue-600 hover:bg-blue-500 text-sm font-medium transition-colors">Contact</a>
			</div>
		</nav>

		<!-- Hero with 3D perspective -->
		<section class="min-h-screen flex items-center justify-center px-6 relative" style="perspective: 1000px;">
			<div class="text-center transform-gpu hover:rotate-y-2 transition-transform duration-700">
				<div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-gradient-to-r from-blue-500/20 to-purple-500/20 border border-white/10 mb-8">
					<span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
					<span class="text-sm">Available for new projects</span>
				</div>
				
				<h1 class="font-sinistre text-6xl sm:text-7xl md:text-8xl lg:text-9xl leading-[0.85] mb-6">
					<span class="block bg-gradient-to-r from-white via-white to-white/60 bg-clip-text text-transparent">Ahmet Tarik</span>
					<span class="block bg-gradient-to-r from-blue-400 via-purple-400 to-pink-400 bg-clip-text text-transparent">Duyar</span>
				</h1>
				
				<p class="text-lg md:text-xl text-white/50 max-w-xl mx-auto mb-10">
					Full-Stack Engineer crafting robust backend systems and scalable architectures. Based in Sarajevo.
				</p>
				
				<div class="flex flex-wrap justify-center gap-4">
					<a href="#projects" class="group px-8 py-4 bg-gradient-to-r from-blue-600 to-purple-600 rounded-full font-medium hover:shadow-lg hover:shadow-blue-500/25 transition-all">
						View Projects
						<span class="inline-block ml-2 group-hover:translate-x-1 transition-transform">&rarr;</span>
					</a>
					<a href="#contact" class="px-8 py-4 rounded-full border border-white/20 hover:bg-white/5 transition-all">
						Get in Touch
					</a>
				</div>
			</div>
			
			<!-- Scroll indicator -->
			<div class="absolute bottom-10 left-1/2 -translate-x-1/2">
				<div class="w-6 h-10 rounded-full border-2 border-white/20 flex justify-center pt-2">
					<div class="w-1 h-2 bg-white/40 rounded-full animate-bounce"></div>
				</div>
			</div>
		</section>

		<!-- About with glassmorphism cards -->
		<section id="about" class="py-32 px-6">
			<div class="max-w-6xl mx-auto">
				<div class="text-center mb-16">
					<span class="text-blue-400 text-sm tracking-widest uppercase mb-4 block">About Me</span>
					<h2 class="font-sinistre text-4xl md:text-6xl">Building the Future</h2>
				</div>
				
				<div class="grid md:grid-cols-2 gap-8">
					<div class="p-8 rounded-3xl bg-gradient-to-br from-white/10 to-white/5 backdrop-blur-xl border border-white/10 hover:border-white/20 transition-all group">
						<div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-blue-500 to-purple-500 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
							<span class="text-2xl">&#9881;</span>
						</div>
						<h3 class="font-sinistre text-2xl mb-4">17,000+ Users Served</h3>
						<p class="text-white/60 leading-relaxed">
							At Deniz Egece Co. Ltd., I architected a complete streaming platform handling video transcoding, payments, and real-time analytics.
						</p>
					</div>
					
					<div class="p-8 rounded-3xl bg-gradient-to-br from-white/10 to-white/5 backdrop-blur-xl border border-white/10 hover:border-white/20 transition-all group">
						<div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
							<span class="text-2xl">&#9733;</span>
						</div>
						<h3 class="font-sinistre text-2xl mb-4">Honor Student</h3>
						<p class="text-white/60 leading-relaxed">
							Pursuing Software Engineering at IUS with deep focus on algorithms, system design, and low-level programming in C and Rust.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Skills with animated cards -->
		<section id="skills" class="py-32 px-6">
			<div class="max-w-6xl mx-auto">
				<div class="text-center mb-16">
					<span class="text-purple-400 text-sm tracking-widest uppercase mb-4 block">Expertise</span>
					<h2 class="font-sinistre text-4xl md:text-6xl">Tech Stack</h2>
				</div>
				
				<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
					<div class="skill-card p-6 rounded-2xl bg-white/5 border border-white/10 hover:border-blue-500/50 hover:bg-blue-500/5 transition-all text-center group">
						<span class="text-3xl mb-3 block group-hover:scale-125 transition-transform">&#128187;</span>
						<span class="font-medium">Backend</span>
						<p class="text-xs text-white/40 mt-1">Node, Rust, Go</p>
					</div>
					<div class="skill-card p-6 rounded-2xl bg-white/5 border border-white/10 hover:border-purple-500/50 hover:bg-purple-500/5 transition-all text-center group">
						<span class="text-3xl mb-3 block group-hover:scale-125 transition-transform">&#128451;</span>
						<span class="font-medium">Databases</span>
						<p class="text-xs text-white/40 mt-1">PostgreSQL, Redis</p>
					</div>
					<div class="skill-card p-6 rounded-2xl bg-white/5 border border-white/10 hover:border-pink-500/50 hover:bg-pink-500/5 transition-all text-center group">
						<span class="text-3xl mb-3 block group-hover:scale-125 transition-transform">&#9729;</span>
						<span class="font-medium">Cloud</span>
						<p class="text-xs text-white/40 mt-1">AWS, Docker, K8s</p>
					</div>
					<div class="skill-card p-6 rounded-2xl bg-white/5 border border-white/10 hover:border-cyan-500/50 hover:bg-cyan-500/5 transition-all text-center group">
						<span class="text-3xl mb-3 block group-hover:scale-125 transition-transform">&#127912;</span>
						<span class="font-medium">Frontend</span>
						<p class="text-xs text-white/40 mt-1">React, TypeScript</p>
					</div>
					<div class="skill-card p-6 rounded-2xl bg-white/5 border border-white/10 hover:border-amber-500/50 hover:bg-amber-500/5 transition-all text-center group">
						<span class="text-3xl mb-3 block group-hover:scale-125 transition-transform">&#9881;</span>
						<span class="font-medium">Systems</span>
						<p class="text-xs text-white/40 mt-1">C, Rust, Linux</p>
					</div>
					<div class="skill-card p-6 rounded-2xl bg-white/5 border border-white/10 hover:border-emerald-500/50 hover:bg-emerald-500/5 transition-all text-center group">
						<span class="text-3xl mb-3 block group-hover:scale-125 transition-transform">&#128249;</span>
						<span class="font-medium">Streaming</span>
						<p class="text-xs text-white/40 mt-1">FFmpeg, HLS</p>
					</div>
					<div class="skill-card p-6 rounded-2xl bg-white/5 border border-white/10 hover:border-rose-500/50 hover:bg-rose-500/5 transition-all text-center group">
						<span class="text-3xl mb-3 block group-hover:scale-125 transition-transform">&#128272;</span>
						<span class="font-medium">Security</span>
						<p class="text-xs text-white/40 mt-1">Auth, Encryption</p>
					</div>
					<div class="skill-card p-6 rounded-2xl bg-white/5 border border-white/10 hover:border-indigo-500/50 hover:bg-indigo-500/5 transition-all text-center group">
						<span class="text-3xl mb-3 block group-hover:scale-125 transition-transform">&#128640;</span>
						<span class="font-medium">DevOps</span>
						<p class="text-xs text-white/40 mt-1">CI/CD, Monitoring</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Projects with hover effects -->
		<section id="projects" class="py-32 px-6">
			<div class="max-w-6xl mx-auto">
				<div class="text-center mb-16">
					<span class="text-pink-400 text-sm tracking-widest uppercase mb-4 block">Portfolio</span>
					<h2 class="font-sinistre text-4xl md:text-6xl">Featured Work</h2>
				</div>
				
				<div class="space-y-6">
					<div class="group p-8 rounded-3xl bg-gradient-to-r from-blue-500/10 to-purple-500/10 border border-white/10 hover:border-blue-500/30 transition-all">
						<div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
							<div>
								<span class="text-blue-400 text-sm">Deniz Egece Co.</span>
								<h3 class="font-sinistre text-3xl mt-2 group-hover:text-blue-400 transition-colors">Streaming Platform</h3>
								<p class="text-white/50 mt-3 max-w-xl">Full-stack video streaming service with 17K+ users, real-time transcoding, and payment processing.</p>
								<div class="flex flex-wrap gap-2 mt-4">
									<span class="px-3 py-1 text-xs rounded-full bg-white/10">Node.js</span>
									<span class="px-3 py-1 text-xs rounded-full bg-white/10">PostgreSQL</span>
									<span class="px-3 py-1 text-xs rounded-full bg-white/10">FFmpeg</span>
								</div>
							</div>
							<div class="w-16 h-16 rounded-full bg-white/5 border border-white/10 flex items-center justify-center group-hover:bg-blue-500 group-hover:border-blue-500 transition-all shrink-0">
								<span class="text-2xl group-hover:scale-110 transition-transform">&rarr;</span>
							</div>
						</div>
					</div>
					
					<div class="group p-8 rounded-3xl bg-gradient-to-r from-purple-500/10 to-pink-500/10 border border-white/10 hover:border-purple-500/30 transition-all">
						<div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
							<div>
								<span class="text-purple-400 text-sm">Personal</span>
								<h3 class="font-sinistre text-3xl mt-2 group-hover:text-purple-400 transition-colors">Portfolio Website</h3>
								<p class="text-white/50 mt-3 max-w-xl">Custom portfolio with Sinistre font, Old Turkic heritage elements, and crafted animations.</p>
								<div class="flex flex-wrap gap-2 mt-4">
									<span class="px-3 py-1 text-xs rounded-full bg-white/10">Astro</span>
									<span class="px-3 py-1 text-xs rounded-full bg-white/10">Tailwind</span>
									<span class="px-3 py-1 text-xs rounded-full bg-white/10">Cloudflare</span>
								</div>
							</div>
							<div class="w-16 h-16 rounded-full bg-white/5 border border-white/10 flex items-center justify-center group-hover:bg-purple-500 group-hover:border-purple-500 transition-all shrink-0">
								<span class="text-2xl group-hover:scale-110 transition-transform">&rarr;</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Contact with gradient border -->
		<section id="contact" class="py-32 px-6">
			<div class="max-w-3xl mx-auto text-center">
				<h2 class="font-sinistre text-5xl md:text-7xl mb-6">
					<span class="bg-gradient-to-r from-blue-400 via-purple-400 to-pink-400 bg-clip-text text-transparent">Let's Connect</span>
				</h2>
				<p class="text-xl text-white/50 mb-10">
					Ready to bring your ideas to life? Let's build something amazing together.
				</p>
				
				<a href="mailto:contact@atduyar.com" class="inline-block px-10 py-5 rounded-full bg-gradient-to-r from-blue-600 via-purple-600 to-pink-600 font-medium text-lg hover:shadow-xl hover:shadow-purple-500/20 transition-all hover:scale-105">
					Start a Conversation
				</a>
				
				<div class="flex justify-center gap-8 mt-12">
					<a href="https://github.com/atduyar" target="_blank" rel="noopener" class="text-white/40 hover:text-white transition-colors">GitHub</a>
					<a href="https://linkedin.com/in/atduyar" target="_blank" rel="noopener" class="text-white/40 hover:text-white transition-colors">LinkedIn</a>
					<a href="mailto:contact@atduyar.com" class="text-white/40 hover:text-white transition-colors">Email</a>
				</div>
			</div>
		</section>

		<!-- Footer -->
		<footer class="py-8 px-6 border-t border-white/10">
			<div class="max-w-6xl mx-auto flex justify-between items-center text-sm text-white/40">
				<span>&copy; 2026 Ahmet Tarik Duyar</span>
				<span>Crafted with care</span>
			</div>
		</footer>
	</main>
</BaseLayout>

<style>
	.hover\:rotate-y-2:hover {
		transform: rotateY(2deg) rotateX(-2deg);
	}
</style>
