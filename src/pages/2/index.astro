---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<!--
	Variant 2 — "Refined Runic"
	The direct evolution of the current homepage. Keeps the dark blue palette,
	Sinistre display type, and Old Turkic glyphs as quiet ornament — but the
	copy is professional, every section uses the same single accent color,
	and the gimmicks (summoning circle, marquee, fake sections) are gone.
-->
<BaseLayout
	title="Ahmet Tarik Duyar — Software Engineer"
	description="Full-stack software engineer. Streaming platforms, education systems, and systems programming."
	bodyClass="bg-[#0a0b0d] text-gray-200 antialiased"
>
	<div class="bg-[#0d0e12] border-x border-[#90c5ff14] max-w-5xl mx-auto min-h-dvh">
		<!-- Navigation -->
		<nav class="py-5 px-6 md:px-12 border-b border-[#90c5ff14] sticky top-0 bg-[#0d0e12]/90 backdrop-blur-sm z-40">
			<div class="flex justify-between items-center">
				<a href="#top" class="flex items-center gap-3">
					<span class="font-oldturcic text-blue-400/70 text-lg leading-none select-none" aria-hidden="true">𐱅</span>
					<span class="font-sinistre text-xl text-white">Ahmet Tarik Duyar</span>
				</a>
				<ul class="flex gap-5 md:gap-8 text-sm">
					<li><a href="#work" class="text-gray-400 hover:text-blue-300 transition-colors">Work</a></li>
					<li><a href="#projects" class="text-gray-400 hover:text-blue-300 transition-colors">Projects</a></li>
					<li><a href="#about" class="text-gray-400 hover:text-blue-300 transition-colors">About</a></li>
					<li><a href="mailto:atduyar@gmail.com" class="text-blue-300 border border-blue-500/30 px-3 py-1 hover:bg-blue-600/10 hover:border-blue-400/50 transition-all">Contact</a></li>
				</ul>
			</div>
		</nav>

		<!-- Hero -->
		<section id="top" class="px-6 md:px-12 py-24 md:py-36 border-b border-[#90c5ff14] relative overflow-hidden">
			<div class="absolute inset-0 opacity-5 pointer-events-none">
				<div class="absolute top-0 right-0 w-96 h-96 bg-blue-500 rounded-full blur-[140px]"></div>
			</div>
			<div class="relative max-w-3xl">
				<p class="text-sm tracking-[0.25em] uppercase text-blue-400/70 mb-6">Software Engineer · Sarajevo</p>
				<h1 class="font-sinistre text-5xl sm:text-6xl lg:text-7xl text-white leading-[0.95] mb-8">
					I build systems<br />
					that <span class="text-blue-300">stay up</span>.
				</h1>
				<p class="text-lg text-gray-400 leading-relaxed max-w-xl">
					Full-stack engineer with end-to-end ownership of production platforms —
					backend architecture, database design, payments, and CI/CD for a
					streaming service used by 17,000+ paying subscribers.
				</p>
				<div class="flex gap-4 mt-10">
					<a href="#work" class="px-6 py-3 bg-blue-600/10 border border-blue-500/30 text-blue-300 hover:bg-blue-600/20 hover:border-blue-400/50 transition-all text-sm">See my work</a>
					<a href="mailto:atduyar@gmail.com" class="px-6 py-3 text-gray-400 hover:text-white transition-colors text-sm">atduyar@gmail.com</a>
				</div>
			</div>
		</section>

		<!-- Work -->
		<section id="work" class="px-6 md:px-12 py-20 border-b border-[#90c5ff14]">
			<h2 class="font-sinistre text-3xl md:text-4xl text-white mb-12 flex items-center gap-4">
				Work
				<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
				<span class="font-oldturcic text-xl text-blue-400/20 leading-none select-none" aria-hidden="true">𐰃𐱁</span>
			</h2>

			<div class="space-y-12">
				<article class="md:grid md:grid-cols-[10rem_1fr] gap-8">
					<div class="text-sm text-gray-500 mb-3 md:mb-0 tabular-nums">2022 — Present</div>
					<div>
						<h3 class="text-xl text-white mb-1">Full-Stack Engineer</h3>
						<p class="text-blue-300/80 text-sm mb-4">Deniz Egece Co. Ltd.</p>
						<ul class="space-y-2 text-gray-400 text-sm leading-relaxed list-disc list-inside marker:text-blue-400/40">
							<li>Founding engineer on <span class="text-gray-200">EgeceTV</span>, a streaming platform serving 17,000+ subscribers and ~1,000 videos on web, iOS, Android, Android TV, and Apple TV.</li>
							<li>Designed the backend architecture and database schema; one GraphQL API serves all five client platforms.</li>
							<li>Built the subscription payment system and the CI/CD pipeline that ships every release.</li>
							<li>Developed a distance-education platform (video consultations, scheduling, progress tracking) with .NET and Clean Architecture in a five-person team.</li>
						</ul>
						<p class="text-xs text-gray-600 mt-4">Next.js · GraphQL · C#/.NET · MySQL · PostgreSQL · Prisma · AWS · GitHub Actions</p>
					</div>
				</article>

				<article class="md:grid md:grid-cols-[10rem_1fr] gap-8">
					<div class="text-sm text-gray-500 mb-3 md:mb-0 tabular-nums">2021 — 2022</div>
					<div>
						<h3 class="text-xl text-white mb-1">Freelance Developer</h3>
						<p class="text-blue-300/80 text-sm mb-4">Independent</p>
						<ul class="space-y-2 text-gray-400 text-sm leading-relaxed list-disc list-inside marker:text-blue-400/40">
							<li>Built and operated <span class="text-gray-200">Evrenomi</span>, a C#/.NET blogging platform with a 95+ Lighthouse score, hosted on self-managed Linux infrastructure.</li>
						</ul>
						<p class="text-xs text-gray-600 mt-4">C# · REST · Linux</p>
					</div>
				</article>
			</div>
		</section>

		<!-- Projects -->
		<section id="projects" class="px-6 md:px-12 py-20 border-b border-[#90c5ff14]">
			<h2 class="font-sinistre text-3xl md:text-4xl text-white mb-12 flex items-center gap-4">
				Projects
				<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
				<span class="font-oldturcic text-xl text-blue-400/20 leading-none select-none" aria-hidden="true">𐰽𐰴</span>
			</h2>

			<div class="grid md:grid-cols-2 gap-6">
				<a href="https://github.com/atduyar/rekv" target="_blank" rel="noopener" class="group block border border-[#90c5ff14] hover:border-blue-400/40 bg-[#0a0b0d]/50 p-6 transition-all">
					<div class="flex items-baseline justify-between mb-3">
						<h3 class="text-lg text-white group-hover:text-blue-200 transition-colors">REKV</h3>
						<span class="text-xs text-gray-600">Rust</span>
					</div>
					<p class="text-sm text-gray-400 leading-relaxed mb-4">
						Type-safe key-value store library. Memory-mapped storage, zero-copy
						deserialization, async I/O.
					</p>
					<span class="text-xs text-blue-400/70 group-hover:text-blue-300 transition-colors">View source →</span>
				</a>

				<a href="https://github.com/atduyar/make2game" target="_blank" rel="noopener" class="group block border border-[#90c5ff14] hover:border-blue-400/40 bg-[#0a0b0d]/50 p-6 transition-all">
					<div class="flex items-baseline justify-between mb-3">
						<h3 class="text-lg text-white group-hover:text-blue-200 transition-colors">Make2Game</h3>
						<span class="text-xs text-gray-600">C++ / OpenGL</span>
					</div>
					<p class="text-sm text-gray-400 leading-relaxed mb-4">
						2D game engine built from scratch, with Lua scripting and an
						immediate-mode GUI editor.
					</p>
					<span class="text-xs text-blue-400/70 group-hover:text-blue-300 transition-colors">View source →</span>
				</a>

				<a href="https://evrenomi.com" target="_blank" rel="noopener" class="group block border border-[#90c5ff14] hover:border-blue-400/40 bg-[#0a0b0d]/50 p-6 transition-all">
					<div class="flex items-baseline justify-between mb-3">
						<h3 class="text-lg text-white group-hover:text-blue-200 transition-colors">Evrenomi</h3>
						<span class="text-xs text-gray-600">C# / .NET</span>
					</div>
					<p class="text-sm text-gray-400 leading-relaxed mb-4">
						Blogging platform optimized for performance — 95+ Lighthouse across
						all metrics on a self-managed VPS.
					</p>
					<span class="text-xs text-blue-400/70 group-hover:text-blue-300 transition-colors">Visit site →</span>
				</a>

				<div class="border border-[#90c5ff14] bg-[#0a0b0d]/50 p-6">
					<div class="flex items-baseline justify-between mb-3">
						<h3 class="text-lg text-white">EgeceTV</h3>
						<span class="text-xs text-gray-600">Next.js / GraphQL</span>
					</div>
					<p class="text-sm text-gray-400 leading-relaxed mb-4">
						Production streaming platform. Adaptive bitrate delivery, custom CMS,
						subscriptions — 17K+ users across five platforms.
					</p>
					<span class="text-xs text-gray-600">Commercial work at Deniz Egece</span>
				</div>
			</div>
		</section>

		<!-- About -->
		<section id="about" class="px-6 md:px-12 py-20 border-b border-[#90c5ff14] relative overflow-hidden">
			<!-- Single, restrained glyph watermark -->
			<span class="font-oldturcic absolute -right-6 top-1/2 -translate-y-1/2 text-[14rem] text-blue-400/[0.04] leading-none select-none pointer-events-none" aria-hidden="true">𐰚</span>
			<div class="relative max-w-2xl">
				<h2 class="font-sinistre text-3xl md:text-4xl text-white mb-8">About</h2>
				<div class="space-y-5 text-gray-400 leading-relaxed">
					<p>
						I'm a full-stack engineer who likes owning the whole problem: the schema,
						the API, the deploy pipeline, and the bill at the end of the month.
						Three years of that at Deniz Egece taught me that boring, well-understood
						architecture beats clever architecture almost every time.
					</p>
					<p>
						I'm also a computer science honor student at the International University
						of Sarajevo, and I spend my spare time below the web stack — writing
						Rust and C, and running my own Linux infrastructure.
					</p>
					<p class="text-gray-500 text-sm">
						The glyphs on this site are Old Turkic — a nod to where I'm from.
					</p>
				</div>
			</div>
		</section>

		<!-- Contact -->
		<section class="px-6 md:px-12 py-24 text-center">
			<span class="font-oldturcic text-blue-400/20 text-lg tracking-[0.5em] block mb-8 select-none" aria-hidden="true">𐰋𐰃𐰠𐰏</span>
			<h2 class="font-sinistre text-4xl md:text-5xl text-white mb-6">Let's talk.</h2>
			<p class="text-gray-400 mb-10 max-w-md mx-auto">
				Open to interesting roles and collaborations.
			</p>
			<a href="mailto:atduyar@gmail.com" class="inline-block px-8 py-4 border border-blue-400/50 text-blue-300 hover:bg-blue-400 hover:text-[#0d0e12] transition-all duration-300">
				atduyar@gmail.com
			</a>
			<div class="flex justify-center gap-8 mt-12 text-sm">
				<a href="https://github.com/atduyar" target="_blank" rel="noopener" class="text-gray-500 hover:text-blue-300 transition-colors">GitHub</a>
				<a href="https://linkedin.com/in/atduyar" target="_blank" rel="noopener" class="text-gray-500 hover:text-blue-300 transition-colors">LinkedIn</a>
			</div>
		</section>

		<footer class="px-6 md:px-12 py-8 border-t border-[#90c5ff14] flex flex-wrap justify-between gap-4 text-xs text-gray-600">
			<span>© 2026 Ahmet Tarik Duyar</span>
			<span>Sarajevo, Bosnia &amp; Herzegovina</span>
		</footer>
	</div>
</BaseLayout>
