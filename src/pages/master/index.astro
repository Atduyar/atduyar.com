<script>
// Section switching logic
document.addEventListener('DOMContentLoaded', () => {
	const sections = {
		nav: [],
		hero: [],
		about: [],
		skills: [],
		projects: [],
		experience: [],
		contact: [],
		footer: []
	};
	
	// Collect all sections
	document.querySelectorAll('.section-option').forEach(el => {
		const type = el.dataset.section;
		if (sections[type]) {
			sections[type].push({
				id: el.dataset.id,
				name: el.dataset.name,
				element: el
			});
		}
	});
	
	// Current selection state
	const currentSelection = {
		nav: 0,
		hero: 0,
		about: 0,
		skills: 0,
		projects: 0,
		experience: 0,
		contact: 0,
		footer: 0
	};
	
	// Create controls
	const controlsContainer = document.getElementById('section-controls');
	
	Object.keys(sections).forEach(type => {
		if (sections[type].length === 0) return;
		
		const control = document.createElement('div');
		control.className = 'flex items-center gap-1 bg-[#0d0e12] border border-[#90c5ff14] rounded px-2 py-1';
		control.innerHTML = `
			<button class="prev-btn text-blue-400 hover:text-blue-300 px-1" data-type="${type}">&lt;</button>
			<div class="flex-1 text-center">
				<div class="text-gray-400 text-[10px] uppercase">${type}</div>
				<div class="section-label text-blue-300 truncate max-w-20" data-type="${type}">${sections[type][0].id}</div>
			</div>
			<button class="next-btn text-blue-400 hover:text-blue-300 px-1" data-type="${type}">&gt;</button>
		`;
		controlsContainer.appendChild(control);
	});
	
	// Switch section function
	function switchSection(type, direction) {
		const sectionList = sections[type];
		if (!sectionList || sectionList.length === 0) return;
		
		// Hide current
		sectionList[currentSelection[type]].element.classList.add('hidden');
		
		// Calculate new index
		let newIndex = currentSelection[type] + direction;
		if (newIndex < 0) newIndex = sectionList.length - 1;
		if (newIndex >= sectionList.length) newIndex = 0;
		
		// Show new
		sectionList[newIndex].element.classList.remove('hidden');
		currentSelection[type] = newIndex;
		
		// Update label
		const label = document.querySelector(`.section-label[data-type="${type}"]`);
		if (label) {
			label.textContent = sectionList[newIndex].id;
			label.title = sectionList[newIndex].name;
		}
	}
	
	// Event listeners
	document.querySelectorAll('.prev-btn').forEach(btn => {
		btn.addEventListener('click', () => switchSection(btn.dataset.type, -1));
	});
	
	document.querySelectorAll('.next-btn').forEach(btn => {
		btn.addEventListener('click', () => switchSection(btn.dataset.type, 1));
	});
	
	// Toggle panel
	const toggleBtn = document.getElementById('toggle-panel');
	const controlPanel = document.getElementById('control-panel');
	let panelHidden = false;
	
	toggleBtn.addEventListener('click', () => {
		panelHidden = !panelHidden;
		if (panelHidden) {
			controlPanel.classList.add('translate-y-[-80%]');
			toggleBtn.textContent = 'Show Panel';
		} else {
			controlPanel.classList.remove('translate-y-[-80%]');
			toggleBtn.textContent = 'Hide Panel';
		}
	});
	
	// Interactive runes (from final/6)
	const runes = document.querySelectorAll('.rune');
	let mouseX = 0;
	let mouseY = 0;
	
	document.addEventListener('mousemove', (e) => {
		mouseX = e.clientX;
		mouseY = e.clientY;
	});
	
	function animateRunes() {
		runes.forEach((rune) => {
			const speed = parseFloat(rune.getAttribute('data-speed') || '0.02');
			const rect = rune.getBoundingClientRect();
			const runeX = rect.left + rect.width / 2;
			const runeY = rect.top + rect.height / 2;
			
			const distX = (mouseX - runeX) * speed;
			const distY = (mouseY - runeY) * speed;
			
			rune.style.transform = `translate(${distX}px, ${distY}px)`;
		});
		
		requestAnimationFrame(animateRunes);
	}
	
	animateRunes();
});
</script>

