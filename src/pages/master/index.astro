---
import BackgroundMarquee from "../../components/BackgroundMarquee.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Master - Section Selector" description="Mix and match portfolio sections" bodyClass="bg-[#0a0b0d] text-white w-screen overflow-x-hidden">
	<!-- Section Control Panel - Fixed at top -->
	<div id="control-panel" class="fixed top-0 left-0 right-0 z-[100] bg-[#0a0b0d]/95 backdrop-blur-md border-b border-blue-500/30 py-3 px-4">
		<div class="max-w-7xl mx-auto">
			<div class="flex items-center justify-between mb-2">
				<h1 class="font-sinistre text-lg text-blue-300">Section Selector</h1>
				<button id="toggle-panel" class="text-xs px-3 py-1 border border-blue-500/30 hover:bg-blue-500/10 transition-colors">
					Hide Panel
				</button>
			</div>
			<div id="section-controls" class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-8 gap-2 text-xs">
				<!-- Controls will be populated by JS -->
			</div>
		</div>
	</div>

	<main class="bg-[#0d0e12] border-x border-[#90c5ff14] max-w-7xl mx-auto min-h-dvh relative pt-24">
		<!-- Subtle noise overlay -->
		<div class="fixed inset-0 pointer-events-none opacity-[0.015] z-50" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 256 256%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22n%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23n)%22/%3E%3C/svg%3E');"></div>
		
		<!-- ==================== NAV SECTIONS ==================== -->
		<div id="nav-container">
			<!-- NAV 4-1: Final 4 Navigation -->
			<nav data-section="nav" data-id="4-1" data-name="Floating Runics Nav" class="section-option py-6 px-4 md:px-8 border-b border-[#90c5ff14] sticky top-24 bg-[#0d0e12]/90 backdrop-blur-sm z-40">
				<div class="flex justify-between items-center">
					<a href="#hero" class="group flex items-center gap-3">
						<img src="/favicon.svg" alt="Logo" class="w-8 h-8 transition-transform group-hover:rotate-12" />
						<span class="font-sinistre text-xl tracking-wide hidden sm:block">Atduyar</span>
					</a>
					<ul class="flex gap-4 md:gap-8">
						<li><a href="#about" class="nav-link font-sinistre text-lg hover:text-blue-300 transition-all hover:-translate-y-0.5 relative after:absolute after:bottom-0 after:left-0 after:w-0 after:h-px after:bg-blue-300 hover:after:w-full after:transition-all">About</a></li>
						<li><a href="#skills" class="nav-link font-sinistre text-lg hover:text-blue-300 transition-all hover:-translate-y-0.5 relative after:absolute after:bottom-0 after:left-0 after:w-0 after:h-px after:bg-blue-300 hover:after:w-full after:transition-all">Skills</a></li>
						<li><a href="#projects" class="nav-link font-sinistre text-lg hover:text-blue-300 transition-all hover:-translate-y-0.5 relative after:absolute after:bottom-0 after:left-0 after:w-0 after:h-px after:bg-blue-300 hover:after:w-full after:transition-all">Projects</a></li>
						<li><a href="#contact" class="nav-link font-sinistre text-lg px-4 py-1 border border-blue-500/30 hover:bg-blue-600/10 hover:border-blue-400/50 transition-all">Summon</a></li>
					</ul>
				</div>
			</nav>

			<!-- NAV 5-1: Final 5 Navigation (Turkic Logo) -->
			<nav data-section="nav" data-id="5-1" data-name="Chronicle Nav (Turkic)" class="section-option hidden py-6 px-4 md:px-8 border-b border-[#90c5ff14] sticky top-24 bg-[#0d0e12]/90 backdrop-blur-sm z-40">
				<div class="flex justify-between items-center">
					<a href="#hero" class="group flex items-center gap-3">
						<img src="/favicon.svg" alt="Logo" class="w-8 h-8 transition-transform group-hover:rotate-12" />
						<span class="font-oldturcic text-xl text-blue-400 leading-none hidden sm:block">𐱅𐰭𐰼𐰃</span>
					</a>
					<ul class="flex gap-4 md:gap-8">
						<li><a href="#about" class="nav-link font-sinistre text-lg hover:text-blue-300 transition-all hover:-translate-y-0.5 relative after:absolute after:bottom-0 after:left-0 after:w-0 after:h-px after:bg-blue-300 hover:after:w-full after:transition-all">Origin</a></li>
						<li><a href="#skills" class="nav-link font-sinistre text-lg hover:text-blue-300 transition-all hover:-translate-y-0.5 relative after:absolute after:bottom-0 after:left-0 after:w-0 after:h-px after:bg-blue-300 hover:after:w-full after:transition-all">Craft</a></li>
						<li><a href="#projects" class="nav-link font-sinistre text-lg hover:text-blue-300 transition-all hover:-translate-y-0.5 relative after:absolute after:bottom-0 after:left-0 after:w-0 after:h-px after:bg-blue-300 hover:after:w-full after:transition-all">Chronicle</a></li>
						<li><a href="#contact" class="nav-link font-sinistre text-lg px-4 py-1 border border-blue-500/30 hover:bg-blue-600/10 hover:border-blue-400/50 transition-all">Summon</a></li>
					</ul>
				</div>
			</nav>

			<!-- NAV 6-1: Final 6 Navigation (Rounded Logo) -->
			<nav data-section="nav" data-id="6-1" data-name="Interactive Runes Nav" class="section-option hidden py-6 px-4 md:px-8 border-b border-[#90c5ff14] sticky top-24 bg-[#0d0e12]/90 backdrop-blur-sm z-40">
				<div class="flex justify-between items-center">
					<a href="#hero" class="group flex items-center gap-3">
						<div class="w-10 h-10 rounded-full border border-blue-400/30 flex items-center justify-center group-hover:border-blue-400/60 transition-colors relative overflow-hidden">
							<div class="absolute inset-0 bg-blue-500/10 group-hover:bg-blue-500/20 transition-colors"></div>
							<img src="/favicon.svg" alt="Logo" class="w-6 h-6 relative z-10" />
						</div>
						<span class="font-sinistre text-xl tracking-wide hidden sm:block">Atduyar</span>
					</a>
					<ul class="flex gap-4 md:gap-8">
						<li><a href="#about" class="nav-link font-sinistre text-lg hover:text-blue-300 transition-all hover:-translate-y-0.5 relative after:absolute after:bottom-0 after:left-0 after:w-0 after:h-px after:bg-blue-300 hover:after:w-full after:transition-all">About</a></li>
						<li><a href="#skills" class="nav-link font-sinistre text-lg hover:text-blue-300 transition-all hover:-translate-y-0.5 relative after:absolute after:bottom-0 after:left-0 after:w-0 after:h-px after:bg-blue-300 hover:after:w-full after:transition-all">Skills</a></li>
						<li><a href="#projects" class="nav-link font-sinistre text-lg hover:text-blue-300 transition-all hover:-translate-y-0.5 relative after:absolute after:bottom-0 after:left-0 after:w-0 after:h-px after:bg-blue-300 hover:after:w-full after:transition-all">Projects</a></li>
						<li><a href="#contact" class="nav-link font-sinistre text-lg px-4 py-1 border border-blue-500/30 hover:bg-blue-600/10 hover:border-blue-400/50 transition-all rounded-full">Invoke</a></li>
					</ul>
				</div>
			</nav>
		</div>

		<!-- ==================== HERO SECTIONS ==================== -->
		<div id="hero-container">
			<!-- HERO 4-1: Final 4 Hero (Floating Runics) -->
			<section data-section="hero" data-id="4-1" data-name="Floating Runics" id="hero" class="section-option min-h-[80vh] flex flex-col justify-center px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14] relative overflow-hidden">
				<!-- Gradient blobs -->
				<div class="absolute inset-0 opacity-5">
					<div class="absolute top-1/4 left-1/4 w-96 h-96 bg-blue-500 rounded-full blur-[128px]"></div>
					<div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-indigo-500 rounded-full blur-[128px]"></div>
				</div>
				
				<!-- Floating Turkic Glyphs -->
				<div class="absolute inset-0 overflow-hidden pointer-events-none">
					<span class="absolute top-1/4 left-[10%] font-oldturcic text-6xl md:text-8xl text-blue-400/[0.06] leading-none animate-float-1">𐰚</span>
					<span class="absolute top-1/3 right-[15%] font-oldturcic text-5xl md:text-6xl text-blue-400/[0.06] leading-none animate-float-2">𐰇</span>
					<span class="absolute bottom-1/4 left-[20%] font-oldturcic text-5xl md:text-7xl text-blue-400/[0.06] leading-none animate-float-3">𐰠</span>
					<span class="absolute bottom-1/3 right-[25%] font-oldturcic text-7xl md:text-9xl text-blue-400/[0.06] leading-none animate-float-1">𐱅</span>
					<span class="absolute top-1/2 left-[5%] font-oldturcic text-4xl md:text-5xl text-blue-400/[0.06] leading-none animate-float-2">𐰃</span>
					<span class="absolute top-[60%] right-[8%] font-oldturcic text-5xl md:text-6xl text-blue-400/[0.06] leading-none animate-float-3">𐰏</span>
				</div>
				
				<div class="relative z-10">
					<!-- Turkic inscription above name -->
					<p class="font-oldturcic text-blue-400/40 text-lg md:text-xl mb-4 tracking-[0.3em] animate-fade-in leading-none">𐰚𐰇𐰠𐱅𐰃𐰏𐰤</p>
					<h1 class="text-5xl sm:text-7xl lg:text-8xl xl:text-9xl font-sinistre leading-[0.9] mb-8">
						<span class="block animate-slide-up" style="animation-delay: 0.1s;">I'm Ahmet</span>
						<span class="block animate-slide-up text-blue-300" style="animation-delay: 0.2s;">Tarik Duyar</span>
					</h1>
					<p class="text-lg md:text-xl text-gray-400 max-w-xl animate-fade-in" style="animation-delay: 0.5s;">
						Building robust backend architectures and scalable systems. 
						Passionate about C, Rust, and Linux.
					</p>
					<div class="flex gap-4 mt-10 animate-fade-in" style="animation-delay: 0.7s;">
						<a href="#projects" class="px-6 py-3 bg-blue-600/10 border border-blue-500/30 hover:bg-blue-600/20 hover:border-blue-400/50 transition-all font-sinistre text-lg rounded-sm">
							View Projects
						</a>
						<a href="#contact" class="px-6 py-3 border border-[#90c5ff14] hover:border-[#90c5ff30] transition-all font-sinistre text-lg rounded-sm">
							Summon Me
						</a>
					</div>
				</div>
				
				<!-- Scroll prompt with Turkic glyph -->
				<div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-3">
					<p class="font-oldturcic text-sm text-blue-400/40 leading-none">𐰆𐰸</p>
					<div class="w-px h-12 bg-gradient-to-b from-blue-400/40 to-transparent animate-pulse-slow"></div>
				</div>
			</section>

			<!-- HERO 5-1: Final 5 Hero (Centered Poetic) -->
			<section data-section="hero" data-id="5-1" data-name="Centered Poetic" id="hero" class="section-option hidden min-h-screen flex flex-col items-center justify-center px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14] relative overflow-hidden">
				<!-- Gradient blobs -->
				<div class="absolute inset-0 opacity-5">
					<div class="absolute top-1/4 left-1/4 w-96 h-96 bg-blue-500 rounded-full blur-[128px]"></div>
					<div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-indigo-500 rounded-full blur-[128px]"></div>
				</div>
				
				<div class="relative z-10 text-center max-w-4xl">
					<!-- Decorative top ornament -->
					<div class="flex items-center justify-center gap-4 mb-8 animate-fade-in">
						<div class="w-16 h-px bg-gradient-to-r from-transparent to-blue-400/50"></div>
						<span class="font-oldturcic text-lg text-blue-400/40 leading-none">𐰋𐰃𐰠𐰼</span>
						<div class="w-16 h-px bg-gradient-to-l from-transparent to-blue-400/50"></div>
					</div>
					
					<p class="font-oldturcic text-blue-400/40 text-xl mb-6 tracking-[0.4em] animate-fade-in leading-none" style="animation-delay: 0.1s;">𐰚𐰇𐰠𐱅𐰃𐰏𐰤</p>
					
					<h1 class="text-5xl sm:text-7xl lg:text-8xl xl:text-9xl font-sinistre leading-[0.9] mb-8">
						<span class="block animate-rise-1">Ahmet Tarik</span>
						<span class="block animate-rise-2 text-blue-300">Duyar</span>
					</h1>
					
					<!-- Subtitle with decorative lines -->
					<div class="flex items-center justify-center gap-4 mb-8 animate-fade-in-delayed">
						<div class="h-px w-12 sm:w-20 bg-gradient-to-r from-transparent to-blue-400/50"></div>
						<p class="text-sm sm:text-base tracking-[0.3em] uppercase text-gray-500">Software Engineer</p>
						<div class="h-px w-12 sm:w-20 bg-gradient-to-l from-transparent to-blue-400/50"></div>
					</div>
					
					<p class="text-lg md:text-xl text-gray-400 max-w-xl mx-auto animate-fade-in-delayed leading-relaxed" style="animation-delay: 0.6s;">
						From the lands where ancient scripts carved wisdom into stone, I carry the same precision into modern architecture.
					</p>
					
					<!-- Bottom ornament -->
					<div class="flex items-center justify-center gap-4 mt-12 animate-fade-in-delayed" style="animation-delay: 0.8s;">
						<div class="w-24 h-px bg-gradient-to-r from-transparent via-blue-400/30 to-transparent"></div>
					</div>
				</div>
				
				<!-- Scroll prompt -->
				<div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-3">
					<span class="text-xs tracking-widest uppercase text-gray-600">Descend</span>
					<div class="w-px h-12 bg-gradient-to-b from-blue-400/50 to-transparent animate-pulse"></div>
				</div>
			</section>

			<!-- HERO 6-1: Final 6 Hero (Interactive Runes) -->
			<section data-section="hero" data-id="6-1" data-name="Interactive Runes" id="hero" class="section-option hidden min-h-[90vh] flex flex-col justify-center px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14] relative overflow-hidden">
				<!-- Parallax gradient layers -->
				<div class="absolute inset-0">
					<div class="absolute top-1/4 left-1/4 w-[500px] h-[500px] bg-blue-500/10 rounded-full blur-[150px] parallax-layer" data-depth="0.2"></div>
					<div class="absolute bottom-1/3 right-1/4 w-[400px] h-[400px] bg-indigo-500/10 rounded-full blur-[120px] parallax-layer" data-depth="0.3"></div>
					<div class="absolute top-1/2 right-1/3 w-[300px] h-[300px] bg-cyan-500/5 rounded-full blur-[100px] parallax-layer" data-depth="0.1"></div>
				</div>
				
				<!-- Interactive Floating Runes -->
				<div class="absolute inset-0 overflow-hidden pointer-events-none" id="rune-container">
					<span class="rune absolute top-[15%] left-[8%] font-oldturcic text-5xl md:text-7xl text-blue-400/[0.08] leading-none" data-speed="0.02">𐰚</span>
					<span class="rune absolute top-[25%] right-[12%] font-oldturcic text-4xl md:text-5xl text-blue-400/[0.1] leading-none" data-speed="0.03">𐰇</span>
					<span class="rune absolute bottom-[30%] left-[15%] font-oldturcic text-6xl md:text-8xl text-blue-400/[0.06] leading-none" data-speed="0.015">𐰠</span>
					<span class="rune absolute top-[55%] right-[20%] font-oldturcic text-7xl md:text-9xl text-blue-400/[0.05] leading-none" data-speed="0.025">𐱅</span>
					<span class="rune absolute top-[40%] left-[5%] font-oldturcic text-3xl md:text-4xl text-blue-400/[0.12] leading-none" data-speed="0.035">𐰃</span>
					<span class="rune absolute bottom-[20%] right-[8%] font-oldturcic text-5xl md:text-6xl text-blue-400/[0.07] leading-none" data-speed="0.02">𐰏</span>
					<span class="rune absolute top-[70%] left-[25%] font-oldturcic text-4xl md:text-5xl text-indigo-400/[0.08] leading-none" data-speed="0.028">𐰼</span>
					<span class="rune absolute top-[10%] right-[30%] font-oldturcic text-5xl md:text-6xl text-cyan-400/[0.06] leading-none" data-speed="0.018">𐰽</span>
				</div>
				
				<div class="relative z-10">
					<!-- Glowing ring decoration -->
					<div class="absolute -top-20 -left-20 w-40 h-40 border border-blue-400/10 rounded-full animate-pulse-ring"></div>
					
					<p class="font-oldturcic text-blue-400/50 text-lg mb-4 tracking-[0.4em] animate-fade-in leading-none">𐰚𐰇𐰠𐱅𐰃𐰏𐰤</p>
					<h1 class="text-5xl sm:text-7xl lg:text-8xl xl:text-9xl font-sinistre leading-[0.9] mb-8">
						<span class="block animate-slide-up glow-text" style="animation-delay: 0.1s;">I'm Ahmet</span>
						<span class="block animate-slide-up" style="animation-delay: 0.2s;">
							<span class="text-blue-300 glow-text-blue">Tarik</span> Duyar
						</span>
					</h1>
					<p class="text-lg md:text-xl text-gray-400 max-w-xl animate-fade-in leading-relaxed" style="animation-delay: 0.5s;">
						Building robust backend architectures and scalable systems. 
						Passionate about C, Rust, and Linux.
					</p>
					<div class="flex gap-4 mt-10 animate-fade-in" style="animation-delay: 0.7s;">
						<a href="#projects" class="group px-6 py-3 bg-blue-600/10 border border-blue-500/30 hover:bg-blue-600/20 hover:border-blue-400/50 transition-all font-sinistre text-lg rounded-sm relative overflow-hidden">
							<span class="relative z-10">View Projects</span>
							<div class="absolute inset-0 bg-gradient-to-r from-blue-500/0 via-blue-500/10 to-blue-500/0 -translate-x-full group-hover:translate-x-full transition-transform duration-700"></div>
						</a>
						<a href="#contact" class="px-6 py-3 border border-[#90c5ff14] hover:border-[#90c5ff30] transition-all font-sinistre text-lg rounded-sm hover:shadow-[0_0_20px_rgba(144,197,255,0.1)]">
							Invoke Me
						</a>
					</div>
				</div>
			</section>
		</div>

		<!-- ==================== ABOUT SECTIONS ==================== -->
		<div id="about-container">
			<!-- ABOUT 4-1: Final 4 About -->
			<section data-section="about" data-id="4-1" data-name="With Emblem Card" id="about" class="section-option px-4 md:px-8 lg:px-16 py-20 border-b border-[#90c5ff14]">
				<div class="flex flex-col lg:flex-row gap-12 items-start">
					<div class="flex-1">
						<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-8 flex items-center gap-4">
							<span class="font-oldturcic text-2xl md:text-3xl text-blue-400/30 leading-none">𐰋𐰃𐰠</span>
							About Me
							<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
						</h2>
						<div class="space-y-6 text-gray-300 text-lg leading-relaxed">
							<p>
								I'm a Full-Stack Software Engineer with a year of professional experience specializing in building robust backend architectures, designing scalable databases, and managing critical systems.
							</p>
							<p>
								During my time at <span class="text-white">Deniz Egece Co. Ltd.</span>, I took ownership of architecting and deploying a streaming platform serving over <span class="text-blue-300">17,000 paid users</span>, demonstrating my ability to deliver end-to-end solutions across various platforms.
							</p>
							<p>
								As an <span class="text-white">Honor Student</span> in Software Engineering at the International University of Sarajevo, I'm deeply focused on computer science fundamentals while actively exploring C, Rust, JavaScript, and Linux.
							</p>
						</div>
					</div>
					<div class="w-full lg:w-80 flex-shrink-0">
						<!-- Emblem card with corner decorations -->
						<div class="aspect-square bg-gradient-to-br from-[#90c5ff08] to-transparent border border-[#90c5ff14] rounded-sm p-8 flex items-center justify-center relative">
							<img src="/favicon.svg" alt="Logo" class="w-full h-full opacity-80" />
							<!-- Corner decorations -->
							<div class="absolute top-0 left-0 w-6 h-6 border-t border-l border-blue-400/30"></div>
							<div class="absolute top-0 right-0 w-6 h-6 border-t border-r border-blue-400/30"></div>
							<div class="absolute bottom-0 left-0 w-6 h-6 border-b border-l border-blue-400/30"></div>
							<div class="absolute bottom-0 right-0 w-6 h-6 border-b border-r border-blue-400/30"></div>
						</div>
					</div>
				</div>
			</section>

			<!-- ABOUT 5-1: Final 5 Origin -->
			<section data-section="about" data-id="5-1" data-name="Origin (Poetic)" id="about" class="section-option hidden px-4 md:px-8 lg:px-16 py-24 border-b border-[#90c5ff14]">
				<div class="flex flex-col lg:flex-row gap-12 items-start">
					<div class="flex-1">
						<h2 class="text-3xl sm:text-4xl lg:text-5xl font-sinistre mb-8 flex items-center gap-4">
							<span class="font-oldturcic text-2xl md:text-3xl text-blue-400/30 leading-none">𐰋𐰃𐰠</span>
							Origin
							<span class="flex-1 h-px bg-gradient-to-r from-[#90c5ff14] to-transparent"></span>
						</h2>
						<div class="space-y-6 text-gray-300 text-lg leading-relaxed">
							<p>
								A Full-Stack Software Engineer from the lands where ancient scripts once carved wisdom into stone. I carry the same precision into modern architecture.
							</p>
							<p>
								At <span class="text-blue-300">Deniz Egece Co. Ltd.</span>, I architected a streaming platform serving <span class="text-blue-300">17,000+ subscribers</span>, managing video transcoding pipelines, payment systems, and real-time analytics.
							</p>
							<p>
								Currently an <span class="text-white">Honor Student</span> at the International University of Sarajevo, diving deep into the roots of computing: C, Rust, and Linux systems.
							</p>
						</div>
					</div>
					<div class="w-full lg:w-72 flex-shrink-0">
						<!-- Decorative card with emblem and corner decorations -->
						<div class="aspect-square border border-[#90c5ff14] bg-gradient-to-br from-[#90c5ff05] to-transparent p-6 flex items-center justify-center relative">
							<img src="/favicon.svg" alt="Emblem" class="w-3/4 opacity-60" />
							<!-- Corner decorations -->
							<div class="absolute top-0 left-0 w-6 h-6 border-t border-l border-blue-400/40"></div>
							<div class="absolute top-0 right-0 w-6 h-6 border-t border-r border-blue-400/40"></div>
							<div class="absolute bottom-0 left-0 w-6 h-6 border-b border-l border-blue-400/40"></div>
							<div class="absolute bottom-0 right-0 w-6 h-6 border-b border-r border-blue-400/40"></div>
						</div>
					</div>
