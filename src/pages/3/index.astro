---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="A. T. Duyar" description="Ahmet Tarik Duyar - Minimal Portfolio" bodyClass="bg-[#faf9f7] text-[#1a1a1a] min-h-screen overflow-x-hidden selection:bg-[#1a1a1a] selection:text-[#faf9f7]">
	<!-- Main container with editorial grid -->
	<div class="min-h-screen">
		<!-- Navigation - Ultra minimal -->
		<nav class="fixed top-0 left-0 right-0 z-50 mix-blend-difference">
			<div class="max-w-screen-2xl mx-auto px-6 md:px-12 py-8 flex justify-between items-center">
				<a href="#" class="text-white font-light tracking-[0.3em] text-sm uppercase">Duyar</a>
				<div class="flex gap-8">
					<a href="#work" class="text-white text-sm tracking-wider hover:opacity-60 transition-opacity">Work</a>
					<a href="#contact" class="text-white text-sm tracking-wider hover:opacity-60 transition-opacity">Contact</a>
				</div>
			</div>
		</nav>

		<!-- Hero - Giant typography -->
		<section class="min-h-screen flex flex-col justify-end px-6 md:px-12 pb-12 pt-32 relative">
			<div class="max-w-screen-2xl mx-auto w-full">
				<!-- Subtle decorative line -->
				<div class="absolute top-1/2 left-6 md:left-12 w-px h-32 bg-gradient-to-b from-transparent via-[#1a1a1a]/20 to-transparent"></div>
				
				<p class="text-sm tracking-[0.5em] uppercase text-[#1a1a1a]/40 mb-8 ml-1">Software Engineer</p>
				
				<h1 class="font-sinistre text-[15vw] md:text-[12vw] leading-[0.85] tracking-tight -ml-2">
					<span class="block overflow-hidden">
						<span class="block animate-rise" style="animation-delay: 0.1s;">Ahmet</span>
					</span>
					<span class="block overflow-hidden">
						<span class="block animate-rise" style="animation-delay: 0.2s;">Tarik</span>
					</span>
					<span class="block overflow-hidden text-[#1a1a1a]/30">
						<span class="block animate-rise" style="animation-delay: 0.3s;">Duyar</span>
					</span>
				</h1>
				
				<div class="flex justify-between items-end mt-16">
					<p class="text-sm tracking-wider text-[#1a1a1a]/60 max-w-xs leading-relaxed">
						Building systems that scale.<br />
						Based in Sarajevo.
					</p>
					<a href="#about" class="group flex items-center gap-3 text-sm tracking-wider">
						<span>Scroll</span>
						<span class="w-8 h-px bg-[#1a1a1a] group-hover:w-16 transition-all"></span>
					</a>
				</div>
			</div>
		</section>

		<!-- About - Split layout -->
		<section id="about" class="min-h-screen px-6 md:px-12 py-32 border-t border-[#1a1a1a]/10">
			<div class="max-w-screen-2xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-24">
				<div class="lg:col-span-4">
					<p class="text-sm tracking-[0.3em] uppercase text-[#1a1a1a]/40 mb-4">01</p>
					<h2 class="font-sinistre text-4xl md:text-5xl">About</h2>
				</div>
				<div class="lg:col-span-6 lg:col-start-7">
					<div class="space-y-8 text-lg md:text-xl leading-relaxed text-[#1a1a1a]/80">
						<p>
							Full-Stack Software Engineer with a focus on building robust backend architectures and scalable databases.
						</p>
						<p>
							At <span class="text-[#1a1a1a]">Deniz Egece Co. Ltd.</span>, I architected a streaming platform serving over <span class="text-[#1a1a1a]">17,000 paid users</span>, handling video transcoding, payment systems, and real-time analytics.
						</p>
						<p>
							Currently pursuing Software Engineering at the International University of Sarajevo as an Honor Student, with deep exploration into C, Rust, and Linux systems.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Skills - Horizontal scroll feel -->
		<section class="py-32 border-t border-[#1a1a1a]/10 overflow-hidden">
			<div class="px-6 md:px-12 max-w-screen-2xl mx-auto mb-16">
				<p class="text-sm tracking-[0.3em] uppercase text-[#1a1a1a]/40 mb-4">02</p>
				<h2 class="font-sinistre text-4xl md:text-5xl">Expertise</h2>
			</div>
			
			<!-- Marquee of skills -->
			<div class="relative py-12 border-y border-[#1a1a1a]/10">
				<div class="flex gap-24 animate-scroll-left whitespace-nowrap">
					<span class="font-sinistre text-6xl md:text-8xl text-[#1a1a1a]/10 hover:text-[#1a1a1a] transition-colors cursor-default">Backend</span>
					<span class="font-sinistre text-6xl md:text-8xl text-[#1a1a1a]/10 hover:text-[#1a1a1a] transition-colors cursor-default">Systems</span>
					<span class="font-sinistre text-6xl md:text-8xl text-[#1a1a1a]/10 hover:text-[#1a1a1a] transition-colors cursor-default">Databases</span>
					<span class="font-sinistre text-6xl md:text-8xl text-[#1a1a1a]/10 hover:text-[#1a1a1a] transition-colors cursor-default">Cloud</span>
					<span class="font-sinistre text-6xl md:text-8xl text-[#1a1a1a]/10 hover:text-[#1a1a1a] transition-colors cursor-default">Streaming</span>
					<span class="font-sinistre text-6xl md:text-8xl text-[#1a1a1a]/10 hover:text-[#1a1a1a] transition-colors cursor-default">Backend</span>
					<span class="font-sinistre text-6xl md:text-8xl text-[#1a1a1a]/10 hover:text-[#1a1a1a] transition-colors cursor-default">Systems</span>
					<span class="font-sinistre text-6xl md:text-8xl text-[#1a1a1a]/10 hover:text-[#1a1a1a] transition-colors cursor-default">Databases</span>
				</div>
			</div>
			
			<!-- Skill details -->
			<div class="px-6 md:px-12 max-w-screen-2xl mx-auto mt-16 grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-16">
				<div class="space-y-3">
					<h3 class="text-sm tracking-wider uppercase text-[#1a1a1a]/40">Languages</h3>
					<p class="text-lg">Rust, C, Go, TypeScript, Python</p>
				</div>
				<div class="space-y-3">
					<h3 class="text-sm tracking-wider uppercase text-[#1a1a1a]/40">Backend</h3>
					<p class="text-lg">Node.js, Actix, Gin, FastAPI</p>
				</div>
				<div class="space-y-3">
					<h3 class="text-sm tracking-wider uppercase text-[#1a1a1a]/40">Data</h3>
					<p class="text-lg">PostgreSQL, Redis, MongoDB</p>
				</div>
				<div class="space-y-3">
					<h3 class="text-sm tracking-wider uppercase text-[#1a1a1a]/40">Infrastructure</h3>
					<p class="text-lg">Docker, K8s, AWS, Cloudflare</p>
				</div>
			</div>
		</section>

		<!-- Work/Projects -->
		<section id="work" class="py-32 px-6 md:px-12 border-t border-[#1a1a1a]/10">
			<div class="max-w-screen-2xl mx-auto">
				<div class="mb-16">
					<p class="text-sm tracking-[0.3em] uppercase text-[#1a1a1a]/40 mb-4">03</p>
					<h2 class="font-sinistre text-4xl md:text-5xl">Selected Work</h2>
				</div>
				
				<!-- Project items -->
				<div class="space-y-1">
					<!-- Project 1 -->
					<a href="#" class="group block py-8 border-b border-[#1a1a1a]/10 hover:border-[#1a1a1a]/30 transition-colors">
						<div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
							<div class="flex items-baseline gap-6">
								<span class="text-sm text-[#1a1a1a]/40">01</span>
								<h3 class="font-sinistre text-3xl md:text-4xl group-hover:translate-x-4 transition-transform">Streaming Platform</h3>
							</div>
							<div class="flex items-center gap-8 text-sm text-[#1a1a1a]/60">
								<span>Deniz Egece</span>
								<span>2023</span>
								<span class="w-8 h-px bg-[#1a1a1a]/30 group-hover:w-16 group-hover:bg-[#1a1a1a] transition-all"></span>
							</div>
						</div>
					</a>
					
					<!-- Project 2 -->
					<a href="#" class="group block py-8 border-b border-[#1a1a1a]/10 hover:border-[#1a1a1a]/30 transition-colors">
						<div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
							<div class="flex items-baseline gap-6">
								<span class="text-sm text-[#1a1a1a]/40">02</span>
								<h3 class="font-sinistre text-3xl md:text-4xl group-hover:translate-x-4 transition-transform">Portfolio Site</h3>
							</div>
							<div class="flex items-center gap-8 text-sm text-[#1a1a1a]/60">
								<span>Personal</span>
								<span>2024</span>
								<span class="w-8 h-px bg-[#1a1a1a]/30 group-hover:w-16 group-hover:bg-[#1a1a1a] transition-all"></span>
							</div>
						</div>
					</a>
					
					<!-- Project 3 -->
					<a href="#" class="group block py-8 border-b border-[#1a1a1a]/10 hover:border-[#1a1a1a]/30 transition-colors">
						<div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
							<div class="flex items-baseline gap-6">
								<span class="text-sm text-[#1a1a1a]/40">03</span>
								<h3 class="font-sinistre text-3xl md:text-4xl group-hover:translate-x-4 transition-transform">Open Source</h3>
							</div>
							<div class="flex items-center gap-8 text-sm text-[#1a1a1a]/60">
								<span>Various</span>
								<span>Ongoing</span>
								<span class="w-8 h-px bg-[#1a1a1a]/30 group-hover:w-16 group-hover:bg-[#1a1a1a] transition-all"></span>
							</div>
						</div>
					</a>
				</div>
			</div>
		</section>

		<!-- Contact - Dramatic typography -->
		<section id="contact" class="min-h-screen flex flex-col justify-center px-6 md:px-12 py-32 border-t border-[#1a1a1a]/10 relative">
			<div class="max-w-screen-2xl mx-auto w-full">
				<p class="text-sm tracking-[0.3em] uppercase text-[#1a1a1a]/40 mb-8">04</p>
				
				<h2 class="font-sinistre text-[10vw] md:text-[8vw] leading-[0.9] mb-16">
					<span class="block">Let's work</span>
					<span class="block text-[#1a1a1a]/30">together</span>
				</h2>
				
				<div class="grid grid-cols-1 md:grid-cols-2 gap-16 md:gap-32">
					<div>
						<p class="text-lg md:text-xl leading-relaxed text-[#1a1a1a]/70 mb-8">
							Available for collaborations, freelance projects, and full-time opportunities.
						</p>
						<a href="mailto:contact@atduyar.com" class="inline-block text-lg border-b border-[#1a1a1a] pb-1 hover:pb-2 transition-all">
							contact@atduyar.com
						</a>
					</div>
					<div class="space-y-6">
						<a href="https://github.com/atduyar" target="_blank" rel="noopener" class="block text-lg text-[#1a1a1a]/60 hover:text-[#1a1a1a] transition-colors">
							GitHub
						</a>
						<a href="https://linkedin.com/in/atduyar" target="_blank" rel="noopener" class="block text-lg text-[#1a1a1a]/60 hover:text-[#1a1a1a] transition-colors">
							LinkedIn
						</a>
					</div>
				</div>
			</div>
			
			<!-- Large decorative year -->
			<div class="absolute bottom-12 right-6 md:right-12 text-[20vw] font-sinistre text-[#1a1a1a]/[0.03] leading-none pointer-events-none select-none">
				26
			</div>
		</section>

		<!-- Footer -->
		<footer class="px-6 md:px-12 py-8 border-t border-[#1a1a1a]/10">
			<div class="max-w-screen-2xl mx-auto flex justify-between items-center text-sm text-[#1a1a1a]/40">
				<span>&copy; 2026</span>
				<span>Ahmet Tarik Duyar</span>
			</div>
		</footer>
	</div>
</BaseLayout>

<style>
	@keyframes rise {
		from {
			transform: translateY(100%);
			opacity: 0;
		}
		to {
			transform: translateY(0);
			opacity: 1;
		}
	}
	
	@keyframes scroll-left {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}
	
	.animate-rise {
		animation: rise 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
		opacity: 0;
	}
	
	.animate-scroll-left {
		animation: scroll-left 30s linear infinite;
	}
</style>
