---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<!--
	Variant 3 — "Index"
	Monospace, dense, structured like a well-kept README. No animation, no
	decoration except one glyph used as a prompt mark. Reads fast, prints
	well, and signals "this person writes documentation".
-->
<BaseLayout
	title="atduyar — software engineer"
	description="Ahmet Tarik Duyar. Full-stack software engineer: streaming platforms, .NET backends, Rust."
	bodyClass="bg-[#0c0d10] text-gray-300 font-mono antialiased"
>
	<main class="max-w-3xl mx-auto px-6 py-16 md:py-24 text-[15px] leading-relaxed">
		<!-- Header -->
		<header class="mb-14">
			<h1 class="text-white text-lg mb-1">
				<span class="text-blue-400 select-none" aria-hidden="true">𐱅 </span>ahmet tarik duyar
			</h1>
			<p class="text-gray-500">software engineer — sarajevo, bosnia &amp; herzegovina</p>
			<p class="mt-4 text-gray-400 max-w-xl">
				I build full-stack systems and keep them running in production.
				Currently: streaming &amp; education platforms at Deniz Egece.
				On the side: Rust, C, and Linux.
			</p>
			<div class="mt-5 grid grid-cols-[6rem_1fr] gap-y-1 text-sm">
				<span class="text-gray-600">email</span>
				<a href="mailto:atduyar@gmail.com" class="text-blue-400 hover:text-blue-300 hover:underline w-fit">atduyar@gmail.com</a>
				<span class="text-gray-600">github</span>
				<a href="https://github.com/atduyar" target="_blank" rel="noopener" class="text-blue-400 hover:text-blue-300 hover:underline w-fit">github.com/atduyar</a>
				<span class="text-gray-600">linkedin</span>
				<a href="https://linkedin.com/in/atduyar" target="_blank" rel="noopener" class="text-blue-400 hover:text-blue-300 hover:underline w-fit">linkedin.com/in/atduyar</a>
			</div>
		</header>

		<!-- Experience -->
		<section class="mb-14">
			<h2 class="text-white mb-6"><span class="text-gray-600 select-none">## </span>experience</h2>

			<article class="mb-8 border-l-2 border-blue-400/20 pl-5">
				<div class="flex flex-wrap justify-between gap-2">
					<h3 class="text-gray-100">full-stack engineer @ deniz egece co. ltd.</h3>
					<span class="text-gray-600 text-sm">2022—now</span>
				</div>
				<ul class="mt-3 space-y-2 text-sm text-gray-400">
					<li><span class="text-gray-600 select-none">- </span>founding engineer on EgeceTV: streaming platform, 17,000+ paid subscribers, ~1,000 videos, 5 client platforms (web / iOS / Android / Android TV / Apple TV)</li>
					<li><span class="text-gray-600 select-none">- </span>owned backend architecture + database design; single GraphQL API behind all clients</li>
					<li><span class="text-gray-600 select-none">- </span>built subscription payments and the CI/CD pipeline (GitHub Actions)</li>
					<li><span class="text-gray-600 select-none">- </span>built a distance-education platform (.NET, Clean Architecture, WebRTC video consultations, scheduling) in a 5-person team</li>
				</ul>
				<p class="mt-3 text-xs text-gray-600">next.js · graphql · c#/.net · mysql · postgresql · prisma · aws</p>
			</article>

			<article class="border-l-2 border-blue-400/20 pl-5">
				<div class="flex flex-wrap justify-between gap-2">
					<h3 class="text-gray-100">freelance developer</h3>
					<span class="text-gray-600 text-sm">2021—2022</span>
				</div>
				<ul class="mt-3 space-y-2 text-sm text-gray-400">
					<li><span class="text-gray-600 select-none">- </span>built Evrenomi, a c#/.net blogging platform; 95+ lighthouse, self-managed linux hosting</li>
				</ul>
			</article>
		</section>

		<!-- Projects -->
		<section class="mb-14">
			<h2 class="text-white mb-6"><span class="text-gray-600 select-none">## </span>projects</h2>
			<div class="space-y-6 text-sm">
				<div>
					<div class="flex flex-wrap items-baseline gap-3">
						<a href="https://github.com/atduyar/rekv" target="_blank" rel="noopener" class="text-blue-400 hover:text-blue-300 hover:underline">rekv</a>
						<span class="text-gray-600">rust</span>
					</div>
					<p class="text-gray-400 mt-1">type-safe key-value store library. memory-mapped storage, zero-copy deserialization, async i/o.</p>
				</div>
				<div>
					<div class="flex flex-wrap items-baseline gap-3">
						<a href="https://github.com/atduyar/make2game" target="_blank" rel="noopener" class="text-blue-400 hover:text-blue-300 hover:underline">make2game</a>
						<span class="text-gray-600">c++ / opengl / lua</span>
					</div>
					<p class="text-gray-400 mt-1">2d game engine from scratch with lua scripting and an immediate-mode editor (imgui).</p>
				</div>
				<div>
					<div class="flex flex-wrap items-baseline gap-3">
						<a href="https://evrenomi.com" target="_blank" rel="noopener" class="text-blue-400 hover:text-blue-300 hover:underline">evrenomi.com</a>
						<span class="text-gray-600">c# / .net</span>
					</div>
					<p class="text-gray-400 mt-1">performance-focused blogging platform. 95+ lighthouse across all metrics.</p>
				</div>
				<div>
					<div class="flex flex-wrap items-baseline gap-3">
						<span class="text-gray-100">egecetv</span>
						<span class="text-gray-600">next.js / graphql — commercial</span>
					</div>
					<p class="text-gray-400 mt-1">production streaming platform described above. adaptive bitrate delivery, custom cms, payments.</p>
				</div>
			</div>
		</section>

		<!-- Skills -->
		<section class="mb-14">
			<h2 class="text-white mb-6"><span class="text-gray-600 select-none">## </span>stack</h2>
			<div class="grid grid-cols-[6rem_1fr] gap-y-2 text-sm">
				<span class="text-gray-600">web</span><span class="text-gray-300">typescript, react, next.js, graphql</span>
				<span class="text-gray-600">backend</span><span class="text-gray-300">c# / .net, rest, clean architecture</span>
				<span class="text-gray-600">data</span><span class="text-gray-300">mysql, postgresql, prisma</span>
				<span class="text-gray-600">systems</span><span class="text-gray-300">rust, c, linux</span>
				<span class="text-gray-600">infra</span><span class="text-gray-300">docker, aws, github actions</span>
			</div>
		</section>

		<!-- Education -->
		<section class="mb-14">
			<h2 class="text-white mb-6"><span class="text-gray-600 select-none">## </span>education</h2>
			<div class="flex flex-wrap justify-between gap-2 text-sm">
				<span class="text-gray-300">b.sc. computer science — international university of sarajevo <span class="text-gray-600">(honor student)</span></span>
			</div>
		</section>

		<!-- Footer -->
		<footer class="pt-6 border-t border-white/10 text-sm text-gray-600 flex flex-wrap justify-between gap-3">
			<span>© 2026 atduyar</span>
			<a href="mailto:atduyar@gmail.com" class="text-blue-400 hover:text-blue-300 hover:underline">say hello →</a>
		</footer>
	</main>
</BaseLayout>
