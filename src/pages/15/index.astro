---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<!--
	/15 — "Atlas, carved"
	The /10 structure (identity hero + named territories) rebuilt flat and
	hard-edged: no rounded corners, no floating cards — every region is a
	bordered cell with its own background tone, like panels cut from one slab.
	Imported from the original homepage: floating runes in the hero and the
	glowing Transmit button (here wired to actually send via mailto).
-->
<BaseLayout
	title="Tarik Duyar"
	description="Personal site of Ahmet Tarik Duyar — code, words, curiosities. Software engineer in Sarajevo."
	bodyClass="bg-[#08090b] text-gray-200 antialiased"
>
	<div class="max-w-5xl mx-auto border-x border-[#90c5ff1a] min-h-dvh">

		<!-- Hero with floating runes -->
		<header class="min-h-[75vh] flex flex-col items-center justify-center text-center px-6 py-20 border-b border-[#90c5ff1a] bg-[#0c0d11] relative overflow-hidden">
			<!-- Floating Turkic glyphs (from the original hero) -->
			<div class="absolute inset-0 overflow-hidden pointer-events-none select-none" aria-hidden="true">
				<span class="absolute top-1/4 left-[10%] font-oldturcic text-6xl md:text-8xl text-blue-400/[0.07] leading-none animate-float-1">𐰚</span>
				<span class="absolute top-1/3 right-[14%] font-oldturcic text-5xl md:text-6xl text-blue-400/[0.07] leading-none animate-float-2">𐰇</span>
				<span class="absolute bottom-1/4 left-[18%] font-oldturcic text-5xl md:text-7xl text-blue-400/[0.07] leading-none animate-float-3">𐰠</span>
				<span class="absolute bottom-[18%] right-[22%] font-oldturcic text-7xl md:text-9xl text-blue-400/[0.06] leading-none animate-float-1">𐱅</span>
				<span class="absolute top-1/2 left-[5%] font-oldturcic text-4xl md:text-5xl text-blue-400/[0.07] leading-none animate-float-2">𐰃</span>
				<span class="absolute top-[58%] right-[7%] font-oldturcic text-5xl md:text-6xl text-blue-400/[0.07] leading-none animate-float-3">𐰏</span>
			</div>

			<div class="relative">
				<div class="w-16 h-16 mx-auto mb-10 border border-blue-400/30 flex items-center justify-center">
					<span class="font-oldturcic text-blue-300/80 text-3xl leading-none select-none" aria-hidden="true">𐱅</span>
				</div>
				<h1 class="font-sinistre text-5xl md:text-7xl text-white leading-none mb-6">Tarik Duyar</h1>
				<p class="text-gray-400 max-w-md mx-auto leading-relaxed">
					Software engineer in Sarajevo. Part workshop, part notebook,
					part map of what I'm curious about.
				</p>
				<div class="flex justify-center gap-7 mt-10 text-sm">
					<a href="#code" class="text-gray-500 hover:text-blue-300 transition-colors">Code</a>
					<a href="#words" class="text-gray-500 hover:text-blue-300 transition-colors">Words</a>
					<a href="#curiosities" class="text-gray-500 hover:text-blue-300 transition-colors">Curiosities</a>
					<a href="#contact" class="text-blue-300 hover:text-blue-200 transition-colors">Contact</a>
				</div>
			</div>
		</header>

		<!-- Now bar -->
		<section class="px-6 md:px-10 py-5 border-b border-[#90c5ff1a] bg-[#0a0b0e]">
			<div class="flex flex-wrap items-baseline gap-x-8 gap-y-2 text-sm">
				<span class="text-xs uppercase tracking-[0.2em] text-blue-400/70 shrink-0">Now</span>
				<span class="text-gray-400">Shipping EgeceTV</span>
				<span class="text-gray-400">REKV write path</span>
				<span class="text-gray-400">Last year of CS @ IUS</span>
				<span class="text-gray-600 text-xs ml-auto tabular-nums">2026-06</span>
			</div>
		</section>

		<!-- Territories: hard grid, no gaps, alternating tones -->
		<main class="grid md:grid-cols-3">

			<!-- Code -->
			<section id="code" class="p-8 md:p-10 border-b md:border-b-0 md:border-r border-[#90c5ff1a] bg-[#0c0d11] scroll-mt-8">
				<h2 class="flex items-baseline gap-3 mb-2">
					<span class="font-oldturcic text-blue-400/30 text-lg leading-none select-none" aria-hidden="true">𐰃𐱁</span>
					<span class="font-sinistre text-2xl text-white">Code</span>
				</h2>
				<p class="text-xs text-gray-600 mb-8">what I build</p>

				<ul class="divide-y divide-[#90c5ff12] text-sm">
					<li class="py-4">
						<p class="text-gray-200 mb-1">EgeceTV <span class="text-gray-600 text-xs">· day job</span></p>
						<p class="text-gray-500 leading-relaxed">Streaming, 17K+ paying subscribers, five platforms. Backend, database, payments, CI/CD — mine.</p>
					</li>
					<li class="py-4">
						<p class="mb-1"><a href="https://github.com/atduyar/rekv" target="_blank" rel="noopener" class="text-gray-200 hover:text-blue-300 transition-colors">REKV ↗</a></p>
						<p class="text-gray-500 leading-relaxed">Type-safe KV store in Rust. Memory-mapped, zero-copy, async.</p>
					</li>
					<li class="py-4">
						<p class="mb-1"><a href="https://github.com/atduyar/make2game" target="_blank" rel="noopener" class="text-gray-200 hover:text-blue-300 transition-colors">Make2Game ↗</a></p>
						<p class="text-gray-500 leading-relaxed">2D engine from scratch — C++, OpenGL, Lua.</p>
					</li>
					<li class="py-4">
						<p class="mb-1"><a href="https://evrenomi.com" target="_blank" rel="noopener" class="text-gray-200 hover:text-blue-300 transition-colors">Evrenomi ↗</a></p>
						<p class="text-gray-500 leading-relaxed">Blog platform, 95+ Lighthouse, self-hosted since 2021.</p>
					</li>
				</ul>
			</section>

			<!-- Words -->
			<section id="words" class="p-8 md:p-10 border-b md:border-b-0 md:border-r border-[#90c5ff1a] bg-[#0a0b0e] scroll-mt-8">
				<h2 class="flex items-baseline gap-3 mb-2">
					<span class="font-oldturcic text-blue-400/30 text-lg leading-none select-none" aria-hidden="true">𐰽𐰉</span>
					<span class="font-sinistre text-2xl text-white">Words</span>
				</h2>
				<p class="text-xs text-gray-600 mb-8">what I'm writing — blog soon</p>

				<ul class="divide-y divide-[#90c5ff12] text-sm">
					<li class="py-4">
						<p class="text-gray-200 leading-snug mb-1">Self-hosting Matrix: the .well-known rabbit hole</p>
						<p class="text-gray-500 leading-relaxed">Three evenings, three HTTP headers, one prettier user ID.</p>
					</li>
					<li class="py-4">
						<p class="text-gray-200 leading-snug mb-1">Memory-mapped files vs. the borrow checker</p>
						<p class="text-gray-500 leading-relaxed">Zero-copy meets ownership. Field notes from REKV.</p>
					</li>
					<li class="py-4">
						<p class="text-gray-200 leading-snug mb-1">Five platforms, one GraphQL API</p>
						<p class="text-gray-500 leading-relaxed">The schema decisions behind EgeceTV — keepers and regrets.</p>
					</li>
					<li class="py-4">
						<p class="text-gray-200 leading-snug mb-1">Why I wrote a game engine nobody asked for</p>
						<p class="text-gray-500 leading-relaxed">A defense of building from scratch as a way of learning.</p>
					</li>
				</ul>
			</section>

			<!-- Curiosities -->
			<section id="curiosities" class="p-8 md:p-10 bg-[#0c0d11] scroll-mt-8">
				<h2 class="flex items-baseline gap-3 mb-2">
					<span class="font-oldturcic text-blue-400/30 text-lg leading-none select-none" aria-hidden="true">𐰚𐰇</span>
					<span class="font-sinistre text-2xl text-white">Curiosities</span>
				</h2>
				<p class="text-xs text-gray-600 mb-8">what pulls me in</p>

				<ul class="divide-y divide-[#90c5ff12] text-sm">
					<li class="py-4">
						<p class="text-gray-200 mb-1">Old Turkic script</p>
						<p class="text-gray-500 leading-relaxed">The Orkhon inscriptions: 1,300-year-old documentation, still readable. Every glyph here is the real alphabet.</p>
					</li>
					<li class="py-4">
						<p class="text-gray-200 mb-1">Self-hosting</p>
						<p class="text-gray-500 leading-relaxed">Matrix homeserver, this site, backups. You write better software when you operate it too.</p>
					</li>
					<li class="py-4">
						<p class="text-gray-200 mb-1">Linux, all the way down</p>
						<p class="text-gray-500 leading-relaxed">Arch on the desktop, Debian on the servers, <a href="https://github.com/atduyar/dotfiles" target="_blank" rel="noopener" class="text-blue-400 hover:text-blue-300 transition-colors">dotfiles in git</a>.</p>
					</li>
					<li class="py-4">
						<p class="text-gray-200 mb-1">One layer lower</p>
						<p class="text-gray-500 leading-relaxed">Each year, one more layer down the stack. 2026: storage engines.</p>
					</li>
				</ul>
			</section>
		</main>

		<!-- Contact with glowing Transmit -->
		<section id="contact" class="border-t border-[#90c5ff1a] bg-[#0a0b0e] px-6 md:px-10 py-16 relative group/contact overflow-hidden scroll-mt-8">
			<div class="max-w-xl mx-auto relative z-10">
				<h2 class="font-sinistre text-3xl md:text-4xl text-white text-center mb-3">Write to me.</h2>
				<p class="text-sm text-gray-500 text-center mb-10">
					Fills your mail client — nothing is sent anywhere else.
				</p>

				<form id="contact-form" class="space-y-6">
					<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
						<div>
							<label for="name" class="block text-xs uppercase tracking-[0.15em] text-gray-500 mb-2">Name</label>
							<input type="text" id="name" name="name" class="w-full bg-[#0c0d11] border border-[#90c5ff1f] focus:border-blue-400/60 outline-none px-3 py-2.5 text-gray-200 transition-colors" placeholder="Your name" />
						</div>
						<div>
							<label for="subject" class="block text-xs uppercase tracking-[0.15em] text-gray-500 mb-2">Subject</label>
							<input type="text" id="subject" name="subject" class="w-full bg-[#0c0d11] border border-[#90c5ff1f] focus:border-blue-400/60 outline-none px-3 py-2.5 text-gray-200 transition-colors" placeholder="What's this about?" />
						</div>
					</div>
					<div>
						<label for="message" class="block text-xs uppercase tracking-[0.15em] text-gray-500 mb-2">Message</label>
						<textarea id="message" name="message" rows="5" class="w-full bg-[#0c0d11] border border-[#90c5ff1f] focus:border-blue-400/60 outline-none px-3 py-2.5 text-gray-200 transition-colors resize-none" placeholder="Say hello…"></textarea>
					</div>
					<div class="flex justify-center">
						<button type="submit" class="px-10 py-4 bg-blue-600/10 border border-blue-500/30 hover:bg-blue-600/20 hover:border-blue-400/60 hover:shadow-[0_0_30px_rgba(59,130,246,0.25)] transition-all font-sinistre text-xl text-blue-200 group relative overflow-hidden cursor-pointer">
							<span class="relative z-10 flex items-center gap-2">
								Transmit
								<span class="transition-transform group-hover:translate-x-1">&rarr;</span>
							</span>
							<span class="absolute inset-0 bg-gradient-to-r from-blue-500/0 via-blue-500/20 to-blue-500/0 -translate-x-full group-hover:translate-x-full transition-transform duration-500"></span>
						</button>
					</div>
				</form>

				<div class="flex justify-center gap-8 mt-10 text-sm">
					<a href="https://github.com/atduyar" target="_blank" rel="noopener" class="text-gray-500 hover:text-blue-300 transition-colors">GitHub</a>
					<a href="https://linkedin.com/in/atduyar" target="_blank" rel="noopener" class="text-gray-500 hover:text-blue-300 transition-colors">LinkedIn</a>
					<a href="mailto:atduyar@gmail.com" class="text-gray-500 hover:text-blue-300 transition-colors">atduyar@gmail.com</a>
				</div>
			</div>

			<!-- Radial glow that rises on button hover (from the original contact) -->
			<div class="select-none pointer-events-none absolute left-0 top-0 h-full w-full transition-[--x] duration-600 ease-out [--x:0%] group-has-[button:hover]/contact:[--x:100%] to-30% opacity-30 from-blue-500 to-transparent mix-blend-hard-light bg-radial-[circle_at_50%_85%,var(--tw-gradient-from)_var(--x)] group-has-[button:hover]/contact:opacity-60"></div>
		</section>

		<footer class="border-t border-[#90c5ff1a] bg-[#0c0d11] px-6 md:px-10 py-8 flex flex-wrap items-center justify-between gap-4 text-xs text-gray-600">
			<span>© 2026 Ahmet Tarik Duyar · Sarajevo</span>
			<span class="font-oldturcic text-blue-400/20 tracking-[0.3em] select-none" aria-hidden="true">𐰋𐰃𐰠𐰏</span>
		</footer>
	</div>

	<script is:inline>
		// Transmit = open the visitor's mail client with the message prefilled.
		document.getElementById("contact-form").addEventListener("submit", (e) => {
			e.preventDefault();
			const name = document.getElementById("name").value.trim();
			const subject = document.getElementById("subject").value.trim() || "Hello from atduyar.com";
			const message = document.getElementById("message").value.trim();
			const body = message + (name ? `\n\n— ${name}` : "");
			location.href = `mailto:atduyar@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
		});
	</script>

	<style>
		@keyframes float-1 {
			0%, 100% { transform: translateY(0) rotate(0deg); }
			50% { transform: translateY(-20px) rotate(5deg); }
		}
		@keyframes float-2 {
			0%, 100% { transform: translateY(0) rotate(0deg); }
			50% { transform: translateY(15px) rotate(-3deg); }
		}
		@keyframes float-3 {
			0%, 100% { transform: translateY(0) rotate(0deg); }
			50% { transform: translateY(-25px) rotate(8deg); }
		}
		.animate-float-1 { animation: float-1 5s ease-in-out infinite; }
		.animate-float-2 { animation: float-2 6s ease-in-out infinite; }
		.animate-float-3 { animation: float-3 7s ease-in-out infinite; }
	</style>
</BaseLayout>
